{"parentUuid":"a074a147-3859-4f5b-abde-8680837dd5fe","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/.claude/skills/translate-srt-selectlanguage/scripts/asr_build_srt.py","snippet":"1\t#!/usr/bin/env python3\n2\t# -*- coding: utf-8 -*-\n3\t\"\"\"Construit une piste de sous-titres japonaise à partir de l'audio, ancrée sur les cues du studio.\n4\t\n5\tPoint d'entrée UNIQUE du mode 3. Remplace `asr_reconcile.py`, dont le défaut structurel était\n6\td'affecter les tokens de l'ASR UN PAR UN aux fenêtres de temps des cues : une frontière de cue qui\n7\ttombe au milieu d'un mot le coupait en deux, et la piste rendait « 山田君イ » puis « エス アイム 山田 »\n8\tau lieu de « 山田君 » puis « イエスアイム山田 » (bug payé le 2026-08-21, deux remux pour rien).\n9\t\n10\tLe principe qui corrige cela : l'unité atomique d'affectation est la PHRASE de l'ASR, jamais le token.\n11\tChaque phrase part en entier dans la cue qu'elle recouvre le plus, si bien qu'aucun mot ne peut être\n12\tscindé, quel que soit l'endroit où tombent les bornes du studio.\n13\t\n14\tUsage :\n15\t    python3 asr_build_srt.py --wav full.wav --en en.srt --out ja.srt [--names names.json]\n16\t\"\"\"\n17\timport argparse\n18\timport json\n19\timport os\n20\timport re\n21\timport subprocess\n22\timport sys\n23\t\n24\t# --- paramètres exposés (principe HDA : rien de codé en dur dans le corps) --------------------\n25\tSILENCE_GAP = 0.22       # s. Seuil qui sépare deux tours de parole. Mesuré : 0,6 colle 3 répliques\n26\t                         # ensemble, 0,22 les sépare proprement.\n27\tMAX_DURATION = None      # JAMAIS une valeur ici : une limite de durée tranche au milieu d'un mot,\n28\t                         # exactement le défaut qu'on corrige. Seul le silence décide.\n29\tCHUNK_DURATION = 120.0   # s. Sans découpage, parakeet-mlx ne rend qu'un token sur un long fichier.\n30\tHALLUCINATION_RUN = 5    # un même caractère répété N fois d'affilée = silence mal transcrit.\n31\tPARAKEET_MODEL = \"mlx-community/parakeet-tdt_ctc-0.6b-ja\"\n32\t\n33\tKANJI = re.compile(r'[一-鿿]')\n34\tGLUE = {\"助詞\", \"助動詞\", \"接尾辞\", \"補助記号\", \"記号\"}\n35\tTAG_RE = re.compile(r'<[^>]+>|\\{\\\\an\\d\\}')\n36\t\n37\t# Cartons en majuscules de l'anglais officiel -> onomatopée japonaise d'usage. Ce ne sont pas des\n38\t# répliques parlées : l'ASR n'a rien à y entendre, et les laisser vides ferait un trou à l'écran.\n39\tSFX = {\n40\t    \"WHOMP\": \"ドッ\", \"THUD\": \"ドスン\", \"BAM\": \"バン\", \"BANG\": \"バンッ\", \"STARE\": \"ジー\",\n41\t    \"SILENCE\": \"シーン\", \"GASP\": \"ハッ\", \"SIGH\": \"はぁ\", \"BLUSH\": \"ぽっ\", \"SPARKLE\": \"キラ\",\n42\t    \"THUMP\": \"ドクン\", \"GULP\": \"ゴクリ\", \"AFTER SCHOOL\": \"放課後\", \"THE NEXT DAY\": \"翌日\",\n43\t    \"MEANWHILE\": \"一方\", \"RUSTLE\": \"ガサ\", \"CRASH\": \"ガシャン\", \"KNOCK\": \"コンコン\",\n44\t    \"RING\": \"リーン\", \"BUZZ\": \"ブー\", \"CLICK\": \"カチッ\", \"SLAM\": \"バタン\", \"POKE\": \"ツン\",\n45\t    \"DOKI\": \"ドキ\", \"THROB\": \"ズキ\", \"TENSE...\": \"ピリッ\", \"SMILE...\": \"ニコッ\", \"EEK\": \"ヒッ\",\n46\t}\n47\t\n48\t\n49\tdef sec(t):\n50\t    h, m, rest = t.split(\":\")\n51\t    s, ms = rest.split(\",\")\n52\t    return int(h) * 3600 + int(m) * 60 + int(s) + int(ms) / 1000\n53\t\n54\t\n55\tdef fmt(v):\n56\t    v = max(0.0, v)\n57\t    h = int(v // 3600); m = int(v % 3600 // 60); s = v - 3600 * h - 60 * m\n58\t    return f\"{h:02d}:{m:02d}:{int(s):02d},{round((s - int(s)) * 1000):03d}\"\n59\t\n60\t\n61\tdef read_en_cues(path):\n62\t    \"\"\"Lit le SRT anglais officiel et marque chaque cue « parlée » ou « décorative ».\n63\t\n64\t    Heuristique mesurée sur une piste subrip Crunchyroll : une réplique parlée porte au plus une\n65\t    balise <font> et aucune de <i>/<b>/{\\\\an} ; un carton décoratif (onomatopée, panneau, aparté)\n66\t    empile les balises (Comic Sans, taille, couleur). Relevé : 292 parlées contre 181 cartons.\n67\t    \"\"\"\n68\t    cues = []\n69\t    for blk in open(path, encoding=\"utf-8\").read().strip().split(\"\\n\\n\"):\n70\t        L = blk.split(\"\\n\")\n71\t        if len(L) < 3:\n72\t            continue\n73\t        m = re.match(r'(\\S+) --> (\\S+)', L[1])\n74\t        if not m:\n75\t            continue\n76\t        raw = \"\\n\".join(L[2:])\n77\t        plain = (raw.count(\"<font\") <= 1 and \"<i>\" not in raw\n78\t                 and \"{\\\\an\" not in raw and \"<b>\" not in raw)\n79\t        cues.append({\"s\": sec(m.group(1)), \"e\": sec(m.group(2)),\n80\t                     \"en\": TAG_RE.sub(\"\", raw).strip(), \"plain\": plain})\n81\t    return sorted(cues, key=lambda c: c[\"s\"])\n82\t\n83\t\n84\tdef cluster_cues(cues):\n85\t    \"\"\"Regroupe les cues dont les fenêtres se recouvrent.\n86\t\n87\t    Indispensable : ffmpeg avale SILENCIEUSEMENT les blocs qui se chevauchent au remux (473 entrés,\n88\t    463 sortis, aucun avertissement). Un groupe ne produit qu'une ligne de sortie.\n89\t    \"\"\"\n90\t    clusters, cur = [], None\n91\t    for c in cues:\n92\t        if cur is None:\n93\t            cur = [c]\n94\t        elif c[\"s\"] < max(m[\"e\"] for m in cur) - 1e-6:\n95\t            cur.append(c)\n96\t        else:\n97\t            clusters.append(cur); cur = [c]\n98\t    if cur:\n99\t        clusters.append(cur)\n100\t    return clusters\n101\t\n102\t\n103\tdef transcribe(wav):\n104\t    \"\"\"Transcrit en PHRASES (pas en tokens) : c'est l'unité atomique d'affectation.\"\"\"\n105\t    from parakeet_mlx import from_pretrained\n106\t    from parakeet_mlx.parakeet import DecodingConfig\n107\t    from parakeet_mlx.alignment import SentenceConfig\n108\t    model = from_pretrained(PARAKEET_MODEL)\n109\t    cfg = DecodingConfig(sentence=SentenceConfig(\n110\t        max_words=None, silence_gap=SILENCE_GAP, max_duration=MAX_DURATION))\n111\t    res = model.transcribe(wav, chunk_duration=CHUNK_DURATION, decoding_config=cfg)\n112\t    return [{\"x\": s.text.strip(), \"s\": s.start, \"e\": s.end}\n113\t            for s in res.sentences if s.text.strip()]\n114\t\n115\t\n116\tdef assign_sentences(sentences, clusters):\n117\t    \"\"\"Affecte chaque phrase ENTIÈRE au groupe qu'elle recouvre le plus.\n118\t\n119\t    C'est le cœur du correctif. Une affectation token par token coupe un mot dès qu'une borne de\n120\t    cue tombe en son milieu ; une phrase, elle, est indivisible, donc « イエスアイム山田 » reste\n121\t    entier même si le studio a placé une frontière à 40,14 s.\n122\t    \"\"\"\n123\t    windows = [(cl[0][\"s\"], max(m[\"e\"] for m in cl)) for cl in clusters]\n124\t    buckets = [[] for _ in clusters]\n125\t    for sn in sentences:\n126\t        best, best_ov = None, 0.0\n127\t        for i, (ws, we) in enumerate(windows):\n128\t            ov = min(we, sn[\"e\"]) - max(ws, sn[\"s\"])\n129\t            if ov > best_ov:\n130\t                best, best_ov = i, ov\n131\t        if best is None:  # aucune intersection : rattacher au groupe le plus proche, sous 1,5 s\n132\t            mid = (sn[\"s\"] + sn[\"e\"]) / 2\n133\t            i = min(range(len(windows)),\n134\t                    key=lambda k: min(abs(mid - windows[k][0]), abs(mid - windows[k][1])))\n135\t            if min(abs(mid - windows[i][0]), abs(mid - windows[i][1])) > 1.5:\n136\t                continue\n137\t            best = i\n138\t        buckets[best].append(sn)\n139\t    for b in buckets:\n140\t        b.sort(key=lambda s: s[\"s\"])\n141\t    return buckets\n142\t\n143\t\n144\tdef is_hallucination(t):\n145\t    \"\"\"Whisper/Parakeet transcrivent un silence en répétant un caractère. Aucun mot japonais ne\n146\t    répète le même signe plus de quatre fois d'affilée.\"\"\"\n147\t    return bool(re.search(r'(.)\\1{' + str(HALLUCINATION_RUN - 1) + r',}', t))\n148\t\n149\t\n150\tclass Furigana:\n151\t    \"\"\"Annote les kanji par fugashi/unidic. Les noms de l'oeuvre portent une lecture IMPOSÉE :\n152\t    l'analyseur ne connaît pas les patronymes et rend 谷 -> こく au lieu de たに.\"\"\"\n153\t\n154\t    def __init__(self, names):\n155\t        import fugashi, jaconv\n156\t        self.tagger = fugashi.Tagger()\n157\t        self.jaconv = jaconv\n158\t        # Composer les suffixes AVANT le tri par longueur, sinon 山田君 sort en\n159\t        # 山田（やまだ）君（きみ）, le -kun étant lu comme le pronom « toi ».\n160\t        full = dict(names)\n161\t        for name, read in list(names.items()):\n162\t            full.setdefault(name + \"君\", read + \"くん\")\n163\t            full.setdefault(name + \"さん\", read + \"さん\")\n164\t        self.names = sorted(full.items(), key=lambda kv: -len(kv[0]))\n165\t\n166\t    @staticmethod\n167\t    def _is_kana(c):\n168\t        return '぀' <= c <= 'ヿ'\n169\t\n170\t    def _ruby(self, surface, reading):\n171\t        if not KANJI.search(surface) or not reading:\n172\t            return surface\n173\t        r = self.jaconv.kata2hira(reading); s = surface\n174\t        suf = 0\n175\t        while suf < min(len(s), len(r)) - 1 and self._is_kana(s[-1 - suf]) and s[-1 - suf] == r[-1 - suf]:\n176\t            suf += 1\n177\t        pre = 0\n\n... [142 lines truncated] ..."},"type":"attachment","uuid":"0d9ad44a-de80-4cf8-a3ea-d063eb8deefb","timestamp":"2026-08-20T16:14:53.775Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"1393489a-77f2-4dd0-9c0e-85b7d7ef0ec1","version":"2.1.234","gitBranch":"main"}
