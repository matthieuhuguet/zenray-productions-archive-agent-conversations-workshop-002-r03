, clusters):\n    \"\"\"Affecte chaque phrase ENTIÈRE au groupe qu'elle recouvre le plus.\n\n    C'est le cœur du correctif. Une affectation token par token coupe un mot dès qu'une borne de\n    cue tombe en son milieu ; une phrase, elle, est indivisible, donc « イエスアイム山田 » reste\n    entier même si le studio a placé une frontière à 40,14 s.\n    \"\"\"\n    windows = [(cl[0][\"s\"], max(m[\"e\"] for m in cl)) for cl in clusters]\n    buckets = [[] for _ in clusters]\n    for sn in sentences:\n        best, best_ov = None, 0.0\n        for i, (ws, we) in enumerate(windows):\n            ov = min(we, sn[\"e\"]) - max(ws, sn[\"s\"])\n            if ov > best_ov:\n                best, best_ov = i, ov\n        if best is None:  # aucune intersection : rattacher au groupe le plus proche, sous 1,5 s\n            mid = (sn[\"s\"] + sn[\"e\"]) / 2\n            i = min(range(len(windows)),\n                    key=lambda k: min(abs(mid - windows[k][0]), abs(mid - windows[k][1])))\n            if min(abs(mid - windows[i][0]), abs(mid - windows[i][1])) > 1.5:\n                continue\n            best = i\n        buckets[best].append(sn)\n    for b in buckets:\n        b.sort(key=lambda s: s[\"s\"])\n    return buckets\n\n\ndef is_hallucination(t):\n    \"\"\"Whisper/Parakeet transcrivent un silence en répétant un caractère. Aucun mot japonais ne\n    répète le même signe plus de quatre fois d'affilée.\"\"\"\n    return bool(re.search(r'(.)\\1{' + str(HALLUCINATION_RUN - 1) + r',}', t))\n\n\nclass Furigana:\n    \"\"\"Annote les kanji par fugashi/unidic. Les noms de l'oeuvre portent une lecture IMPOSÉE :\n    l'analyseur ne connaît pas les patronymes et rend 谷 -> こく au lieu de たに.\"\"\"\n\n    def __init__(self, names):\n        import fugashi, jaconv\n        self.tagger = fugashi.Tagger()\n        self.jaconv = jaconv\n        # Composer les suffixes AVANT le tri par longueur, sinon 山田君 sort en\n        # 山田（やまだ）君（きみ）, le -kun étant lu comme le pronom « toi ».\n        full = dict(names)\n        for name, read in list(names.items()):\n            full.setdefault(name + \"君\", read + \"くん\")\n            full.setdefault(name + \"さん\", read + \"さん\")\n        self.names = sorted(full.items(), key=lambda kv: -len(kv[0]))\n\n    @staticmethod\n    def _is_kana(c):\n        return '぀' <= c <= 'ヿ'\n\n    def _ruby(self, surface, reading):\n        if not KANJI.search(surface) or not reading:\n            return surface\n        r = self.jaconv.kata2hira(reading); s = surface\n        suf = 0\n        while suf < min(len(s), len(r)) - 1 and self._is_kana(s[-1 - suf]) and s[-1 - suf] == r[-1 - suf]:\n            suf += 1\n        pre = 0\n        while pre < min(len(s) - suf, len(r) - suf) - 1 and self._is_kana(s[pre]) and s[pre] == r[pre]:\n            pre += 1\n        cs = s[pre:len(s) - suf] if suf else s[pre:]\n        cr = r[pre:len(r) - suf] if suf else r[pre:]\n        if not cs or not cr or not KANJI.search(cs):\n            return surface\n        return s[:pre] + cs + \"（\" + cr + \"）\" + (s[len(s) - suf:] if suf else \"\")\n\n    def __call__(self, text):\n        holes = {}\n        for i, (name, read) in enumerate(self.names):\n            k = chr(0xE000 + i)  # zone privée Unicode : une sentinelle numérique serait recrachée\n            if name in text:     # telle quelle et afficherait « 14 » à la place du prénom.\n                text = text.replace(name, k); holes[k] = f\"{name}（{read}）\"\n        chunks = []\n        for w in self.tagger(text):\n            s = w.surface\n            if any(0xE000 <= ord(ch) <= 0xF8FF for ch in s):\n                chunks.append(s); continue\n            piece = self._ruby(s, getattr(w.feature, \"kana\", None) or getattr(w.feature, \"pron\", None))\n            if chunks and (w.feature.pos1 in GLUE or not chunks[-1].strip()):\n                chunks[-1] += piece\n            else:\n                chunks.append(piece)\n        out = \" \".join(c for c in chunks if c.strip())\n        for k, v in holes.items():\n            out = out.replace(k, v)\n        return re.sub(r'\\s+', ' ', out).strip()\n\n\ndef check_no_overlap(blocks):\n    \"\"\"Contrôle 1 du protocole : zéro chevauchement AVANT de laisser ffmpeg y toucher.\"\"\"\n    bad, prev_e = 0, -1.0\n    for b in blocks:\n        L = b.split(\"\\n\")\n        m = re.match(r'(\\S+) --> (\\S+)', L[1])\n        if sec(m.group(1)) < prev_e - 1e-6:\n            bad += 1\n        prev_e = sec(m.group(2))\n    return bad\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--wav\", required=True, help=\"audio japonais, WAV 16 kHz mono\")\n    ap.add_argument(\"--en\", required=True, help=\"SRT anglais officiel (structure + cartons)\")\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--names\", help=\"JSON {kanji: lecture} des noms propres de la série\")\n    ap.add_argument(\"--report\", help=\"rapport des cues sans ASR / en désaccord\")\n    ap.add_argument(\"--cache\", help=\"JSON de phrases déjà transcrites (évite de refaire l'ASR)\")\n    args = ap.parse_args()\n\n    names = json.load(open(args.names, encoding=\"utf-8\")) if args.names else {}\n    cues = read_en_cues(args.en)\n    clusters = cluster_cues(cues)\n\n    if args.cache and os.path.exists(args.cache):\n        sentences = json.load(open(args.cache, encoding=\"utf-8\"))\n    else:\n        sentences = transcribe(args.wav)\n        if args.cache:\n            json.dump(sentences, open(args.cache, \"w\"), ensure_ascii=False, indent=1)\n\n    buckets = assign_sentences(sentences, clusters)\n    furi = Furigana(names)\n\n    blocks, report = [], []\n    for i, (cl, got) in enumerate(zip(clusters, buckets), start=1):\n        cs, ce = cl[0][\"s\"], max(m[\"e\"] for m in cl)\n        text = \"\".join(s[\"x\"] for s in got if not is_hallucination(s[\"x\"])).strip()\n        if text:\n            line = furi(text)\n        else:\n            sfx = next((SFX[m[\"en\"].strip().upper()] for m in cl\n                        if m[\"en\"].strip().upper() in SFX), None)\n            line = sfx or \"…\"\n            if sfx is None:\n                report.append((i, cs, \" / \".join(m[\"en\"] for m in cl), \"aucun ASR, aucun SFX connu\"))\n        blocks.append(f'{i}\\n{fmt(cs)} --> {fmt(ce)}\\n{line}')\n\n    overlaps = check_no_overlap(blocks)\n    if overlaps:\n        sys.exit(f\"ÉCHEC : {overlaps} chevauchement(s) dans le SRT produit — ffmpeg les avalerait \"\n                 f\"en silence. Corriger cluster_cues() avant de remuxer.\")\n\n    open(args.out, \"w\", encoding=\"utf-8\").write(\"\\n\\n\".join(blocks) + \"\\n\")\n    if args.report:\n        with open(args.report, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"# Cues sans transcription\\n\\n\")\n            for n, s, en, tag in report:\n                f.write(f'## [{n}] {fmt(s)} — {tag}\\n- Anglais : {en}\\n\\n')\n\n    filled = sum(1 for b in blocks if b.split(\"\\n\")[-1] != \"…\")\n    print(f\"{len(blocks)} blocs | {filled} avec texte ({100*filled//len(blocks)}%) | \"\n          f\"{len(sentences)} phrases ASR | 0 chevauchement\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"22f7bf26-59d5-4478-a546-e5c70e712c18","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"1393489a-77f2-4dd0-9c0e-85b7d7ef0ec1","version":"2.1.234","gitBranch":"main"}
