OUTES.has(name)\n56\t\n57\texport async function authOk(req, name) {\n58\t  if (!API_SECRET) return true\n59\t  if (isPublicReadRoute(req, name)) return true\n60\t  // La résolution d'un jeton de partage est publique. Son émission et sa révocation restent protégées par\n61\t  // x-zr-auth, comme toutes les écritures de l'app.\n62\t  if (name === 'share-token' && (req.method || 'GET').toUpperCase() === 'GET') return true\n63\t  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n64\t  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n65\t  if (name === 'video-comment') return true\n66\t  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n67\t  if (typeof h === 'string' && h.length === API_SECRET.length) {\n68\t    try { if (timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET))) return true } catch {}\n69\t  }"}]},"uuid":"552a7078-0c43-4196-a126-8243bd740540","timestamp":"2026-08-20T14:27:36.743Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/api/[...route].js","content":"\n// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\n// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\n// Vercel : la clé maître (media-key), les écritures (page/upload-*/publish/state) et la gestion de repos sont\n// fermées par défaut. EXEMPTÉS : les endpoints servis comme src DOM (<img>/<video>/hls.js) qui NE PEUVENT PAS\n// porter de header custom — leur contenu est chiffré sur CDN public ou derrière la protection de déploiement.\n// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\nconst API_SECRET = process.env.ZENRAY_API_SECRET || ''\n// raw-proxy est EXEMPTÉ du gate (servi comme src DOM <img>,