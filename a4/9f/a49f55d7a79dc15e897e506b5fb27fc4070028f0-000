lication) -> Bool {\n   185\t        false\n   186\t    }\n   187\t\n   188\t    @objc private func repositionPanel() {\n   189\t        positionPanel()\n   190\t    }\n   191\t\n   192\t    private func positionPanel() {\n   193\t        guard let panel, let screen = NSScreen.main ?? NSScreen.screens.first else { return }\n   194\t        let visibleFrame = screen.visibleFrame\n   195\t        let origin = NSPoint(\n   196\t            x: visibleFrame.maxX - panel.frame.width - model.config.widgetMargin,\n   197\t            y: visibleFrame.minY + model.config.widgetMargin\n   198\t        )\n   199\t        panel.setFrameOrigin(origin)\n   200\t    }\n   201\t\n   202\t    private func shutdownMac() {\n   203\t        var error: NSDictionary?\n   204\t        let script = #\"do shell script \"/sbin/shutdown -h now\" with administrator privileges\"#\n   205\t        NSAppleScript(source: script)?.executeAndReturnError(&error)\n   206\t\n   207\t        if error != nil {\n   208\t            model.setShutdownError(\"macOS n’a pas autorisé l’extinction immédiate. Réessaie et accepte l’autorisation administrateur.\")\n   209\t        }\n   210\t    }\n   211\t}\n   212\t\n   213\t@main\n   214\tstruct SleepShutdownMain {\n   215\t    static func main() {\n   216\t        let application = NSApplication.shared\n   217\t        let delegate = AppDelegate()\n   218\t        application.delegate = delegate\n   219\t        application.run()\n   220\t    }\n   221\t}\n"},{"type":"input_text","text":"     1\timport Foundation\n     2\t\n     3\tstruct AppConfig {\n     4\t    // Debug test: 22:00. Change this single value to 0 after validation for midnight.\n     5\t    let sleepStartHour = 22\n     6\t    let sleepStartMinute = 0\n     7\t    let widgetWidth: CGFloat = 380\n     8\t    let widgetHeight: CGFloat = 250\n     9\t    let widgetMargin: CGFloat = 22\n    10\t}\n\n--- state.json ---\n{\n  \"status\": \"debug-running\",\n  \"testStart\": \"22:00\",\n  \"production