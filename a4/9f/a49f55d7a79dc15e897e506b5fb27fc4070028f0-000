/ass_library.c\nTools/libass-rounded/src/libass/ass_library.h\nTools/libass-rounded/src/libass/ass_outline.c\nTools/libass-rounded/src/libass/ass_outline.h\nTools/libass-rounded/src/libass/ass_parse.c\nTools/libass-rounded/src/libass/ass_parse.h\nTools/libass-rounded/src/libass/ass_priv.h\nTools/libass-rounded/src/libass/ass_rasterizer.c\nTools/libass-rounded/src/libass/ass_rasterizer.h\nTools/libass-rounded/src/libass/ass_render.c\nTools/libass-rounded/src/libass/ass_render.h\nTools/libass-rounded/src/libass/ass_render_api.c\nTools/libass-rounded/src/libass/ass_shaper.c\nTools/libass-rounded/src/libass/ass_shaper.h\nTools/libass-rounded/src/libass/ass_string.c\nTools/libass-rounded/src/libass/ass_string.h\nTools/libass-rounded/src/libass/ass_strtod.c\nTools/libass-rounded/src/libass/ass_types.h\nTools/libass-rounded/src/libass/ass_utils.c\nTools/libass-rounded/src/libass/ass_utils.h\nTools/libass-rounded/src/libass/dwrite_c.h\nTools/libass-rounded/src/libass/libass.sym\nTools/libass-rounded/src/libass/meson.build\nTools/libass-rounded/src/libass/wyhash.h\nTools/libass-rounded/src/ltnasm.sh\nTools/libass-rounded/src/m4/.gitignore\nTools/libass-rounded/src/m4/ax_append_compile_flags.m4\nTools/libass-rounded/src/m4/ax_append_flag.m4\nTools/libass-rounded/src/m4/ax_check_compile_flag.m4\nTools/libass-rounded/src/m4/ax_require_defined.m4\nTools/libass-rounded/src/meson.build\nTools/libass-rounded/src/meson_options.txt\nTools/libass-rounded/src/profile/meson.build\nTools/libass-rounded/src/profile/profile.c\nTools/libass-rounded/src/test/meson.build\nTools/libass-rounded/src/test/test.c\n"},{"type":"input_text","text":"import AppKit\nimport ApplicationServices\nimport CoreGraphics\nimport Darwin\nimport Foundation\n\nprivate let appLimitsURL = URL(string: \"x-apple.systempreferences:com.apple.Screen-Time-Settings.extension?path=app-limits\")!\n\nprivate enum ScreenTimeError: LocalizedError {\n    case missingPasscode\n    case invalidPasscode\n    case settingsUnavailable\n    case appLimitsWindowUnavailable\n    case appLimitsToggleUnavailable\n    case togglePressFailed(AXError)\n    case appLimitsStillEnabled\n\n    var errorDescription: String? {\n        switch self {\n        case .missingPasscode:\n            return \"SCREEN_TIME_PASSCODE est absent.\"\n        case .invalidPasscode:\n            return \"SCREEN_TIME_PASSCODE doit contenir exactement 4 chiffres.\"\n        case .settingsUnavailable:\n            return \"System Settings ne se lance pas.\"\n        case .appLimitsWindowUnavailable:\n            return \"La page App Limits ne répond pas.\"\n        case .appLimitsToggleUnavailable:\n            return \"Le bouton App Limits est introuvable dans l’accessibilité macOS.\"\n        case .togglePressFailed(let error):\n            return \"Le bouton App Limits refuse l’action : \\(error.rawValue).\"\n        case .appLimitsStillEnabled:\n            return \"App Limits reste actif après la saisie du code.\"\n        }\n    }\n}\n\nprivate func attribute(_ element: AXUIElement, _ key: String) -> Any? {\n    var result: CFTypeRef?\n    let error = AXUIElementCopyAttributeValue(element, key as CFString, &result)\n    return error == .success ? result : nil\n}\n\nprivate func children(of element: AXUIElement) -> [AXUIElement] {\n    (attribute(element, kAXChildrenAttribute) as? [AXUIElement]) ?? []\n}\n\nprivate func role(of element: AXUIElement) -> String {\n    (attribute(element, kAXRoleAttribute) as? String) ?? \"\"\n}\n\nprivate func isToggle(_ element: AXUIElement) -> Bool {\n    let elementRole = role(of: element)\n    return elementRole == kAXCheckBoxRole || elementRole == \"AXSwitch\"\n}\n\nprivate func toggleState(of element: AXUIElement) -> Bool? {\n    guard let number = attribute(element, kAXValueAttribute) as? NSNumber else { return nil }\n    return number.intValue != 0\n}\n\nprivate func findWindow(in application: AXUIElement) -> AXUIElement? {\n    if role(of: application) == kAXWindowRole {\n        let title = (attribute(application, kAXTitleAttribute) as? String) ?? \"\"\n        if title == \"App Limits\" { return application }\n    }\n    for child in children(of: application) {\n        if let match = findWindow(in: child) { return match }\n    }\n    return nil\n}\n\nprivate func findToggles(in element: AXUIElement, result: inout [AXUIElement]) {\n    if isToggle(element) { result.append(element) }\n    for child in children(of: element) { findToggles(in: child, result: &result) }\n}\n\nprivate func runningSystemSettings() -> NSRunningApplication? {\n    NSWorkspace.shared.runningApplications.first { $0.bundleIdentifier == \"com.apple.systempreferences\" }\n}\n\nprivate func openAppLimits() throws -> (NSRunningApplication, AXUIElement) {\n    _ = NSWorkspace.shared.open(appLimitsURL)\n\n    var app: NSRunningApplication?\n    for _ in 0..<30 {\n        app = runningSystemSettings()\n        if app != nil { break }\n        Thread.sleep(forTimeInterval: 0.2)\n    }\n    guard let settings = app else { throw ScreenTimeError.settingsUnavailable }\n\n    settings.unhide()\n    _ = settings.activate(options: [.activateAllWindows])\n\n    let application = AXUIElementCreateApplication(settings.processIdentifier)\n    for _ in 0..<50 {\n        if let window = findWindow(in: application) { return (settings, window) }\n        Thread.sleep(forTimeInterval: 0.2)\n    }\n    throw ScreenTimeError.appLimitsWindowUnavailable\n}\n\nprivate func firstToggle(in window: AXUIElement) -> AXUIElement? {\n    var toggles: [AXUIElement] = []\n    findToggles(in: window, result: &toggles)\n    return toggles.first\n}\n\nprivate func keyCode(for digit: Character) -> CGKeyCode? {\n    switch digit {\n    case \"0\": return 29\n    case \"1\": return 18\n    case \"2\": return 19\n    case \"3\": return 20\n    case \"4\": return 21\n    case \"5\": return 23\n    case \"6\": return 22\n    case \"7\": return 26\n    case \"8\": return 28\n\n--- ScreenTime fix ---\n#!/bin/zsh\nset -euo pipefail\n\nscript_dir=\"$(cd -- \"$(dirname -- \"$0\")\" && pwd)\"\nhelper=\"$script_dir/ScreenTimeAX.swift\"\n\nif [[ ! -f \"$helper\" ]]; then\n  print -u2 \"Screen Time helper introuvable : $helper\"\n  exit 1\nfi\n\nscreen_time_passcode=\"${SCREEN_TIME_PASSCODE:-}\"\nif [[ -z \"$screen_time_passcode\" ]]; then\n  read -r -s \"screen_time_passcode?Code Screen Time (4 chiffres) : \"\n  print\nfi\n\nif [[ ! \"$screen_time_passcode\" == [0-9][0-9][0-9][0-9] ]]; then\n  print -u2 \"Le code Screen Time doit contenir exactement 4 chiffres.\"\n  unset screen_time_passcode\n  exit 2\nfi\n\nbuild_dir=\"$(mktemp -d \"${TMPDIR:-/tmp}/zenray-screen-time.XXXXXX\")\"\ntrap 'rm -rf \"$build_dir\"; unset screen_time_passcode' EXIT\n\nswiftc \\\n  -framework AppKit \\\n  -framework ApplicationServices \\\n  -framework CoreGraphics \\\n  \"$helper\" \\\n  -o \"$build_dir/ScreenTimeAX\"\n\nSCREEN_TIME_PASSCODE=\"$screen_time_passcode\" \"$build_dir/ScreenTimeAX\" --disable-app-limits\n\n--- libass README ---\nlibass [![Coverity scan build status](https://scan.coverity.com/projects/3531/badge.svg)](https://scan.coverity.com/projects/3531) [![Build status](https://github.com/libass/libass/actions/workflows/ghci.yml/badge.svg?branch=master&event=push)](https://github.com/libass/libass/actions/workflows/ghci.yml?query=branch%3Amaster+event%3Apush)\n======\nlibass is a portable subtitle renderer for the ASS/SSA (Advanced Substation Alpha/Substation Alpha) subtitle format. It is mostly compatible with VSFilter.\n\nGet it\n======\nSee [GitHub releases](https://github.com/libass/libass/releases) for the latest release 0.17.5 (released 2026-06-24).\nSee the [changelog](https://github.com/libass/libass/blob/master/Changelog) for a detailed list of changes.\n\nSource code is available from our [GitHub repository](https://github.com/libass/libass).\n\nContact\n=======\nPlease use the [issue tracker](https://github.com/libass/libass/issues?state=open) to report bugs or feature requests.\n\nWe have an IRC channel, too. Talk to us on [irc.libera.chat/#libass](https://web.libera.chat/#libass). Note that we cannot be online all the time and we cannot answer IRC questions if you leave the channel. Even if you do not get an immediate response, keep your IRC client open, and we will eventually get back to you.\n\nBuilding\n========\n\nlibass offers two build systems to choose from: Autotools and Meson.\n\nAutotools is preferred for development since it integrates with our testing\ninfrastructure and is feature-complete on all platforms supported by Autotools.  \nIf you are packaging libass for distribution, Autotools is recommended;\nwhen packaging for Windows Meson should work equally well.\n\nMeson lacks integration with testing infrastructure, but works otherwise well on\nWindows. It is suited for static-only builds on any platform well supported by\nMeson and as a Meson subproject.\nNotably, Meson supports MSVC and generation of VS project files.\n\nMacro defines\n-------------\n\nUnless developing libass there’s usually no need to manually define macros\nand there are no stability guarantees for these manual defines.\n\n- `DEBUG_LEVEL=0..3`\n  - `0` use the default set of asserts; implied if macro is not defined at all\n  - `1`, `2` *unused*\n  - `3` additionally assert assumptions usually pledged to the compiler for optimization purposes\n\nInformation about the ASS format:\n=================================\n- [ASS format overview](https://github.com/libass/libass/wiki/ASS-File-Format-Guide)\n- [ASS override tags (Aegisub manual)](http://docs.aegisub.org/latest/ASS_Tags/)\n- [VSFilter source code (Guliverkli2)](http://sourceforge.net/p/guliverkli2/code/HEAD/tree/src/subtitles/)\n\nOther ASS/SSA implementations:\n==============================\n- VSFilter:\n  - [xy-VSFilter/XySubFilter](https://github.com/Cyberbeing/xy-VSFilter/)\n    - [pfmod](https://github.com/pinterf/xy-VSFilter/)\n  - VSFilter in [MPC-HC](https://github.com/clsid2/mpc-hc/tree/develop/src/filters/transform/VSFilter/)\n  - [VSFilterMod](https://code.google.com/archive/p/vsfiltermod/) with custom format extensions (defunct, subsumed by forks)\n    - [sorayuki fork](https://github.com/sorayuki/VSFilterMod/) with some bugfixes (defunct)\n    - various forks focussing on internal use\n  - [Threaded VSFilter](https://code.google.com/p/threaded-vsfilter/) (defunct)\n  - VSFilter in [Guliverkli2](http://sourceforge.net/projects/guliverkli2/) (defunct, subsumed by all of the above)\n  - VSFilter in [guliverkli](http://sourceforge.net/projects/guliverkli/) (defunct, forked as Guliverkli2)\n- [ffdshow](http://ffdshow-tryout.sourceforge.net/) (defunct)\n- [Perian](https://github.com/MaddTheSane/perian) (defunct)\n- [asa](https://web.archive.org/web/20110906033709/http://asa.diac24.net/) (defunct)\n- [libjass](https://github.com/Arnavion/libjass) (defunct)\n- [ASS.js](https://github.com/weizhenye/ASS)\n\nPackaging status\n================\n\n[![Packaging status](https://repology.org/badge/vertical-allrepos/libass.svg?columns=3&header=libass&exclude_unsupported=1)](https://repology.org/project/libass/versions)\n"},{"type":"input_text","text":"Tools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/._Info.plist\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/._MacOS\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/._Resources\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/.__CodeSignature\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/Info.plist\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/MacOS/._winevideo-patcher\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/MacOS/winevideo-patcher\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/Resources/._patch.sh\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/Resources/._payload\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/Resources/._restore.sh\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/Resources/patch.sh\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/Resources/restore.sh\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/_CodeSignature/._CodeResources\nTools/CrossOverWinevideoPatcher/winevideo Patcher.app/Contents/_CodeSignature/CodeResources\n\n--- Info ---\n{\n  \"CFBundleDisplayName\" => \"winevideo Patcher\"\n  \"CFBundleExecutable\" => \"winevideo-patcher\"\n  \"CFBundleIdentifier\" => \"com.winevideo.patcher\"\n  \"CFBundleName\" => \"winevideo Patcher\"\n  \"CFBundlePackageType\" => \"APPL\"\n  \"CFBundleShortVersionString\" => \"1.0\"\n  \"CFBundleVersion\" => \"1.0\"\n  \"LSApplicationCategoryType\" => \"public.app-category.utilities\"\n  \"LSMinimumSystemVersion\" => \"14.0\"\n  \"NSHighResolutionCapable\" => true\n}\n"},{"type":"input_text","text":"--- FocusGuard header ---\n#!/bin/zsh\n#\n# YouTube Guard\n#\n# Rule: YouTube is blocked. One click grants 15 minutes on the whole site.\n# Always free, no click needed: /feed/subscriptions, @IciJapon, @IciJaponCorp.\n#\n# A short list of channels is treated as STRICT: unlocking one of them only\n# buys 1 minute, not 15, and it never rides along on a general 15-minute\n# grant. Watching one of these means clicking through a block screen roughly\n# once a minute — enough friction to break the habit without an outright ban.\n#\n# 1. Settings\n# 2. Reading a URL\n# 3. Grants (general 15 min, strict 1 min)\n# 4. The block page\n# 5. Talking to Chrome\n# 6. The loop\n# 7. Install / uninstall / status\n#\n\nset -u\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin\"\n\n# ---------------------------------------------------------------- 1. Settings\n\nGRANT_MINUTES=15          # general YouTube unlock\nSTRICT_GRANT_MINUTES=1    # unlock for channels in STRICT_CHANNELS\n\n# Channels that get the 1-minute leash instead of the general 15-minute one.\n# Match against the lowercased path, no query/anchor (see UrlPath below).\nSTRICT_CHANNELS=(\n  \"/@gregguillotin\"\n  \"/channel/ucm1c1okz-7cpv7bez-pzugg\"   # Greg Guillotin (main)\n  \"/channel/ucjd8rq4cazzsximqtkqlh1q\"   # Greg Guillotin - La Chaîne Animale\n)\n\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"\nTABS_DIR=\"$STATE_DIR/tabs\"\nGRANT_FILE=\"$STATE_DIR/grant_until\"\nSTRICT_GRANT_FILE=\"$STATE_DIR/grant_until_strict\"\n\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\n\nTIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"\nTIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"\n\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\n\nSay() { printf '%s\\n' \"$*\"; }\nNow() { date '+%s'; }\n\nEnsureState() {\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\" \"$TABS_DIR\"\n  chmod 700 \"$STATE_DIR\"\n}\n\n# ---------------------------------------------------------- 2. Reading a URL\n\n# Everything below works on the lowercased URL, with query and anchor removed.\nUrlPath() {\n  local path=\"${1%%\\?*}\"\n  printf '%s' \"${${path%%\\#*}:l}\"\n}\n\nIsYouTube() {\n  case \"${1:l}\" in\n    https://youtube.com*|https://www.youtube.com*|https://m.youtube.com*) return 0 ;;\n    https://music.youtube.com*|https://youtu.be*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Pages that never need a grant.\nIsAlwaysFree() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */feed/subscriptions|*/feed/subscriptions/*) return 0 ;;\n    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n    */channel/ucegev5mbdmgmgzfpralemfa|*/channel/ucegev5mbdmgmgzfpralemfa/*) return 0 ;;\n    */channel/uc_r99mjdkzksbgeedoylbkw|*/channel/uc_r99mjdkzksbgeedoylbkw/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Channels on the 1-minute leash.\nIsStrictChannel() {\n  local path pattern; path=\"$(UrlPath \"$1\")\"\n  for pattern in $STRICT_CHANNELS; do\n    case \"$path\" in\n      *\"$pattern\"|*\"$pattern\"/*) return 0 ;;\n    esac\n  done\n  return 1\n}\n\nScope() { IsStrictChannel \"$1\" && printf 'strict' || printf 'general' }\n\nIsBlockPage() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] }\nIsUnlockClick() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] && [[ \"$1\" == *\"unlock=1\"* ]] }\nScopeFromURL() { [[ \"$1\" == *\"scope=strict\"* ]] && printf 'strict' || printf 'general' }\n\n# ------------------------------------------------------- 3. Grants (per scope)\n\nGrantFile() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_FILE\" || printf '%s' \"$GRANT_FILE\" }\nGrantMinutes() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_MINUTES\" || printf '%s' \"$GRANT_MINUTES\" }\nTimerPidFile() { printf '%s' \"$STATE_DIR/timer_pid_$1\" }\n\nGrantActive() {\n  local file=\"$(GrantFile \"$1\")\" until\n  [[ -s \"$file\" ]] || return 1\n  until=\"$(cat \"$file\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  (( $(Now) < until ))\n}\n\nStartGrant() {\n  local scope=\"$1\" file minutes pidfile\n  file=\"$(GrantFile \"$scope\")\"; minutes=\"$(GrantMinutes \"$scope\")\"; pidfile=\"$(TimerPidFile \"$scope\")\"\n  EnsureState\n  printf '%s\\n' $(( $(Now) + minutes * 60 )) > \"$file\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\"\n  if [[ -x \"$TIMER_BIN\" ]]; then\n    nohup \"$TIMER_BIN\" \"$file\" >/dev/null 2>&1 </dev/null &\n    printf '%s\\n' $! > \"$pidfile\"\n  fi\n}\n\nEndGrant() {\n  local scope=\"$1\" pidfile; pidfile=\"$(TimerPidFile \"$scope\")\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\" \"$(GrantFile \"$scope\")\"\n}\n\n# The pkill sweep catches timers left over by an older version, which knew no\n# pid file: one surviving timer holds the binary open and makes swiftc fail.\nEndAllGrants() {\n  EndGrant general\n  EndGrant strict\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$TABS_DIR\"/*(N)\n}\n\n# Each blocked tab remembers where it was going, keyed by its Chrome tab id.\nRememberTab() { printf '%s\\n' \"$2\" > \"$TABS_DIR/$1\" }\nRecallTab() { cat \"$TABS_DIR/$1\" 2>/dev/null }\nForgetTab() { rm -f \"$TABS_DIR/$1\" }\n\n# --------------------------------------------------------- 4. The block page\n\nWriteBlockPage() {\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  :root {\n    color-scheme: dark;\n    --font-sans: \"Inter Variable\", \"Inter\", sans-serif;\n    --font-serif: \"AnthropicSerif\", serif;\n    --font-mono: \"AnthropicMono\", monospace;\n    --font-sans-weight: 400;\n    --font-serif-weight: 350;\n    --font-number-weight: 400;\n  }\n  * { box-sizing: border-box }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center;\n         background: #202020; color: #f3f3f3; font-family: var(--font-sans);\n         font-size: 18px; font-weight: var(--font-sans-weight) }\n  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;\n         border-radius: 18px; background: #292929; box-shadow: 0 24px 80px #0005 }\n--- MacMini header ---\n#!/bin/bash\n# bootstrap.sh — Setup Mac Mini M1 comme serveur always-on\n# Usage : copier ce script sur le Mac Mini, puis : bash bootstrap.sh\n#\n# Prérequis : macOS configuré, compte Matthieu Huguet actif, accès internet\n# Le Time Machine transfer doit avoir copié le profil utilisateur de base\n\nset -e\n\necho \"=== Mac Mini M1 Server Bootstrap ===\"\necho \"\"\n\n# --- Phase 1 : Homebrew ---\nif ! command -v brew &>/dev/null; then\n  echo \"[1/8] Installation Homebrew...\"\n  /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"\n  echo 'eval \"$(/opt/homebrew/bin/brew shellenv)\"' >> ~/.zprofile\n  eval \"$(/opt/homebrew/bin/brew shellenv)\"\nelse\n  echo \"[1/8] Homebrew déjà installé ✓\"\nfi\n\n# --- Phase 2 : Paquets essentiels ---\necho \"[2/8] Installation des paquets serveur...\"\nbrew install git gh node ntfs-3g-mac tmux\nbrew install --cask mounty\n\necho \"[3/8] Installation Claude Code CLI...\"\nnpm install -g @anthropic-ai/claude-code\n\n# --- Phase 3 : Auth GitHub ---\necho \"[4/8] Authentification GitHub...\"\nif ! gh auth status &>/dev/null; then\n  gh auth login\nelse\n  echo \"  GitHub déjà authentifié ✓\"\nfi\n\n# --- Phase 4 : Clone repos critiques ---\nMEMORY_DIR=\"$HOME/Create/Build/Memory\"\nCLAUDE_DIR=\"$HOME/.claude\"\nCLAUDE_TOOLS_DIR=\"$HOME/Create/Build/Productions/GithubProductions/claude-tools\"\n\necho \"[5/8] Clonage des repos...\"\n\nif [[ ! -d \"$MEMORY_DIR/.git\" ]]; then\n  mkdir -p \"$(dirname \"$MEMORY_DIR\")\"\n  git clone https://github.com/matthieuhuguet/Memory.git \"$MEMORY_DIR\"\n  echo \"  Memory cloné ✓\"\nelse\n  echo \"  Memory déjà présent ✓\"\n  git -C \"$MEMORY_DIR\" pull --ff-only 2>/dev/null || true\nfi\n\nif [[ ! -d \"$CLAUDE_DIR/.git\" ]]; then\n  # Backup si .claude existe déjà (créé par Claude Code au premier lancement)\n  [[ -d \"$CLAUDE_DIR\" ]] && mv \"$CLAUDE_DIR\" \"${CLAUDE_DIR}.bak.$(date +%s)\"\n  git clone https://github.com/matthieuhuguet/.claude.git \"$CLAUDE_DIR\"\n  echo \"  .claude cloné ✓\"\nelse\n  echo \"  .claude déjà présent ✓\"\n  git -C \"$CLAUDE_DIR\" pull --ff-only 2>/dev/null || true\nfi\n\nif [[ ! -d \"$CLAUDE_TOOLS_DIR/.git\" ]]; then\n  mkdir -p \"$(dirname \"$CLAUDE_TOOLS_DIR\")\"\n  git clone https://github.com/matthieuhuguet/claude-tools.git \"$CLAUDE_TOOLS_DIR\"\n  echo \"  claude-tools cloné ✓\"\nelse\n  echo \"  claude-tools déjà présent ✓\"\nfi\n\n# --- Phase 5 : Polices Anthropic ---\necho \"[6/8] Installation polices Anthropic...\"\nFONTS_TMP=\"/tmp/anthropic-fonts\"\nif [[ $(ls ~/Library/Fonts/Anthropic*.ttf 2>/dev/null | wc -l) -lt 30 ]]; then\n  rm -rf \"$FONTS_TMP\"\n  git clone https://github.com/matthieuhuguet/anthropic-fonts.git \"$FONTS_TMP\"\n  cp \"$FONTS_TMP\"/*.ttf ~/Library/Fonts/ 2>/dev/null || true\n  rm -rf \"$FONTS_TMP\"\n  echo \"  35 TTF installées ✓\"\nelse\n  echo \"  Polices déjà installées ✓\"\nfi\n\n# --- Phase 6 : Services LaunchAgents ---\necho \"[7/8] Installation des LaunchAgents...\"\nbash \"$CLAUDE_TOOLS_DIR/install.sh\" 2>/dev/null || echo \"  (claude-tools install à refaire manuellement si erreur)\"\n\n# --- Phase 7 : Config système serveur ---\necho \"[8/8] Configuration serveur...\"\n\n# Empêcher la mise en veille (persistant via pmset)\nsudo pmset -a displaysleep 10 disksleep 0 sleep 0 womp 1\necho \"  Veille désactivée (écran 10 min, disques jamais, réveil réseau ON) ✓\"\n\n# Git config globale\ngit config --global user.name \"Matthieu Huguet\"\ngit config --global user.email \"matthieuhuguet@me.com\"\n\necho \"\"\necho \"=== Bootstrap terminé ===\"\necho \"\"\necho \"Actions manuelles restantes :\"\necho \"  1. Activer SSH : Préférences Système > Général > Partage > Session à distance\"\necho \"  2. Activer Screen Sharing si besoin d'accès GUI distant\"\necho \"  3. Brancher les 3 disques NTFS (12TB, 8TB, 4TB)\"\necho \"  4. Lancer Mounty pour monter les disques en écriture\"\necho \"  5. Configurer le mirror 2TB (voir mirror-sync.sh)\"\necho \"  6. Tester Claude Code : cd ~/Create/Build/Memory && claude\"\n--- Recovery headers ---\n#!/bin/bash\n# Recovery3_full.sh — Full autonomous pipeline:\n#   1. Sequential ntfsundelete recovery (17,747 remaining files)\n#   2. chown root→zenray\n#   3. AVIF convert (16 workers)\n#   4. Eagle import with game classification\n# Runs unattended. HDD = sequential only (no parallel).\n\nDEVICE=\"/dev/disk6s2\"\nREMAINING=\"/Users/zenray/tmp_d_img/recovery2_not_recovered.txt\"\nSTAGING=\"/Users/zenray/tmp_d_img/recovery3_staged\"\nLOG=\"/Users/zenray/tmp_d_img/recovery3.log\"\n\nlog() { echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $*\" | tee -a \"$LOG\"; }\n\necho \"\" > \"$LOG\"\nlog \"=== Recovery3 START ===\"\n\n# Verify device\nif ! diskutil info \"$DEVICE\" > /dev/null 2>&1; then\n    log \"ERROR: Device $DEVICE not found\"\n    exit 1\nfi\n\n# Unmount\ndiskutil unmount force /Users/zenray/.mounty/d 2>/dev/null || true\ndiskutil unmount force /Volumes/d 2>/dev/null || true\nsleep 1\nif mount | grep -q \"$DEVICE\"; then\n    log \"ERROR: $DEVICE still mounted\"\n    exit 1\nfi\n\nmkdir -p \"$STAGING\"\n\nTOTAL=$(wc -l < \"$REMAINING\" | tr -d ' ')\nlog \"Recovering $TOTAL files from $DEVICE to $STAGING\"\n\nRECOVERED=0\nFAILED=0\n\nwhile IFS=$'\\t' read -r INODE PCT FILENAME; do\n    [ -z \"$INODE\" ] && continue\n    OUT=$(/usr/local/bin/ntfsundelete \"$DEVICE\" -u -i \"$INODE\" -d \"$STAGING\" -f 2>&1 || true)\n    if echo \"$OUT\" | grep -qi \"success\"; then\n        RECOVERED=$((RECOVERED + 1))\n    else\n        FAILED=$((FAILED + 1))\n    fi\n\n    DONE=$((RECOVERED + FAILED))\n    if [ $((DONE % 500)) -eq 0 ]; then\n        log \"  $RECOVERED OK / $DONE total (failed: $FAILED)\"\n    fi\ndone < \"$REMAINING\"\n\nlog \"=== Recovery3 DONE === $RECOVERED OK, $FAILED failed\"\nlog \"Files in staging: $(ls \"$STAGING\" 2>/dev/null | wc -l | tr -d ' ')\"\n\n# Step 2: chown\nlog \"chown staging...\"\nchown -R zenray:staff \"$STAGING/\"\nlog \"chown done\"\n\n# Step 3+4: Launch Python pipeline\nlog \"Launching Pipeline3in1 for recovery3...\"\nexec python3 /Users/zenray/Create/Build/Memory/Tools/Recovery/Pipeline3in1_r3.py\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03cbc-d786-7e40-8d2b-3c802e1943d6","create_time":1787725499.768957}}}
