page App Limits ne répond pas.\"\n        case .appLimitsToggleUnavailable:\n            return \"Le bouton App Limits est introuvable dans l’accessibilité macOS.\"\n        case .togglePressFailed(let error):\n            return \"Le bouton App Limits refuse l’action : \\(error.rawValue).\"\n        case .appLimitsStillEnabled:\n            return \"App Limits reste actif après la saisie du code.\"\n        }\n    }\n}\n\nprivate func attribute(_ element: AXUIElement, _ key: String) -> Any? {\n    var result: CFTypeRef?\n    let error = AXUIElementCopyAttributeValue(element, key as CFString, &result)\n    return error == .success ? result : nil\n}\n\nprivate func children(of element: AXUIElement) -> [AXUIElement] {\n    (attribute(element, kAXChildrenAttribute) as? [AXUIElement]) ?? []\n}\n\nprivate func role(of element: AXUIElement) -> String {\n    (attribute(element, kAXRoleAttribute) as? String) ?? \"\"\n}\n\nprivate func isToggle(_ element: AXUIElement) -> Bool {\n    let elementRole = role(of: element)\n    return elementRole == kAXCheckBoxRole || elementRole == \"AXSwitch\"\n}\n\nprivate func toggleState(of element: AXUIElement) -> Bool? {\n    guard let number = attribute(element, kAXValueAttribute) as? NSNumber else { return nil }\n    return number.intValue != 0\n}\n\nprivate func findWindow(in application: AXUIElement) -> AXUIElement? {\n    if role(of: application) == kAXWindowRole {\n        let title = (attribute(application, kAXTitleAttribute) as? String) ?? \"\"\n        if title == \"App Limits\" { return application }\n    }\n    for child in children(of: application) {\n        if let match = findWindow(in: child) { return match }\n    }\n    return nil\n}\n\nprivate func findToggles(in element: AXUIElement, result: inout [AXUIElement]) {\n    if isToggle(element) { result.append(element) }\n    for child in children(of: element) { findToggles(in: child, result: &result) }\n}\n\nprivate func runningSystemSettings() -> NSRunningApplication? {\n   