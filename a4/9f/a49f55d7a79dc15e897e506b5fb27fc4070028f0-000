device\nif ! diskutil info \"$DEVICE\" > /dev/null 2>&1; then\n    log \"ERROR: Device $DEVICE not found\"\n    exit 1\nfi\n\n# Unmount\ndiskutil unmount force /Users/zenray/.mounty/d 2>/dev/null || true\ndiskutil unmount force /Volumes/d 2>/dev/null || true\nsleep 1\nif mount | grep -q \"$DEVICE\"; then\n    log \"ERROR: $DEVICE still mounted\"\n    exit 1\nfi\n\nmkdir -p \"$STAGING\"\n\nTOTAL=$(wc -l < \"$REMAINING\" | tr -d ' ')\nlog \"Recovering $TOTAL files from $DEVICE to $STAGING\"\n\nRECOVERED=0\nFAILED=0\n\nwhile IFS=$'\\t' read -r INODE PCT FILENAME; do\n    [ -z \"$INODE\" ] && continue\n    OUT=$(/usr/local/bin/ntfsundelete \"$DEVICE\" -u -i \"$INODE\" -d \"$STAGING\" -f 2>&1 || true)\n    if echo \"$OUT\" | grep -qi \"success\"; then\n        RECOVERED=$((RECOVERED + 1))\n    else\n        FAILED=$((FAILED + 1))\n    fi\n\n    DONE=$((RECOVERED + FAILED))\n    if [ $((DONE % 500)) -eq 0 ]; then\n        log \"  $RECOVERED OK / $DONE total (failed: $FAILED)\"\n    fi\ndone < \"$REMAINING\"\n\nlog \"=== Recovery3 DONE === $RECOVERED OK, $FAILED failed\"\nlog \"Files in staging: $(ls \"$STAGING\" 2>/dev/null | wc -l | tr -d ' ')\"\n\n# Step 2: chown\nlog \"chown staging...\"\nchown -R zenray:staff \"$STAGING/\"\nlog \"chown done\"\n\n# Step 3+4: Launch Python pipeline\nlog \"Launching Pipeline3in1 for recovery3...\"\nexec python3 /Users/zenray/Create/Build/Memory/Tools/Recovery/Pipeline3in1_r3.py\n"},"started_at_ms":1787725499765,"completed_at_ms":1787725499765}}
