japon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n    */channel/ucegev5mbdmgmgzfpralemfa|*/channel/ucegev5mbdmgmgzfpralemfa/*) return 0 ;;\n    */channel/uc_r99mjdkzksbgeedoylbkw|*/channel/uc_r99mjdkzksbgeedoylbkw/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Channels on the 1-minute leash.\nIsStrictChannel() {\n  local path pattern; path=\"$(UrlPath \"$1\")\"\n  for pattern in $STRICT_CHANNELS; do\n    case \"$path\" in\n      *\"$pattern\"|*\"$pattern\"/*) return 0 ;;\n    esac\n  done\n  return 1\n}\n\nScope() { IsStrictChannel \"$1\" && printf 'strict' || printf 'general' }\n\nIsBlockPage() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] }\nIsUnlockClick() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] && [[ \"$1\" == *\"unlock=1\"* ]] }\nScopeFromURL() { [[ \"$1\" == *\"scope=strict\"* ]] && printf 'strict' || printf 'general' }\n\n# ------------------------------------------------------- 3. Grants (per scope)\n\nGrantFile() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_FILE\" || printf '%s' \"$GRANT_FILE\" }\nGrantMinutes() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_MINUTES\" || printf '%s' \"$GRANT_MINUTES\" }\nTimerPidFile() { printf '%s' \"$STATE_DIR/timer_pid_$1\" }\n\nGrantActive() {\n  local file=\"$(GrantFile \"$1\")\" until\n  [[ -s \"$file\" ]] || return 1\n  until=\"$(cat \"$file\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  (( $(Now) < until ))\n}\n\nStartGrant() {\n  local scope=\"$1\" file minutes pidfile\n  file=\"$(GrantFile \"$scope\")\"; minutes=\"$(GrantMinutes \"$scope\")\"; pidfile=\"$(TimerPidFile \"$scope\")\"\n  EnsureState\n  printf '%s\\n' $(( $(Now) + minutes * 60 )) > \"$file\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\"\n  if [[ -x \"$TIMER_BIN\" ]]; then\n    nohup \"$TIMER_BIN\" \"$file\" >/dev/null 2>&1 </dev/null &\n    printf '%s\\n' $! > \"$pidfile\"\n  fi\n}\n\nEndGrant() {\n  local scope=\"$1\" pidfile; pidfile=\