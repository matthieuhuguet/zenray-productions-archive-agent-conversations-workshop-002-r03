es\",\n        \"journal-3-colonnes\",\n        \"bandeau-outils\",\n        \"pied-liens\"\n      ],\n      \"tokens\": {\n        \"--paper\": \"#FBFAF7\",\n        \"--ink\": \"#22211E\",\n        \"--brand\": \"#9A5B3C\",\n        \"--body\": \"17px\",\n        \"--serif\": \"AnthropicSerif\",\n        \"--sans\": \"Inter\",\n        \"--zr-weight-serif\": \"350\"\n      }\n    }\n  }\n}#!/bin/bash\n# Renders every slide-*.html in this folder to PNG, at 1x and 2x.\n#\n#   ./render.sh            renders all slides\n#   ./render.sh slide-2    renders one\n#\n# Output goes to out/ , kept separate from the sources so the working folder\n# stays readable and the finished files are trivial to grab, upload or drag:\n#   out/<name>.png   2160x2700  (4:5)\n#\n# ONE file per slide, not two. A 1x export next to a 2x one is pure duplication:\n# the 2x carries strictly more detail, and anything that needs 1080x1350 can be\n# downscaled in a second, whereas the reverse is impossible.\n#\n# --force-device-scale-factor=2 re-renders the page at double resolution rather\n# than upscaling a 1x bitmap, so text and vector edges stay genuinely sharp.\n# Blowing up a small PNG instead is exactly how the first attempt at this flyer\n# ended up an unusable blur.\nset -euo pipefail\ncd \"$(dirname \"$0\")\"\n\nW=1080\nH=1350\n\nCHROME=\"/Users/zenray/Library/Caches/ms-playwright/chromium-1228/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing\"\nif [[ ! -x \"$CHROME\" ]]; then\n    CHROME=$(ls -d \"$HOME/Library/Caches/ms-playwright\"/chromium-*/chrome-mac-arm64/*.app/Contents/MacOS/* 2>/dev/null | head -1 || true)\nfi\nif [[ -z \"${CHROME:-}\" || ! -x \"$CHROME\" ]]; then\n    echo \"No headless Chromium found. Install one with: npx playwright install chromium\"\n    exit 1\nfi\n\nmkdir -p out\n\ntargets=()\nif [[ $# -gt 0 ]]; then\n    for a in \"$@\"; do targets+=(\"${a%.html}.html\"); done\nelse\n    for f in slide-*.html; do targets+=(\"$f\"); done\nfi\n\nfor html in \"${targets[@]}\"; do\n    [[ -f \"$html\" ]] || { echo \"skip, no such file: $html\"; continue; }\n    base=\"${html%.html}\"\n\n    \"$CHROME\" --headless=new --disable-gpu --hide-scrollbars \\\n        --force-device-scale-factor=2 \\\n        --window-size=$W,$H --screenshot=\"out/$base.png\" \\\n        \"file://$(pwd)/$html\" >/dev/null 2>&1\n\n    # Assert the format really is 4:5. A silent wrong-size export is worse than\n    # a loud failure: Instagram would crop it and nobody would know why.\n    python3 - \"$base\" $W $H <<'PY'\nimport sys\nfrom PIL import Image\nbase, w, h = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])\nok = True\nfor path, ew, eh in ((f\"out/{base}.png\", w*2, h*2),):\n    got = Image.open(path).size\n    flag = \"ok\" if got == (ew, eh) else f\"WRONG, expected {ew}x{eh}\"\n    if got != (ew, eh): ok = False\n    print(f\"  {path:28s} {got[0]}x{got[1]}  {flag}\")\nsys.exit(0 if ok else 1)\nPY\n\n    # Instagram refuses anything above 8 Mo. A flattened flyer PNG (full-bleed\n    # photo background, no transparency) is a wasteful format for that limit —\n    # convert to JPEG the moment it's crossed, quality searched down from 95\n    # until it fits, and drop the oversized PNG so nobody uploads it by mistake.\n    python3 - \"$base\" <<'PY'\nimport sys, os\nfrom PIL import Image\nbase = sys.argv[1]\npng = f\"out/{base}.png\"\nlimit = 8 * 1024 * 1024\nsize = os.path.getsize(png)\nif size <= limit:\n    print(f\"  {png:28s} {size/1024/1024:.1f} Mo  ok\")\nelse:\n    im = Image.open(png).convert(\"RGB\")\n    jpg = f\"out/{base}.jpg\"\n    for q in (95, 92, 90, 88, 85):\n        im.save(jpg, quality=q, subsampling=0)\n        new_size = os.path.getsize(jpg)\n        if new_size <= limit:\n            break\n    os.remove(png)\n    print(f\"  {png:28s} {size/1024/1024:.1f} Mo  > 8 Mo, converted -> {jpg} \"\n          f\"({new_size/1024/1024:.1f} Mo, q{q})\")\n","exit_code":0,"duration":{"secs":0,"nanos":8250},"formatted_output":"\ndef main():\n    parser = argparse.ArgumentParser(description=\"Cree une instance d'outil zenray-html-hda.\")\n    parser.add_argument(\"source\", type=Path, help=\"dossier d'images ou image unique\")\n    parser.add_argument(\"--mode\", choices=(\"light\", \"heavy\"), default=\"light\",\n                        help=\"light = cadrage et texte ; heavy = reorder, photo et texte\")\n    parser.add_argument(\"--project\", default=None, help=\"nom parlant (defaut : nom du dossier source)\")\n    parser.add_argument(\"--format\", dest=\"target_format\", default=\"4:5\", choices=sorted(FORMATS),\n                        help=\"format cible du mode light (defaut 4:5)\")\n    parser.add_argument(\"--dest\", type=Path, default=None, help=\"dossier de l'instance\")\n    parser.add_argument(\"--open\", action=\"store_true\", help=\"ouvrir dans Chrome une fois cree\")\n    parser.add_argument(\"--serve\", action=\"store_true\",\n                        help=\"forcer le service local (automatique en mode heavy, que WebGL impose)\")\n    parser.add_argument(\"--force\", action=\"store_true\", help=\"ecraser une instance existante\")\n    parser.add_argument(\"--post\", type=Path, help=\"brouillon préparé .txt, .md ou .json, sans réécriture automatique\")\n    args = parser.parse_args()\n    args.format_given = any(a.startswith(\"--format\") for a in sys.argv[1:])\n\n    source_path = args.source.expanduser().resolve()\n    if source_path.is_dir():\n        source_dir, only = source_path, None\n    elif source_path.is_file() and source_path.suffix in IMAGE_SUFFIXES:\n        source_dir, only = source_path.parent, source_path\n    else:\n        raise SystemExit(f\"source image ou dossier introuvable : {source_path}\")\n\n    project = args.project or (source_path.stem if only else source_dir.name)\n    dest = (args.dest.expanduser().resolve() if args.dest\n            else source_dir / f\"zenray-html-hda-{project}\")\n    if args.mode == \"heavy\" and not args.dest:\n        dest = source_dir / f\"zenray-html-hda-{project}-heavy\"\n\n    if dest.exists() and not args.force:\n        raise SystemExit(f\"l'instance existe deja : {dest}\\nrelancer avec --force pour l'ecraser\")\n\n    images = collect_images(source_dir, only)\n    if not images:\n        raise SystemExit(f\"aucune image trouvee dans {source_dir}\")\n\n    # Le cadrage se met en route TOUT SEUL quand il est utile, et reste neutre\n    # sinon. Un lot deja passe par une etape de cadrage a toutes ses images au\n    # meme rapport : le recadrer une seconde fois n'aurait pas de sens, donc le\n    # format demarre sur « source ». Un lot brut, aux rapports melanges ou\n    # differents de la cible, demarre sur le format demande.\n    target_format = args.target_format\n    if args.mode == \"heavy\" and not args.format_given:\n        ratios = {round(i[\"width\"] / i[\"height\"], 4) for i in images if i[\"height\"]}\n        wanted = FORMAT_RATIOS.get(args.target_format)\n        already = len(ratios) == 1 and wanted and abs(ratios.pop() - wanted) < 0.01\n        target_format = \"source\" if already else args.target_format\n\n{\n  \"$schema\": \"urn:zenray:design-registry:v1\",\n  \"nom\": \"ZenRay Design Registry\",\n  \"description\": \"Catalogue universel de templates et composants HDA réutilisables. Évite le gaspillage de tokens par réutilisation sémantique via ID parlants.\",\n  \"derniereMiseAJour\": \"2026-09-11T09:35:00+02:00\",\n  \"total\": 9,\n  \"capaciteCible\": \"1000+\",\n  \"designs\": {\n    \"luxe-epure\": {\n      \"id\": \"luxe-epure\",\n      \"nom\": \"Luxe Épuré (Direction Galerie)\",\n      \"type\": \"page\",\n      \"domaine\": \"web-editorial\",\n      \"tags\": [\n        \"luxe\",\n        \"epure\",\n        \"editorial\",\n        \"galerie\",\n        \"serif-deux-tons\",\n        \"respiration\",\n        \"minimal\"\n      ],\n      \"description\": \"Le catalogue d'une maison d'édition plutôt qu'un tableau de bord. Deux sous-groupes At