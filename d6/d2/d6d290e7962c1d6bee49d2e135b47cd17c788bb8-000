p=\"light = cadrage et texte ; heavy = reorder, photo et texte\")\n    parser.add_argument(\"--project\", default=None, help=\"nom parlant (defaut : nom du dossier source)\")\n    parser.add_argument(\"--format\", dest=\"target_format\", default=\"4:5\", choices=sorted(FORMATS),\n                        help=\"format cible du mode light (defaut 4:5)\")\n    parser.add_argument(\"--dest\", type=Path, default=None, help=\"dossier de l'instance\")\n    parser.add_argument(\"--open\", action=\"store_true\", help=\"ouvrir dans Chrome une fois cree\")\n    parser.add_argument(\"--serve\", action=\"store_true\",\n                        help=\"forcer le service local (automatique en mode heavy, que WebGL impose)\")\n    parser.add_argument(\"--force\", action=\"store_true\", help=\"ecraser une instance existante\")\n    parser.add_argument(\"--post\", type=Path, help=\"brouillon préparé .txt, .md ou .json, sans réécriture automatique\")\n    args = parser.parse_args()\n    args.format_given = any(a.startswith(\"--format\") for a in sys.argv[1:])\n\n    source_path = args.source.expanduser().resolve()\n    if source_path.is_dir():\n        source_dir, only = source_path, None\n    elif source_path.is_file() and source_path.suffix in IMAGE_SUFFIXES:\n        source_dir, only = source_path.parent, source_path\n    else:\n        raise SystemExit(f\"source image ou dossier introuvable : {source_path}\")\n\n    project = args.project or (source_path.stem if only else source_dir.name)\n    dest = (args.dest.expanduser().resolve() if args.dest\n            else source_dir / f\"zenray-html-hda-{project}\")\n    if args.mode == \"heavy\" and not args.dest:\n        dest = source_dir / f\"zenray-html-hda-{project}-heavy\"\n\n    if dest.exists() and not args.force:\n        raise SystemExit(f\"l'instance existe deja : {dest}\\nrelancer avec --force pour l'ecraser\")\n\n    images = collect_images(source_dir, only)\n    if not images:\n        raise SystemExit(f\"aucune image trouvee