orkflow'),(5551,6023,'EditorCorrections'),(6024,6087,'DesignLibrary'),(6088,6123,'UiContract'),(6124,len(lines),'ShortsCorrections')]\\n+routes = []\\n+for start, end, name in ranges:\\n+    relative = f'references/legacy/{name}.md'\\n+    (target / relative).write_text(''.join(lines[start - 1:end]))\\n+    routes.append({'name': name, 'path': relative, 'startLine': start, 'endLine': end})\\n+(target / 'references/Routes.json').write_text(json.dumps({'sourceSha256': files['SKILL.md'], 'lineCount': len(lines), 'blocks': routes}, indent=2) + '\\\\n')\\n+(target / 'SKILL.md').write_text('''---\\n+name: zenray-edit\\n+description: Créer et éditer textes, photos, compositions HTML, carrousels, PDF et shorts avec templates paramétriques réutilisables et sources conservées ; correction grammaticale fidèle par défaut, projets et exports liés à ZenRay Assets V2.\\n+---\\n+\\n+# ZenRay Edit (7 October 2026)\\n+\\n+Atelier de création et d’édition, de la demande à un média vérifié et modifiable. Lire [ActiveContract.md](references/ActiveContract.md), puis seulement les références du mode utile. (7 October 2026)\\n+\\n+- Reprendre l’identité Assets existante, son contexte et son feedback avec zenray-assets-v2 ; travailler dans l’atelier ou les sources effectivement liées. Une conversation ne se réattribue jamais implicitement. (7 October 2026)\\n+- Pour un texte de Matthieu, corriger uniquement grammaire, orthographe, conjugaison et transcription manifestement erronée. Conserver vocabulaire, rythme, ordre, répétitions et contenu ; réécriture, réorganisation et traduction exigent une demande explicite. Lire [TextEditing.md](references/TextEditing.md). (7 October 2026)\\n+- Chercher un gabarit avant de construire : `node scripts/zr-design.mjs list`, puis `get <id>`. Instancier la définition existante ; paramètres globaux, de famille et d’instance distincts. (7 October 2026)\\n+- Images et post : `python3 scripts/zr-hda-instance.py <source> --dest <atelier/instance> --mode light -