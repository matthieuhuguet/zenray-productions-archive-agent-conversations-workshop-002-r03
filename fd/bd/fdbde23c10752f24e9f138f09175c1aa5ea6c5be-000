           NSWorkspace.shared.frontmostApplication?.localizedName == \"Google Chrome\",\n            let address = runAppleScript(frontTabURLScript),\n            let host = URL(string: address)?.host?.lowercased()\n        else { return false }\n        return host == \"youtube.com\" || host.hasSuffix(\".youtube.com\") || host == \"youtu.be\"\n    }\n\n    // No AppleScript here: the window list is a direct call, so it can run every tick.\n    private func chromeIsFullscreen() -> Bool {\n        guard\n            NSWorkspace.shared.frontmostApplication?.localizedName == \"Google Chrome\",\n            let windows = CGWindowListCopyWindowInfo(\n                [.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID\n            ) as? [[String: Any]]\n        else { return false }\n\n        let screens = screenRectsInWindowSpace()\n\n        for window in windows {\n            guard\n                window[kCGWindowOwnerName as String] as? String == \"Google Chrome\",\n                window[kCGWindowLayer as String] as? Int == 0,\n                let raw = window[kCGWindowBounds as String],\n                let bounds = CGRect(dictionaryRepresentation: raw as! CFDictionary)\n            else { continue }\n\n            for screen in screens\n            where abs(bounds.width - screen.width) < Config.fullscreenTolerance\n                && abs(bounds.maxY - screen.maxY) < Config.fullscreenTolerance {\n                return true\n            }\n        }\n        return false\n    }\n\n    // Window bounds count down from the top of the primary screen, while NSScreen\n    // counts up from its bottom, so the screens are flipped into the same space.\n    private func screenRectsInWindowSpace() -> [CGRect] {\n        guard let primary = NSScreen.screens.first else { return [] }\n        let top = primary.frame.maxY\n        return NSScreen.screens.map {\n            CGRect(x: $0.frame.minX, y: top - $0.frame.maxY,\n                   width: $0.frame.width, height: $0.frame.height)\n        }\n    }\n\n    private let frontTabURLScript = \"\"\"\n    try\n        tell application \"Google Chrome\"\n            if (count of windows) is 0 then return \"\"\n            return URL of active tab of front window as text\n        end tell\n    on error\n        return \"\"\n    end try\n    \"\"\"\n\n    private func runAppleScript(_ script: String) -> String? {\n        let process = Process()\n        let output = Pipe()\n        process.executableURL = URL(fileURLWithPath: \"/usr/bin/osascript\")\n        process.arguments = [\"-e\", script]\n        process.standardOutput = output\n        process.standardError = FileHandle.nullDevice\n        guard (try? process.run()) != nil else { return nil }\n        let data = output.fileHandleForReading.readDataToEndOfFile()\n        process.waitUntilExit()\n        return String(data: data, encoding: .utf8)?\n            .trimmingCharacters(in: .whitespacesAndNewlines)\n    }\n\n    private func position(_ panel: NSPanel) {\n        guard let screen = NSScreen.main ?? NSScreen.screens.first else { return }\n        let frame = screen.visibleFrame\n        panel.setFrameOrigin(NSPoint(\n            x: frame.maxX - panel.frame.width - Config.screenMargin,\n            y: frame.minY + Config.screenMargin\n        ))\n    }\n\n    private func fadeIn() {\n        guard let panel, !visible else { return }\n        visible = true\n        position(panel)\n        panel.orderFrontRegardless()\n        NSAnimationContext.runAnimationGroup { $0.duration = Config.fadeIn; panel.animator().alphaValue = 1 }\n    }\n\n    private func fadeOut(duration: TimeInterval) {\n        guard let panel, visible else { return }\n        visible = false\n        NSAnimationContext.runAnimationGroup {\n            $0.duration = duration\n            panel.animator().alphaValue = 0\n        } completionHandler: { [weak self] in\n            guard let self, !self.visible else { return }\n            self.panel