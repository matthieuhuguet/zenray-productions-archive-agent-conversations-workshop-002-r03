vior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary]\n        panel.ignoresMouseEvents = true\n        panel.hidesOnDeactivate = false\n        panel.alphaValue = 0\n\n        let view = TimerView(frame: NSRect(origin: .zero, size: Config.panelSize))\n        panel.contentView = view\n        self.panel = panel\n        self.view = view\n        position(panel)\n\n        NSWorkspace.shared.notificationCenter.addObserver(\n            self, selector: #selector(appChanged),\n            name: NSWorkspace.didActivateApplicationNotification, object: nil\n        )\n        ticker = Timer.scheduledTimer(withTimeInterval: Config.tickInterval, repeats: true) { [weak self] _ in\n            self?.tick()\n        }\n        tick()\n    }\n\n    // Chrome came to the front, or left it: re-read the address right away.\n    @objc private func appChanged() {\n        lastURLCheck = .distantPast\n        tick()\n    }\n\n    private func tick() {\n        guard\n            let raw = try? String(contentsOf: stateURL, encoding: .utf8),\n            let until = Int(raw.trimmingCharacters(in: .whitespacesAndNewlines)),\n            case let left = until - Int(Date().timeIntervalSince1970),\n            left > 0\n        else {\n            finish()\n            return\n        }\n\n        view?.remaining = left\n\n        if Date().timeIntervalSince(lastURLCheck) >= Config.urlCheckInterval {\n            lastURLCheck = Date()\n            onYouTube = chromeIsShowingYouTube()\n        }\n\n        // Cheap enough to run every tick, so leaving fullscreen brings the card back fast.\n        let fullscreen = chromeIsFullscreen()\n\n        if onYouTube && !fullscreen {\n            fadeIn()\n        } else {\n            fadeOut(duration: fullscreen ? Config.fadeOutFullscreen : Config.fadeOut)\n        }\n    }\n\n    private func chromeIsShowingYouTube() -> Bool {\n        guard\n            NSWorkspace.shared.frontmostApplication?.localizedName == \"Google Chrome\",\n            let address = runAppleScript(frontTabURLScript),\n            let host = URL(string: address)?.host?.lowercased()\n        else { return false }\n        return host == \"youtube.com\" || host.hasSuffix(\".youtube.com\") || host == \"youtu.be\"\n    }\n\n    // No AppleScript here: the window list is a direct call, so it can run every tick.\n    // No owner name is checked either, on purpose: in HTML5 fullscreen the video\n    // window can belong to a Chrome helper process rather than to \"Google Chrome\",\n    // and a card left sitting on a fullscreen window is unwanted whoever owns it.\n    private func someWindowIsFullscreen() -> Bool {\n        guard let windows = CGWindowListCopyWindowInfo(\n            [.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID\n        ) as? [[String: Any]] else { return false }\n\n        let screens = screenRectsInWindowSpace()\n\n        for window in windows {\n            guard\n                window[kCGWindowLayer as String] as? Int == 0,\n                let raw = window[kCGWindowBounds as String],\n                let bounds = CGRect(dictionaryRepresentation: raw as! CFDictionary)\n            else { continue }\n\n            for screen in screens\n            where abs(bounds.width - screen.width) < Config.fullscreenTolerance\n                && abs(bounds.maxY - screen.maxY) < Config.fullscreenTolerance {\n                return true\n            }\n        }\n        return false\n    }\n\n    // Window bounds count down from the top of the primary screen, while NSScreen\n    // counts up from its bottom, so the screens are flipped into the same space.\n    private func screenRectsInWindowSpace() -> [CGRect] {\n        guard let primary = NSScreen.screens.first else { return [] }\n        let top = primary.frame.maxY\n        return NSScreen.screens.map {\n            CGRect(x: $0.frame.minX, y: top - $0.frame.maxY,\n                   width: $0.frame.width, height: $0.frame.height)\n        }\n    }\n