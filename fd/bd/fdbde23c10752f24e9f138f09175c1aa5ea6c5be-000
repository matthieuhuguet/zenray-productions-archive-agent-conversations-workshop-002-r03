  // window can belong to a Chrome helper process rather than to \"Google Chrome\",\n    // and a card left sitting on a fullscreen window is unwanted whoever owns it.\n    private func someWindowIsFullscreen() -> Bool {\n        guard let windows = CGWindowListCopyWindowInfo(\n            [.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID\n        ) as? [[String: Any]] else { return false }\n\n        let screens = screenRectsInWindowSpace()\n\n        for window in windows {\n            guard\n                window[kCGWindowLayer as String] as? Int == 0,\n                let raw = window[kCGWindowBounds as String],\n                let bounds = CGRect(dictionaryRepresentation: raw as! CFDictionary)\n            else { continue }\n\n            for screen in screens\n            where abs(bounds.width - screen.width) < Config.fullscreenTolerance\n                && abs(bounds.maxY - screen.maxY) < Config.fullscreenTolerance {\n                return true\n            }\n        }\n        return false\n    }","originalFile":"import AppKit\n\n// Small floating card, bottom right, showing the time left on the YouTube grant.\n// It shows up while Chrome is in front on a YouTube page, and quits at zero.\n// It gets out of the way fast when Chrome goes fullscreen: a card parked over a\n// film is worse than no card at all.\n\nprivate enum Config {\n    static let panelSize = NSSize(width: 178, height: 64)\n    static let screenMargin: CGFloat = 24\n\n    static let tickInterval: TimeInterval = 0.5   // countdown + fullscreen check\n    static let urlCheckInterval: TimeInterval = 2 // asking Chrome costs a process\n\n    static let fadeIn: TimeInterval = 0.20\n    static let fadeOut: TimeInterval = 0.25\n    static let fadeOutFullscreen: TimeInterval = 0.08\n\n    // Measured on this Mac, screen 1728x1117: a fullscreen Chrome window sits at\n    // y=33 and runs 1084 tall, so its bottom lands on 1117, the very edge of the\n    // screen; merely zoomed, the same window is 1017 tall and stops at 1050 to\n    // leave the Dock its room. The bottom edge is what tells them apart, never\n    // the height, which is why matching the full screen size found nothing.\n    static let fullscreenTolerance: CGFloat = 2\n}\n\nfinal class TimerView: NSView {\n    var remaining = 0 { didSet { needsDisplay = true } }\n\n    override func draw(_ dirtyRect: NSRect) {\n        NSColor(calibratedWhite: 0.10, alpha: 0.96).setFill()\n        NSBezierPath(roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5), xRadius: 14, yRadius: 14).fill()\n\n        NSString(string: \"YOUTUBE\").draw(\n            at: NSPoint(x: 18, y: bounds.maxY - 22),\n            withAttributes: [\n                .font: NSFont.systemFont(ofSize: 10, weight: .medium),\n                .foregroundColor: NSColor(calibratedWhite: 0.62, alpha: 1),\n                .kern: 1.1\n            ]\n        )\n        NSString(string: String(format: \"%02d:%02d\", max(0, remaining) / 60, max(0, remaining) % 60)).draw(\n            at: NSPoint(x: 18, y: 10),\n            withAttributes: [\n                .font: NSFont.monospacedDigitSystemFont(ofSize: 25, weight: .light),\n                .foregroundColor: NSColor.white\n            ]\n        )\n    }\n}\n\nfinal class TimerController: NSObject, NSApplicationDelegate {\n    private let stateURL: URL\n    private var panel: NSPanel?\n    private var view: TimerView?\n    private var ticker: Timer?\n    private var visible = false\n    private var onYouTube = false\n    private var lastURLCheck = Date.distantPast\n\n    init(stateURL: URL) { self.stateURL = stateURL }\n\n    func applicationDidFinishLaunching(_ notification: Notification) {\n        let panel = NSPanel(\n            contentRect: NSRect(origin: .zero, size: Config.panelSize),\n            styleMask: [.borderless, .nonactivatingPanel],\n            backing: .buffered,\n            defer: false\n        )\n        panel.isOpaque = false\n        panel.backgroundColor = .clear