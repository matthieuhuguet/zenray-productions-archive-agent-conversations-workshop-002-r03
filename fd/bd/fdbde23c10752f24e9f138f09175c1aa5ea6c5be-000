y}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"\nTABS_DIR=\"$STATE_DIR/tabs\"\nGRANT_FILE=\"$STATE_DIR/grant_until\"\nSTRICT_GRANT_FILE=\"$STATE_DIR/grant_until_strict\"\n\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\n\nTIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"\nTIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"\n\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\n\nSay() { printf '%s\\n' \"$*\"; }\nNow() { date '+%s'; }\n\nEnsureState() {\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\" \"$TABS_DIR\"\n  chmod 700 \"$STATE_DIR\"\n}\n\n# ---------------------------------------------------------- 2. Reading a URL\n\n# Everything below works on the lowercased URL, with query and anchor removed.\nUrlPath() {\n  local path=\"${1%%\\?*}\"\n  printf '%s' \"${${path%%\\#*}:l}\"\n}\n\nIsYouTube() {\n  case \"${1:l}\" in\n    https://youtube.com*|https://www.youtube.com*|https://m.youtube.com*) return 0 ;;\n    https://music.youtube.com*|https://youtu.be*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Pages that never need a grant.\nIsAlwaysFree() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */feed/subscriptions|*/feed/subscriptions/*) return 0 ;;\n    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n    */channel/ucegev5mbdmgmgzfpralemfa|*/channel/ucegev5mbdmgmgzfpralemfa/*) return 0 ;;\n    */channel/uc_r99mjdkzksbgeedoylbkw|*/channel/uc_r99mjdkzksbgeedoylbkw/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Channels on the 1-minute leash.\nIsStrictChannel() {\n  local path pattern; path=\"$(UrlPath \"$1\")\"\n  for pattern in $STRICT_CHANNELS; do\n    case \"$path\" in\n      *\"$pattern\"|*\"$pattern\"/*) return 0 ;;\n    esac\n  done\n  return 1\n}\n\nScope() { IsStrictChannel \"$1\" && printf 'strict' || printf 'general' }\n\nIsBlockPage() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] }\nIsUnlockClick() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] && [[ \"$1\" == *\"unlock=1\"* ]] }\nScopeFromURL() { [[ \"$1\" == *\"scope=strict\"* ]] && printf 'strict' || printf 'general' }\n\n# ------------------------------------------------------- 3. Grants (per scope)\n\nGrantFile() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_FILE\" || printf '%s' \"$GRANT_FILE\" }\nGrantMinutes() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_MINUTES\" || printf '%s' \"$GRANT_MINUTES\" }\nTimerPidFile() { printf '%s' \"$STATE_DIR/timer_pid_$1\" }\n\nGrantActive() {\n  local file=\"$(GrantFile \"$1\")\" until\n  [[ -s \"$file\" ]] || return 1\n  until=\"$(cat \"$file\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  (( $(Now) < until ))\n}\n\nStartGrant() {\n  local scope=\"$1\" file minutes pidfile\n  file=\"$(GrantFile \"$scope\")\"; minutes=\"$(GrantMinutes \"$scope\")\"; pidfile=\"$(TimerPidFile \"$scope\")\"\n  EnsureState\n  printf '%s\\n' $(( $(Now) + minutes * 60 )) > \"$file\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\"\n  if [[ -x \"$TIMER_BIN\" ]]; then\n    nohup \"$TIMER_BIN\" \"$file\" >/dev/null 2>&1 </dev/null &\n    printf '%s\\n' $! > \"$pidfile\"\n  fi\n}\n\nEndGrant() {\n  local scope=\"$1\" pidfile; pidfile=\"$(TimerPidFile \"$scope\")\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\" \"$(GrantFile \"$scope\")\"\n}\n\nEndAllGrants() { EndGrant general; EndGrant strict; rm -f \"$TABS_DIR\"/*(N) }\n\n# Each blocked tab remembers where it was going, keyed by its Chrome tab id.\nRememberTab() { printf '%s\\n' \"$2\" > \"$TABS_DIR/$1\" }\nRecallTab() { cat \"$TABS_DIR/$1\" 2>/dev/null }\nForgetTab() { rm -f \"$TABS_DIR/$1\" }\n\n# --------------------------------------------------------- 4. The block page\n\nWriteBlockPage() {\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  :root { color-scheme: dark }\n  * { box-sizing: border-box }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center;\n         background: #202020; color: #f3f3f3; font: 300 18px system-ui, sans-serif }\n  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;\n         border-radius: 18px; background: #292929; box-shadow: 0 24px 80px #0005 }\n  h1 { margin: 0; font: 300 clamp(32px, 6vw, 58px)/1.08 Georgia, serif }\n  p { color: #aaa; line-height: 1.5 }\n  a { display: inline-block; margin-top: 18px; padding: 14px 28px; border-radius: 999px;\n      background: #f3f3f3; color: #202020; text-decoration: none; font-weight: 600 }\n  a:active { background: #c9c9c9 }\n</style>\n</head>\n<body>\n<main>\n  <h1 id=\"h1\">YouTube est bloqué.</h1>\n  <p id=\"p\">Un clic ouvre YouTube en entier pendant <span id=\"mins\">$GRANT_MINUTES</span> minutes.</p>\n  <a id=\"unlock\" href=\"?unlock=1\">Ouvrir</a>\n</main>\n<script>\n  var minutesByScope = { general: $GRANT_MINUTES, strict: $STRICT_GRANT_MINUTES };\n  var scope = new URLSearchParams(location.search).get('scope') === 'strict' ? 'strict' : 'general';\n  var minutes = minutesByScope[scope];\n  document.getElementById('mins').textContent = minutes;\n  document.getElementById('unlock').href = '?unlock=1&scope=' + scope;\n  document.getElementById('unlock').textContent = 'Ouvrir ' + minutes + ' minute' + (minutes > 1 ? 's' : '');\n  if (scope === 'strict') {\n    document.title = 'Chaîne bloquée';\n    document.getElementById('h1').textContent = 'Cette chaîne est bloquée.';\n    document.getElementById('p').textContent = 'Elle recommence à couper toutes les ' + minutes + ' minute' + (minutes > 1 ? 's' : '') + '.';\n  }\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\"\n}\n\n# ------------------------------------------------------- 5. Talking to Chrome\n\n# One line per tab: window index, tab index, tab id, URL.\nListTabs() {\n  pgrep -x \"Google Chrome\" >/dev/null 2>&1 || return 0\n  osascript <<'APPLESCRIPT' 2>/dev/null || true\nset output to \"\"\nset sep to ASCII character 9\ntell application \"Google Chrome\"\n  repeat with w from 1 to (count of windows)\n    repeat with t from 1 to (count of tabs of window w)\n      try\n        set theTab to tab t of window w\n        set output to output & w & sep & t & sep & (id of theTab) & sep & (URL of theTab as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn output\nAPPLESCRIPT\n}\n\nSetTabURL() {\n  osascript - \"$1\" \"$2\" \"$3\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set w to (item 1 of argv) as integer\n  set t to (item 2 of argv) as integer\n  tell application \"Google Chrome\" to set URL of tab t of window w to (item 3 of argv)\nend run\nAPPLESCRIPT\n}\n\n# ------------------------------------------------------------- 6. The loop\n\nEnforce() {\n  local -a lines fields\n  lines=(\"${(@f)$(ListTabs)}\")\n  local line window tab tabId url target scope\n\n  # Expired grants: drop them, tabs get blocked again below.\n  for scope in general strict; do\n    [[ -s \"$(GrantFile \"$scope\")\" ]] && ! GrantActive \"$scope\" && EndGrant \"$scope\"\n  done\n\n  # A click anywhere starts its grant, before any tab is handled.\n  for line in $lines; do\n    url=\"${line##*$'\\t'}\"\n    if IsUnlockClick \"$url\"; then\n      scope=\"$(ScopeFromURL \"$url\")\"\n      GrantActive \"$scope\" || StartGrant \"$scope\"\n    fi\n  done\n\n  for line in $lines; do\n    [[ -n \"$line\" ]] || continue\n    fields=(\"${(@ps:\\t:)line}\")\n    (( ${#fields} == 4 )) || continue\n    window=$fields[1]; tab=$fields[2]; tabId=$fields[3]; url=$fields[4]\n\n    if IsBlockPage \"$url\"; then\n      scope=\"$(ScopeFromURL \"$url\")\"\n      GrantActive \"$scope\" || continue\n      target=\"$(RecallTab \"$tabId\")\"\n      [[ -n \"$target\" ]] || target=\"https://www.youtube.com/\"\n      ForgetTab \"$tabId\"\n      SetTabURL \"$window\" \"$tab\" \"$target\"\n      continue\n    fi\n\n    IsYouTube \"$url\" || continue\n    IsAlwaysFree \"$url\" && continue\n    scope=\"$(Scope \"$url\")\"\n    GrantActive \"$scope\" && continue\n\n    RememberTab \"$tabId\" \"$url\"\n    SetTabURL \"$window\" \"$tab\" \"$BLOCK_PAGE_URL?scope=$scope\"\n  done\n}\n\n# ---------------------------------------------- 7. Install / uninstall / status\n\nCompileTimer() {\n  command -v swiftc >/dev/null 2>&1 || { Say \"swiftc introuvable.\"; return 1 }\n  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"\n  chmod 700 \"$TIMER_BIN\"\n}\n\nInstallUser() {\n  EnsureState\n  WriteBlockPage\n  EndAllGrants\n  # Leftovers from the old per-channel version.\n  rm -f \"$STATE_DIR\"/channel_v2_*.txt(N) \"$STATE_DIR\"/grant_channel(N) \"$STATE_DIR\"/grant_url(N)\n  rm -rf \"$STATE_DIR/youtube-identity-cache\"\n  CompileTimer || return 1\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key><array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.log</string>\n  <key>StandardErrorPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.err.log</string>\n</dict></plist>\nPLIST\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"YouTube Guard installé : un clic ouvre YouTube $GRANT_MINUTES minutes.\"\n  Say \"Chaînes strictes (1 min, pas de trêve pendant un grant général) : ${#STRICT_CHANNELS} configurée(s).\"\n  Say \"Toujours libres : abonnements, Ici Japon, Ici Japon Corp.\"\n}\n\nUninstallUser() {\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  EndAllGrants\n  rm -f \"$USER_PLIST\"\n  Say \"YouTube Guard désinstallé.\"\n}\n\nStatus() {\n  local loaded=no left_general=0 left_strict=0\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && loaded=yes\n  GrantActive general && left_general=$(( ( $(cat \"$GRANT_FILE\") - $(Now) + 59 ) / 60 ))\n  GrantActive strict && left_strict=$(( ( $(cat \"$STRICT_GRANT_FILE\") - $(Now) + 59 ) / 60 ))\n  Say \"guard_loaded=$loaded\"\n  Say \"grant_minutes=$GRANT_MINUTES\"\n  Say \"grant_active=$(GrantActive general && printf yes || printf no)\"\n  Say \"minutes_left=$left_general\"\n  Say \"strict_grant_minutes=$STRICT_GRANT_MINUTES\"\n  Say \"strict_grant_active=$(GrantActive strict && printf yes || printf no)\"\n  Say \"strict_minutes_left=$left_strict\"\n  Say \"strict_channels=${#STRICT_CHANNELS}\"\n  Say \"timer_binary=$([[ -x \"$TIMER_BIN\" ]] && printf yes || printf no)\"\n}\n\ncase \"${1:-status}\" in\n  install-user) InstallUser ;;\n  uninstall-user) UninstallUser ;;\n  watch-tabs) EnsureState; while true; do Enforce; sleep 1; done ;;\n  enforce) EnsureState; WriteBlockPage; Enforce ;;\n  open) StartGrant general; Say \"YouTube ouvert $GRANT_MINUTES minutes.\" ;;\n  close) EndAllGrants; Say \"YouTube refermé.\" ;;\n  status) Status ;;\n  *) Say \"Usage: $0 {install-user|uninstall-user|watch-tabs|enforce|open|close|status}\"; exit 1 ;;\nesac\n","structuredPatch":[{"oldStart":18,"oldLines":3,"newStart":18,"newLines":327,"lines":[" # 6. The loop"," # 7. Install / uninstall / status"," #","+","+set -u","+export PATH=\"/usr/bin:/bin:/usr/sbin:/sbin\"","+","+# ---------------------------------------------------------------- 1. Settings","+","+GRANT_MINUTES=15          # general YouTube unlock","+STRICT_GRANT_MINUTES=1    # unlock for channels in STRICT_CHANNELS","+","+# Channels that get the 1-minute leash instead of the general 15-minute one.","+# Match against the lowercased path, no query/anchor (see UrlPath below).","+STRICT_CHANNELS=(","+  \"/@gregguillotin\"","+  \"/channel/ucm1c1okz-7cpv7bez-pzugg\"   # Greg Guillotin (main)","+  \"/channel/ucjd8rq4cazzsximqtkqlh1q\"   # Greg Guillotin - La Chaîne Animale","+)","+","+MEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"","+FOCUS_DIR=\"$MEMORY_ROOT/Focus\"","+STATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"","+TABS_DIR=\"$STATE_DIR/tabs\"","+GRANT_FILE=\"$STATE_DIR/grant_until\"","+STRICT_GRANT_FILE=\"$STATE_DIR/grant_until_strict\"","+","+BLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"","+BLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"","+","+TIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"","+TIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"","+","+SCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"","+USER_LABEL=\"com.zenray.social-media-guard.tabs\"","+USER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"","+","+Say() { printf '%s\\n' \"$*\"; }","+Now() { date '+%s'; }","+","+EnsureState() {","+  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\" \"$TABS_DIR\"","+  chmod 700 \"$STATE_DIR\"","+}","+","+# ---------------------------------------------------------- 2. Reading a URL","+","+# Everything below works on the lowercased URL, with query and anchor removed.","+UrlPath() {","+  local path=\"${1%%\\?*}\"","+  printf '%s' \"${${path%%\\#*}:l}\"","+}","+","+IsYouTube() {","+  case \"${1:l}\" in","+    https://youtube.com*|https://www.youtube.com*|https://m.youtube.com*) return 0 ;;","+    https://music.youtube.com*|https://youtu.be*) return 0 ;;","+    *) return 1 ;;","+  esac","+}","+","+# Pages that never need a grant.","+IsAlwaysFree() {","+  local path; path=\"$(UrlPath \"$1\")\"","+  case \"$path\" in","+    */feed/subscriptions|*/feed/subscriptions/*) return 0 ;;","+    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;","+    */channel/ucegev5mbdmgmgzfpralemfa|*/channel/ucegev5mbdmgmgzfpralemfa/*) return 0 ;;","+    */channel/uc_r99mjdkzksbgeedoylbkw|*/channel/uc_r99mjdkzksbgeedoylbkw/*) return 0 ;;","+    *) return 1 ;;","+  esac","+}","+","+# Channels on the 1-minute leash.","+IsStrictChannel() {","+  local path pattern; path=\"$(UrlPath \"$1\")\"","+  for pattern in $STRICT_CHANNELS; do","+    case \"$path\" in","+      *\"$pattern\"|*\"$pattern\"/*) return 0 ;;","+    esac","+  done","+  return 1","+}","+","+Scope() { IsStrictChannel \"$1\" && printf 'strict' || printf 'general' }","+","+IsBlockPage() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] }","+IsUnlockClick() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] && [[ \"$1\" == *\"unlock=1\"* ]] }","+ScopeFromURL() { [[ \"$1\" == *\"scope=strict\"* ]] && printf 'strict' || printf 'general' }","+","+# ------------------------------------------------------- 3. Grants (per scope)","+","+GrantFile() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_FILE\" || printf '%s' \"$GRANT_FILE\" }","+GrantMinutes() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_MINUTES\" || printf '%s' \"$GRANT_MINUTES\" }","+TimerPidFile() { printf '%s' \"$STATE_DIR/timer_pid_$1\" }","+","+GrantActive() {","+  local file=\"$(GrantFile \"$1\")\" until","+  [[ -s \"$file\" ]] || return 1","+  until=\"$(cat \"$file\" 2>/dev/null || printf '0')\"","+  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1","+  (( $(Now) < until ))","+}","+","+StartGrant() {","+  local scope=\"$1\" file minutes pidfile","+  file=\"$(GrantFile \"$scope\")\"; minutes=\"$(GrantMinutes \"$scope\")\"; pidfile=\"$(TimerPidFile \"$scope\")\"","+  EnsureState","+  printf '%s\\n' $(( $(Now) + minutes * 60 )) > \"$file\"","+  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1","+  rm -f \"$pidfile\"","+  if [[ -x \"$TIMER_BIN\" ]]; then","+    nohup \"$TIMER_BIN\" \"$file\" >/dev/null 2>&1 </dev/null &","+    printf '%s\\n' $! > \"$pidfile\"","+  fi","+}","+","+EndGrant() {","+  local scope=\"$1\" pidfile; pidfile=\"$(TimerPidFile \"$scope\")\"","+  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1","+  rm -f \"$pidfile\" \"$(GrantFile \"$scope\")\"","+}","+","+EndAllGrants() { EndGrant general; EndGrant strict; rm -f \"$TABS_DIR\"/*(N) }","+","+# Each blocked tab remembers where it was going, keyed by its Chrome tab id.","+RememberTab() { printf '%s\\n' \"$2\" > \"$TABS_DIR/$1\" }","+RecallTab() { cat \"$TABS_DIR/$1\" 2>/dev/null }","+ForgetTab() { rm -f \"$TABS_DIR/$1\" }","+","+# --------------------------------------------------------- 4. The block page","+","+WriteBlockPage() {","+  cat > \"$BLOCK_PAGE_FILE\" <<HTML","+<!doctype html>","+<html lang=\"fr\">","+<head>","+<meta charset=\"utf-8\">","+<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">","+<title>YouTube bloqué</title>","+<style>","+  :root { color-scheme: dark }","+  * { box-sizing: border-box }","+  body { margin: 0; min-height: 100vh; display: grid; place-items: center;","+         background: #202020; color: #f3f3f3; font: 300 18px system-ui, sans-serif }","+  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;","+         border-radius: 18px; background: #292929; box-shadow: 0 24px 80px #0005 }","+  h1 { margin: 0; font: 300 clamp(32px, 6vw, 58px)/1.08 Georgia, serif }","+  p { color: #aaa; line-height: 1.5 }","+  a { display: inline-block; margin-top: 18px; padding: 14px 28px; border-radius: 999px;","+      background: #f3f3f3; color: #202020; text-decoration: none; font-weight: 600 }","+  a:active { background: #c9c9c9 }","+</style>","+</head>","+<body>","+<main>","+  <h1 id=\"h1\">YouTube est bloqué.</h1>","+  <p id=\"p\">Un clic ouvre YouTube en entier pendant <span id=\"mins\">$GRANT_MINUTES</span> minutes.</p>","+  <a id=\"unlock\" href=\"?unlock=1\">Ouvrir</a>","+</main>","+<script>","+  var minutesByScope = { general: $GRANT_MINUTES, strict: $STRICT_GRANT_MINUTES };","+  var scope = new URLSearchParams(location.search).get('scope') === 'strict' ? 'strict' : 'general';","+  var minutes = minutesByScope[scope];","+  document.getElementById('mins').textContent = minutes;","+  document.getElementById('unlock').href = '?unlock=1&scope=' + scope;","+  document.getElementById('unlock').textContent = 'Ouvrir ' + minutes + ' minute' + (minutes > 1 ? 's' : '');","+  if (scope === 'strict') {","+    document.title = 'Chaîne bloquée';","+    document.getElementById('h1').textContent = 'Cette chaîne est bloquée.';","+    document.getElementById('p').textContent = 'Elle recommence à couper toutes les ' + minutes + ' minute' + (minutes > 1 ? 's' : '') + '.';","+  }","+</script>","+</body>","+</html>","+HTML","+  chmod 644 \"$BLOCK_PAGE_FILE\"","+}","+","+# ------------------------------------------------------- 5. Talking to Chrome","+","+# One line per tab: window index, tab index, tab id, URL.","+ListTabs() {","+  pgrep -x \"Google Chrome\" >/dev/null 2>&1 || return 0","+  osascript <<'APPLESCRIPT' 2>/dev/null || true","+set output to \"\"","+set sep to ASCII character 9","+tell application \"Google Chrome\"","+  repeat with w from 1 to (count of windows)","+    repeat with t from 1 to (count of tabs of window w)","+      try","+        set theTab to tab t of window w","+        set output to output & w & sep & t & sep & (id of theTab) & sep & (URL of theTab as text) & linefeed","+      end try","+    end repeat","+  end repeat","+end tell","+return output","+APPLESCRIPT","+}","+","+SetTabURL() {","+  osascript - \"$1\" \"$2\" \"$3\" <<'APPLESCRIPT' >/dev/null 2>&1 || true","+on run argv","+  set w to (item 1 of argv) as integer","+  set t to (item 2 of argv) as integer","+  tell application \"Google Chrome\" to set URL of tab t of window w to (item 3 of argv)","+end run","+APPLESCRIPT","+}","+","+# ------------------------------------------------------------- 6. The loop","+","+Enforce() {","+  local -a lines fields","+  lines=(\"${(@f)$(ListTabs)}\")","+  local line window tab tabId url target scope","+","+  # Expired grants: drop them, tabs get blocked again below.","+  for scope in general strict; do","+    [[ -s \"$(GrantFile \"$scope\")\" ]] && ! GrantActive \"$scope\" && EndGrant \"$scope\"","+  done","+","+  # A click anywhere starts its grant, before any tab is handled.","+  for line in $lines; do","+    url=\"${line##*$'\\t'}\"","+    if IsUnlockClick \"$url\"; then","+      scope=\"$(ScopeFromURL \"$url\")\"","+      GrantActive \"$scope\" || StartGrant \"$scope\"","+    fi","+  done","+","+  for line in $lines; do","+    [[ -n \"$line\" ]] || continue","+    fields=(\"${(@ps:\\t:)line}\")","+    (( ${#fields} == 4 )) || continue","+    window=$fields[1]; tab=$fields[2]; tabId=$fields[3]; url=$fields[4]","+","+    if IsBlockPage \"$url\"; then","+      scope=\"$(ScopeFromURL \"$url\")\"","+      GrantActive \"$scope\" || continue","+      target=\"$(RecallTab \"$tabId\")\"","+      [[ -n \"$target\" ]] || target=\"https://www.youtube.com/\"","+      ForgetTab \"$tabId\"","+      SetTabURL \"$window\" \"$tab\" \"$target\"","+      continue","+    fi","+","+    IsYouTube \"$url\" || continue","+    IsAlwaysFree \"$url\" && continue","+    scope=\"$(Scope \"$url\")\"","+    GrantActive \"$scope\" && continue","+","+    RememberTab \"$tabId\" \"$url\"","+    SetTabURL \"$window\" \"$tab\" \"$BLOCK_PAGE_URL?scope=$scope\"","+  done","+}","+","+# ---------------------------------------------- 7. Install / uninstall / status","+","+CompileTimer() {","+  command -v swiftc >/dev/null 2>&1 || { Say \"swiftc introuvable.\"; return 1 }","+  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"","+  chmod 700 \"$TIMER_BIN\"","+}","+","+InstallUser() {","+  EnsureState","+  WriteBlockPage","+  EndAllGrants","+  # Leftovers from the old per-channel version.","+  rm -f \"$STATE_DIR\"/channel_v2_*.txt(N) \"$STATE_DIR\"/grant_channel(N) \"$STATE_DIR\"/grant_url(N)","+  rm -rf \"$STATE_DIR/youtube-identity-cache\"","+  CompileTimer || return 1","+  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"","+  cat > \"$USER_PLIST\" <<PLIST","+<?xml version=\"1.0\" encoding=\"UTF-8\"?>","+<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0\" encoding=\"UTF-8\"?>","+<plist version=\"1.0\"><dict>","+  <key>Label</key><string>$USER_LABEL</string>","+  <key>ProgramArguments</key><array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>","+  <key>RunAtLoad</key><true/>","+  <key>KeepAlive</key><true/>","+  <key>StandardOutPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.log</string>","+  <key>StandardErrorPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.err.log</string>","+</dict></plist>","+PLIST","+  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true","+  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"","+  Say \"YouTube Guard installé : un clic ouvre YouTube $GRANT_MINUTES minutes.\"","+  Say \"Chaînes strictes (1 min, pas de trêve pendant un grant général) : ${#STRICT_CHANNELS} configurée(s).\"","+  Say \"Toujours libres : abonnements, Ici Japon, Ici Japon Corp.\"","+}","+","+UninstallUser() {","+  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true","+  EndAllGrants","+  rm -f \"$USER_PLIST\"","+  Say \"YouTube Guard désinstallé.\"","+}","+","+Status() {","+  local loaded=no left_general=0 left_strict=0","+  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && loaded=yes","+  GrantActive general && left_general=$(( ( $(cat \"$GRANT_FILE\") - $(Now) + 59 ) / 60 ))","+  GrantActive strict && left_strict=$(( ( $(cat \"$STRICT_GRANT_FILE\") - $(Now) + 59 ) / 60 ))","+  Say \"guard_loaded=$loaded\"","+  Say \"grant_minutes=$GRANT_MINUTES\"","+  Say \"grant_active=$(GrantActive general && printf yes || printf no)\"","+  Say \"minutes_left=$left_general\"","+  Say \"strict_grant_minutes=$STRICT_GRANT_MINUTES\"","+