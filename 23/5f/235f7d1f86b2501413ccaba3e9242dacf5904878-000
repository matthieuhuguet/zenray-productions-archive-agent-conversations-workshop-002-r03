ON (qui sauvegardent ensuite) n'envoient PAS raw=1 et gardent le sha via l'API.\nserver/page.js:530:            const rr = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\nserver/upload.js:41:    const url = `https://raw.githubusercontent.com/${repo}/${branch}/${path}`\nserver/share-cover.js:24:    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(`${dir}/${COVER_FILE}`)}`,\nserver/shared-media.js:52:    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\nserver/shared-media.js:74:      const cdnUrl = `https://raw.githubusercontent.com/matthieuhuguet/${m.cdnRepo}/${m.cdnCommit}/${m.cdnPath}`\nserver/share-og.js:24:    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(p)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n"},{"type":"input_text","text":"---RESULT 2---\n// INDEX DE RECHERCHE CÔTÉ CLIENT — chargé UNE fois, gardé en local, scoré sans réseau.\n//\n// EN CLAIR POUR TOUS : avant, chaque lettre tapée dans la recherche partait demander au serveur\n// la liste des fichiers qui matchent. Lent, et ça spammait le réseau. Maintenant on télécharge\n// la grande liste de tous les chemins UNE seule fois, on la range dans une petite base locale du\n// navigateur (IndexedDB) qui survit au reload, et on cherche en mémoire instantanément. On ne\n// re-télécharge que si le serveur dit que la liste a changé (champ builtAt).\n//\n// TECHNIQUE : IndexedDB store clé->valeur. Une seule clé 'pages' stocke { builtAt, paths }.\n// Tout est best-effort : si IndexedDB est indispo (navigation privée, quota), on retombe sur un\n// chargement réseau simple sans persistance. Jamais d'exception qui casse la recherche.\n\nimport { decryptBytes } from '../media/crypto.js'\n\nconst DB_NAME = 'zr-search-index'\nconst STORE = 'idx'\nconst KEY = 'pages'\nlet dbPromise = null\n\n// INDEX SHARDÉ CHIFFRÉ servi par CDN (raw.githubusercontent, hors quota API REST). head.json (clair, dossiers\n// hachés) liste les shards ; chaque shard `s/<h>-<part>.json` = { iv, ct } AES-GCM (clé maître, même que les\n// médias). On lit head + tous les shards via raw@main (~5 min de cache, 0 appel API GitHub), on déchiffre et on\n// fusionne en { paths, thumbs, content }. Scalable (pas de mur 50 Mo) et privacy gardée (ciphertext public).\nconst IDX_BASE = 'https://raw.githubusercontent.com/matthieuhuguet/zenray-index-public/main'\nconst bytesFromB64 = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))\n\nasync function fetchHead() {\n  try { const h = await fetch(`${IDX_BASE}/head.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null); return (h && Array.isArray(h.shards) && h.shards.length) ? h : null } catch { return null }\n}\nasync function loadFromCDN(head) {\n  head = head || await fetchHead()\n  if (!head) return null\n  const parts = await Promise.all(head.shards.map(async (s) => {\n    const fn = s.part != null ? `${s.h}-${s.part}.json` : `${s.h}.json`\n    try {\n      const blob = await fetch(`${IDX_BASE}/s/${fn}`).then((r) => r.ok ? r.json() : null)\n      if (!blob || !blob.ct) return null\n      const clear = await decryptBytes(bytesFromB64(blob.ct), blob.iv)\n      return JSON.parse(new TextDecoder().decode(new Uint8Array(clear)))\n    } catch { return null }\n  }))\n  const merged = { builtAt: null, paths: [], thumbs: {}, content: {}, sizes: {}, mimes: {} }\n  for (const r of parts) { if (!r) continue; if (Array.isArray(r.paths)) merged.paths.push(...r.paths); Object.assign(merged.thumbs, r.thumbs || {}); Object.assign(merged.content, r.content || {}); Object.assign(merged.sizes, r.sizes || {}); Object.assign(merged.mimes, r.mimes || {}) }\n  // DELTA : ajouts récents (drop/archive/push/HLS) pas encore repliés dans les shards. Petit, chiffré, fusionné.\n  let deltaAt = ''\n  try {\n    const dr = await fetch(`${IDX_BASE}/delta.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null)\n    if (dr && dr.ct) {\n      deltaAt = dr.builtAt || ''\n      const d = JSON.parse(new TextDecoder().decode(new Uint8Array(await decryptBytes(bytesFromB64(dr.ct), dr.iv))))\n      if (Array.isArray(d.paths)) { const seen = new Set(merged.paths); for (const p of d.paths) if (!seen.has(p)) merged.paths.push(p); Object.assign(merged.thumbs, d.thumbs || {}); Object.assign(merged.content, d.content || {}); Object.assign(merged.sizes, d.sizes || {}); Object.assign(merged.mimes, d.mimes || {}) }\n      // rm = chemins déplacés/supprimés : on les ôte des chemins issus des shards (sinon résultats périmés -> 404).\n      if (Array.isArray(d.rm) && d.rm.length) { const rm = new Set(d.rm); merged.paths = merged.paths.filter((p) => !rm.has(p)); for (const p of d.rm) { delete merged.thumbs[p]; delete merged.content[p] } }\n    }\n  } catch {}\n  merged.builtAt = `${head.builtAt || ''}|${deltaAt}` // jeton combiné : change si shards OU delta changent\n  return merged.paths.length ? merged : null\n}\n\nfunction openDB() {\n  if (dbPromise) return dbPromise\n  dbPromise = new Promise((resolve) => {\n    try {\n      if (typeof indexedDB === 'undefined') return resolve(null)\n      const req = indexedDB.open(DB_NAME, 1)\n      req.onupgradeneeded = () => {\n        try { const db = req.result; if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE) } catch {}\n      }\n      req.onsuccess = () => resolve(req.result)\n      req.onerror = () => resolve(null)\n    } catch { resolve(null) }\n  })\n  return dbPromise\n}\n\nfunction idbReadIndex() {\n  return openDB().then((db) => {\n    if (!db) return null\n    return new Promise((resolve) => {\n      try {\n        const rq = db.transaction(STORE, 'readonly').objectStore(STORE).get(KEY)\n        rq.onsuccess = () => resolve(rq.result && Array.isArray(rq.result.paths) ? rq.result : null)\n        rq.onerror = () => resolve(null)\n      } catch { resolve(null) }\n    })\n  }).catch(() => null)\n}\n\nfunction idbWriteIndex(rec) {\n  openDB().then((db) => {\n    if (!db) return\n    try { db.transaction(STORE, 'readwrite').objectStore(STORE).put(rec, KEY) } catch {}\n  }).catch(() => {})\n}\n\n// État mémoire (vivant tant que l'onglet est ouvert) : évite même le coût IndexedDB par frappe.\n// E (vignette dans l'index v2) : le record porte AUSSI `thumbs` (carte chemin->{u}|{r,p}) pour\n// que la recherche affiche les vignettes sans relire un .img.json par image. thumbs absent\n// (cache v1) -> traité comme {} -> fallback lecture manifeste (comportement actuel inchangé).\nlet mem = null // { builtAt, paths, thumbs }\nlet inflight = null\n// Optimistic overlay for mutations performed in this tab. It survives an\n// invalidate/reload while raw GitHub/CDN is still propagating the new delta.\nconst localAdds = new Set()\nconst localRemoves = new Set()\n\nfunction applyLocalOverlay(rec) {\n  if (!rec) rec = { builtAt: null, paths: [], thumbs: {}, content: {}, sizes: {}, mimes: {} }\n  const seen = new Set((rec.paths || []).filter((p) => !localRemoves.has(p)))\n  for (const p of localAdds) seen.add(p)\n  rec.paths = [...seen]\n  return rec\n}\n\n// Charge l'index, en privilégiant le cache local. Vérifie le builtAt serveur (action=index est léger\n// à appeler côté GitHub car le serveur garde un cache mémoire 120 s). Si builtAt identique au cache\n// local, on garde la copie locale. Sinon on prend la liste fraîche renvoyée et on la persiste.\nexport async function loadSearchIndex() {\n  if (mem) {\n    // Rafraîchissement opportuniste en arrière-plan (ne bloque pas l'appelant).\n    if (!inflight) refresh().catch(() => {})\n    mem = applyLocalOverlay(mem)\n    return mem\n  }\n  if (inflight) return inflight\n  inflight = (async () => {\n    const local = await idbReadIndex()\n    if (local) { mem = { builtAt: local.builtAt || null, paths: local.paths, thumbs: (local.thumbs && typeof local.thumbs === 'object') ? local.thumbs : {}, content: (local.content && typeof local.content === 'object') ? local.content : {} } }\n    // 1) Source PRIMAIRE : index shardé chiffré servi par CDN (0 quota API GitHub).\n    try {\n      const fresh = await loadFromCDN()\n      if (fresh && fresh.paths.length && (!mem || mem.builtAt !== fresh.builtAt)) { mem = fresh; idbWriteIndex(fresh) }\n    } catch {}\n    // 2) FALLBACK : ancien index privé via l'API (si le CDN est indispo ou pas encore peuplé).\n    if (!mem || !mem.paths || !mem.paths.length) {\n      try {\n        const j = await fetch('/api/page?action=index', { cache: 'no-store' }).then((r) => r.json())\n        if (j && Array.isArray(j.paths) && j.paths.length) {\n          const fresh = { builtAt: j.builtAt || null, paths: j.paths, thumbs: (j.thumbs && typeof j.thumbs === 'object') ? j.thumbs : {}, content: (j.content && typeof j.content === 'object') ? j.content : {} }\n          if (!mem || mem.builtAt !== fresh.builtAt) { mem = fresh; idbWriteIndex(fresh) }\n        }\n      } catch {}\n    }\n    inflight = null\n    mem = applyLocalOverlay(mem)\n    return mem\n  })()\n  return inflight\n}\n\n// Vérifie en arrière-plan si l'index a changé ; met à jour mem + IndexedDB le cas échéant.\n// search-6 : on demande d'abord la TÊTE (head=1, quelques octets) pour comparer builtAt. On ne\n// re-télécharge le corps complet (~11-28 Mo) QUE si le serveur annonce un builtAt différent. Évite\n// de transférer tout l'index à chaque rafraîchissement opportuniste alors qu'il n'a pas changé.\nasync function refresh() {\n  try {\n    // head.json + delta.json sont minuscules (raw, ~5 min de cache, 0 API). On ne recharge les shards que si le\n    // jeton combiné (shards|delta) a changé -> capte aussi bien un rebuild complet qu'un simple ajout récent.\n    const head = await fetchHead(); if (!head) return\n    let deltaAt = ''\n    try { const dr = await fetch(`${IDX_BASE}/delta.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null); if (dr) deltaAt = dr.builtAt || '' } catch {}\n    if (`${head.builtAt || ''}|${deltaAt}` === (mem ? mem.builtAt : null)) return\n    const fresh = await loadFromCDN(head)\n    if (fresh && fresh.paths.length && (!mem || mem.builtAt !== fresh.builtAt)) { mem = applyLocalOverlay(fresh); idbWriteIndex(mem) }\n  } catch {}\n}\n\n// Invalide le cache mémoire (à appeler après un ajout de nœud pour forcer un rechargement frais).\nexport function invalidateSearchIndex() { mem = null; inflight = null }\n\nimport { describe, expect, it } from 'vitest'\nimport { getIndexPaths, injectSearchIndexPaths, loadSearchIndex, rollbackSearchIndexPaths } from './searchIndexClient.js'\n\ndescribe('optimistic Eagle placement index', () => {\n  it('rend le placement cherchable immédiatement et sait annuler un lot atomique', async () => {\n    const paths = ['pages/Projet/dragon.hda.file.json', 'pages/Projet/music.media.json']\n    injectSearchIndexPaths(paths)\n    expect(getIndexPaths()).toEqual(expect.arrayContaining(paths))\n    expect((await loadSearchIndex()).paths).toEqual(expect.arrayContaining(paths))\n\n    rollbackSearchIndexPaths(paths)\n    expect(getIndexPaths()).not.toEqual(expect.arrayContaining(paths))\n  })\n})\nimport { describe, it, expect, vi, beforeEach } from 'vitest'\nimport { readPageCached, clearPageReadCache } from './manifestReadCache.js'\n\ndescribe('readPageCached', () => {\n  beforeEach(() => { clearPageReadCache(); vi.restoreAllMocks() })\n\n  it('ne fetch qu\\'une fois pour la même URL (cache + dédup des appels concurrents)', async () => {\n    const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({ ok: true, json: async () => ({ markdown: '# hello' }) })\n    const [a, b] = await Promise.all([readPageCached('/u1'), readPageCached('/u1')])\n    expect(a).toEqual({ markdown: '# hello' })\n    expect(b).toEqual({ markdown: '#