, [cur && cur.path])\n  const [status, setStatus] = useState('')\n  const [q, setQ] = useState('')\n  // Le chemin détaillé du dossier reste disponible sans prendre une rangée permanente : un petit chevron\n  // l'affiche à la demande, conformément au chrome compact de Create.\n  const [pathBarOpen, setPathBarOpen] = useState(false)\n  // vue Finder PERSISTÉE (list | icons | gallery) : le choix reste en mémoire entre dossiers/pages.\n  // GARDE (2026-07-14, bug production « Create n'affiche plus rien », même famille que `folder` plus bas) :\n  // la grille n'est rendue QUE si `view` vaut exactement list/icons/gallery — une valeur corrompue persistée\n  // dans localStorage (« pages » observé en prod chez Matthieu) ne matche AUCUNE branche de rendu -> grille\n  // définitivement vide, reload compris, sans aucune erreur visible. Toute valeur inconnue s'auto-répare\n  // en 'icons' dès le chargement, et setView refuse d'écrire autre chose que les 3 valeurs légales.\n  const validView = (v) => (v === 'list' || v === 'icons' || v === 'gallery') ? v : 'icons'\n  const [view, setView] = usePersistedState('zr:create:view', 'icons', { validate: validView })\n  // Filtre par type (carte « trier par type ») : Set des catégories à afficher (folder/page/image/media/db).\n  // null = tout afficher. Borné au dossier/embranchement courant (s'applique sur shownEntries).\n  // -> retry avec backoff, et on N'ÉCRASE JAMAIS un listing déjà valide sur un échec passager.\n  // `cacheMode` : `no-store` par défaut (comportement historique de tous les appels). L'arbre, lui,\n  // passe en `no-cache` pour que le navigateur garde de quoi REVALIDER et puisse envoyer\n  // `If-None-Match` — sans cela, le 304 posé côté serveur ne peut jamais se déclencher.\n  const fetchJSONRetry = async (url, tries = 6, cacheMode = 'no-store') => {\n    for (let i = 0; i < tries; i++) {\n      try {\n        const r = await fetch(url, { cache: cacheMode })\n        if (r.ok) {\n          const j = await r.json()\n          // D — 403 GRACIEUX : le serveur renvoie 200 avec { rateLimited:true, resetAt } quand le quota\n          // GitHub est épuisé. On NE relance PAS la boucle (sinon 6 appels gâchés sur un quota à zéro + 12 s\n          // de spinner). On note l'heure de reset (bandeau + re-fetch programmé) et on s'arrête net : le\n          // cache déjà servi par loadDir reste affiché.\n          if (j && j.rateLimited) { markRateLimited(j.resetAt); return null }\n          if (j && !j.error) return j\n        }\n      } catch {}\n      await new Promise((res) => setTimeout(res, Math.min(4000, 350 * (i + 1))))\n    }\n    return null\n  }\n  const dirReqId = useRef(0)\n  // P5 — single-flight par dossier (voir le wrapper loadDir plus bas) : refs de coalescence des revalidations.\n  const dirInflight = useRef(new Map()) // dossier -> Promise de revalidation actuellement en vol\n  const dirRerun = useRef(new Set())    // dossiers à re-revalider UNE fois la promesse en vol terminée\n  // loadDirOnce = SWR (stale-while-revalidate) : on AFFICHE d'abord le cache (instantané, zéro réseau),\n  // puis on REVALIDE en arrière-plan via fetch et on réécrit le cache. Anti-race conservé via dirReqId :\n  // si un autre dossier a été ouvert entre-temps, on n'écrase pas son listing.\n  const loadDirOnce = async (f) => {\n    const my = ++dirReqId.current\n    setFolderEagleSource(folderEagleSourceCache.current.get(f) || null)\n    if (my === dirReqId.current) setDirError(false) // finder-core-5 : on repart d'un état neutre (pas l'erreur du dossier précédent)\n    // CHEMIN PRINCIPAL = action=children (API contents, listing d'UN dossier). C'est la SEULE énumération\n    // FIABLE : l'API git tree récursive (action=tree) TRONQUE au-delà d'une certaine taille (truncated:true sur\n    // ce repo, ~30k entrées) -> liste partielle ET variable d'un appel à l'autre, d'où des dossiers qui\n    // « disparaissaient » au refresh. children liste un dossier précis sans cette troncature (dossiers vides\n    // inclus, renvoyés comme type:'dir'). SWR : cache affiché instantanément, revalidation derrière.\n    const cached = readDirCache(f)\n    if (cached && my === dirReqId.current) setDirEntries(cached) // stale immédiat\n    const j = await fetchJSONRetry(`/api/page?action=children&dir=${encodeURIComponent(f)}`)\n    if (my !== dirReqId.current) return // un autre chargement de dossier a démarré entre-temps\n    if (j && Array.isArray(j.entries)) {\n      if (j.eagleSource) folderEagleSourceCache.current.set(f, j.eagleSource)\n      else folderEagleSourceCache.current.delete(f)\n      setFolderEagleSource(j.eagleSource || null)\n      const built = (f === 'Memory' || f.startsWith('Memory/')) ? buildMemoryEntries(j.entries, f) : buildDirEntries(j.entries, f)\n      // Racine Create : tuile synthétique \"Memory\" (dossier live, repo distinct) -- accessible en NAVIGUANT\n      // Create normalement, pas seulement via le raccourci sidebar \"Skills\" qui saute directement dans Memory/Skills.\n      if (f === 'pages') built.unshift({ name: 'Memory', contentPath: null, hasKids: true, dir: 'Memory', type: 'folder', ...legacyFlags('folder') })\n      writeDirCache(f, built)\n      setDirEntries(built); setDirError(false) // le serveur a répondu : vide légitime si built.length===0\n    } else if (!cached) {\n      setDirEntries((prev) => (prev && prev.length ? prev : [])) // pas de cache + échec -> garde l'état valide, jamais d'écran cassé\n      setDirError((prev) => prev || true) // finder-core-5 : échec réseau SANS cache -> vrai état d'erreur (pas \"dossier vide\")\n    } else { setDirError(false) } // cache servi : on ne signale pas d'erreur\n  }\n  // P5 — loadDir public = loadDirOnce protégé par single-flight PAR DOSSIER. En rafale d'opérations\n  // (déplacements, renommages, suppressions enchaînés), chacune lance loadTree() -> loadDir(folder) en\n  // fire-and-forget : sans garde, N revalidations réseau IDENTIQUES du même dossier s'empilent. Ici, si\n  // une revalidation de ce dossier est déjà en vol, on NE la double PAS : on note qu'un changement est\n  // arrivé (dirRerun) et on renvoie la même promesse. À la fin, UNE seule reprise rattrape l'état final.\n  // Résultat : une op isolée = exactement 1 fetch (zéro latence ajoutée, l'écran reste piloté par\n  // l'optimisticDir) ; une rafale = au plus 2 fetch (le vol en cours + 1 reprise), au lieu de N.\n  const loadDir = (f) => {\n    if (dirInflight.current.has(f)) { dirRerun.current.add(f); return dirInflight.current.get(f) }\n    const p = (async () => {\n      try { await loadDirOnce(f) } finally {\n        dirInflight.current.delete(f)\n        if (dirRerun.current.has(f)) { dirRerun.current.delete(f); loadDir(f) } // 1 seule reprise pour l'état final\n      }\n    })()\n    dirInflight.current.set(f, p)\n    return p\n  }\n  // PRÉCHARGEMENT AU SURVOL (2026-07-06, perf dossiers) : survoler une tuile-dossier ~150 ms lance le fetch\n  // de SON listing en fond -> le double-clic qui suit trouve le cache déjà chaud (ouverture 0,1 s même pour\n  // un dossier jamais visité). Ne touche PAS l'écran (writeDirCache seulement), dédupliqué (1 fetch par\n  // dossier max), et sauté si un cache existe déjà (le SWR normal suffit alors).\n  const prefetched = useRef(new Set())\n  const prefetchTimer = useRef(null)\n  const prefetchDir = (e) => {\n    if (!e || !(e.hasKids || !e.contentPath)) return // seuls les dossiers se préchargent\n    const f = e.dir\n    if (!f || prefetched.current.has(f) || readDirCache(f)) return\n    if (prefetchTimer.current) clearTimeout(prefetchTimer.current)\n    prefetchTimer.current = setTimeout(async () => {\n      if (prefetched.current.has(f) || readDirCache(f)) return\n      prefetched.current.add(f)\n      const j = await fetch(`/api/page?action=children&dir=${encodeURIComponent(f)}`).then((r) => r.json()).catch(() => null)\n      if (j && Array.isArray(j.entries)) writeDirCache(f, (f === 'Memory' || f.startsWith('Memory/')) ? buildMemoryEntries(j.entries, f) : buildDirEntries(j.entries, f))\n      else prefetched.current.delete(f) // échec -> re-tentable au prochain survol\n    }, 150)\n  }\n  const loadPaths = async () => {\n    const j = await fetchJSONRetry('/api/page?action=tree', 6, 'no-cache')\n    if (j && Array.isArray(j.paths)) {\n      // PERF : le poll 25 s (ci-dessous) rappelle ceci en continu même quand l'arbre n'a pas bougé. Si le\n      // contenu est identique à ce qu'on a déjà, on garde l'ancienne RÉFÉRENCE `paths` (pas de setPaths) ->\n      // pathNorms/nonEmptyDirs (useMemo dépendants de `paths`/`allPaths`) ne recalculent pas pour rien.\n      // pathsRef reste à jour dans tous les cas (miroir synchrone utilisé par les écritures optimistes).\n      const changed = !sameStringArray(pathsRef.current, j.paths)\n      pathsRef.current = j.paths\n      if (changed) { pathsMemo = j.paths; setPaths(j.paths) }\n    }\n    else setPaths((prev) => (prev && prev.length ? prev : []))\n  }\n  // loadPaths est le VRAI tueur de latence (arbre git récursif ~10 Mo). On le SORT du chemin critique :\n  // après une écriture, on rafraîchit le dossier courant tout de suite (rapide), mais l'arbre global n'est\n  // ré-aspiré qu'après 800 ms d'inactivité (debounce). Plusieurs ops rapprochées = 1 seul gros fetch.\n  const loadPathsTimer = useRef(null)\n  const loadPathsDebounced = () => {\n    if (loadPathsTimer.current) clearTimeout(loadPathsTimer.current)\n    loadPathsTimer.current = setTimeout(() => { loadPathsTimer.current = null; loadPaths() }, 800)\n  }\n  // loadTree() = rafraîchit le dossier courant (rapide, non bloquant) + l'index global (debounce, secondaire).\n  const loadTree = () => { loadDir(folder); loadPathsDebounced() }\n  // Vide TOUS les caches Create. À lancer APRÈS une migration média (les manifests changent d'URL/visibilité,\n  // sinon l'app sert les anciennes URLs en cache). Purge : listings (RAM+sessionStorage), manifests image,\n  // cache image persistant IndexedDB, index de recherche, et les caches de couverture/titre/commentaire des tuiles.\n  const clearCreateCaches = async () => {\n    setStatus('vidage du cache…')\n    clearAllDirCache(); clearManifestCache(); clearPageReadCache(); invalidateSearchIndex()\n    for (const cache of [_thumbCache, _labelCache, _commentCountCache]) {\n      for (const key of Object.keys(cache)) delete cache[key]\n    }\n    // _mediaMimeMem/_mediaPosterMem/_mediaDurMem/_fileThumbMem/_videoCardMem sont…7541 tokens truncated…eture après suppression).\n  const panelTask = (board && renderedId ? board.tasks.find((tk) => tk.id === renderedId) : null) || (renderedId ? renderedTaskRef.current : null)\n\n  // ── Navigation jour par jour (v14 remplace le mois-par-mois de v11) ───────────────────────────────\n  const selectDay = (cell) => { selectIso(cell.iso); closePanel() }\n  const stepDay = (delta) => {\n    const next = addDays(selectedIso, delta)\n    selectIso(next)\n    const d = parseIso(next)\n    if (d.getFullYear() !== cursor.year || d.getMonth() !== cursor.month) setCursor({ year: d.getFullYear(), month: d.getMonth() })\n    closePanel()\n  }\n  const goToday = () => {\n    selectIso(today)\n    const d = new Date()\n    setCursor({ year: d.getFullYear(), month: d.getMonth() })\n    closePanel()\n  }\n\n  // Piste mobile : scrolle jusqu'au jour sélectionné dès qu'il change (Today/‹ ›/tap sur une tâche\n  // d'un autre jour) -- no-op si l'utilisateur est déjà dessus (le swipe qui a POSÉ ce selectedIso).\n  useEffect(() => {\n    if (!isNarrow) { mobileReadyRef.current = false; return }\n    if (loading) return\n    const el = mobileStripRef.current\n    if (!el || !el.clientWidth) return\n    const index = cells.findIndex((c) => c.iso === selectedIso)\n    if (index < 0) return\n    const target = index * el.clientWidth\n    const behavior = reducedMotion() || !mobileReadyRef.current ? 'auto' : 'smooth'\n    if (Math.abs(el.scrollLeft - target) > 4) el.scrollTo({ left: target, behavior })\n    mobileReadyRef.current = true\n  }, [selectedIso, cells, isNarrow, loading])\n  const onStripScroll = () => {\n    const el = mobileStripRef.current\n    if (!el || !el.clientWidth) return\n    window.clearTimeout(stripSettleRef.current)\n    stripSettleRef.current = window.setTimeout(() => {\n      const index = Math.round(el.scrollLeft / el.clientWidth)\n      const cell = cells[index]\n      if (!cell || cell.iso === selectedIso) return\n      selectIso(cell.iso)\n      const d = parseIso(cell.iso)\n      if (d.getFullYear() !== cursor.year || d.getMonth() !== cursor.month) setCursor({ year: d.getFullYear(), month: d.getMonth() })\n      closePanel()\n    }, 120)\n  }\n\n  // ── Cycle de vie d'une tâche ───────────────────────────────────────────────────────────────────────\n  const toggleDone = (task) => {\n    persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => {\n      if (tk.id !== task.id) return tk\n      const isDone = tk.status === 'done' || tk.status === 'late-complete'\n      if (isDone) return { ...tk, status: 'planned', doneAt: null } // décoche : redevient \"en retard\" si sa date est déjà passée\n      const nowLate = tk.date < today\n      return { ...tk, status: nowLate ? 'late-complete' : 'done', doneAt: new Date().toISOString(), overdueSince: nowLate ? (tk.overdueSince || tk.date) : tk.overdueSince }\n    }) }))\n  }\n  // ABANDONNER / REPRENDRE (2026-08-07). Bascule pure, réversible, qui ne supprime RIEN : la tâche\n  // garde son titre, sa note, ses images et sa date, elle cesse simplement de compter comme à faire.\n  // On mémorise `droppedAt` pour l'historique, et on efface `doneAt` — une tâche abandonnée n'a pas\n  // été terminée, mélanger les deux fausserait tout décompte ultérieur.\n  const toggleDropped = (task) => {\n    persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => {\n      if (tk.id !== task.id) return tk\n      if (tk.status === 'dropped') return { ...tk, status: 'planned', droppedAt: null }\n      return { ...tk, status: 'dropped', droppedAt: new Date().toISOString(), doneAt: null }\n    }) }))\n  }\n  const rescueToday = (task) => {\n    persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => (tk.id === task.id ? { ...tk, overdueSince: tk.overdueSince || tk.date, date: today } : tk)) }))\n  }\n  // Suppression (demande explicite 2026-07-20, absente de la référence-prototype) : la fermeture animée\n  // part D'ABORD (le bloc continue d'afficher l'instantané renderedTaskRef pendant qu'elle se joue),\n  // la donnée est retirée en parallèle. Récupérable via l'historique Git du .plan.json.\n  const deleteTask = (task) => {\n    if (!canDeleteTask(task)) return // verrou d'engagement 4h (l'UI grise déjà la corbeille)\n    closePanel()\n    persist((cur) => ({ ...cur, tasks: cur.tasks.filter((tk) => tk.id !== task.id) }))\n  }\n  const submitComposer = () => {\n    const title = draft.title.trim()\n    if (!title) return\n    const duration = Math.max(5, Math.min(240, draft.duration))\n    const baseTask = (date, streakId) => ({\n      id: uid(), title, date, startTime: draft.time || null, durationMin: duration,\n      status: 'planned', note: '', images: [], overdueSince: null, doneAt: null,\n      createdAt: new Date().toISOString(), ...(streakId ? { streakId, streakEvery: draft.streakEvery } : {}),\n      ...(draft.publish ? { publish: true } : {}),\n      ...(draft.firstMovement ? { firstMovement: true } : {}),\n    })\n    // Streak task (retour Matthieu 2026-07-20) : une occurrence tous les N jours, de la date de départ\n    // jusqu'à la date d'arrêt incluse (plafond de sécurité STREAK_MAX_OCCURRENCES). Chaque occurrence\n    // est une tâche à part entière (cochable/manquable indépendamment), reliée par streakId.\n    if (draft.streak && draft.streakEnd && draft.streakEnd >= draft.date) {\n      const streakId = uid()\n      const occurrences = []\n      let iso = draft.date\n      while (iso <= draft.streakEnd && occurrences.length < STREAK_MAX_OCCURRENCES) {\n        occurrences.push(baseTask(iso, streakId))\n        iso = addDays(iso, Math.max(1, draft.streakEvery))\n      }\n      persist((cur) => ({ ...cur, tasks: [...cur.tasks, ...occurrences] }))\n    } else {\n      persist((cur) => ({ ...cur, tasks: [...cur.tasks, baseTask(draft.date, null)] }))\n    }\n    setComposerOpen(false)\n  }\n  const openComposer = () => {\n    setMenuOpen(false)\n    setComposerPicker(null)\n    setComposerAnchor(null)\n    setComposerPos(null)\n    setComposerOpen((v) => {\n      const next = !v\n      if (next) setDraft({ title: '', date: selectedIso, time: '09:00', duration: 90, customOpen: false, customMinutes: 60, streak: false, streakEvery: 1, streakEnd: '', publish: false, firstMovement: false })\n      return next\n    })\n  }\n  // Ouverture par clic droit sur une case du mois : même composer, même `draft` par défaut, mais la\n  // date part de la case cliquée (pas de `selectedIso`) et le popover s'ancre au point du clic plutôt\n  // qu'au bouton +. `x`/`y` viennent de `e.clientX/clientY`, donc déjà en coordonnées écran -- le\n  // rendu se fait via portail (voir plus bas), qui échappe à la grille et à ses transitions.\n  const openComposerAt = (iso, x, y) => {\n    setMenuOpen(false)\n    setComposerPicker(null)\n    setComposerPos(null)\n    setComposerAnchor({ x, y })\n    setDraft({ title: '', date: iso, time: '09:00', duration: 90, customOpen: false, customMinutes: 60, streak: false, streakEvery: 1, streakEnd: '', publish: false, firstMovement: false })\n    setComposerOpen(true)\n  }\n  // Fermeture au clic ailleurs dans le popover (le composer lui-même se ferme déjà au clic à\n  // l'extérieur -- ce listener local ne gère QUE les 3 mini-widgets date/heure, plus précis).\n  useEffect(() => {\n    if (!composerPicker) return undefined\n    const close = () => setComposerPicker(null)\n    window.addEventListener('pointerdown', close)\n    return () => window.removeEventListener('pointerdown', close)\n  }, [composerPicker])\n  // CLAMPAGE APRÈS MESURE RÉELLE (pas une largeur/hauteur devinée) : le popover ancré au clic droit\n  // peut s'ouvrir près d'un bord de fenêtre ; on mesure sa vraie taille une fois monté et on recale\n  // seulement si elle déborde. Réévalué quand son contenu change de hauteur (streak, durée custom),\n  // sans quoi ouvrir \"Streak\" près du bas du grid pousserait le bloc de fréquence hors écran.\n  useLayoutEffect(() => {\n    if (!composerOpen || !composerAnchor || !composerRef.current) return\n    const pad = 12\n    const r = composerRef.current.getBoundingClientRect()\n    let left = composerAnchor.x\n    let top = composerAnchor.y\n    if (left + r.width + pad > window.innerWidth) left = window.innerWidth - r.width - pad\n    if (top + r.height + pad > window.innerHeight) top = window.innerHeight - r.height - pad\n    left = Math.max(pad, left)\n    top = Math.max(pad, top)\n    setComposerPos({ left, top })\n  }, [composerOpen, composerAnchor, draft.streak, draft.customOpen])\n  // Fermeture au clic EN DEHORS du composer (demande du 2026-08-11) -- \"dehors\" exclut le popover\n  // lui-même (`composerRef`, le même nœud que le popover soit ancré au bouton +, soit porté par clic\n  // droit) ET le cluster de boutons +/... (`composerActionsRef`) : sans cette exclusion, cliquer sur\n  // + pour refermer le popover le fermerait ici (pointerdown, avant le `click` du bouton) puis le\n  // `openComposer` du bouton le rouvrirait aussitôt (toggle lu sur l'état déjà fermé) -- un clic sur\n  // + aurait semblé ne plus rien faire.\n  useEffect(() => {\n    if (!composerOpen) return undefined\n    const onDown = (e) => {\n      const dansPopover = composerRef.current && composerRef.current.contains(e.target)\n      const dansActions = composerActionsRef.current && composerActionsRef.current.contains(e.target)\n      if (!dansPopover && !dansActions) setComposerOpen(false)\n    }\n    window.addEventListener('pointerdown', onDown)\n    return () => window.removeEventListener('pointerdown', onDown)\n  }, [composerOpen])\n\n  if (loading) return <div className={`zrp-shell${t.textPrimary === PALETTE.textPrimaryDark ? '' : ' zrp-light'}`} style={PLAN_CSS_VARIABLES}><div className=\"zrp-loading\">Loading plan…</div></div>\n\n  const dark = t.textPrimary === PALETTE.textPrimaryDark\n  const selectedDayLabel = planDayLabel(selectedIso, today)\n\n  return (\n    <div className={`zrp-shell${dark ? '' : ' zrp-light'}`} style={PLAN_CSS_VARIABLES}>\n      <div className=\"zrp-stage\">\n        <div className=\"zrp-toolbar\">\n          <div className=\"zrp-brand-cluster\">\n            <div className=\"zrp-score-capsule\" aria-label={`Plan score ${score}`}>\n              <span className=\"zrp-score-icon\" style={{ color: UI.yellow }}><AnimatedDollar value={score} /></span>\n              <span className=\"zrp-score-value\"><AnimatedScore value={score} /></span>\n            </div>\n            <div className=\"zrp-brand\">ZenRay Plan</div>\n          </div>\n          <div className=\"zrp-nav\">\n            <button type=\"button\" className=\"zrp-btn zrp-icon\" aria-label=\"Previous day\" onClick={() => stepDay(-1)}><Icon name=\"chevron.left\" size={15} /></button>\n            <div className=\"zrp-date-capsule\" data-direction={dateDirection}>\n              <button type=\"button\" className=\"zrp-today-btn\" onClick={goToday} title={selectedIso === today ? 'Today' : 'Back to Today'} aria-label={selectedIso === today ? 'Today' : 'Back to Today'}>\n              <button type=\"button\" className=\"zrp-today-btn\" onClick={goToday} title={selectedIso === today ? 'Today' : 'Back to Today'} aria-label={selectedIso === today ? 'Today' : 'Back to Today'}>\n                <span key={`day-${selectedIso}`} className=\"zrp-date-motion\">{selectedDayLabel}</span>\n              </button>\n              <span className=\"zrp-selected-date\"><span key={`date-${selectedIso}`} className=\"zrp-date-motion\">{fmtFullDate(selectedIso)}</span></span>\n            </div>\n            <button type=\"button\" className=\"zrp-btn zrp-icon\" aria-label=\"Next day\" onClick={() => stepDay(1)}><Icon name=\"chevron.right\" size={15} /></button>\n          </div>\n          <div className=\"zrp-actions\" ref={composerActionsRef} style={{ position: 'relative' }}>\n            <button type=\"button\" className=\"zrp-btn zrp-primary zrp-new\" title=\"New goal\" aria-label=\"New goal\" onClick={openComposer}><Icon name=\"plus\" size={18} weight={1.9} /></button>\n            <button type=\"button\" className=\"zrp-btn zrp-icon\" title=\"Options\" onClick={() => { setComposerOpen(false); setMenuOpen((v) => !v) }}><Icon name=\"ellipsis\" size={17} /></button>\n            {composerOpen && (() => {\n              // Corps identique que le popover s'ouvre au bouton + (position CSS par défaut, dans le\n              // flux de `.zrp-actions`) ou par clic droit sur une case (portail vers <body>, position\n              // FIXED clampée à l'écran -- un portail évite tout piège d'empilement/`overflow` entre\n              // ici et la case cliquée, ailleurs dans la grille du mois).\n              const corps = (\n                <React.Fragment>\n                <header className=\"zrp-composer-head\"><span>Enter to add</span></header>\n                <label className=\"zrp-field-label\" htmlFor=\"zrp-title-input\">Outcome</label>\n                <input id=\"zrp-title-input\" className=\"zrp-input\" placeholder=\"Plan…\" autoFocus autoComplete=\"off\" value={draft.title}\n                  onChange={(e) => setDraft((d) => ({ ...d, title: e.target.value }))}\n                  onKeyDown={(e) => { if (e.key === 'Enter') submitComposer(); if (e.key === 'Escape') setComposerOpen(false) }} />\n                <div className=\"zrp-schedule-row\">\n                  <div className=\"zrp-field zrp-date-field\" style={{ position: 'relative' }}><span>Date</span>\n                    {/* Widget maison (retour Matthieu 2026-07-20 : \"je ne veux pas taper la date... un\n  