>= PICKER_MAX) break\n    }\n    return out\n  }, [ready, query])\n  return (\n    <div className=\"zrp-image-picker\" onClick={(e) => e.stopPropagation()}>\n      <div className=\"zrp-image-picker-head\">\n        <input autoFocus value={query} placeholder=\"Search site images… or paste (⌘V)\" aria-label=\"Search images\"\n          onChange={(e) => setQuery(e.target.value)}\n          onPaste={async (e) => {\n            const file = [...(e.clipboardData?.items || [])].map((it) => it.kind === 'file' ? it.getAsFile() : null).find((f) => f && f.type.startsWith('image/'))\n            if (!file) return\n            e.preventDefault()\n            const dataUrl = await shrinkImageFile(file)\n            if (dataUrl) onPick(dataUrl)\n          }}\n          onKeyDown={(e) => { if (e.key === 'Escape') onClose() }} />\n        <button type=\"button\" className=\"zrp-detail-icon\" title=\"Close picker\" aria-label=\"Close picker\" onClick={onClose}><Icon name=\"xmark\" size={12} /></button>\n      </div>\n"},{"type":"input_text","text":"---RESULT 3---\nsrc/lib/manifestReadCache.js:15:export async function readPageCached(url) {\nsrc/components/ImageNodeViewer.jsx:172:      const m = await readImgManifestCached(list[i])\nsrc/components/ImageNodeViewer.jsx:304:const _cache = createLruCache({ maxEntries: IMAGE_NODE_CACHE_LIMITS.manifests })\nsrc/components/ImageNodeViewer.jsx:305:// Clear the manifest cache (after a migration: a manifest changed URL/visibility).\nsrc/components/ImageNodeViewer.jsx:316:export async function readImgManifestCached(path) {\nsrc/components/ImageNodeViewer.jsx:325:      m = await readImgManifestCached(r.path)\nsrc/components/ImageNodeViewer.jsx:556:    readImgManifestCached(path).then((mm) => {\nsrc/components/ImageNodeViewer.jsx:706:  const m = await readImgManifestCached(path)\nsrc/components/VideoPlayer2.jsx:152:          if (!sessionStorage.getItem(key)) { sessionStorage.setItem(key, '1'); window.location.reload(); return }\nsrc/components/Vide