 n = new Date(); setDraft((d) => ({ ...d, time: `${pad2(n.getHours())}:${pad2(n.getMinutes())}` })) }}><Icon name=\"clock.arrow.2.circlepath\" size={16} /></button>\n                    {composerPicker === 'start' && (\n                      <div className=\"zrp-field-popover\" onClick={(e) => e.stopPropagation()}>\n                        <MiniTimePicker value={draft.time} onSelect={(time) => setDraft((d) => ({ ...d, time }))} />\n                      </div>\n                    )}\n                  </div>\n                </div>\n                <div className=\"zrp-duration-block\">\n                  <div className=\"zrp-duration-head\"><span>Time block</span><small>4h maximum</small></div>\n                  <div className=\"zrp-duration-presets\" role=\"group\" aria-label=\"Time block duration\">\n                    {DURATION_PRESETS.map(({ minutes, label }) => (\n                      <button key={minutes} type=\"button\" className={`zrp-duration${draft.duration === minutes && !draft.customOpen ? ' zrp-active' : ''}`}\n                        onClick={() => setDraft((d) => ({ ...d, duration: minutes, customOpen: false }))}>{label}</button>\n                    ))}\n                    <button type=\"button\" className={`zrp-duration zrp-custom${draft.customOpen ? ' zrp-active' : ''}`} aria-label=\"Custom duration\"\n                      onClick={() => setDraft((d) => ({ ...d, customOpen: true, duration: d.customMinutes }))}>+</button>\n                  </div>\n                  {draft.customOpen && (\n                    <label className=\"zrp-custom-duration\"><span>Custom</span>\n                      <input type=\"number\" min={5} max={240} step={5} value={draft.customMinutes}\n                        onChange={(e) => { const v = Math.max(5, Math.min(240, Number(e.target.value) || 5)); setDraft((d) => ({ ...d, customMinutes: v, duration: v })) }} /><small>min</small>\n                    </label>\n                  )}\n                </div>\n                {/* UN SEUL BLOC D'OPTIONS, PAS TROIS SECTIONS EMPILÉES (refonte 2026-08-01, demande de\n                    Matthieu). Streak, Publication et First movement sont trois interrupteurs de même\n                    nature : ils qualifient la tâche sans rien exiger d'autre. Leur donner chacun un\n                    titre et une ligne allongeait le popover à chaque ajout, et la quatrième option\n                    aurait rendu le formulaire plus haut que l'écran. Une rangée de ronds les tient\n                    tous, et les réglages propres à l'un n'apparaissent QUE lorsqu'il est actif —\n                    ici la fréquence et la date de fin du streak.\n\n---RESULT 4---\n# Configuration Cloudflare Pages. Le pendant de vercel.json, préparé le 2026-07-30 et NON DÉPLOYÉ :\n# il attend le jour où l'on bascule, et ce jour-là il ne restera qu'à reporter les variables.\n\nname = \"zenray-progress\"\npages_build_output_dir = \"dist\"\n\n# LA DATE COMPTE AUTANT QUE LE DRAPEAU.\n#\n# `nodejs_compat` donne node:fs, node:crypto, node:path et node:url — ce qui permet aux\n# quarante-quatre handlers de `server/` de tourner sans être réécrits.\n#\n# Et surtout, `nodejs_compat_populate_process_env` peuple `process.env` avec les variables et les\n# secrets du Worker. Il est actif PAR DÉFAUT à partir d'une date de compatibilité au 2025-04-01,\n# et c'est lui qui rend inutile le portage des 112 lectures de `process.env` dans le code. Une date\n# antérieure les casserait toutes en silence : elles rendraient une chaîne vide, et l'application\n# se comporterait comme si aucun jeton n'était configuré.\ncompatibility_date = \"2025-06-01\"\ncompatibility_flags = [\"nodejs_compat\"]\n\n# Les 38 variables se posent en secrets dans l'interface, ou par `wrangler pages secret put`.\n# Elles ne sont volontairement PAS listées ici : ce fichier est commité, elles ne doivent pas\n# l'être. La liste vit dans docs/HEBERGEMENT-audit-cloudflare.md, sans les valeurs.\n74b0db9 (HEAD -> main, origin/main, origin/HEAD) Goals: titres d'axes en AnthropicSans Black (900)\ne923174 Goals: renomme l'axe « Game Dev / création » en « Game Dev »\nc495042 Goals: titres en Semibold + dégradé bleu-vert, espacement harmonisé\n1e2e10f Progress: nettoyage doublons DJI (441 photos + 18 vidéos en corbeille)\n82bbbd3 Ajoute la galerie Japan (pages/Japan/japan.json)\nb7a7663 Docs: ajoute ZENRAYGALLERY.md, index feature + vérification code partagé\n3e349a9 Généralise Design en 3 galeries-pointeur (Design/Characters/Environments)\n0dd1451 Log MathieuHuguet.com Cloudflare migration handoff\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ffb9c-f3f4-7253-ab58-6a2b6b9eaec6"}}}
