s.js'\n    23\timport { loadMasterKey } from './lib/img-pipeline.mjs'\n    24\tconst execFileP = promisify(execFile)\n    25\t\n    26\tconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\n    27\tconst PART = 95 * 1024 * 1024            // 95 Mo : marge sûre sous la limite 100 Mo de GitHub/raw.github\n    28\tconst SHARD_CAP = 4.0 * 1024 * 1024 * 1024 // découpage interne d'un LOT en plusieurs repos neufs (compteur LOCAL uniquement, jamais de lecture distante) — marge sûre sous la recommandation 5 Go GitHub\n    29\tconst noop = () => {}\n    30\tconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\n    31\tconst sha256 = (buf) => createHash('sha256').update(buf).digest('hex')\n    32\t// chemin d'adresse de contenu : ab/cd/<hash>.bin (dédup + arbo équilibrée)\n    33\tconst partPathFor = (h) => `${h.slice(0, 2)}/${h.slice(2, 4)}/${h}.bin`\n    34\tconst rawUrl = (repo, sha, p) => `https://raw.githubusercontent.com/${OWNER}/${repo}/${sha}/${p}`\n    35\t// mimeOf : SOURCE UNIQUE partagée avec le viewer (src/lib/fileKinds.js). Garantit que tout futur upload stocke\n    36\t// le MÊME mime que celui attendu par l'aperçu -> aucune divergence possible. Défaut application/octet-stream.\n    37\tconst mimeOf = (f) => mimeForName(path.basename(f))\n    38\t\n    39\t// ── CHIFFREMENT DES PARTS (2026-07-05) ────────────────────────────────────────────────────────────────\n    40\t// AES-256-GCM, IV aléatoire 12o PAR part, MÊME clé maître que le reste de l'app (chunked-media audio/PDF,\n    41\t// images privées — server/media-key.js, src/media/crypto.js) : un seul modèle de sécurité, une seule clé.\n    42\t// Le repo reste PUBLIC (raw.github), mais son contenu est illisible sans la clé -> \"public + chiffré\".\n    43\t// Le nom de la part sur disque est dérivé du hash du CIPHERTEXT (pas du clair) : le clair d'une part est\n    44\t// chiffré avec un IV aléatoire à chaque tentative, donc jamais déterministe -> hash-du-clair ne peut plus\n    45\t// servir d'adresse de contenu stable (une 2e tentative après crash donnerait un ciphertext différent pour\n    46\t// le même chemin, et écraserait un manifest antérieur dont l'IV ne correspondrait plus aux octets réels).\n    47\t// Hash du ciphertext = toujours unique par chiffrement -> jamais de collision, retry après crash sûr.\n    48\t// Coût : perte du dédup inter-vidéos par contenu identique (négligeable, deux vidéos distinctes ne\n    49\t// partagent jamais de chunk 95 Mo aligné identique en pratique). Le POSTER reste EN CLAIR (affiché en\n    50\t// <img src> direct dans le Finder, un décodage async pour une simple miniature serait disproportionné).\n    51\tconst REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')\n    52\tlet _mediaKey = null\n    53\tfunction mediaKey() { if (!_mediaKey) _mediaKey = loadMasterKey(REPO_ROOT, { readFileSync }); return _mediaKey }\n    54\tfunction encryptPart(buf) {\n    55\t  const iv = randomBytes(12)\n    56\t  const c = createCipheriv('aes-256-gcm', mediaKey(), iv)\n    57\t  const cipher = Buffer.concat([c.update(buf), c.final(), c.getAuthTag()])\n    58\t  return { cipher, iv: iv.toString('base64') }\n    59\t}\n    60\t\n    61\tasync function probe(file) {\n    62\t  try {\n    63\t    const { stdout } = await execFileP('ffprobe', ['-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height,codec_name', '-show_entries', 'format=duration', '-of', 'json', file], { timeout: 30000 })\n    64\t    const j = JSON.parse(stdout); const s = (j.streams && j.streams[0]) || {}\n    65\t    return { width: +s.width || 0, height: +s.height || 0, codec: s.codec_name || '', duration: +((j.format && j.format.duration) || 0) || 0 }\n    66\t  } catch { return { width: 0, height: 0, codec: '', duration: 0 } }\n    67\t}\n    68\t// FASTSTART : l'index (atome 'moov') doit être AU DÉBUT pour que la lecture démarre avec la 1re part seulement.\n    69\t// Les fichiers caméra (DJI) mettent 'moov' à la FIN -> sans ça, le lecteur doit aussi chercher la dernière part.\n    70\t// On détecte l'ordre des atomes ; si 'moov' est après 'mdat', on remux `-c copy +faststart` (LOSSLESS, AUCUN\n    71\t// réencodage : flux vidéo/audio copiés octet pour octet, seul l'index est déplacé). Sinon on garde l'original.\n    72\tasync function isFaststart(file) {\n    73\t  const fd = await open(file, 'r'); const b = Buffer.alloc(16)\n    74\t  try {\n    75\t    let off = 0\n    76\t    for (let i = 0; i < 16; i++) {\n    77\t      const { bytesRead } = await fd.read(b, 0, 16, off); if (bytesRead < 8) return true\n    78\t      let size = b.readUInt32BE(0); const type = b.toString('latin1', 4, 8)\n    79\t      if (type === 'moov') return true          // index avant données -> faststart\n    80\t      if (type === 'mdat') return false         // données avant index -> PAS faststart\n    81\t      if (size === 1) size = Number(b.readBigUInt64BE(8)) // taille 64-bit\n    82\t      if (size < 8) return true\n    83\t      off += size\n    84\t    }\n    85\t  } finally { await fd.close() }\n    86\t  return true\n    87\t}\n    88\t// CONTENEUR NON-MP4 (mkv/avi/webm/ts/…) : isFaststart() lit des atomes façon ISO-BMFF (moov/mdat) — sur un\n    89\t// conteneur Matroska/EBML (structure binaire totalement différente), le résultat est indéfini et peut renvoyer\n    90\t// \"déjà faststart\" à tort, laissant passer un .mkv brut qu'AUCUN navigateur ne lit nativement (balise <video>\n    91\t// ne supporte pas Matroska, quel que soit le codec interne). Trouvé en pratique le 2026-07-05 avant un upload\n    92\t// réel de deux épisodes .mkv. Fix : on FORCE le remux vers .mp4 pour toute extension ≠ mp4/mov/m4v, sans même\n    93\t// appeler isFaststart() (le test n'a de sens que pour un conteneur déjà ISO-BMFF).\n    94\tconst MP4_LIKE = new Set(['mp4', 'mov', 'm4v'])\n    95\tasync function remuxFaststart(file, outDir, log, codec = '') {\n    96\t  const ext = path.extname(file).slice(1).toLowerCase()\n    97\t  const forceContainerRemux = !MP4_LIKE.has(ext)\n    98\t  if (!forceContainerRemux && await isFaststart(file)) { log('  (déjà faststart, pas de remux)'); return file }\n    99\t  if (forceContainerRemux) log(`  conteneur .${ext} non lisible nativement par <video> -> remux vers .mp4 (stream copy, aucun réencodage)`)\n   100\t  const out = path.join(outDir, 'faststart.mp4')\n   101\t  // -map v+a (on laisse tomber les pistes data propriétaires DJI, et toute piste sous-titres/audio secondaire,\n   102\t  // qui ne se muxent pas proprement en mp4) — AVERTISSEMENT : si la source a plusieurs pistes audio ou des\n   103\t  // sous-titres embarqués, seule la 1re piste vidéo + 1re piste audio survivent, tout le reste est perdu.\n   104\t  //\n   105\t  // BUG RÉEL iPhone (2026-07-05, Matthieu, iPhone 15 Pro) : sans -tag:v, ffmpeg tague le HEVC remuxé en\n   106\t  // \"hev1\" — valide côté spec MP4 mais REFUSÉ par Apple/AVFoundation (iOS/Safari exigent \"hvc1\", où les\n   107\t  // paramètres du codec sont dans l'entête et pas dans le flux). Résultat : vidéo HEVC illisible sur\n   108\t  // iPhone alors que l'appareil décode le H.265 nativement depuis des années. Reproduit puis vérifié par\n   109\t  // ffprobe sur le remux réel : sans le flag -> hev1, avec -> hvc1. RÈGLE PERMANENTE : tout remux HEVC\n   110\t  // vers MP4 porte -tag:v hvc1. (h264 n'est pas concerné, son tag avc1 par défaut est correct partout.)\n   111\t  const args = ['-y', '-i', file, '-map', '0:v:0', '-map', '0:a:0?', '-c', 'copy']\n   112\t  if (codec === 'hevc') args.push('-tag:v', 'hvc1')\n   113\t  args.push('-movflags', '+faststart', '-f', 'mp4', out)\n   114\t  await execFileP('ffmpeg', args, { timeout: 1800000, maxBuffer: 1 << 26 })\n   115\t  log(`  faststart : index déplacé au début (lossless, -c copy)${codec === 'hevc' ? ' + tag hvc1 (lecture iPhone/Apple)' : ''} -> démarrage dès la 1re part`)\n   116\t  return out\n   117\t}\n   118\t\n   119\t// poster : 1 frame (au milieu si durée connue), JPEG (ce ffmpeg n'a pas d'encodeur webp). Best-effort.\n   120\tasync function makePoster(file, outDir, atSec) {\n   121\t  const p = path.join(outDir, 'poster.jpg')\n   122\t  try { await execFileP('ffmpeg', ['-y', '-ss', String(Math.max(0, atSec || 1)), '-i', file, '-frames:v', '1', '-vf', 'scale=640:-2', '-q:v', '3', p], { timeout: 60000 }); return existsSync(p) ? p : null } catch { return null }\n   123\t}\n   124\t\n   125\t// ── CONTEXTE SHARD VIDÉO BRUTE (clone git persistant, push incrémental, rollover < 4,3 Go) ─────────────\n   126\t// Patron jumeau de makeImgShardCtx mais EN CLAIR (pas de chiffrement : la lecture <video> a besoin des octets\n   127\t// bruts) et pour la famille zenray-vidraw-NN. Le bulk crée UN ctx, le réutilise pour chaque vidéo, flush à la fin.\n   128\t// startShard (1-based) : index du PREMIER shard à ouvrir. >1 -> on saute les shards pleins existants et on\n   129\t// démarre sur un shard NEUF VIDE (création instantanée, ZÉRO clone de 4 Go). base : famille de repos (vidéo\n   130\t// brute par défaut ; réutilisable pour des blobs génériques 'zenray-blob-public').\n   131\t// ── NOUVEAU MODÈLE (2026-07-05, décision explicite de Matthieu) : REPO NEUF PAR LOT, ZÉRO CHECK ─────────\n   132\t// L'ancien modèle (réutiliser/cloner un shard existant + vérifier sa taille auprès de GitHub) est ABANDONNÉ :\n   133\t// il pouvait recloner des Go sur le disque (\"bug infini qui redl des trucs\") et brûlait de la bande passante\n   134\t// en vérifications. Nouveau contrat, définitif :\n   135\t//   1. Chaque LOT d'upload crée un repo GitHub NEUF, nom aléatoire façon workflow : zenrayshards-<type>-<hex12>.\n   136\t//   2. AUCUNE question posée à GitHub (\"reste-t-il de la place ?\") — jamais, ni avant ni pendant. GitHub\n   137\t//      accepte 100k repos, on en a ~300 : vérifier l'espace est contre-productif.\n   138\t//   3. Le découpage en plusieurs repos au sein d'UN lot géant est ANTICIPÉ localement : compteur d'octets\n   139\t//      local, AVANT d'écrire une part qui dépasserait le plafond -> on ouvre un AUTRE repo neuf (nouveau hex).\n   140\t//      Jamais de clone, jamais de pull, jamais de lecture distante.\n   141\t//   4. Visibilité ENCODÉE DANS LE NOM (convention dure, utilisée par le lecteur/le SW/le téléchargement) :\n   142\t//      zenrayshards-img-* = PUBLIC (jsDelivr exige public) ; tout autre type (vid/blob/pdf/doc/...) = PRIVÉ,\n   143\t//      lu via api.github.com (Accept: raw, token) — CORS vérifié OK le 2026-07-05 (authorization autorisé).\n   144\t//   5. Ne JAMAIS recréer un repo avec un ANCIEN nom : les vieux manifestes reposent sur la redirection\n   145\t//      GitHub ancien-nom -> nouveau-nom (vérifiée OK raw.github ET jsDelivr le 2026-07-05) ; recréer l'ancien\n   146\t//      nom tuerait cette redirection.\n   147\tconst SHARD_PREFIX = 'zenrayshards'\n   148\tconst newShardName = (type) => `${SHARD_PREFIX}-${type}-${randomBytes(6).toString('hex')}`\n   149\texport const isPrivateShardName = (repo) => repo.startsWith(SHARD_PREFIX + '-') && !repo.startsWith(SHARD_PREFIX + '-img-')\n   150\t\n   151\texport function makeVidRawShardCtx({ token, owner = OWNER, work, log = console.log, type = 'vid', vis = 'private' }) {\n   152\t  const GENV = { ...process.env, GIT_TERMINAL_PROMPT: '0' }\n   153\t  const cloneUrl = (repo) => `https://x-access-token:${token}@github.com/${owner}/${repo}.git`\n   154\t  const git = (dir, a, timeout = 600000) => spawnSync('git', ['-C', dir, ...a], { encoding: 'utf8', env: GENV, timeout, killSignal: 'SIGKILL' })\n   155\t  const ctx = { type, vis, repo: null, dir: null, bytes: 0, pendingBytes: 0, commitOf: {} }\n   156\t\n   157\t  async function openShard() {\n   158\t    ctx.repo = newShardName(ctx.type)\n   159\t    ctx.dir = path.join(work, ctx.repo)\n   160\t    await rm(ctx.dir, { recursive: true, force: true })\n   161\t    await mkdir(ctx.dir, { recursive: true })\n   162\t    git(ctx.dir, ['init', '-q']); git(ctx.dir, ['branch', '-M', 'main'])\n   163\t    await writeFile(path.join(ctx.dir, 'README.md'), `# zenrayshards (${ctx.type}, ${ctx.vis})\\n\\nParts de 95 Mo, chiffrees AES-256-GCM, nommees par empreinte. Manifeste sur zenray-data.\\n`)\n   164\t    // création API directe (nom aléatoire -> collision quasi impossible, pas de pré-check d'existence)\n   165\t    const cr = spawnSync('curl', ['-s', '-o', '/dev/null', '-w', '%{http_code}', '-X', 'POST', '-H', `Authorization: Bearer ${token}`, 'https://api.github.com/user/repos', '-d', JSON.stringify({ name: ctx.repo, private: ctx.vis === 'private' })], { encoding: 'utf8' })\n   166\t    if ((cr.stdout || '').trim() !== '201') throw new Error(`création repo ${ctx.repo}: HTTP ${(cr.stdout || '?')}`)\n   167\t    git(ctx.dir, ['config', 'user.email', 'bot@zenray']); git(ctx.dir, ['config', 'user.name', 'zenray-bot'])\n   168\t    git(ctx.dir, ['config', 'http.version', 'HTTP/1.1']); git(ctx.dir, ['config', 'http.postBuffer', '524288000'])\n   169\t    git(ctx.dir, ['add', '-A']); git(ctx.dir, ['commit', '-q', '-m', 'init'])\n   170\t    git(ctx.dir, ['remote', 'add', 'origin', cloneUrl(ctx.repo)])\n   171\t    const ps = git(ctx.dir, ['push', '-q', 'origin', 'HEAD:main'], 120000)\n   172\t    if (ps.status !== 0) throw new Error('push-init shard: ' + (ps.stderr || '').slice(-200))\n   173\t    log(`  >>> repo neuf ${ctx.repo} (${ctx.vis}) créé — zéro clone, zéro check`)\n   174\t    ctx.bytes = 0; ctx.pendingBytes = 0\n   175\t  }\n   176\t\n   177\t  async function pushShard() {\n   178\t    const st = git(ctx.dir, ['status', '--porcelain'])\n   179\t    if (!st.stdout || !st.stdout.trim()) return true\n   180\t    git(ctx.dir, ['add', '-A']); git(ctx.dir, ['commit', '-q', '-m', '+vidraw'])\n   181\t    for (let a = 0; a < 12; a++) {\n   182\t      const ps = git(ctx.dir, ['push', '-q', 'origin', 'HEAD:main'], 1800000)\n   183\t      if (ps.status === 0) { ctx.pendingBytes = 0; return true }\n   184\t      log(`  vidraw push retry ${a + 1}/12 ${(ps.stderr || '').slice(-120)}`)\n   185\t      git(ctx.dir, ['pull', '--rebase', '-q', 'origin', 'main'], 600000)\n   186\t      await sleep(Math.min(60000, 3000 * (a + 1)))\n   187\t    }\n   188\t    return false\n   189\t  }\n   190\t\n   191\t  // Écrit une part (déjà hachée) dans le clone. Rollover AVANT écriture si le shard atteint le cap. Push\n   192\t  // incrémental tous les ~900 Mo (anti-RAM, anti-packfile géant). Renvoie le repo où elle a atterri.\n   193\t  //\n   194\t  // SEUIL 900 Mo (2026-07-11, relevé depuis 400 Mo, demande Matthieu de pousser plus gros pour aller plus\n   195\t  // vite). ATTENTION AU PLAFOND RÉEL : img-pipeline.mjs documente un incident DÉJÀ VÉCU — un push unique de\n   196\t  // plusieurs Go HANG (git reste à 0% CPU, aucun timeout ne le rattrape avant l'échéance de 30 min ci-dessous)\n   197\t  // -> règle éprouvée « rester sous 1 Go/commit ». Matthieu proposait 1900 Mo en pensant une limite GitHub à\n   198\t  // 2000 Mo : cette limite n'existe nulle part dans ce projet ni dans la doc GitHub — le seul plafond RÉEL et\n   199\t  // TESTÉ ici est <1 Go. 900 Mo reste sous cette marge de sécurité tout en coupant le nombre de push d'un gros\n   200\t  // lot vidéo de plus de moitié vs 400 Mo (ex. 53 Go/900 Mo ≈ 60 push contre 133 à 400 Mo). AUCUN effet sur la\n   201\t  // visibilité média-par-média : le manifeste vidéo n'est de toute façon committé qu'UNE fois par vidéo (flush\n   202\t  // final ci-dessous), ce seuil ne pilote QUE les push intermédiaires PENDANT l'écriture d'UNE SEULE vidéo.\n   203\t  async function writePart(hashedPath, buf) {\n   204\t    // Découpage ANTICIPÉ (avant le push de la part, jamais de question à GitHub) : si cette part ferait\n   205\t    // dépasser le plafond au repo courant, on pousse ce qui est en attente et on ouvre un AUTRE repo neuf.\n   206\t    if (ctx.bytes > 0 && ctx.bytes + buf.length > SHARD_CAP) { if (!await pushShard()) throw new Error('push-incr vidraw'); ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim(); await openShard() }\n   207\t    const dst = path.join(ctx.dir, hashedPath)\n   208\t    await mkdir(path.dirname(dst), { recursive: true })\n   209\t    await writeFile(dst, buf)\n   210\t    ctx.bytes += buf.length; ctx.pendingBytes += buf.length\n   211\t    if (ctx.pendingBytes >= 900 * 1024 * 1024) { if (!await pushShard()) throw new Error('push-incr vidraw') }\n   212\t    return ctx.repo\n   213\t  }\n   214\t\n   215\t  async function flush() {\n   216\t    if (ctx.dir && existsSync(ctx.dir)) {\n   217\t      if (!await pushShard()) throw new Error('push-final vidraw ' + ctx.repo)\n   218\t      ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim()\n   219\t      log(`  ✓ ${ctx.repo} poussé (commit ${(ctx.commitOf[ctx.repo] || '').slice(0, 7)})`)\n   220\t    }\n   221\t  }\n   222\t  // commit SHA courant du shard (pour pinner raw.github tout de suite après le flush d'UNE vidéo)\n   223\t  function headSha() { return ctx.dir ? git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim() : null }\n   224\t\n   225\t  ctx.openShard = openShard; ctx.writePart = writePart; ctx.pushShard = pushShard; ctx.flush = flush; ctx.headSha = headSha\n   226\t  return ctx\n   227\t}\n   228\t\n   229\t// ── INGESTION D'UNE VIDÉO BRUTE ───────────────────────────────────────────────────────────────────────\n   230\t// Découpe le fichier ORIGINAL en parts de 95 Mo (lecture streamée, anti-OOM), les pousse via le ctx shard,\n   231\t// pousse le poster, et renvoie le manifeste .media.json (type 'video-raw') prêt à committer sur zenray-data.\n   232\t// CONFIRMÉ EN LIGNE = ce manifeste committé (le bulk le fait), pas avant. URLs raw.github pinnées sur le commit.\n   233\texport async function ingestVideoRaw(file, { dest, base, vctx, posterCtx = null, workDir = '/tmp/zr_vidraw', log = noop }) {\n   234\t  const p = await probe(file)\n   235\t  const outDir = path.join(workDir, base.replace(/[^\\w.-]/g, '_'