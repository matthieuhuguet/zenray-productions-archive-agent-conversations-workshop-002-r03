  9\tconst youtubeNoCookieUrl = (value) => {\n    10\t  try {\n    11\t    const url = new URL(String(value || ''))\n    12\t    return url.protocol === 'https:' && url.hostname === 'www.youtube-nocookie.com' && /^\\/embed\\/[\\w-]{6,20}$/.test(url.pathname) ? url.toString() : null\n    13\t  } catch { return null }\n    14\t}\n    15\t\n    16\texport default function EmbedBlock({ block, theme }) {\n    17\t  const p = (block && block.props) || {}\n    18\t  const [playing, setPlaying] = useState(false)\n    19\t  const dark = theme === 'dark'\n    20\t  const border = dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)'\n    21\t  const thumb = safeImg(p.thumbnail) || (p.provider === 'youtube' && /^[\\w-]{6,20}$/.test(p.providerId || '') ? `https://i.ytimg.com/vi/${p.providerId}/hqdefault.jpg` : null)\n    22\t  const heading = p.title || 'Vidéo'\n    23\t  const embedUrl = youtubeNoCookieUrl(p.embedUrl)\n    24\t\n    25\t  // editor-10 — robustesse : un bloc zenrayEmbed sans embedUrl (donnée corrompue / ancienne version)\n    26\t  // ne doit PAS disparaître (return null le rendait invisible ET non sélectionnable -> impossible à\n    27\t  // supprimer pour l'utilisateur, bloc fantôme). On rend un petit placeholder cliquable/sélectionnable.\n    28\t  if (!embedUrl) {\n    29\t    return (\n    30\t      <div contentEditable={false} style={{ fontFamily: SANS, margin: '8px 0', maxWidth: 720, border: `1px dashed ${border}`, borderRadius: RADII.lg, padding: '10px 14px', color: PALETTE.gray600, fontSize: 13 }}>\n    31\t        Embed invalide{p.url ? <> · <a href={p.url} target=\"_blank\" rel=\"noreferrer\" style={{ color: PALETTE.primary, textDecoration: 'none' }}>{p.url}</a></> : null}\n    32\t      </div>\n    33\t    )\n    34\t  }\n    35\t  return (\n    36\t    <div style={{ fontFamily: SANS, margin: '8px 0', maxWidth: 720 }} contentEditable={false}>\n    37\t      <div style={{ background: dark ? '#1a1a1a' : '#FDFDFC', border: `1px solid ${border}`, borderRadius: RADII.lg, overflow: 'hidden' }}>\n    38\t        <div style={{ position: 'relative', width: '100%', aspectRatio: '16 / 9', background: '#000' }}>\n    39\t          {playing ? (\n    40\t            <iframe\n    41\t              src={embedUrl}\n    42\t              title={heading}\n    43\t              loading=\"lazy\"\n    44\t              allow=\"accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n    45\t              referrerPolicy=\"strict-origin-when-cross-origin\"\n    46\t              sandbox=\"allow-scripts allow-presentation allow-popups\"\n    47\t              style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', border: 'none' }}\n    48\t            />\n    49\t          ) : (\n    50\t            <button onClick={() => setPlaying(true)} aria-label=\"Lire la vidéo\"\n    51\t              style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', border: 'none', cursor: 'pointer', padding: 0, background: thumb ? `center/cover no-repeat url(\"${thumb}\")` : '#000' }}>\n    52\t              <span style={{ position: 'absolute', top: '50%', left: '50%', transform: 'translate(-50%,-50%)', width: 64, height: 64, borderRadius: 99, background: 'rgba(0,0,0,0.55)', display: 'grid', placeItems: 'center' }}>\n    53\t                <span style={{ borderStyle: 'solid', borderWidth: '12px 0 12px 20px', borderColor: 'transparent transparent transparent #fff', marginLeft: 4 }} />\n    54\t              </span>\n    55\t            </button>\n    56\t          )}\n    57\t        </div>\n    58\t        <div style={{ padding: '10px 14px' }}>\n    59\t          <div style={{ fontSize: 14, fontWeight: 600, color: dark ? '#ECECEA' : '#1F1F1E' }}>{heading}</div>\n    60\t          <div style={{ fontSize: 12, color: PALETTE.gray600, marginTop: 3 }}>\n    61\t            {p.provider || 'youtube'} · <a href={p.url} target=\"_blank\" rel=\"noreferrer\" style={{ color: PALETTE.primary, textDecoration: 'none' }}>ouvrir la source</a>\n    62\t          </div>\n    63\t        </div>\n    64\t      </div>\n    65\t    </div>\n    66\t  )\n    67\t}\n"},{"type":"input_text","text":"---RESULT 3---\n     1\t// Rendu Markdown SÛR — un seul point d'entrée pour tout l'app.\n     2\t//\n     3\t// EN CLAIR POUR TOUS : l'app affiche des aperçus de pages écrites en Markdown (un texte simple où\n     4\t// \"**gras**\" devient gras, etc.). Ces aperçus sont injectés dans la page via innerHTML. Problème :\n     5\t// la bibliothèque marked, depuis sa version 5, laisse passer TEL QUEL le HTML brut écrit dans le\n     6\t// Markdown. Donc un fichier piégé contenant <script>…</script> ou <img onerror=…> verrait son code\n     7\t// s'exécuter dans l'app (faille XSS). Ici tout le contenu vit sur le drive privé GitHub de Matthieu,\n     8\t// donc la surface est limitée, mais rendre du HTML brut d'origine arbitraire reste une vraie faille.\n     9\t//\n    10\t// CE QUE FAIT CE MODULE : il configure marked avec un rendu qui ÉCHAPPE le HTML brut (les balises\n    11\t// deviennent du texte visible \"&lt;script&gt;\" au lieu d'être exécutées), tout en gardant intact le\n    12\t// Markdown normal (gras, titres, listes, liens, images Markdown). Aucune dépendance ajoutée (pas de\n    13\t// DOMPurify) : on neutralise à la source, dans marked lui-même.\n    14\t//\n    15\t// USAGE : importer `safeMarkedParse` et l'utiliser partout où on faisait `marked.parse(...)` avant\n    16\t// d'injecter via dangerouslySetInnerHTML. Centralisé pour qu'il n'existe qu'UNE seule vérité.\n    17\timport { Marked } from 'marked'\n    18\t\n    19\tconst escapeHtml = (s) =>\n    20\t  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n    21\t\n    22\tconst escapeAttribute = (s) =>\n    23\t  escapeHtml(s).replace(/\"/g, '&quot;').replace(/'/g, '&#39;')\n    24\t\n    25\t// Liste blanche positive : les URL web/mail explicites et les chemins internes.\n    26\t// On décode aussi les formes percent/entity qui pourraient cacher « javascript: »\n    27\t// avant que le navigateur ne réinterprète la valeur de l'attribut HTML.\n    28\tfunction safeMarkdownUrl(raw, { image = false } = {}) {\n    29\t  if (typeof raw !== 'string') return null\n    30\t  const value = raw.trim()\n    31\t  if (!value || /[\\u0000-\\u0020\\u007f-\\u009f]/.test(value)) return null\n    32\t  let probe = value.replace(/&#(?:x([0-9a-f]+)|(\\d+));?/gi, (_, hex, dec) => {\n    33\t    const code = Number.parseInt(hex || dec, hex ? 16 : 10)\n    34\t    return Number.isFinite(code) && code >= 0 && code <= 0x10ffff ? String.fromCodePoint(code) : ''\n    35\t  }).replace(/&colon;/gi, ':')\n    36\t  for (let i = 0; i < 2 && probe.includes('%'); i += 1) {\n    37\t    try {\n    38\t      const decoded = decodeURIComponent(probe)\n    39\t      if (decoded === probe) break\n    40\t      probe = decoded\n    41\t    } catch {\n    42\t      return null\n    43\t    }\n    44\t  }\n    45\t  if (/[\\u0000-\\u001f\\u007f-\\u009f]/.test(probe)) return null\n    46\t\n    47\t  const scheme = probe.match(/^([a-z][a-z0-9+.-]*):/i)\n    48\t  if (scheme) {\n    49\t    const allowed = image ? new Set(['http', 'https']) : new Set(['http', 'https', 'mailto'])\n    50\t    if (!allowed.has(scheme[1].toLowerCase())) return null\n    51\t  }\n    52\t  return value\n    53\t}\n    54\t\n    55\t// Instance dédiée (n'altère pas un éventuel marked global) configurée pour neutraliser le HTML brut.\n    56\t// Le renderer `html` reçoit soit un token { raw/text }, soit (anciennes signatures) une chaîne :\n    57\t// on échappe la source brute dans les deux cas -> le HTML s'affiche en texte littéral, jamais exécuté.\n    58\tconst safeMarked = new Marked({ async: false, gfm: true, breaks: false })\n    59\tsafeMarked.use({\n    60\t  renderer: {\n    61\t    html(token) {\n    62\t      const raw = typeof token === 'string' ? token : (token && (token.raw || token.text)) || ''\n    63\t      return escapeHtml(raw)\n    64\t    },\n    65\t    link(token) {\n    66\t      const text = this.parser.parseInline(token.tokens || [])\n    67\t      const href = safeMarkdownUrl(token.href)\n    68\t      if (!href) return text\n    69\t      const title = token.title ? ` title=\"${escapeAttribute(token.title)}\"` : ''\n    70\t      return `<a href=\"${escapeAttribute(href)}\"${title}>${text}</a>`\n    71\t    },\n    72\t    image(token) {\n    73\t      const src = safeMarkdownUrl(token.href, { image: true })\n    74\t      if (!src) return escapeHtml(token.text || '')\n    75\t      const title = token.title ? ` title=\"${escapeAttribute(token.title)}\"` : ''\n    76\t      return `<img src=\"${escapeAttribute(src)}\" alt=\"${escapeAttribute(token.text || '')}\"${title}>`\n    77\t    },\n    78\t  },\n    79\t})\n    80\t\n    81\texport function safeMarkedParse(md) {\n    82\t  try {\n    83\t    return safeMarked.parse(typeof md === 'string' ? md : '')\n    84\t  } catch {\n    85\t    // Dernier filet : en cas d'erreur de parsing, on renvoie le texte échappé (jamais d'injection).\n    86\t    return escapeHtml(md || '')\n    87\t  }\n    88\t}\n"},{"type":"input_text","text":"---RESULT 4---\ndiff --git a/src/components/EmbedNodeViewer.jsx b/src/components/EmbedNodeViewer.jsx\nindex fc0a75c..d1afffe 100644\n--- a/src/components/EmbedNodeViewer.jsx\n+++ b/src/components/EmbedNodeViewer.jsx\n@@ -9,63 +9,70 @@ import { PALETTE, RADII } from '../theme.js'\n // on lit le manifest (provider/id/url canonique), on montre une CARTE inactive (vignette + titre), et l'iframe\n // YouTube no-cookie sandboxée ne se monte qu'au clic « Lire » (plan §4.4, §10 sécurité embeds).\n \n const SANS = \"'AnthropicSans', sans-serif\"\n \n export default function EmbedNodeViewer({ t, path, title }) {\n   const tt = t || { textSecondary: PALETTE.gray600, bg: '#FDFDFC', border: 'rgba(0,0,0,0.1)', textPrimary: '#1d1d1f' }\n   const [data, setData] = useState(null)\n   c