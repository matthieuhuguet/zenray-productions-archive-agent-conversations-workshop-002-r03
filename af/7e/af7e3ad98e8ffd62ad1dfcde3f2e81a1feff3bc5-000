/api/media-key). CORS d'api.github.com vérifié OK\n    78\t// avec le header Authorization le 2026-07-05.\n    79\tlet _tokenPromise = null\n    80\tfunction rawToken() {\n    81\t  if (!_tokenPromise) {\n    82\t    _tokenPromise = (async () => {\n    83\t      const r = await fetch(authQ('/api/raw-token'), { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n    84\t      const t = (r && r.token) || null\n    85\t      if (!t) _tokenPromise = null // pas de cache d'échec (401 avant saisie du code -> retente après)\n    86\t      return t\n    87\t    })()\n    88\t  }\n    89\t  return _tokenPromise\n    90\t}\n    91\t// raw.githubusercontent.com/<owner>/<repo>/<sha>/<path> -> https://api.github.com/repos/<owner>/<repo>/contents/<path>?ref=<sha>\n    92\tfunction rawToApiUrl(rawUrl) {\n    93\t  const m = /^https:\\/\\/raw\\.githubusercontent\\.com\\/([^/]+)\\/([^/]+)\\/([^/]+)\\/(.+)$/.exec(rawUrl)\n    94\t  if (!m) return null\n    95\t  return `https://api.github.com/repos/${m[1]}/${m[2]}/contents/${m[4]}?ref=${m[3]}`\n    96\t}\n    97\tconst isPrivateFamilyUrl = (u) => /raw\\.githubusercontent\\.com\\/[^/]+\\/zenrayshards-(?!img-)/.test(u)\n    98\t\n    99\t// Récupère une part ENTIÈRE (raw.github ne garantit pas le Range), déchiffre si `p.iv` présent, avec cache LRU.\n   100\t// video.private (manifeste) OU nom de famille privé dans l'URL -> chemin authentifié d'office ; sinon fetch\n   101\t// public avec REPLI authentifié sur 401/403/404 (couvre un repo public basculé privé après coup).\n   102\tasync function getPart(p, priv) {\n   103\t  const url = p.url\n   104\t  if (PARTCACHE.has(url)) { const b = PARTCACHE.get(url); PARTCACHE.delete(url); PARTCACHE.set(url, b); return b } // LRU touch\n   105\t  let r\n   106\t  if (priv || isPrivateFamilyUrl(url)) {\n   107\t    const t = await rawToken()\n   108\t    const api = rawToApiUrl(url)\n   109\t    if (!t || !api) throw new Error('part privée: token/url indisponible')\n   110\t    r = await