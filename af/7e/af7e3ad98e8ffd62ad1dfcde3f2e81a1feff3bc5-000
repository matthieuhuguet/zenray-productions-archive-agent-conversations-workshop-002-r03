   314\t\n   315\t      // Mise à jour INCRÉMENTALE de l'index de recherche après un ajout de nœud (drop / Ctrl-V).\n   316\t      // Sans ça, l'index complet (pages/.zr-search-index.json) ne se reconstruisait qu'à la main\n   317\t      // via scripts/build-search-index.mjs : les fichiers fraîchement déposés restaient introuvables\n   318\t      // par la recherche jusqu'au prochain rebuild. Ici on AJOUTE seulement les chemins manquants\n   319\t      // (jamais de suppression), via la Git Data API (blob + tree base_tree + commit + ref force:false),\n   320\t      // exactement comme l'importeur, donc aucun risque d'effacer les autres nœuds. Best-effort,\n   321\t      // déclenché en arrière-plan par universalCapture : un échec ne bloque jamais l'upload.\n   322\t      // AUTO-INDEXATION UNIVERSELLE (drop/Ctrl-V, archive clonée, push Claude, vidéo HLS...) : tout nouveau nœud\n   323\t      // est appendé au DELTA public chiffré -> cherchable immédiatement, sans réécrire le gros index, sans quota.\n   324\t      if (action === 'index-add') {\n   325\t        const add = (Array.isArray(body.paths) ? body.paths : [])\n   326\t          .filter((p) => typeof p === 'string' && p && !p.includes('..') && !p.endsWith('.zr-search-index.json'))\n   327\t        if (!add.length) return res.status(200).json({ ok: true, added: 0 })\n   328\t        const newThumbs = await thumbsForPaths(token, add)\n   329\t        const ok = await appendPublicDelta(token, add, newThumbs)\n   330\t        const g = globalThis; if (g.__zrIndex) g.__zrIndex = null\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f671b-d4fe-76d0-a6f4-1f8b5364967c"}}}
