tart')\n    29\t  if (t) {\n    30\t    if (/^\\d+$/.test(t)) start = Number(t)\n    31\t    else { const mm = t.match(/(\\d+)m/); const ss = t.match(/(\\d+)s/); start = (mm ? Number(mm[1]) * 60 : 0) + (ss ? Number(ss[1]) : 0) }\n    32\t  }\n    33\t  return { provider: 'youtube', providerId: id, start }\n    34\t}\n    35\t\n    36\t// Reconnaît une URL embeddable (V1 : YouTube uniquement). Renvoie un objet provider ou null.\n    37\texport function parseEmbedUrl(url) {\n    38\t  return parseYouTube(url)\n    39\t}\n    40\t\n    41\t// Fabrique l'objet .embed.json conforme au schéma (plan §4.4). Aucun HTML.\n    42\texport function makeEmbed({ provider, providerId, url, start = 0, title = '' }) {\n    43\t  const t = nowIso()\n    44\t  const canonicalUrl = provider === 'youtube' ? `https://www.youtube-nocookie.com/embed/${providerId}` : url\n    45\t  return {\n    46\t    schema: EMBED_SCHEMA,\n    47\t    id: newId('embed'),\n    48\t    provider,\n    49\t    url,\n    50\t    canonicalUrl,\n    51\t    providerId,\n    52\t    title: title || (provider === 'youtube' ? 'Vidéo YouTube' : 'Embed'),\n    53\t    thumbnailRef: null,\n    54\t    start: start || 0,\n    55\t    createdAt: t,\n    56\t    updatedAt: t,\n    57\t    embedPolicy: {\n    58\t      lazy: true,\n    59\t      sandbox: true,\n    60\t      allow: 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',\n    61\t    },\n    62\t  }\n    63\t}\n    64\t\n    65\t// URL d'iframe lazy (avec start). Sandbox/no-cookie appliqués côté composant.\n    66\texport function embedIframeUrl(embed) {\n    67\t  if (!embed || embed.provider !== 'youtube') return embed && embed.canonicalUrl\n    68\t  const base = `https://www.youtube-nocookie.com/embed/${embed.providerId}`\n    69\t  return embed.start ? `${base}?start=${embed.start}` : base\n    70\t}\n    71\t\n    72\t// Crée un nœud .embed.json dans le dossier Embeds/ d'un projet Ref puis renvoie son chemin (ou n