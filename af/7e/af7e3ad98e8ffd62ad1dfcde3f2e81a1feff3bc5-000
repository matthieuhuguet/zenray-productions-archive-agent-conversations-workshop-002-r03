27\t  if (kind === 'image') return path.endsWith('.img.json')\n    28\t  return kind === 'folder' && path !== 'pages' && !/\\.(?:media|img)\\.json$/i.test(path)\n    29\t}\n    30\t\n    31\texport const inferShareKind = (path) => path.endsWith('.media.json') ? 'video' : path.endsWith('.img.json') ? 'image' : 'folder'\n    32\t\n    33\texport function decodeLegacyShare(token) {\n    34\t  try {\n    35\t    const value = Buffer.from(String(token || '').replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8')\n    36\t    return isShareTarget(inferShareKind(value), value) ? value : ''\n    37\t  } catch { return '' }\n    38\t}\n    39\t\n    40\texport function createSignedShareToken(secret = secretFromEnv(), entropy = randomBytes(24)) {\n    41\t  if (!secret) throw new Error('missing-share-secret')\n    42\t  const id = b64url(entropy)\n    43\t  return `${PREFIX}.${id}.${signatureFor(secret, id)}`\n    44\t}\n    45\t\n    46\texport function verifySignedShareToken(token, secret = secretFromEnv()) {\n    47\t  if (!secret) return false\n    48\t  const parts = String(token || '').split('.')\n    49\t  if (parts.length !== 3 || parts[0] !== PREFIX || !/^[A-Za-z0-9_-]{24,64}$/.test(parts[1]) || !/^[A-Za-z0-9_-]{40,64}$/.test(parts[2])) return false\n    50\t  const expected = signatureFor(secret, parts[1])\n    51\t  const actual = parts[2]\n    52\t  if (actual.length !== expected.length) return false\n    53\t  try { return timingSafeEqual(Buffer.from(actual), Buffer.from(expected)) } catch { return false }\n    54\t}\n    55\t\n    56\texport const shareRecordPath = (token) => {\n    57\t  const hash = sha256(token)\n    58\t  return `_shares/v1/${hash.slice(0, 2)}/${hash}.json`\n    59\t}\n    60\t\n    61\tasync function githubReadRecord(token, githubToken = process.env.GITHUB_TOKEN, fetchImpl = fetch) {\n    62\t  if (!githubToken) return null\n    63\t  const cached = recordCache.get(token)\n    64\t  if (cached && cached.until > Date.now()) return