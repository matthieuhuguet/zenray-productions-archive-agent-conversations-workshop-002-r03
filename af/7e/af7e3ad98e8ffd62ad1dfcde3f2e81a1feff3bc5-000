{"timestamp":"2026-07-15T18:48:25.113Z","ordinal":115,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_gDEYCw8x8XgQXrWNtyySdXsu","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"   229\t// ── INGESTION D'UNE VIDÉO BRUTE ───────────────────────────────────────────────────────────────────────\n   230\t// Découpe le fichier ORIGINAL en parts de 95 Mo (lecture streamée, anti-OOM), les pousse via le ctx shard,\n   231\t// pousse le poster, et renvoie le manifeste .media.json (type 'video-raw') prêt à committer sur zenray-data.\n   232\t// CONFIRMÉ EN LIGNE = ce manifeste committé (le bulk le fait), pas avant. URLs raw.github pinnées sur le commit.\n   233\texport async function ingestVideoRaw(file, { dest, base, vctx, posterCtx = null, workDir = '/tmp/zr_vidraw', log = noop }) {\n   234\t  const p = await probe(file)\n   235\t  const outDir = path.join(workDir, base.replace(/[^\\w.-]/g, '_') + '-' + Date.now().toString(36))\n   236\t  await mkdir(outDir, { recursive: true })\n   237\t\n   238\t  // 0) FASTSTART : index au début -> la lecture démarre avec la 1re part. Lossless (-c copy), pas d'encodage.\n   239\t  //    On découpe ENSUITE ce fichier (et plus l'original) pour que la part 1 contienne l'index.\n   240\t  //    p.codec transmis pour le tag hvc1 obligatoire quand la source est HEVC (lecture iPhone).\n   241\t  const srcFile = await remuxFaststart(file, outDir, log, p.codec)\n   242\t  const total = (await stat(srcFile)).size\n   243\t  const nParts = Math.ceil(total / PART)\n   244\t  log(`${base} — ${(total / 1073741824).toFixed(2)} Go, ${p.width}x${p.height} ${p.codec}, ${nParts} parts de 95 Mo (AUCUN réencodage)`)\n   245\t\n   246\t  // 1) poster (1 frame, best-effort) depuis l'original\n   247\t  const posterFile = await makePoster(file, outDir, p.duration ? p.duration / 2 : 1)\n   248\t\n   249\t  // 2) split streamé du fichier (faststart) + push part par part (jamais le fichier entier en RAM)\n   250\t  const parts = []           // { idx, repo, path, hash, size, iv }\n   251\t  const fd = await open(srcFile, 'r')\n   252\t  const b = Buffer.alloc(PART)\n   253\t  try {\n   254\t    let off = 0, idx = 0\n   255\t    while (off < total) {\n   256\t      const { bytesRead } = await fd.read(b, 0, PART, off)\n   257\t      if (!bytesRead) break\n   258\t      const slice = Buffer.from(b.subarray(0, bytesRead)) // copie : writePart est async, on réutilise b\n   259\t      const { cipher, iv } = encryptPart(slice) // AES-256-GCM, IV aléatoire par part (voir plus haut)\n   260\t      const h = sha256(cipher); const hp = partPathFor(h) // adressé par hash du CIPHERTEXT (jamais du clair)\n   261\t      const repo = await vctx.writePart(hp, cipher)\n   262\t      parts.push({ idx, repo, path: hp, hash: h, size: bytesRead, iv })\n   263\t      off += bytesRead; idx++\n   264\t      if (idx % 5 === 0 || off >= total) log(`  part ${idx}/${nParts} (${(off / 1073741824).toFixed(2)}/${(total / 1073741824).toFixed(2)} Go)`)\n   265\t    }\n   266\t  } finally { await fd.close() }\n   267\t\n   268\t  // poster en part raw (simple, toujours dispo) — petit, va dans le shard courant\n   269\t  let posterPart = null\n   270\t  if (posterFile) {\n   271\t    try {\n   272\t      const pb = await readFile(posterFile)\n   273\t      const h = sha256(pb); const hp = `${h.slice(0, 2)}/${h.slice(2, 4)}/${h}.jpg`\n   274\t      const repo = await vctx.writePart(hp, pb)\n   275\t      posterPart = { repo, path: hp }\n   276\t    } catch (e) { log(`  ⚠ poster: ${(e.message || e).toString().slice(0, 80)}`) }\n   277\t  }\n   278\t\n   279\t  // 3) flush du shard -> commit SHA connu -> URLs raw.github pinnées\n   280\t  await vctx.flush()\n   281\t  const shaOf = (repo) => vctx.commitOf[repo] || vctx.headSha()\n   282\t  const isPriv = vctx.vis === 'private'\n   283\t  const partUrls = parts.map((pt) => rawUrl(pt.repo, shaOf(pt.repo), pt.path))\n   284\t  // POSTER sur repo PRIVÉ : un <img src> ne peut pas porter de header d'authentification -> l'URL stockée\n   285\t  // dans le manifeste passe par /api/raw-proxy (le serveur, qui a le token, va chercher l'image et la sert\n   286\t  // même-origine). Petit fichier (~50 Ko), zéro impact bande passante notable. Repo public : URL raw directe.\n   287\t  const posterRaw = posterPart ? rawUrl(posterPart.repo, shaOf(posterPart.repo), posterPart.path) : null\n   288\t  const posterUrl = posterRaw ? (isPriv ? `/api/raw-proxy?u=${encodeURIComponent(posterRaw)}` : posterRaw) : null\n   289\t\n   290\t  // 4) manifeste .media.json (type 'video-raw'). offsets cumulés (EN CLAIR) -> le Service Worker mappe un\n   291\t  // Range -> part(s), déchiffre chaque part avec son iv, PUIS applique ces offsets sur le clair obtenu.\n   292\t  // private:true -> le lecteur (SW) et le téléchargement convertissent chaque URL raw en appel\n   293\t  // api.github.com (Accept: raw + token via /api/raw-token) — le repo est invisible/illisible publiquement.\n   294\t  let acc = 0\n   295\t  const partsMeta = parts.map((pt) => { const start = acc; acc += pt.size; return { url: partUrls[pt.idx], start, end: acc - 1, size: pt.size, iv: pt.iv } })\n   296\t  const manifest = {\n   297\t    // Si remuxFaststart() a produit un nouveau conteneur, les octets servis sont du MP4 même si\n   298\t    // le nom logique reste celui de la source (.mkv/.avi/…). Annoncer le MIME original ferait\n   299\t    // refuser au navigateur un fichier pourtant correctement remuxé.\n   300\t    type: 'video-raw', v: 1, name: path.basename(file), mime: srcFile === file ? mimeOf(file) : 'video/mp4',\n   301\t    size: total, codec: p.codec, width: p.width, height: p.height, duration: p.duration,\n   302\t    parts: partsMeta, poster: posterUrl,\n   303\t    enc: true, alg: 'AES-GCM', // chaque part est chiffrée (iv par part ci-dessus) ; poster = clair (voir plus haut)\n   304\t    ...(isPriv ? { private: true } : {}),\n   305\t  }\n   306\t  const manifestPath = `${dest}/${base}.${path.basename(file).split('.').pop().toLowerCase()}.media.json`\n   307\t  await rm(outDir, { recursive: true, force: true }).catch(() => {})\n   308\t  return { manifestPath, manifest, posterUrl }\n   309\t}\n   310\t\n   311\t// ── INGESTION D'UN FICHIER QUELCONQUE (blob brut) ──────────────────────────────────────────────────────\n   312\t// Pour les fichiers NON ouvrables directement sur le site (wav, py, cube, zip, …) : on découpe le fichier\n   313\t// ORIGINAL en parts de 95 Mo (aucune transformation), on les pousse via le ctx shard, et on renvoie un\n   314\t// manifeste .file.json (type 'blob-raw'). Le téléchargement recolle les parts dans l'ordre = fichier BIT À BIT\n   315\t// identique (offsets cumulés + tailles + empreinte par part). Aucune perte. URLs raw.github pinnées sur commit.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f671b-d4fe-76d0-a6f4-1f8b5364967c"}}}
