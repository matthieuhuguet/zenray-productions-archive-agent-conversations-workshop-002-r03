olves.toBe(true)\n    61\t    await expect(authorizeShareAccess(token, 'pages/Photos/Elsewhere/a.jpg.img.json')).resolves.toBe(false)\n    62\t  })\n    63\t\n    64\t  it('persists issue records under a hash-only path through the API', async () => {\n    65\t    vi.stubEnv('ZENRAY_SHARE_SECRET', SECRET)\n    66\t    vi.stubEnv('GITHUB_TOKEN', 'github-test-token')\n    67\t    const fetchMock = vi.fn().mockResolvedValue({ ok: true, status: 201, json: async () => ({ content: { sha: 'commit' } }) })\n    68\t    vi.stubGlobal('fetch', fetchMock)\n    69\t    const res = response()\n    70\t    await shareTokenHandler({ method: 'POST', body: { action: 'issue', kind: 'video', path: 'pages/Videos/demo.mp4.media.json', expiresInSeconds: 600 }, query: {} }, res)\n    71\t\n    72\t    expect(res.statusCode).toBe(201)\n    73\t    expect(verifySignedShareToken(res.body.token, SECRET)).toBe(true)\n    74\t    const [url, init] = fetchMock.mock.calls[0]\n    75\t    expect(url).toContain(shareRecordPath(res.body.token))\n    76\t    expect(url).not.toContain('demo')\n    77\t    const stored = JSON.parse(Buffer.from(JSON.parse(init.body).content, 'base64').toString('utf8'))\n    78\t    expect(stored).toMatchObject({ kind: 'video', path: 'pages/Videos/demo.mp4.media.json', revokedAt: null })\n    79\t    expect(stored.tokenHash).toBe(hash(res.body.token))\n    80\t\n    81\t    const revokeRes = response()\n    82\t    await shareTokenHandler({ method: 'POST', body: { action: 'revoke', token: res.body.token }, query: {} }, revokeRes)\n    83\t    expect(revokeRes.statusCode).toBe(200)\n    84\t    const revoked = JSON.parse(Buffer.from(JSON.parse(fetchMock.mock.calls[1][1].body).content, 'base64').toString('utf8'))\n    85\t    expect(revoked.revokedAt).toMatch(/^\\d{4}-\\d{2}-\\d{2}T/)\n    86\t  })\n    87\t})\n     1\timport { afterEach, describe, expect, it, vi } from 'vitest'\n     2\timport {\n     3\t  appendShareCredential,\n     4\t  createShareLink,\n     5\t  decodeLegacyShare,\n     6\t  encodeLegacyShare,\n     7\t  resolveShareToken,\n     8\t  SHARE_KIND,\n     9\t} from './shareLinks.js'\n    10\t\n    11\tafterEach(() => vi.restoreAllMocks())\n    12\t\n    13\tdescribe('shareLinks client contract', () => {\n    14\t  it('round-trips old UTF-8 links without a network request', async () => {\n    15\t    const path = 'pages/Photos/29 Juin 2026/Été.jpg.img.json'\n    16\t    const token = encodeLegacyShare(path)\n    17\t    expect(decodeLegacyShare(token)).toBe(path)\n    18\t    const fetchMock = vi.spyOn(globalThis, 'fetch')\n    19\t    await expect(resolveShareToken(token, SHARE_KIND.image)).resolves.toMatchObject({ path, legacy: true })\n    20\t    expect(fetchMock).not.toHaveBeenCalled()\n    21\t  })\n    22\t\n    23\t  it('resolves opaque tokens through the public endpoint', async () => {\n    24\t    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({\n    25\t      ok: true, status: 200,\n    26\t      json: async () => ({ path: 'pages/Videos/demo.mp4.media.json', kind: 'video', expiresAt: '2026-08-01T00:00:00.000Z' }),\n    27\t    })\n    28\t    await expect(resolveShareToken('zrs1.id.signature', SHARE_KIND.video)).resolves.toMatchObject({ path: 'pages/Videos/demo.mp4.media.json' })\n    29\t    expect(fetchMock.mock.calls[0][0]).toContain('/api/share-token?')\n    30\t  })\n    31\t\n    32\t  it('creates new URLs only from a server-issued opaque token', async () => {\n    33\t    vi.spyOn(globalThis, 'fetch').mockResolvedValue({\n    34\t      ok: true, status: 201,\n    35\t      json: async () => ({ token: 'zrs1.id.signature', expiresAt: '2026-08-01T00:00:00.000Z' }),\n    36\t    })\n    37\t    const result = await createShareLink(SHARE_KIND.folder, 'pages/Photos/Trip')\n    38\t    expect(result.url).toBe('http://localhost:3000/folder?d=zrs1.id.signature')\n    39\t    expect(result.url).not.toContain('Photos')\n    40\t  })\n    41\t\n    42\t  it('adds the credential without dropping existing query parameters', () => {\n    43\t    expect(appendShareCredential('/api/page?action=read', 'abc')).toBe('/api/page?action=read&share=abc')\n    44\t  })\n    45\t})\n    30\timport treeHandler from '../server/tree.js'\n    31\timport videoCommentHandler from '../server/video-comment.js'\n    32\timport sharedMediaHandler from '../server/shared-media.js'\n    33\timport shareOgHandler from '../server/share-og.js'\n    34\timport shareTokenHandler, { authorizeShareAccess } from '../server/share-token.js'\n    35\timport { timingSafeEqual } from 'node:crypto'\n    36\t\n    37\t// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\n    38\t// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\n    39\t// Vercel : la clé maître (media-key), les écritures (page/upload-*/publish/state) et la gestion de repos sont\n    40\t// fermées par défaut. EXEMPTÉS : les endpoints servis comme src DOM (<img>/<video>/hls.js) qui NE PEUVENT PAS\n    41\t// porter de header custom — leur contenu est chiffré sur CDN public ou derrière la protection de déploiement.\n    42\t// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\n    43\tconst API_SECRET = process.env.ZENRAY_API_SECRET || ''\n    44\t// raw-proxy est EXEMPTÉ du gate (servi comme src DOM <img>, ne peut pas porter x-zr-auth) : il ne sert que\n    45\t// des binaires pinnés par commit du compte owner (posters), pas de secret. raw-token, lui, RESTE gated\n    46\t// (même surface que media-key : servi au client authentifié uniquement quand le gate est actif).\n    47\tconst PUBLIC_ROUTES = new Set(['img', 'stream', 'media', 'shard', 'hls', 'hls-key', 'hls-download-info', 'hls-cli', 'hls-download-script', 'shared-media', 'share-og', 'raw-proxy'])\n    48\tasync function authOk(req, name) {\n    49\t  if (!API_SECRET) return true\n    50\t  if (PUBLIC_ROUTES.has(name)) return true\n    51\t  // La résolution d'un jeton de partage est publique. Son émission et sa révocation restent protégées par\n    52\t  // x-zr-auth, comme toutes les écritures de l'app.\n    53\t  if (name === 'share-token' && (req.method || 'GET').toUpperCase() === 'GET') return true\n    54\t  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n    55\t  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n    56\t  if (name === 'video-comment') return true\n    57\t  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n    58\t  if (typeof h === 'string' && h.length === API_SECRET.length) {\n    59\t    try { if (timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET))) return true } catch {}\n    60\t  }\n    61\t\n    62\t  // PARTAGE PUBLIC : une lecture page/tree anonyme doit désormais prouver qu'un partage a réellement été émis.\n    63\t  // Les anciens liens base64 restent acceptés uniquement quand leur cible correspond exactement au path demandé.\n    64\t  const method = (req.method || 'GET').toUpperCase()\n    65\t  if (name === 'page' && method === 'GET') {\n    66\t    const q = req.query || {}\n    67\t    const action = (q.action || '').toString()\n    68\t    const path = (q.path || '').toString()\n    69\t    const dir = (q.dir || '').toString()\n    70\t    const requested = action === 'read' && /\\.(media|img)\\.json$/.test(path) ? path\n    71\t      : action === 'tree' && dir.startsWith('pages/') && dir !== 'pages' ? dir\n    72\t        : ''\n    73\t    if (requested) return authorizeShareAccess((q.share || '').toString(), requested)\n    74\t  }\n    75\t  return false\n    76\t}\n    77\t\n    78\tconst routes = {\n    79\t  page: pageHandler,\n    80\t  img: imgHandler,\n    81\t  media: mediaHandler,\n    82\t  stream: streamHandler,\n    83\t  shard: shardHandler,\n    84\t  repos: reposHandler,\n    85\t  'upload-shard': uploadShardHandler,\n    86\t  publish: publishHandler,\n    87\t  state: stateHandler,\n    88\t  unfurl: unfurlHandler,\n    89\t  upload: uploadHandler,\n    90\t  hls: hlsHandler,\n    91\t  'hls-key': hlsKeyHandler,\n    92\t  'hls-download-info': hlsDownloadInfoHandler,\n    93\t  'hls-cli': hlsCliHandler,\n    94\t  'hls-download-script': hlsDownloadScriptHandler,\n    95\t  'upload-cmd': uploadCmdHandler,\n    96\t  'upload-vid': uploadVidHandler,\n    97\t  cmdlog: cmdlogHandler,\n    98\t  'media-key': mediaKeyHandler,\n    99\t  'raw-token': rawTokenHandler, // token de LECTURE des repos privés zenrayshards-* (SW vidéo + download) — gated comme media-key\n   100\t  'raw-proxy': rawProxyHandler, // <img> des posters privés (une balise img ne peut pas porter de header) — servi comme src DOM\n   101\t  'shelf-img': shelfImgHandler,   // télécharge une image et la stocke en repo public (jsDelivr)\n   102\t  'shelf-search': shelfSearchHandler, // recherche de posters via API média (RAWG/TMDB/AniList)\n   103\t  doc: docHandler,                // lecture live read-only d'un .md (repo Memory/.claude) — Documents\n   104\t  tree: treeHandler,              // liste les .md d'un repo perso — mode « parcourir tout »\n   105\t  'video-comment': videoCommentHandler, // commentaires publics sous une vidéo (lecteur + page /watch)\n   106\t  'shared-media': sharedMediaHandler,   // déchiffre côté serveur une image publique+chiffrée -> octets clairs (fix partage image + source OG)\n   107\t  'share-og': shareOgHandler,           // sert dist/index.html avec les balises Open Graph du média partagé (WhatsApp/Notion/iMessage)\n   108\t  'share-token': shareTokenHandler,     // émet/résout/révoque les jetons opaques de partage v1\n   109\t}\n   110\t\n   111\t// Vercel n'applique `export const config` que sur le fichier de fonction réellement déployé\n   112\t// (= ce routeur). media.js et upload-shard.js déclaraient un bodyParser à 8mb ; on relève donc\n   113\t// la limite ici à 8mb pour TOUT le routeur, sinon les uploads chunkés (parts 3 Mo) seraient\n   114\t// rejetés en 413. ATTENTION : la plateforme impose malgré tout un plafond effectif proche de 4,5 Mo ;\n   115\t// universalCapture conserve donc des parts de 3 Mo. Ne jamais relever CHUNK_SIZE en se fiant au « 8mb ».\n   116\t// Les autres routes ne sont pas impactées par une limite déclarative plus haute.\n   117\texport const config = { api: { bodyParser: { sizeLimit: '8mb' } } }\n   118\t\n   119\texport default async function handler(req, res) {\n   120\t  // Le segment dynamique est nommé `route` (fichier [...route].js) et NON `path`, pour ne PAS écraser\n   121\t  // le paramètre de requête ?path= utilisé par les handlers (img/shard/hls/stream/page read).\n   122\t  // Vercel expose le segment catch-all sous la clé \"...route\" (avec les 3 points), PAS \"route\".\n   123\t  // local-server.mjs, lui, injecte req.query.route. On lit donc les deux pour marcher des deux côtés.\n   124\t  let parts = req.query.route ?? req.query['...route']\n   125\t  if (typeof parts === 'string') parts = parts.split('/')\n   126\t  const name = Array.isArray(parts) ? parts[0] : parts\n   127\t  const target = name && routes[name]\n   128\t  if (!target) return res.status(404).json({ error: 'not-found', route: name || null })\n   129\t  if (!(await authOk(req, name))) return res.status(401).json({ error: 'unauthorized' })\n   130\t  return target(req, res)\n   131\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f671b-d4fe-76d0-a6f4-1f8b5364967c"}}}
