{"timestamp":"2026-07-15T18:48:25.113Z","ordinal":218,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_VnWwSVBWOpSlMzoTZ6Q9JV5m","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"    35\timport { timingSafeEqual } from 'node:crypto'\n    36\t\n    37\t// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\n    38\t// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\n    39\t// Vercel : la clé maître (media-key), les écritures (page/upload-*/publish/state) et la gestion de repos sont\n    40\t// fermées par défaut. EXEMPTÉS : les endpoints servis comme src DOM (<img>/<video>/hls.js) qui NE PEUVENT PAS\n    41\t// porter de header custom — leur contenu est chiffré sur CDN public ou derrière la protection de déploiement.\n    42\t// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\n    43\tconst API_SECRET = process.env.ZENRAY_API_SECRET || ''\n    44\t// raw-proxy est EXEMPTÉ du gate (servi comme src DOM <img>, ne peut pas porter x-zr-auth) : il ne sert que\n    45\t// des binaires pinnés par commit du compte owner (posters), pas de secret. raw-token, lui, RESTE gated\n    46\t// (même surface que media-key : servi au client authentifié uniquement quand le gate est actif).\n    47\tconst PUBLIC_ROUTES = new Set(['img', 'stream', 'media', 'shard', 'hls', 'hls-key', 'hls-download-info', 'hls-cli', 'hls-download-script', 'shared-media', 'share-og', 'raw-proxy'])\n    48\tasync function authOk(req, name) {\n    49\t  if (!API_SECRET) return true\n    50\t  if (PUBLIC_ROUTES.has(name)) return true\n    51\t  // La résolution d'un jeton de partage est publique. Son émission et sa révocation restent protégées par\n    52\t  // x-zr-auth, comme toutes les écritures de l'app.\n    53\t  if (name === 'share-token' && (req.method || 'GET').toUpperCase() === 'GET') return true\n    54\t  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n    55\t  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n    56\t  if (name === 'video-comment') return true\n    57\t  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n    58\t  if (typeof h === 'string' && h.length === API_SECRET.length) {\n    59\t    try { if (timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET))) return true } catch {}\n    60\t  }\n    61\t\n    62\t  // PARTAGE PUBLIC : une lecture page/tree anonyme doit désormais prouver qu'un partage a réellement été émis.\n    63\t  // Les anciens liens base64 restent acceptés uniquement quand leur cible correspond exactement au path demandé.\n    64\t  const method = (req.method || 'GET').toUpperCase()\n    65\t  if (name === 'page' && method === 'GET') {\n    66\t    const q = req.query || {}\n    67\t    const action = (q.action || '').toString()\n    68\t    const path = (q.path || '').toString()\n    69\t    const dir = (q.dir || '').toString()\n    70\t    const requested = action === 'read' && /\\.(media|img)\\.json$/.test(path) ? path\n    71\t      : action === 'tree' && dir.startsWith('pages/') && dir !== 'pages' ? dir\n    72\t        : ''\n    73\t    if (requested) return authorizeShareAccess((q.share || '').toString(), requested)\n    74\t  }\n    75\t  return false\n    76\t}\n    77\t\n    78\tconst routes = {\n    79\t  page: pageHandler,\n    80\t  img: imgHandler,\n    81\t  media: mediaHandler,\n    82\t  stream: streamHandler,\n    83\t  shard: shardHandler,\n    84\t  repos: reposHandler,\n    85\t  'upload-shard': uploadShardHandler,\n    86\t  publish: publishHandler,\n    87\t  state: stateHandler,\n    88\t  unfurl: unfurlHandler,\n    89\t  upload: uploadHandler,\n    90\t  hls: hlsHandler,\n    91\t  'hls-key': hlsKeyHandler,\n    92\t  'hls-download-info': hlsDownloadInfoHandler,\n    93\t  'hls-cli': hlsCliHandler,\n    94\t  'hls-download-script': hlsDownloadScriptHandler,\n    95\t  'upload-cmd': uploadCmdHandler,\n     1\t// GET /api/hls-cli?token=<signed>[&p=<playlist.m3u8 sous le dossier Videos de la vidéo>]\n     2\t//\n     3\t// EN CLAIR (pour tout le monde) :\n     4\t//   ffmpeg/VLC lancés en ligne de commande n'ont pas le \"contexte navigateur\" : pas d'en-tête Origin,\n     5\t//   pas de résolution d'URL relative comme une page web. Cet endpoint leur sert une version \"CLI\" des\n     6\t//   playlists HLS : toutes les adresses internes sont RÉÉCRITES en URLs absolues, et l'adresse de la clé\n     7\t//   de déchiffrement reçoit le token (laissez-passer) pour que /api/hls-key l'accepte hors navigateur.\n     8\t//\n     9\t//   Pourquoi pas /api/hls directement : les playlists se référencent entre elles en chemins relatifs au\n    10\t//   site, et la clé serait bloquée par le gate Origin. On contrôle aussi l'expiration via le token.\n    11\t//\n    12\t//   Le serveur ne télécharge AUCUN segment et ne reconstruit JAMAIS la vidéo : il ne fait que servir du\n    13\t//   texte (les .m3u8) en réécrivant des URLs. ffmpeg, sur la machine de l'utilisateur, fait tout le reste.\n    14\timport { verifyToken } from './hls-token.js'\n    15\timport { siteBase } from './hls-download-info.js'\n    16\t\n    17\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    18\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    19\t\n    20\t// dossier Videos de la vidéo, déduit de la fiche .media.json (pages/Foo/bar.media.json -> on lit son master).\n    21\tfunction videosDirFromMaster(master) {\n    22\t  // master = \"pages/Videos/<base>/master.m3u8\" -> base name = avant-dernier segment.\n    23\t  const m = /^pages\\/(.+)\\/master\\.m3u8$/.exec(master || '')\n    24\t  return m ? { dir: `pages/${m[1]}`, base: m[1].split('/').pop() } : null\n    25\t}\n    26\t\n    27\tasync function readText(token, path) {\n    28\t  const r = await fetch(`https://api.github.com/repos/${REPO}/contents/${encodeURI(path)}?ref=${BRANCH}`, {\n    29\t    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.raw', 'User-Agent': 'zenray-progress' },\n    30\t  })\n    31\t  if (!r.ok) return null\n    32\t  return await r.text()\n    33\t}\n    34\t\n    35\texport default async function handler(req, res) {\n    36\t  const ghToken = process.env.GITHUB_TOKEN\n    37\t  if (!ghToken) return res.status(500).end()\n    38\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n    39\t\n    40\t  // 1) valider le token : il porte le chemin de la fiche .media.json et sa date d'expiration.\n    41\t  const tok = (req.query.token || '').toString()\n    42\t  const v = verifyToken(tok)\n    43\t  if (!v.ok) return res.status(v.reason === 'expired' ? 410 : 403).end() // 410 = expiré (message clair côté script)\n    44\t  const mediaPath = v.path\n    45\t  if (!mediaPath.startsWith('pages/') || !mediaPath.endsWith('.media.json') || mediaPath.includes('..')) return res.status(403).end()\n    46\t\n    47\t  // 2) lire la fiche -> retrouver le master HLS (pages/Videos/<base>/master.m3u8).\n    48\t  let manifest\n    49\t  try { const t = await readText(ghToken, mediaPath); if (!t) return res.status(404).end(); manifest = JSON.parse(t) } catch { return res.status(502).end() }\n    50\t  if (!manifest || manifest.type !== 'hls' || !manifest.master) return res.status(400).end()\n    51\t  const info = videosDirFromMaster(manifest.master)\n    52\t  if (!info) return res.status(400).end()\n    53\t\n    54\t  // 3) quelle playlist sert-on ? master par défaut, sinon ?p=<nom.m3u8> borné au dossier de CETTE vidéo.\n    55\t  let playlistPath = manifest.master\n    56\t  const p = (req.query.p || '').toString()\n    57\t  if (p) {\n    58\t    // p = nom de fichier .m3u8 simple (pas de dossier, pas de '..') -> on le résout DANS le dossier de la vidéo.\n    59\t    if (p.includes('/') || p.includes('..') || !p.endsWith('.m3u8')) return res.status(400).end()\n    60\t    playlistPath = `${info.dir}/${p}`\n    61\t  }\n    62\t\n    63\t  const text = await readText(ghToken, playlistPath)\n    64\t  if (text == null) return res.status(404).end()\n    65\t\n    66\t  const base = siteBase(req)\n    67\t  const encTok = encodeURIComponent(tok)\n    68\t  // RÉÉCRITURE des URI internes :\n    69\t  //   - \"/api/hls?path=pages/Videos/<base>/<x>.m3u8\"  -> \"<base>/api/hls-cli?token=...&p=<x>.m3u8\"\n    70\t  //     (sous-playlists : on reste dans hls-cli pour propager le token et garder tout absolu)\n    71\t  //   - \"/api/hls-key?v=<base>\"                        -> \"<base>/api/hls-key?v=<base>&token=...\" (clé gated + token)\n    72\t  //   - les segments pointent déjà jsDelivr (URLs absolues publiques) -> on n'y touche pas.\n    73\t  const out = text.replace(/URI=\"([^\"]*)\"/g, (full, uri) => {\n    74\t    const u = rewriteUri(uri, base, encTok, info.dir)\n    75\t    return u ? `URI=\"${u}\"` : full\n    76\t  }).split('\\n').map((line) => {\n    77\t    // lignes \"nues\" (non-tag) = références directes à des playlists/segments. Réécrire les /api/hls?path=.\n    78\t    if (line.startsWith('#') || !line.trim()) return line\n    79\t    if (line.startsWith('/api/hls?path=')) { const u = rewriteHlsPath(line.trim(), base, encTok, info.dir); return u || line }\n    80\t    return line\n    81\t  }).join('\\n')\n    82\t\n    83\t  res.setHeader('Content-Type', 'application/vnd.apple.mpegurl')\n    84\t  res.setHeader('Cache-Control', 'no-store')\n    85\t  res.setHeader('Content-Disposition', 'inline; filename=\"playlist.m3u8\"')\n    86\t  return res.status(200).send(out)\n    87\t}\n    88\t\n    89\t// Réécrit une seule URI interne (clé, sous-playlist EXT-X-MEDIA, EXT-X-MAP). Renvoie null si on ne touche pas.\n    90\tfunction rewriteUri(uri, base, encTok, dir) {\n    91\t  if (uri.startsWith('/api/hls-key')) {\n    92\t    // garder ?v=... existant, ajouter le token\n    93\t    const sep = uri.includes('?') ? '&' : '?'\n    94\t    return `${base}${uri}${sep}token=${encTok}`\n    95\t  }\n    96\t  if (uri.startsWith('/api/hls?path=')) return rewriteHlsPath(uri, base, encTok, dir)\n    97\t  return null\n    98\t}\n    99\t\n   100\t// \"/api/hls?path=pages/Videos/<base>/<x>.m3u8\" -> \"<base>/api/hls-cli?token=...&p=<x>.m3u8\" si dans le dossier.\n   101\tfunction rewriteHlsPath(uri, base, encTok, dir) {\n   102\t  const m = /^\\/api\\/hls\\?path=(.+)$/.exec(uri)\n   103\t  if (!m) return null\n   104\t  let pathParam\n   105\t  try { pathParam = decodeURIComponent(m[1]) } catch { pathParam = m[1] }\n   106\t  if (!pathParam.startsWith(dir + '/') || !pathParam.endsWith('.m3u8')) return null\n   107\t  const name = pathParam.slice(dir.length + 1)\n   108\t  if (name.includes('/')) return null\n   109\t  return `${base}/api/hls-cli?token=${encTok}&p=${encodeURIComponent(name)}`\n   110\t}\n     1\t// Token de download HLS — signature HMAC partagée par hls-download-info / hls-cli / hls-key.\n     2\t//\n     3\t// EN CLAIR (pour tout le monde) :\n     4\t//   ffmpeg lancé en ligne de commande sur l'ordi de l'utilisateur n'envoie PAS l'en-tête Origin/Referer\n     5\t//   qu'un navigateur enverrait. Le gate anti-hotlinking de /api/hls-key ne peut donc pas le laisser passer.\n     6\t//   On lui donne à la place un « laissez-passer » signé à durée limitée : un token. Le serveur l'a fabriqué\n     7\t//   (signé avec un secret que lui seul connaît), donc il peut vérifier qu'il est authentique et pas expiré.\n     8\t//   Tant que le token est valide, ffmpeg peut récupérer le master, les sous-playlists et la clé AES.\n     9\t//\n    10\t// FORMAT du token : base64url(`${path}\\n${exp}`) + '.' + base64url(HMAC-SHA256(secret, `${path}\\n${exp}`)).\n    11\t//   - path = chemin du .media.json (lie le token à UNE vidéo précise, pas un passe-partout)\n    12\t//   - exp  = timestamp d'expiration en millisecondes (Date.now() + TTL)\n    13\t// On signe path+exp ensemble : impossible de prolonger l'expiration ou de viser une autre vidéo sans le secret.\n    14\timport crypto from 'node:crypto'\n    15\t\n    16\t// TTL par défaut 60 min (plan §12). Option longue 3 h pour les vidéos longues, plafonnée à 3 h.\n    17\texport const DEFAULT_TTL_MS = 60 * 60 * 1000\n    18\texport const MAX_TTL_MS = 3 * 60 * 60 * 1000\n    19\t\n    20\t// Secret de signature. Var dédiée HLS_DL_SECRET de préférence ; à défaut on dérive du GITHUB_TOKEN\n    21\t// (présent côté serveur) pour ne jamais tomber sur un secret vide. JAMAIS exposé au client.\n    22\tfunction secret() {\n    23\t  const dedicated = process.env.HLS_DL_SECRET\n    24\t  if (dedicated && dedicated.length >= 8) return dedicated\n    25\t  const gh = process.env.GITHUB_TOKEN || ''\n    26\t  // dérivation : on ne réutilise pas le token brut comme clé, on le hash avec un sel fixe.\n    27\t  return crypto.createHash('sha256').update('zenray-hls-dl|' + gh).digest('hex')\n    28\t}\n    29\t\n    30\tconst b64url = (buf) => Buffer.from(buf).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '')\n    31\tconst fromB64url = (s) => Buffer.from(s.replace(/-/g, '+').replace(/_/g, '/'), 'base64')\n    32\t\n    33\t// Signe un token pour ce path, expirant dans ttlMs (borné à MAX_TTL_MS).\n    34\texport function signToken(mediaPath, ttlMs = DEFAULT_TTL_MS) {\n    35\t  const ttl = Math.min(Math.max(60 * 1000, Number(ttlMs) || DEFAULT_TTL_MS), MAX_TTL_MS)\n    36\t  const exp = Date.now() + ttl\n    37\t  const payload = `${mediaPath}\\n${exp}`\n    38\t  const sig = crypto.createHmac('sha256', secret()).update(payload).digest()\n    39\t  return { token: `${b64url(payload)}.${b64url(sig)}`, exp }\n    40\t}\n    41\t\n    42\t// Vérifie un token. Renvoie { ok, path, exp } ou { ok:false, reason }. Comparaison constante (timingSafeEqual).\n    43\texport function verifyToken(token) {\n    44\t  if (!token || typeof token !== 'string' || !token.includes('.')) return { ok: false, reason: 'malformed' }\n    45\t  const [payloadB64, sigB64] = token.split('.', 2)\n    46\t  let payload\n    47\t  try { payload = fromB64url(payloadB64).toString('utf8') } catch { return { ok: false, reason: 'malformed' } }\n    48\t  const expected = crypto.createHmac('sha256', secret()).update(payload).digest()\n    49\t  let got\n    50\t  try { got = fromB64url(sigB64) } catch { return { ok: false, reason: 'malformed' } }\n    51\t  if (got.length !== expected.length || !crypto.timingSafeEqual(got, expected)) return { ok: false, reason: 'bad-signature' }\n    52\t  const nl = payload.lastIndexOf('\\n')\n    53\t  if (nl < 0) return { ok: false, reason: 'malformed' }\n    54\t  const path = payload.slice(0, nl)\n    55\t  const exp = Number(payload.slice(nl + 1))\n    56\t  if (!Number.isFinite(exp)) return { ok: false, reason: 'malformed' }\n    57\t  if (Date.now() > exp) return { ok: false, reason: 'expired' }\n    58\t  return { ok: true, path, exp }\n    59\t}\n     1\t// /api/video-comment — commentaires publics sous une vidéo (lecteur normal ET page de partage /watch).\n     2\t// Même patron que page.js (Git Data API, pas de base de données) : chaque commentaire est APPENDÉ à un\n     3\t// fichier JSON dédié `pages/_comments/<hash du chemin vidéo>.json` (array de {name, text, at}) dans le\n     4\t// repo content (zenray-data). Un visiteur d'un lien /watch peut commenter SANS mot de passe : cette route\n     5\t// est déclarée PUBLIQUE dans api/[...route].js (comme img/stream/hls), donc jamais gatée par x-zr-auth.\n     6\timport { createHash } from 'node:crypto'\n     7\timport { instrument } from './cmdlog.js'\n     8\t\n     9\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    10\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    11\t\n    12\tconst ghRaw = (token, path, init = {}) =>\n    13\t  fetch(`https://api.github.com/repos/${REPO}/${path}`, {\n    14\t    ...init,\n    15\t    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) },\n    16\t  })\n    17\tconst gh = instrument(ghRaw, { repoOf: () => REPO, pathOf: (args) => args[1], initOf: (args) => args[2] || {} })\n    18\tconst b64e = (s) => Buffer.from(s, 'utf8').toString('base64')\n    19\tconst b64d = (s) => Buffer.from(s, 'base64').toString('utf8')\n    20\t\n    21\t// hash court et stable du chemin vidéo -> nom de fichier commentaires (pas de caractères spéciaux/longueur imprévisible).\n    22\tconst hashPath = (p) => createHash('sha256').update(String(p)).digest('hex').slice(0, 24)\n    23\tconst fileFor = (videoPath) => `pages/_comments/${hashPath(videoPath)}.json`\n    24\t\n    25\texport default async function handler(req, res) {\n    26\t  const token = process.env.GITHUB_TOKEN\n    27\t  if (!token) return res.status(200).json({ error: 'no-token' })\n    28\t  res.setHeader('Cache-Control', 'no-store')\n    29\t\n    30\t  try {\n    31\t    if (req.method === 'GET') {\n    32\t      const videoPath = (req.query.videoPath || '').toString()\n    33\t      if (!videoPath) return res.status(400).json({ error: 'bad-path' })\n    34\t      const file = fileFor(videoPath)\n    35\t      // Lecture RAW (hors quota REST) : liste de commentaires, lecture pure, pas de sha nécessaire.\n    36\t      const rr = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(file)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    37\t      if (rr.status === 404) return res.status(200).json({ comments: [] })\n    38\t      if (!rr.ok) return res.status(200).json({ comments: [], error: 'github' })\n    39\t      try { const arr = JSON.parse(await rr.text()); return res.status(200).json({ comments: Array.isArray(arr) ? arr : [] }) }\n    40\t      catch { return res.status(200).json({ comments: [] }) }\n    41\t    }\n    42\t\n    43\t    if (req.method === 'POST') {\n    44\t      let body = req.body\n    45\t      if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n    46\t      const videoPath = (body.videoPath || '').toString()\n    47\t      const name = (body.name || '').toString().trim().slice(0, 60)\n    48\t      const text = (body.text || '').toString().trim().slice(0, 1000)\n    49\t      if (!videoPath || !name || !text) return res.status(400).json({ error: 'bad-input' })\n    50\t      const file = fileFor(videoPath)\n    51\t      const entry = { name, text, at: new Date().toISOString() }\n    52\t\n    53\t      // Read-modify-write avec retry sur conflit (409/422), comme saveJsonWithRetry côté client pour `page`.\n    54\t      for (let i = 0; i < 3; i++) {\n    55\t        let cur = []; let sha = null\n    56\t        const r = await gh(token, `contents/${encodeURI(file)}?ref=${BRANCH}`)\n    57\t        if (r.ok) { const j = await r.json(); sha = j.sha; try { cur = JSON.parse(b64d(j.content)) } catch { cur = [] } }\n    58\t        else if (r.status !== 404) return res.status(200).json({ error: 'github' })\n    59\t        const next = [...(Array.isArray(cur) ? cur : []), entry].slice(-500) // borne raisonnable\n    60\t        const payload = { message: 'video comment', content: b64e(JSON.stringify(next, null, 2)), branch: BRANCH }\n    61\t        if (sha) payload.sha = sha\n    62\t        const w = await gh(token, `contents/${encodeURI(file)}`, { method: 'PUT', body: JSON.stringify(payload) })\n    63\t        if (w.ok) return res.status(200).json({ ok: true, comment: entry })\n    64\t        if (w.status === 409 || w.status === 422) continue // HEAD a bougé -> on relit et rejoue\n    65\t        return res.status(200).json({ error: 'github' })\n    66\t      }\n    67\t      return res.status(200).json({ error: 'conflict' })\n    68\t    }\n    69\t\n    70\t    res.setHeader('Allow', 'GET, POST')\n    71\t    return res.status(405).end()\n    72\t  } catch (e) {\n    73\t    return res.status(200).json({ error: 'fetch', detail: String((e && e.message) || e).slice(0, 160) })\n    74\t  }\n    75\t}\n     1\t#!/usr/bin/env node\n     2\t// zenray-uploader.mjs — WORKER AUTONOME d'upload vidéo (tourne en fond sur le Mac, lancé au login).\n     3\t//\n     4\t// EN UNE PHRASE : tu déposes une vidéo dans un dossier surveillé (par défaut ~/Downloads), et ce worker\n     5\t// la remuxe en MP4 faststart sans perte puis la pousse, chiffrée, sur ZenRayShards.\n     6\t// Le navigateur ne peut PAS connaître le chemin disque d'un fichier glissé (sécurité) ; ce petit programme\n     7\t// local, lui, voit les fichiers -> c'est le pont qui manque pour automatiser l'upload.\n     8\t//\n     9\t// LANCEMENT : GITHUB_TOKEN=$(gh auth token) node scripts/zenray-uploader.mjs \\\n    10\t//               [--watch ~/Downloads] [--dest pages/Videos] [--api http://localhost:3100] [--interval 4] [--crf 21]\n    11\t//\n    12\t// COMPORTEMENT : poll du dossier toutes les `interval` s. Pour chaque NOUVELLE vidéo stable (taille qui ne\n    13\t// bouge plus = copie/téléchargement terminé) : remux lossless + push privé + manifeste video-raw.\n    14\t// Le fichier SOURCE n'est JAMAIS supprimé. Idempotent : une VERSION déjà traitée n'est pas reprise ; si un\n    15\t// nom de caméra est réutilisé avec un nouveau fichier, sa signature change et l'upload repart normalement.\n    16\t//\n    17\t// SÉCURITÉ : token via env, jamais committé. Binaires sur shard PRIVÉ, parts AES-GCM adressées par hash ;\n    18\t// seul le manifeste est écrit sur zenray-data. Aucun repo n'est créé avant la première vidéo stable.\n    19\t\n    20\timport path from 'node:path'\n    21\timport os from 'node:os'\n    22\timport { readdir, stat, readFile, writeFile, mkdir, rm } from 'node:fs/promises'\n    23\timport { makeVidRawShardCtx, ingestVideoRaw } from './video-raw-lib.mjs'\n    24\timport { pushBlobs } from './video-mse-lib.mjs'\n    25\t\n    26\tconst args = process.argv.slice(2)\n    27\tconst getArg = (k, d) => { const i = args.indexOf(k); return i >= 0 ? args[i + 1] : d }\n    28\tconst home = os.homedir()\n    29\tconst expand = (p) => p.replace(/^~(?=$|\\/)/, home)\n    30\tconst TOKEN = process.env.GITHUB_TOKEN\n    31\tconst WATCH = expand(getArg('--watch', path.join(home, 'Downloads')))\n    32\tconst DEST = getArg('--dest', 'pages/Videos').replace(/\\/$/, '')\n    33\t// --api reste accepté pour ne pas casser les anciens .command, mais video-raw n'en dépend plus.\n    34\tgetArg('--api', 'http://localhost:3100')\n    35\tconst INTERVAL = Math.max(2, parseInt(getArg('--interval', '4'), 10)) * 1000\n    36\tgetArg('--crf', '21') // option historique acceptée ; video-raw ne réencode plus.\n    37\tconst VIDEO_RE = /\\.(mkv|mp4|webm|avi|mov|m4v|ts|flv|wmv)$/i\n    38\t\n    39\tif (!TOKEN) { console.error('GITHUB_TOKEN manquant : lance avec GITHUB_TOKEN=$(gh auth token) node scripts/zenray-uploader.mjs'); process.exit(1) }\n    40\t\n    41\tconst STATE_DIR = path.join(home, '.zenray')\n    42\tconst SEEN_FILE = path.join(STATE_DIR, 'uploader-seen.json')\n    43\tconst WORK_DIR = path.join(os.tmpdir(), 'zr_zenray_uploader')\n    44\tconst log = (...a) => console.log(new Date().toLocaleTimeString('fr-FR'), ...a)\n    45\t\n    46\tasync function loadSeen() {\n    47\t  try {\n    48\t    const parsed = JSON.parse(await readFile(SEEN_FILE, 'utf8'))\n    49\t    if (parsed && parsed.v === 2 && parsed.files && typeof parsed.files === 'object') return new Map(Object.entries(parsed.files))\n    50\t    // Migration non destructive de l'ancien tableau de chemins : on adopte la version actuellement présente\n    51\t    // au premier tick sans la ré-uploader, puis toute future réutilisation du même nom sera détectée.\n    52\t    if (Array.isArray(parsed)) return new Map(parsed.map((file) => [file, 'legacy']))\n    53\t  } catch {}\n    54\t  return new Map()\n    55\t}\n    56\tasync function saveSeen(map) {\n    57\t  try {\n    58\t    await mkdir(STATE_DIR, { recursive: true })\n    59\t    await writeFile(SEEN_FILE, JSON.stringify({ v: 2, files: Object.fromEntries(map) }))\n    60\t  } catch {}\n    61\t}\n    62\t\n    63\tconst fileSignature = (st) => `${st.size}:${Math.round(st.mtimeMs || 0)}:${st.ino || 0}`\n    64\t\n    65\tconst sizes = new Map() // fichier -> dernière taille vue (pour détecter une copie terminée)\n    66\tconst seen = await loadSeen()\n    67\t\n    68\tlog(`ZenRay uploader — surveille ${WATCH} -> ${DEST}. Dépose une vidéo, elle s'uploade en video-raw chiffré.`)\n    69\t\n    70\tlet shardCtx = null\n    71\tasync function getShardCtx() {\n    72\t  if (shardCtx) return shardCtx\n    73\t  await rm(WORK_DIR, { recursive: true, force: true })\n    74\t  shardCtx = makeVidRawShardCtx({ token: TOKEN, work: WORK_DIR, log: (...parts) => log('   ', ...parts) })\n    75\t  await shardCtx.openShard()\n    76\t  return shardCtx\n    77\t}\n    78\t\n    79\tasync function tick() {\n    80\t  let files = []\n    81\t  try { files = (await readdir(WATCH)).filter((f) => VIDEO_RE.test(f)) } catch { return }\n    82\t  for (const name of files) {\n    83\t    const full = path.join(WATCH, name)\n    84\t    let st\n    85\t    try { st = await stat(full) } catch { continue }\n    86\t    const sz = st.size\n    87\t    const signature = fileSignature(st)\n    88\t    const previous = seen.get(full)\n    89\t    if (previous === 'legacy') { seen.set(full, signature); await saveSeen(seen); continue }\n    90\t    if (previous === signature) continue\n    91\t    // Attendre la STABILITÉ (2 ticks à la même signature) : évite de transcoder un fichier en cours de copie,\n    92\t    // y compris quand un téléchargement remplace un ancien fichier par un nouveau de taille identique.\n    93\t    if (sizes.get(full)