n, githubToken)\n   165\t      if (!loaded || !loaded.record) return res.status(404).json({ error: 'invalid-share' })\n   166\t      const revokedAt = new Date().toISOString()\n   167\t      await githubWriteRecord(token, { ...loaded.record, revokedAt }, loaded.sha, githubToken)\n   168\t      return res.status(200).json({ ok: true, revokedAt })\n   169\t    }\n   170\t\n   171\t    const kind = String(body.kind || '')\n   172\t    const path = String(body.path || '')\n   173\t    if (!isShareTarget(kind, path)) return res.status(400).json({ error: 'invalid-target' })\n   174\t    const requestedTtl = Number(body.expiresInSeconds)\n   175\t    const ttl = Number.isFinite(requestedTtl)\n   176\t      ? Math.min(MAX_TTL_SECONDS, Math.max(MIN_TTL_SECONDS, Math.round(requestedTtl)))\n   177\t      : DEFAULT_TTL_SECONDS\n   178\t    const token = createSignedShareToken(secret)\n   179\t    const createdAt = new Date().toISOString()\n   180\t    const expiresAt = new Date(Date.now() + ttl * 1000).toISOString()\n   181\t    const record = { v: VERSION, tokenHash: sha256(token), kind, path, createdAt, expiresAt, revokedAt: null }\n   182\t    await githubWriteRecord(token, record, '', githubToken)\n   183\t    return res.status(201).json({ token, kind, expiresAt })\n   184\t  } catch (error) {\n   185\t    const status = Number(error && error.status) || 500\n   186\t    return res.status(status).json({ error: (error && error.code) || 'share-service-error' })\n   187\t  }\n   188\t}\n\n---RESULT 2---\n     1\t// Politique unique des endpoints Documents (/api/tree et /api/doc).\n     2\t// Ces routes lisent des repos personnels avec un token serveur : une vérification\n     3\t// côté client ne suffit jamais. Les chemins sensibles restent invisibles dans\n     4\t// l'arbre ET impossibles à lire directement en connaissant leur nom.\n     5\t\n     6\texport const DOCUMENT_REPOS = Object.freeze({\n     7\t  memory: process.env.MEMORY_REPO || 'matthieuhuguet/Memory',\n     8\t 