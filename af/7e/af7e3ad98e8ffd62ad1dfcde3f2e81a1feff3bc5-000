{"timestamp":"2026-07-15T18:48:25.113Z","ordinal":119,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_6LHWWvSjIEFZAuqKTCbHW8rI","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\t// Sert un fichier média depuis un repo SHARD PRIVÉ via le token serveur.\n     2\t// Les repos privés ne sont pas accessibles depuis le navigateur -> tout passe ici.\n     3\t// Accepte : zenray-media-NN (legacy img/private), et toute famille PRIVÉE zenray-<kind>-private-NN.\n     4\t// Le PUBLIC ne transite JAMAIS par le proxy (servi par jsDelivr) sauf fallback explicite côté client.\n     5\timport { parseShard, shardName } from './shard-naming.js'\n     6\tconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\n     7\t// Repo lisible par le proxy = famille privée (nouveau schéma) OU legacy zenray-media-NN.\n     8\tconst proxyRepoOk = (repo) => { const p = parseShard(repo); return !!p && p.vis === 'private' }\n     9\t// Cache de résolution path -> repo réel (mémoire process, persiste à chaud). Sert au PROXY AUTO-RÉSILIENT :\n    10\t// après un déplacement de binaire entre shards, le manifeste peut encore pointer l'ancien repo ; on retrouve\n    11\t// le binaire sur un shard frère et on mémorise où il est pour les requêtes suivantes (zéro re-scan).\n    12\tconst g = globalThis\n    13\tg.__zrPathRepo = g.__zrPathRepo || new Map()\n    14\t// Cache NÉGATIF borné : un 404 réel (binaire jamais existé, ex. .webp non générée) ne doit PAS relancer\n    15\t// un scan complet de ~40 shards à CHAQUE affichage de la même tuile. On mémorise path -> expiration (ms)\n    16\t// et on court-circuite le re-scan tant que le TTL court. TTL court pour laisser une 2e chance après génération.\n    17\tg.__zrPath404 = g.__zrPath404 || new Map()\n    18\tconst NEG_TTL = 60000\n    19\tconst SHARD_BRANCH = 'main'\n    20\t// FIX ARCHI QUOTA : on sert les binaires via raw.githubusercontent.com, qui NE COMPTE PAS dans la limite\n    21\t// REST de 5000 requêtes/h (vérifié : raw renvoie 200 même quand le core est à 0). L'API contents la consommait\n    22\t// -> au bout de ~5000 vignettes vues, tout passait en 403 et le site se figeait. Exception : les playlists HLS\n    23\t// .m3u8 peuvent être réécrites (transcode progressif) et le CDN raw a ~5 min de cache -> on les sert encore via\n    24\t// l'API contents (frais, faible volume). Tout le reste (images, vignettes .webp, segments) = immuable -> raw CDN.\n    25\tconst rawFetch = (repo, path, token) => {\n    26\t  const ext = path.split('.').pop().toLowerCase()\n    27\t  if (ext === 'm3u8') return fetch(`https://api.github.com/repos/${OWNER}/${repo}/contents/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.raw', 'User-Agent': 'zenray-progress' } })\n    28\t  return fetch(`https://raw.githubusercontent.com/${OWNER}/${repo}/${SHARD_BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    29\t}\n    30\tconst ctFor = (p) => {\n    31\t  const e = p.split('.').pop().toLowerCase()\n    32\t  const m = { avif: 'image/avif', webp: 'image/webp', png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', svg: 'image/svg+xml', bmp: 'image/bmp', tiff: 'image/tiff', heic: 'image/heic',\n    33\t    // Sous-titres : le pipeline mse-av (transcode-worker) pousse les VTT sur le shard privé et le manifest\n    34\t    // porte `repo`, donc StreamVideoMSE les sert via /api/shard. Sans ce mapping, le navigateur recevait\n    35\t    // application/octet-stream et refusait le <track> -> sous-titres muets. (srt/ass en text/plain par cohérence.)\n    36\t    vtt: 'text/vtt', srt: 'text/plain', ass: 'text/plain', ssa: 'text/plain',\n    37\t    // Segments HLS (CMAF fMP4) servis depuis le shard privé : sans le bon Content-Type, Safari refuse\n    38\t    // un .m4s / init.mp4. m4s = segment média, mp4 = init segment, ts = segment legacy mpegts (au cas où),\n    39\t    // m3u8 = playlist (normalement servie par /api/hls, mappée ici par sécurité).\n    40\t    m4s: 'video/iso.segment', mp4: 'video/mp4', m4v: 'video/mp4', ts: 'video/mp2t',\n    41\t    m3u8: 'application/vnd.apple.mpegurl' }\n    42\t  return m[e] || 'application/octet-stream'\n    43\t}\n    44\texport default async function handler(req, res) {\n    45\t  const token = process.env.GITHUB_TOKEN\n    46\t  if (!token) return res.status(500).end()\n    47\t  const repo = String(req.query.repo || '')\n    48\t  const path = String(req.query.path || '')\n    49\t  if (!proxyRepoOk(repo)) return res.status(400).end()\n    50\t  if (!path || path.includes('..') || path.startsWith('/')) return res.status(400).end()\n    51\t  try {\n    52\t    // PROXY AUTO-RÉSILIENT : on sert depuis le repo demandé ; si le binaire n'y est plus (déplacé vers un shard\n    53\t    // frère), on retrouve le binaire au MÊME chemin haché sur les autres shards de la famille et on mémorise où.\n    54\t    const known = g.__zrPathRepo.get(path)\n    55\t    const first = (known && proxyRepoOk(known)) ? known : repo\n    56\t    let r = await rawFetch(first, path, token)\n    57\t    if (!r.ok && r.status === 404) {\n    58\t      // Cache négatif : 404 récent déjà constaté pour ce chemin -> on ne re-scanne pas (évite l'orage de fetchs).\n    59\t      const neg = g.__zrPath404.get(path)\n    60\t      if (neg && neg > Date.now()) return res.status(404).end()\n    61\t      // serving-quota-5 : dériver les candidats du DERNIER emplacement connu (first), pas du repo demandé.\n    62\t      const p = parseShard(first)\n    63\t      const cands = []\n    64\t      if (p) {\n    65\t        for (let n = 1; n <= 20; n++) cands.push(shardName(p.kind, p.vis, n))\n    66\t        if (p.kind === 'img' && p.vis === 'private') for (let n = 1; n <= 20; n++) cands.push(`zenray-media-${String(n).padStart(2, '0')}`)\n    67\t      }\n    68\t      for (const c of cands) {\n    69\t        if (c === first) continue\n    70\t        const rr = await rawFetch(c, path, token)\n    71\t        if (rr.ok) { g.__zrPathRepo.set(path, c); g.__zrPath404.delete(path); r = rr; break }\n    72\t      }\n    73\t      // Scan complet bredouille -> mémorise le 404 pour TTL court (évite le re-scan à chaque tuile manquante).\n    74\t      if (!r.ok && r.status === 404) g.__zrPath404.set(path, Date.now() + NEG_TTL)\n    75\t    }\n    76\t    if (!r.ok) return res.status(r.status === 404 ? 404 : 502).end()\n    77\t    const buf = Buffer.from(await r.arrayBuffer())\n    78\t    res.setHeader('Content-Type', ctFor(path))\n    79\t    // Tout binaire adressé par CONTENU (chemin haché, jamais réécrit) est IMMUABLE -> cache navigateur LONG.\n    80\t    // Cela couvre les images/vignettes (avif, webp, png…) ET les segments média + sous-titres HLS (m4s, mp4,\n    81\t    // m4v, ts, vtt, srt, ass) : eux aussi sont hashés et figés, donc on évite le re-fetch réseau à chaque\n    82\t    // seek/replay (l'ancien max-age=0 les re-téléchargeait sans raison). SEULES les playlists HLS (.m3u8)\n    83\t    // sont réellement mutables (réécrites sous le même chemin par le transcode progressif) -> cache court.\n    84\t    const ext = path.split('.').pop().toLowerCase()\n    85\t    // serving-quota-6 : une .m3u8 est RÉÉCRITE par le transcode progressif -> jamais cachable. `no-store`\n    86\t    // (cohérent avec server/hls.js). L'ancien `s-maxage=31536000 immutable` pouvait figer une playlist\n    87\t    // incomplète côté CDN/proxy intermédiaire. Les segments binaires et images (chemins hashés) restent immuables.\n    88\t    const mutablePlaylist = ext === 'm3u8'\n    89\t    res.setHeader('Cache-Control', mutablePlaylist ? 'no-store' : 'public, max-age=31536000, immutable')\n    90\t    res.setHeader('Content-Length', String(buf.length))\n    91\t    return res.status(200).send(buf)\n    92\t  } catch (e) { return res.status(500).end() }\n    93\t}\n     1\t// Helper PARTAGÉ (côté serveur) du nommage des repos shard ZenRay.\n     2\t//\n     3\t// POURQUOI : avant, le nommage était dispersé (regex /^zenray-media-\\d{2,}$/ et /^zenray-vid-\\d{2,}$/\n     4\t// copiées dans upload-shard.js, upload-vid.js, shard.js, repos.js). On centralise ici la SEULE source de\n     5\t// vérité du schéma générique :   zenray-<kind>-<vis>-NN\n     6\t//   kind ∈ {img, vid, audio, doc, table, markdown}   vis ∈ {public, private}   NN = numéro 2 chiffres.\n     7\t// Ex : zenray-img-public-01, zenray-img-private-01, zenray-audio-private-01.\n     8\t//\n     9\t// RÉTRO-COMPAT (non négociable) : on ne renomme JAMAIS les anciens repos. On accepte donc aussi les deux\n    10\t// schémas LEGACY existants :\n    11\t//   - zenray-media-NN  = historiquement les IMAGES PRIVÉES  -> on le traite comme (kind=img, vis=private).\n    12\t//   - zenray-vid-NN    = historiquement les VIDÉOS PUBLIQUES -> on le traite comme (kind=vid, vis=public).\n    13\t// Le but : un manifest .img.json SANS champ vis reste « private » et continue d'être servi par /api/shard,\n    14\t// et les repos déjà en place ne bougent pas.\n    15\t//\n    16\t// ASYMÉTRIE VOLONTAIRE (ne PAS la « corriger » par erreur) : la création de FUTURS shards diverge selon la\n    17\t// famille. Familles MIGRÉES vers le nouveau nom : img/private (defaultShard/nextShard renvoient\n    18\t// zenray-img-private-NN, même pour un legacy zenray-media). Familles FIGÉES legacy : vid/public\n    19\t// (defaultShard/nextShard restent sur zenray-vid-NN, migration hors scope). En LECTURE, parseShard accepte\n    20\t// les deux schémas pour toutes les familles, donc cette divergence n'affecte que le NOMMAGE des nouveaux repos.\n    21\t\n    22\timport { randomBytes } from 'node:crypto'\n    23\t\n    24\texport const KINDS = ['img', 'vid', 'audio', 'doc', 'pdf', 'table', 'markdown', 'blob', 'archive', 'backup']\n    25\texport const VIS = ['public', 'private']\n    26\t\n    27\t// CONVENTION V2 (2026-07-05, décision Matthieu) : zenrayshards-<type>-<hex12>, nom aléatoire façon\n    28\t// workflow. TOUTE création de shard passe par ce schéma désormais — plus JAMAIS de nom séquentiel NN\n    29\t// (les anciens repos ont été renommés vers v2 ; recréer un ancien nom tuerait la redirection GitHub\n    30\t// dont dépendent tous les manifestes historiques). Visibilité par convention de type : img/archive\n    31\t// publics (jsDelivr/existant), le reste privé — mais la source de vérité par-manifeste (m.vis,\n    32\t// m.private) prime toujours quand elle existe.\n    33\texport const shardReV2 = /^zenrayshards-([a-z]+)-[0-9a-f]{8,}$/\n    34\t// Audio v2 is public too, but ALWAYS AES-256-GCM encrypted and addressed by hashes.\n    35\t// This enables immutable jsDelivr streaming while the Service Worker decrypts locally.\n    36\tconst V2_PUBLIC_TYPES = new Set(['img', 'audio', 'archive'])\n    37\t\n    38\t// Regex de l'ancien schéma générique (LECTURE seule : repos renommés, mais manifestes/état porteurs des\n    39\t// anciens noms — les redirections GitHub les servent toujours).\n    40\texport const shardReNew = /^zenray-(img|vid|audio|doc|pdf|table|markdown)-(public|private)-\\d{2,}$/\n    41\t// Regex LEGACY (anciens repos, non renommés).\n    42\texport const legacyMediaRe = /^zenray-media-\\d{2,}$/   // = img / private (legacy)\n    43\texport const legacyVidRe = /^zenray-vid-\\d{2,}$/       // = vid / public (legacy)\n    44\t// ARCHIVE UNIVERSELLE (A4, 2026-06-11) : zenray-productions-archive-<NomDuDossier>[-NN] (NN seulement si >5 Go).\n    45\texport const archiveRe = /^zenray-productions-archive-[a-z0-9._-]+$/\n    46\t\n    47\t// Regex GÉNÉRIQUE : accepte v2 + ancien schéma + les deux legacy. À utiliser partout pour valider un repo\n    48\t// shard, quel que soit son type/visibilité.\n    49\texport const shardRe = new RegExp(\n    50\t  '^(?:' +\n    51\t    'zenrayshards-[a-z]+-[0-9a-f]{8,}' + // v2 (2026-07-05)\n    52\t    '|zenray-(?:img|vid|audio|doc|pdf|table|markdown)-(?:public|private)-\\\\d{2,}' + // ancien générique\n    53\t    '|zenray-media-\\\\d{2,}' + // legacy img/private\n    54\t    '|zenray-vid-\\\\d{2,}' +   // legacy vid/public\n    55\t    '|zenray-productions-archive-[a-z0-9._-]+' + // archive universelle\n    56\t  ')$'\n    57\t)\n    58\t\n    59\t// Construit le nom d'un NOUVEAU repo shard — TOUJOURS v2 : zenrayshards-<kind>-<hex12>. La signature\n    60\t// (kind, vis, n) est conservée pour les appelants existants ; n est ignoré (les noms ne sont plus\n    61\t// séquentiels), vis reste utilisée par l'appelant pour créer le repo public/privé.\n    62\texport function shardName(kind, vis, n) {\n    63\t  if (!KINDS.includes(kind)) throw new Error('shardName: bad kind ' + kind)\n    64\t  if (!VIS.includes(vis)) throw new Error('shardName: bad vis ' + vis)\n    65\t  return `zenrayshards-${kind}-${randomBytes(6).toString('hex')}`\n    66\t}\n    67\t\n    68\t// Décompose un nom de repo (v2, ancien OU legacy) en {kind, vis, n}. Renvoie null si non reconnu.\n    69\texport function parseShard(name) {\n    70\t  const s = String(name || '')\n    71\t  let m = shardReV2.exec(s)\n    72\t  if (m) {\n    73\t    const kind = KINDS.includes(m[1]) ? m[1] : 'blob'\n    74\t    return { kind, vis: V2_PUBLIC_TYPES.has(kind) ? 'public' : 'private', n: 0, v2: true }\n    75\t  }\n    76\t  m = shardReNew.exec(s)\n    77\t  if (m) return { kind: m[1], vis: m[2], n: parseInt(s.match(/-(\\d{2,})$/)[1], 10) }\n    78\t  m = legacyMediaRe.exec(s)\n    79\t  if (m) return { kind: 'img', vis: 'private', n: parseInt(s.match(/-(\\d{2,})$/)[1], 10), legacy: 'media' }\n    80\t  m = legacyVidRe.exec(s)\n    81\t  if (m) return { kind: 'vid', vis: 'public', n: parseInt(s.match(/-(\\d{2,})$/)[1], 10), legacy: 'vid' }\n    82\t  if (archiveRe.test(s)) { const nn = s.match(/-(\\d{2,})$/); return { kind: 'archive', vis: 'public', n: nn ? parseInt(nn[1], 10) : 1 } }\n    83\t  return null\n    84\t}\n    85\t\n    86\t// Nom du shard SUIVANT dans la même famille. V2 : un shard \"suivant\" est simplement un NOUVEAU nom\n    87\t// aléatoire du même kind — jamais d'incrément, jamais de réutilisation d'un ancien nom (règle dure\n    88\t// post-rename : un ancien nom recréé casserait la redirection de tout l'historique).\n    89\texport function nextShard(name) {\n    90\t  const p = parseShard(name)\n    91\t  if (!p) throw new Error('nextShard: bad name ' + name)\n    92\t  return shardName(p.kind, p.vis, 0)\n    93\t}\n    94\t\n    95\t// isPublic('public') === true. Tolère un repo name OU une visibilité brute.\n    96\texport function isPublic(visOrName) {\n    97\t  if (visOrName === 'public') return true\n    98\t  if (visOrName === 'private') return false\n    99\t  const p = parseShard(visOrName)\n   100\t  return p ? p.vis === 'public' : false\n   101\t}\n   102\t\n   103\t// Chemin du fichier d'ÉTAT (dans zenray-data, privé) qui suit le shard actif d'UNE famille (kind+vis).\n   104\t// MAPPING LEGACY conservé pour ne RIEN migrer :\n   105\t//   (img, private) -> 'pages/.zr-drive.json'      (état historique des zenray-media-NN)\n   106\t//   (vid, public)  -> 'pages/.zr-vid-drive.json'  (état historique des zenray-vid-NN)\n   107\t// Toute autre famille -> 'pages/.zr-drive-<kind>-<vis>.json'.\n   108\texport function driveStatePath(kind, vis) {\n   109\t  if (kind === 'img' && vis === 'private') return 'pages/.zr-drive.json'\n   110\t  if (kind === 'vid' && vis === 'public') return 'pages/.zr-vid-drive.json'\n   111\t  return `pages/.zr-drive-${kind}-${vis}.json`\n   112\t}\n   113\t\n   114\t// Shard PAR DÉFAUT (NN=01) d'une famille. La vidéo reste sur le legacy zenray-vid-01 (hors scope).\n   115\t// img/private adopte le NOUVEAU nom zenray-img-private-01 (objectif RENAME) : si aucun état n'existe encore,\n   116\t// un drive vierge crée directement le nouveau nom. Les anciens zenray-media-NN restent lus (parseShard).\n   117\texport function defaultShard(kind, vis) {\n   118\t  // HARMONISÉ (2026-06-09) : la vidéo passe au schéma standard zenray-vid-public-NN (comme zenray-img-public-NN).\n   119\t  // parseShard accepte toujours les anciens zenray-vid-NN en LECTURE (legacyVidRe), donc rien ne casse côté lecture.\n   120\t  return shardName(kind, vis, 1)\n   121\t}\n     1\t// /api/raw-proxy?u=<encoded raw.githubusercontent.com url> — read proxy for the SMALL files of\n     2\t// PRIVATE zenrayshards-* repos that must render in an <img> tag (video posters, thumbnails): an\n     3\t// <img src> cannot carry an Authorization header, so the server (which has the token) fetches the\n     4\t// bytes and serves them same-origin. RESERVED for small files (a ~50 KB poster) — 95 MB video\n     5\t// parts go through the Service Worker + api.github.com directly (never here: Vercel response cap ~4.5 MB).\n     6\t//\n     7\t// ANTI-ABUSE: only accepts raw.githubusercontent.com/<expected owner>/… — not an open proxy.\n     8\tconst OWNER = (process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data').split('/')[0]\n     9\t\n    10\texport default async function handler(req, res) {\n    11\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n    12\t  const token = process.env.ZENRAY_RAW_TOKEN || process.env.GITHUB_TOKEN\n    13\t  if (!token) return res.status(500).end()\n    14\t  const u = (req.query.u || '').toString()\n    15\t  let url\n    16\t  try { url = new URL(u) } catch { return res.status(400).end() }\n    17\t  if (url.hostname !== 'raw.githubusercontent.com' || !url.pathname.startsWith(`/${OWNER}/`)) return res.status(400).end()\n    18\t  try {\n    19\t    const r = await fetch(url.toString(), { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    20\t    if (!r.ok) return res.status(r.status === 404 ? 404 : 502).end()\n    21\t    const buf = Buffer.from(await r.arrayBuffer())\n    22\t    // Hard bound: this proxy serves posters/thumbnails, not parts. 8 MB is already very generous.\n    23\t    if (buf.length > 8 * 1024 * 1024) return res.status(413).end()\n    24\t    const ext = url.pathname.split('.').pop().toLowerCase()\n    25\t    res.setHeader('Content-Type', ext === 'jpg' || ext === 'jpeg' ? 'image/jpeg' : ext === 'png' ? 'image/png' : ext === 'webp' ? 'image/webp' : 'application/octet-stream')\n    26\t    // URL pinned on a commit SHA -> immutable content -> long cache is safe (anti-blank-screen\n    27\t    // rule respected: this is NOT an index.html, it is a version-addressed binary).\n    28\t    res.setHeader('Cache-Control', 'public, max-age=31536000, s-maxage=31536000, immutable')\n    29\t    return res.status(200).send(buf)\n    30\t  } catch { return res.status(502).end() }\n    31\t}\n     1\t// /api/raw-token — serves the CLIENT the READ token for private zenrayshards-* repos (vid/blob/pdf/doc).\n     2\t//\n     3\t// WHY: since 2026-07-05, every non-image media lives on PRIVATE GitHub repos (Matthieu's decision:\n     4\t// only img stays public, jsDelivr requires it). The Service Worker (video playback) and downloads\n     5\t// fetch parts directly from api.github.com (Accept: application/vnd.github.raw) — CORS verified OK\n     6\t// with the Authorization header. This endpoint hands them the token, exactly on the /api/media-key\n     7\t// model (the master key is already served to the client the same way; same trust surface, same gating).\n     8\t//\n     9\t// SECURITY: prefer ZENRAY_RAW_TOKEN (a READ-ONLY fine-grained PAT limited to zenrayshards-* repos,\n    10\t// to create in GitHub settings) — when defined, THAT is what gets served, never the main token.\n    11\t// Fallback: GITHUB_TOKEN (full token — acceptable for gated personal use, but the reduced PAT is\n    12\t// recommended and documented in docs/INDEX-ERREURS-FEATURES.md). In prod the router sits behind\n    13\t// Vercel protection + the optional app gate, like media-key.\n    14\texport default async function handler(req, res) {\n    15\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n    16\t  const token = process.env.ZENRAY_RAW_TOKEN || process.env.GITHUB_TOKEN\n    17\t  if (!token) return res.status(200).json({ error: 'raw-token indisponible' })\n    18\t  res.setHeader('Cache-Control', 'no-store')\n    19\t  return res.status(200).json({ token, scoped: !!process.env.ZENRAY_RAW_TOKEN })\n    20\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f671b-d4fe-76d0-a6f4-1f8b5364967c"}}}
