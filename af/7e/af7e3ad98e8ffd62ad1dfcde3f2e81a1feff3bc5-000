{"timestamp":"2026-07-15T18:48:25.113Z","ordinal":160,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_1EdiHHVzcCZewhjsiI0RTCKb","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\t// /api/video-comment — commentaires publics sous une vidéo (lecteur normal ET page de partage /watch).\n     2\t// Même patron que page.js (Git Data API, pas de base de données) : chaque commentaire est APPENDÉ à un\n     3\t// fichier JSON dédié `pages/_comments/<hash du chemin vidéo>.json` (array de {name, text, at}) dans le\n     4\t// repo content (zenray-data). Un visiteur d'un lien /watch peut commenter SANS mot de passe : cette route\n     5\t// est déclarée PUBLIQUE dans api/[...route].js (comme img/stream/hls), donc jamais gatée par x-zr-auth.\n     6\timport { createHash } from 'node:crypto'\n     7\timport { instrument } from './cmdlog.js'\n     8\t\n     9\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    10\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    11\t\n    12\tconst ghRaw = (token, path, init = {}) =>\n    13\t  fetch(`https://api.github.com/repos/${REPO}/${path}`, {\n    14\t    ...init,\n    15\t    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) },\n    16\t  })\n    17\tconst gh = instrument(ghRaw, { repoOf: () => REPO, pathOf: (args) => args[1], initOf: (args) => args[2] || {} })\n    18\tconst b64e = (s) => Buffer.from(s, 'utf8').toString('base64')\n    19\tconst b64d = (s) => Buffer.from(s, 'base64').toString('utf8')\n    20\t\n    21\t// hash court et stable du chemin vidéo -> nom de fichier commentaires (pas de caractères spéciaux/longueur imprévisible).\n    22\tconst hashPath = (p) => createHash('sha256').update(String(p)).digest('hex').slice(0, 24)\n    23\tconst fileFor = (videoPath) => `pages/_comments/${hashPath(videoPath)}.json`\n    24\t\n    25\texport default async function handler(req, res) {\n    26\t  const token = process.env.GITHUB_TOKEN\n    27\t  if (!token) return res.status(200).json({ error: 'no-token' })\n    28\t  res.setHeader('Cache-Control', 'no-store')\n    29\t\n    30\t  try {\n    31\t    if (req.method === 'GET') {\n    32\t      const videoPath = (req.query.videoPath || '').toString()\n    33\t      if (!videoPath) return res.status(400).json({ error: 'bad-path' })\n    34\t      const file = fileFor(videoPath)\n    35\t      // Lecture RAW (hors quota REST) : liste de commentaires, lecture pure, pas de sha nécessaire.\n    36\t      const rr = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(file)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    37\t      if (rr.status === 404) return res.status(200).json({ comments: [] })\n    38\t      if (!rr.ok) return res.status(200).json({ comments: [], error: 'github' })\n    39\t      try { const arr = JSON.parse(await rr.text()); return res.status(200).json({ comments: Array.isArray(arr) ? arr : [] }) }\n    40\t      catch { return res.status(200).json({ comments: [] }) }\n    41\t    }\n    42\t\n    43\t    if (req.method === 'POST') {\n    44\t      let body = req.body\n    45\t      if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n    46\t      const videoPath = (body.videoPath || '').toString()\n    47\t      const name = (body.name || '').toString().trim().slice(0, 60)\n    48\t      const text = (body.text || '').toString().trim().slice(0, 1000)\n    49\t      if (!videoPath || !name || !text) return res.status(400).json({ error: 'bad-input' })\n    50\t      const file = fileFor(videoPath)\n    51\t      const entry = { name, text, at: new Date().toISOString() }\n    52\t\n    53\t      // Read-modify-write avec retry sur conflit (409/422), comme saveJsonWithRetry côté client pour `page`.\n    54\t      for (let i = 0; i < 3; i++) {\n    55\t        let cur = []; let sha = null\n    56\t        const r = await gh(token, `contents/${encodeURI(file)}?ref=${BRANCH}`)\n    57\t        if (r.ok) { const j = await r.json(); sha = j.sha; try { cur = JSON.parse(b64d(j.content)) } catch { cur = [] } }\n    58\t        else if (r.status !== 404) return res.status(200).json({ error: 'github' })\n    59\t        const next = [...(Array.isArray(cur) ? cur : []), entry].slice(-500) // borne raisonnable\n    60\t        const payload = { message: 'video comment', content: b64e(JSON.stringify(next, null, 2)), branch: BRANCH }\n    61\t        if (sha) payload.sha = sha\n    62\t        const w = await gh(token, `contents/${encodeURI(file)}`, { method: 'PUT', body: JSON.stringify(payload) })\n    63\t        if (w.ok) return res.status(200).json({ ok: true, comment: entry })\n    64\t        if (w.status === 409 || w.status === 422) continue // HEAD a bougé -> on relit et rejoue\n    65\t        return res.status(200).json({ error: 'github' })\n    66\t      }\n    67\t      return res.status(200).json({ error: 'conflict' })\n    68\t    }\n    69\t\n    70\t    res.setHeader('Allow', 'GET, POST')\n    71\t    return res.status(405).end()\n    72\t  } catch (e) {\n    73\t    return res.status(200).json({ error: 'fetch', detail: String((e && e.message) || e).slice(0, 160) })\n    74\t  }\n    75\t}\n     1\t// Token de download HLS — signature HMAC partagée par hls-download-info / hls-cli / hls-key.\n     2\t//\n     3\t// EN CLAIR (pour tout le monde) :\n     4\t//   ffmpeg lancé en ligne de commande sur l'ordi de l'utilisateur n'envoie PAS l'en-tête Origin/Referer\n     5\t//   qu'un navigateur enverrait. Le gate anti-hotlinking de /api/hls-key ne peut donc pas le laisser passer.\n     6\t//   On lui donne à la place un « laissez-passer » signé à durée limitée : un token. Le serveur l'a fabriqué\n     7\t//   (signé avec un secret que lui seul connaît), donc il peut vérifier qu'il est authentique et pas expiré.\n     8\t//   Tant que le token est valide, ffmpeg peut récupérer le master, les sous-playlists et la clé AES.\n     9\t//\n    10\t// FORMAT du token : base64url(`${path}\\n${exp}`) + '.' + base64url(HMAC-SHA256(secret, `${path}\\n${exp}`)).\n    11\t//   - path = chemin du .media.json (lie le token à UNE vidéo précise, pas un passe-partout)\n    12\t//   - exp  = timestamp d'expiration en millisecondes (Date.now() + TTL)\n    13\t// On signe path+exp ensemble : impossible de prolonger l'expiration ou de viser une autre vidéo sans le secret.\n    14\timport crypto from 'node:crypto'\n    15\t\n    16\t// TTL par défaut 60 min (plan §12). Option longue 3 h pour les vidéos longues, plafonnée à 3 h.\n    17\texport const DEFAULT_TTL_MS = 60 * 60 * 1000\n    18\texport const MAX_TTL_MS = 3 * 60 * 60 * 1000\n    19\t\n    20\t// Secret de signature. Var dédiée HLS_DL_SECRET de préférence ; à défaut on dérive du GITHUB_TOKEN\n    21\t// (présent côté serveur) pour ne jamais tomber sur un secret vide. JAMAIS exposé au client.\n    22\tfunction secret() {\n    23\t  const dedicated = process.env.HLS_DL_SECRET\n    24\t  if (dedicated && dedicated.length >= 8) return dedicated\n    25\t  const gh = process.env.GITHUB_TOKEN || ''\n    26\t  // dérivation : on ne réutilise pas le token brut comme clé, on le hash avec un sel fixe.\n    27\t  return crypto.createHash('sha256').update('zenray-hls-dl|' + gh).digest('hex')\n    28\t}\n    29\t\n    30\tconst b64url = (buf) => Buffer.from(buf).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '')\n    31\tconst fromB64url = (s) => Buffer.from(s.replace(/-/g, '+').replace(/_/g, '/'), 'base64')\n    32\t\n    33\t// Signe un token pour ce path, expirant dans ttlMs (borné à MAX_TTL_MS).\n    34\texport function signToken(mediaPath, ttlMs = DEFAULT_TTL_MS) {\n    35\t  const ttl = Math.min(Math.max(60 * 1000, Number(ttlMs) || DEFAULT_TTL_MS), MAX_TTL_MS)\n    36\t  const exp = Date.now() + ttl\n    37\t  const payload = `${mediaPath}\\n${exp}`\n    38\t  const sig = crypto.createHmac('sha256', secret()).update(payload).digest()\n    39\t  return { token: `${b64url(payload)}.${b64url(sig)}`, exp }\n    40\t}\n    41\t\n    42\t// Vérifie un token. Renvoie { ok, path, exp } ou { ok:false, reason }. Comparaison constante (timingSafeEqual).\n    43\texport function verifyToken(token) {\n    44\t  if (!token || typeof token !== 'string' || !token.includes('.')) return { ok: false, reason: 'malformed' }\n    45\t  const [payloadB64, sigB64] = token.split('.', 2)\n    46\t  let payload\n    47\t  try { payload = fromB64url(payloadB64).toString('utf8') } catch { return { ok: false, reason: 'malformed' } }\n    48\t  const expected = crypto.createHmac('sha256', secret()).update(payload).digest()\n    49\t  let got\n    50\t  try { got = fromB64url(sigB64) } catch { return { ok: false, reason: 'malformed' } }\n    51\t  if (got.length !== expected.length || !crypto.timingSafeEqual(got, expected)) return { ok: false, reason: 'bad-signature' }\n    52\t  const nl = payload.lastIndexOf('\\n')\n    53\t  if (nl < 0) return { ok: false, reason: 'malformed' }\n    54\t  const path = payload.slice(0, nl)\n    55\t  const exp = Number(payload.slice(nl + 1))\n    56\t  if (!Number.isFinite(exp)) return { ok: false, reason: 'malformed' }\n    57\t  if (Date.now() > exp) return { ok: false, reason: 'expired' }\n    58\t  return { ok: true, path, exp }\n    59\t}\n     1\t// Sert les playlists HLS (.m3u8) en TEXTE depuis le repo content zenray-data, avec le Content-Type\n     2\t// EXIGÉ par Safari : application/vnd.apple.mpegurl. Sans ce type, Safari refuse de lire le master.\n     3\t//\n     4\t// Endpoint DÉDIÉ (clone minimal du GET de img.js) pour ZÉRO risque de régression sur /api/img :\n     5\t//   - n'accepte qu'un path commençant par pages/Videos/ et finissant par .m3u8 ;\n     6\t//   - rejette tout '..' (pas de path traversal) et tout path absolu ;\n     7\t//   - lit le blob via le token serveur (repo content peut être privé) ;\n     8\t//   - cache COURT (no-store) : une playlist peut être re-générée après re-transcodage, donc on ne la\n     9\t//     fige pas (les segments, eux, sont hashés et immutables, servis par /api/shard).\n    10\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    11\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    12\t\n    13\texport default async function handler(req, res) {\n    14\t  const token = process.env.GITHUB_TOKEN\n    15\t  if (!token) return res.status(500).end()\n    16\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n    17\t\n    18\t  const path = (req.query.path || '').toString()\n    19\t  // Sert les manifestes texte de streaming : .m3u8 (HLS) ET .mpd (DASH, streaming v2). Même garde anti-traversal.\n    20\t  const isMpd = path.endsWith('.mpd')\n    21\t  if (!path.startsWith('pages/') || !(path.endsWith('.m3u8') || isMpd) || path.includes('..') || path.startsWith('/')) {\n    22\t    return res.status(400).end()\n    23\t  }\n    24\t  try {\n    25\t    const r = await fetch(`https://api.github.com/repos/${REPO}/contents/${encodeURI(path)}?ref=${BRANCH}`, {\n    26\t      headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.raw', 'User-Agent': 'zenray-progress' },\n    27\t    })\n    28\t    if (!r.ok) return res.status(r.status === 404 ? 404 : 502).end()\n    29\t    const buf = Buffer.from(await r.arrayBuffer())\n    30\t    res.setHeader('Content-Type', isMpd ? 'application/dash+xml' : 'application/vnd.apple.mpegurl')\n    31\t    res.setHeader('Cache-Control', 'no-store')\n    32\t    res.setHeader('Content-Length', String(buf.length))\n    33\t    return res.status(200).send(buf)\n    34\t  } catch { return res.status(500).end() }\n    35\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f671b-d4fe-76d0-a6f4-1f8b5364967c"}}}
