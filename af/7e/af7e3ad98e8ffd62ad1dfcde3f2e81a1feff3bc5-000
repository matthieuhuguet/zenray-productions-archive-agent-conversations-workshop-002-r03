{"timestamp":"2026-07-15T18:48:25.113Z","ordinal":214,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_ecrqIOHJC4pXMgmGIYw9s84z","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\t// /api/shared-media — SERVER-SIDE DECRYPTION PROXY, public (no x-zr-auth), for encrypted images.\n     2\t//\n     3\t// WHY THIS FILE EXISTS (bug found 2026-07-01): /api/media-key is GATED (x-zr-auth required in prod).\n     4\t// Image sharing (/view) and shared-gallery thumbnails (/folder) used to decrypt CLIENT-SIDE,\n     5\t// starting with `fetch('/api/media-key')` — for an anonymous visitor (without the drive code) that\n     6\t// call returns 401 and the image stays white/broken. Verified in prod: `curl /api/media-key` -> 401.\n     7\t// Image sharing therefore NEVER actually worked for an external recipient.\n     8\t//\n     9\t// FIX: this endpoint decrypts SERVER-SIDE (the key never leaves the server, unlike /api/media-key\n    10\t// which sends it to the client in clear) and streams the DECRYPTED BYTES directly with the right\n    11\t// Content-Type. The client (or a WhatsApp/Notion crawler that cannot run JS) no longer needs to\n    12\t// know the key or do any crypto: a plain <img src=\"/api/shared-media?path=...&kind=thumb&share=...\"> is\n    13\t// enough. Also serves as the image source for Open Graph meta tags (server/share-og.js).\n    14\t//\n    15\t// SECURITY: la route HTTP reste publique (une balise img ne sait pas envoyer x-zr-auth), mais le handler\n    16\t// exige un jeton de partage valide pour cette image ou un dossier parent. Il n'expose jamais la clé, seulement\n    17\t// les octets déchiffrés d'une cible explicitement partagée.\n    18\timport { loadMediaKey } from './media-key.js'\n    19\timport { createDecipheriv } from 'node:crypto'\n    20\timport { authorizeShareAccess } from './share-token.js'\n    21\t\n    22\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    23\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    24\t\n    25\t// AES-GCM: same algo as client-side media/crypto.js (12-byte IV, 16-byte tag at the end of the ciphertext).\n    26\tfunction decryptAesGcm(cipherBuf, ivB64, keyB64) {\n    27\t  const key = Buffer.from(keyB64, 'base64')\n    28\t  const iv = Buffer.from(ivB64, 'base64')\n    29\t  const tag = cipherBuf.subarray(cipherBuf.length - 16)\n    30\t  const data = cipherBuf.subarray(0, cipherBuf.length - 16)\n    31\t  const decipher = createDecipheriv('aes-256-gcm', key, iv)\n    32\t  decipher.setAuthTag(tag)\n    33\t  return Buffer.concat([decipher.update(data), decipher.final()])\n    34\t}\n    35\t\n    36\tconst mimeForExt = (ext) => ({\n    37\t  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', gif: 'image/gif',\n    38\t  avif: 'image/avif', heic: 'image/heic', bmp: 'image/bmp', tif: 'image/tiff', tiff: 'image/tiff',\n    39\t}[ext] || 'application/octet-stream')\n    40\t\n    41\texport default async function handler(req, res) {\n    42\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n    43\t  const token = process.env.GITHUB_TOKEN\n    44\t  const path = (req.query.path || '').toString()\n    45\t  const kind = (req.query.kind || 'full').toString() // 'thumb' | 'full'\n    46\t  const share = (req.query.share || '').toString()\n    47\t  if (!token || !path || !/\\.img\\.json$/.test(path)) return res.status(400).end('bad-request')\n    48\t  // Le proxy livre des octets DÉCHIFFRÉS : un path deviné ne suffit plus. Le jeton doit viser cette image\n    49\t  // exactement, ou un dossier parent explicitement partagé. Les anciens liens base64 restent vérifiés ici.\n    50\t  if (!(await authorizeShareAccess(share, path))) return res.status(403).end('invalid-share')\n    51\t  try {\n    52\t    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    53\t    if (!r.ok) return res.status(404).end('manifest-not-found')\n    54\t    const m = await r.json()\n    55\t    if (m.vis !== 'public' || !m.cdnRepo || !m.cdnCommit) return res.status(404).end('not-shareable')\n    56\t\n    57\t    // thumb: m.thumb is already the full jsDelivr URL of the encrypted .webp, never chunked.\n    58\t    // full: NEW schema (cdnChunks[], 2026-07-07) -> concatenate jsDelivr chunks in order before\n    59\t    // decrypting (bit-exact). OLD schema (cdnPath, never migrated) -> raw.github, UNCHANGED.\n    60\t    let iv = null\n    61\t    let cipherBuf = null\n    62\t    if (kind === 'thumb' && m.thumb && m.thumbIv) {\n    63\t      const cr = await fetch(m.thumb)\n    64\t      if (!cr.ok) return res.status(404).end('cdn-not-found')\n    65\t      cipherBuf = Buffer.from(await cr.arrayBuffer())\n    66\t      iv = m.thumbIv\n    67\t    } else if (Array.isArray(m.cdnChunks) && m.cdnChunks.length) {\n    68\t      iv = m.iv\n    69\t      const bufs = await Promise.all(m.cdnChunks.map((p) =>\n    70\t        fetch(`https://cdn.jsdelivr.net/gh/matthieuhuguet/${m.cdnRepo}@${m.cdnCommit}/${p}`).then((x) => (x.ok ? x.arrayBuffer() : Promise.reject(new Error('chunk ' + x.status))))))\n    71\t      cipherBuf = Buffer.concat(bufs.map((b) => Buffer.from(b)))\n    72\t    } else {\n    73\t      iv = m.iv\n    74\t      const cdnUrl = `https://raw.githubusercontent.com/matthieuhuguet/${m.cdnRepo}/${m.cdnCommit}/${m.cdnPath}`\n    75\t      const cr = await fetch(cdnUrl)\n    76\t      if (!cr.ok) return res.status(404).end('cdn-not-found')\n    77\t      cipherBuf = Buffer.from(await cr.arrayBuffer())\n    78\t    }\n    79\t    if (!cipherBuf || !iv) return res.status(404).end('no-thumb')\n    80\t\n    81\t    const key = loadMediaKey()\n    82\t    const plain = decryptAesGcm(cipherBuf, iv, key)\n    83\t\n    84\t    const ext = kind === 'thumb' ? 'webp' : (m.ext || 'jpg').toLowerCase()\n    85\t    res.setHeader('Content-Type', mimeForExt(ext))\n    86\t    // Hash-addressed content (immutable CDN path) -> long cache is safe.\n    87\t    res.setHeader('Cache-Control', 'public, max-age=604800, immutable')\n    88\t    return res.status(200).end(plain)\n    89\t  } catch (e) {\n    90\t    return res.status(500).end('decrypt-error: ' + String((e && e.message) || e).slice(0, 120))\n    91\t  }\n    92\t}\n     1\t// GET /api/hls-download-info?path=<...media.json>\n     2\t//\n     3\t// EN CLAIR (pour tout le monde) :\n     4\t//   Le navigateur a besoin de savoir QUOI proposer dans le panneau \"Télécharger\". Cet endpoint lit la\n     5\t//   fiche de la vidéo (le .media.json), vérifie que c'est bien du HLS, fabrique un laissez-passer signé\n     6\t//   (token, durée limitée), puis renvoie : un joli nom de fichier de sortie, une commande ffmpeg prête à\n     7\t//   coller, une URL ouvrable dans VLC, et l'adresse pour télécharger le petit script. Il ne renvoie\n     8\t//   JAMAIS la clé de déchiffrement brute (plan §9 / §15).\n     9\t//\n    10\t//   Le serveur ne reconstruit JAMAIS la vidéo. Il ne fait que signer un token et composer du texte.\n    11\timport { signToken, DEFAULT_TTL_MS } from './hls-token.js'\n    12\t\n    13\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    14\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    15\t\n    16\t// path autorisé : une fiche média sous pages/, finissant par .media.json, sans remontée de dossier.\n    17\tfunction safeMediaPath(p) {\n    18\t  return typeof p === 'string' && p.startsWith('pages/') && p.endsWith('.media.json') && !p.includes('..') && !p.startsWith('/')\n    19\t}\n    20\t\n    21\t// Nom de sortie \"propre\" : pas d'espace exotique ni de caractère interdit, jamais d'injection shell.\n    22\texport function safeName(name) {\n    23\t  const base = String(name || 'video').replace(/\\.[^.]+$/, '') // retire l'extension d'origine\n    24\t  const clean = base.normalize('NFKD').replace(/[^\\w.\\- ]+/g, '').replace(/\\s+/g, '-').replace(/-+/g, '-').replace(/^[-.]+|[-.]+$/g, '')\n    25\t  return clean.slice(0, 80) || 'video'\n    26\t}\n    27\t\n    28\t// Base absolue du site (https://host) déduite des en-têtes — pour des URLs que ffmpeg/VLC peuvent ouvrir.\n    29\texport function siteBase(req) {\n    30\t  const proto = (req.headers['x-forwarded-proto'] || '').toString().split(',')[0] || (req.headers.host && /localhost|127\\.0\\.0\\.1/.test(req.headers.host) ? 'http' : 'https')\n    31\t  const host = (req.headers['x-forwarded-host'] || req.headers.host || '').toString().split(',')[0]\n    32\t  return `${proto}://${host}`\n    33\t}\n    34\t\n    35\texport default async function handler(req, res) {\n    36\t  const token = process.env.GITHUB_TOKEN\n    37\t  if (!token) return res.status(500).json({ ok: false, error: 'no-token' })\n    38\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).json({ ok: false, error: 'method' }) }\n    39\t  res.setHeader('Cache-Control', 'no-store')\n    40\t\n    41\t  const mediaPath = (req.query.path || '').toString()\n    42\t  if (!safeMediaPath(mediaPath)) return res.status(400).json({ ok: false, error: 'bad-path' })\n    43\t\n    44\t  let manifest\n    45\t  try {\n    46\t    const r = await fetch(`https://api.github.com/repos/${REPO}/contents/${encodeURI(mediaPath)}?ref=${BRANCH}`, {\n    47\t      headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.raw', 'User-Agent': 'zenray-progress' },\n    48\t    })\n    49\t    if (r.status === 404) return res.status(404).json({ ok: false, error: 'not-found' })\n    50\t    if (!r.ok) return res.status(502).json({ ok: false, error: 'github' })\n    51\t    manifest = JSON.parse(await r.text())\n    52\t  } catch { return res.status(502).json({ ok: false, error: 'read' }) }\n    53\t\n    54\t  if (!manifest || manifest.type !== 'hls') return res.status(400).json({ ok: false, error: 'not-hls' })\n    55\t\n    56\t  const name = safeName(manifest.name || mediaPath.split('/').pop())\n    57\t  const outputName = `${name}.mkv`\n    58\t  const { token: dlToken, exp } = signToken(mediaPath, DEFAULT_TTL_MS)\n    59\t  const base = siteBase(req)\n    60\t  const cliUrl = `${base}/api/hls-cli?token=${encodeURIComponent(dlToken)}`\n    61\t  // -map 0 -c copy = on prend toutes les pistes (vidéo + audios + sous-titres) sans réencoder, juste remux.\n    62\t  const ffmpegCommand = `ffmpeg -hide_banner -stats -i \"${cliUrl}\" -map 0 -c copy \"${outputName}\"`\n    63\t  const scriptUrl = `${base}/api/hls-download-script?path=${encodeURIComponent(mediaPath)}&format=zip`\n    64\t\n    65\t  return res.status(200).json({\n    66\t    ok: true,\n    67\t    name,\n    68\t    outputName,\n    69\t    format: 'mkv',\n    70\t    expiresAt: new Date(exp).toISOString(),\n    71\t    hlsUrl: cliUrl,\n    72\t    vlcUrl: cliUrl,\n    73\t    ffmpegCommand,\n    74\t    scriptUrl,\n    75\t  })\n    76\t}\n   150\t    ch.writeUInt32LE(crc, 16)\n   151\t    ch.writeUInt32LE(size, 20)\n   152\t    ch.writeUInt32LE(size, 24)\n   153\t    ch.writeUInt16LE(nameBuf.length, 28)\n   154\t    ch.writeUInt16LE(0, 30)            // extra\n   155\t    ch.writeUInt16LE(0, 32)            // comment\n   156\t    ch.writeUInt16LE(0, 34)            // disk\n   157\t    ch.writeUInt16LE(0, 36)            // internal attrs\n   158\t    const unix = (f.unix || 0o644) & 0xFFFF\n   159\t    ch.writeUInt32LE((unix << 16) >>> 0, 38) // external attrs = mode unix dans les 16 bits hauts\n   160\t    ch.writeUInt32LE(offset, 42)       // offset of local header\n   161\t    centrals.push(ch, nameBuf)\n   162\t    offset += lh.length + nameBuf.length + f.data.length\n   163\t  }\n   164\t  const localPart = Buffer.concat(locals)\n   165\t  const centralPart = Buffer.concat(centrals)\n   166\t  const end = Buffer.alloc(22)\n   167\t  end.writeUInt32LE(0x06054b50, 0)\n   168\t  end.writeUInt16LE(0, 4)\n   169\t  end.writeUInt16LE(0, 6)\n   170\t  end.writeUInt16LE(files.length, 8)\n   171\t  end.writeUInt16LE(files.length, 10)\n   172\t  end.writeUInt32LE(centralPart.length, 12)\n   173\t  end.writeUInt32LE(localPart.length, 16)\n   174\t  end.writeUInt16LE(0, 20)\n   175\t  return Buffer.concat([localPart, centralPart, end])\n   176\t}\n   177\t\n   178\texport default async function handler(req, res) {\n   179\t  const ghToken = process.env.GITHUB_TOKEN\n   180\t  if (!ghToken) return res.status(500).end()\n   181\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n   182\t  res.setHeader('Cache-Control', 'no-store')\n   183\t\n   184\t  const mediaPath = (req.query.path || '').toString()\n   185\t  if (!safeMediaPath(mediaPath)) return res.status(400).json({ ok: false, error: 'bad-path' })\n   186\t  const format = (req.query.format || 'zip').toString()\n   187\t\n   188\t  let manifest\n   189\t  try {\n   190\t    const r = await fetch(`https://api.github.com/repos/${REPO}/contents/${encodeURI(mediaPath)}?ref=${BRANCH}`, {\n   191\t      headers: { Authorization: `Bearer ${ghToken}`, Accept: 'application/vnd.github.raw', 'User-Agent': 'zenray-progress' },\n   192\t    })\n   193\t    if (r.status === 404) return res.status(404).json({ ok: false, error: 'not-found' })\n   194\t    if (!r.ok) return res.status(502).json({ ok: false, error: 'github' })\n   195\t    manifest = JSON.parse(await r.text())\n   196\t  } catch { return res.status(502).json({ ok: false, error: 'read' }) }\n   197\t  if (!manifest || manifest.type !== 'hls') return res.status(400).json({ ok: false, error: 'not-hls' })\n   198\t\n   199\t  const name = safeName(manifest.name || mediaPath.split('/').pop())\n   200\t  const outName = `${name}.mkv`\n   201\t  // TTL long (3 h) pour les scripts : un remux de longue video ne doit pas expirer en cours de route (plan §12).\n   202\t  const { token, exp } = signToken(mediaPath, MAX_TTL_MS)\n   203\t  const expIso = new Date(exp).toISOString()\n   204\t  const cliUrl = `${siteBase(req)}/api/hls-cli?token=${encodeURIComponent(token)}`\n   205\t\n   206\t  const cmd = commandScript(cliUrl, outName)\n   207\t  const sh = shScript(cliUrl, outName)\n   208\t  const ps1 = ps1Script(cliUrl, outName)\n   209\t\n   210\t  const attach = (filename, type, body) => {\n   211\t    res.setHeader('Content-Type', type)\n   212\t    res.setHeader('Content-Disposition', `attachment; filename=\"${filename}\"`)\n   213\t    res.setHeader('Content-Length', String(Buffer.byteLength(body)))\n   214\t    return res.status(200).send(body)\n   215\t  }\n   216\t\n   217\t  if (format === 'command') return attach('download.command', 'text/x-shellscript', cmd)\n   218\t  if (format === 'sh') return attach('download.sh', 'text/x-shellscript', sh)\n   219\t  if (format === 'ps1') return attach('download.ps1', 'text/plain; charset=utf-8', ps1)\n   220\t\n   221\t  // format=zip (defaut) : bundle complet.\n   222\t  const files = [\n   223\t    { name: 'README.txt', data: Buffer.from(readme(outName, expIso), 'utf8'), unix: 0o644 },\n   224\t    { name: 'download.command', data: Buffer.from(cmd, 'utf8'), unix: 0o755 },\n   225\t    { name: 'download.sh', data: Buffer.from(sh, 'utf8'), unix: 0o755 },\n   226\t    { name: 'download.ps1', data: Buffer.from(ps1, 'utf8'), unix: 0o644 },\n   227\t    { name: 'video.url.txt', data: Buffer.from(cliUrl + '\\n', 'utf8'), unix: 0o644 },\n   228\t  ]\n   229\t  const zip = zipStore(files)\n   230\t  res.setHeader('Content-Type', 'application/zip')\n   231\t  res.setHeader('Content-Disposition', `attachment; filename=\"ZenRay-${name}.zip\"`)\n   232\t  res.setHeader('Content-Length', String(zip.length))\n   233\t  return res.status(200).send(zip)\n   234\t}\n     1\t// Sert la CLÉ AES-128 de déchiffrement HLS, depuis le repo PRIVÉ zenray-data, AVEC un garde-fou.\n     2\t//\n     3\t// EN CLAIR (pour tout le monde) :\n     4\t//   Les morceaux de vidéo (segments) sont publics mais CHIFFRÉS : sans la clé, c'est du bruit illisible.\n     5\t//   La clé, elle, n'est JAMAIS publique. Elle vit dans un dépôt privé. Quand le lecteur du site veut lire\n     6\t//   la vidéo, hls.js demande la clé à CETTE adresse. Le serveur va la chercher dans le dépôt privé avec son\n     7\t//   token secret, vérifie que la demande vient bien du site (et pas d'un pillard externe), puis la renvoie.\n     8\t//\n     9\t// CE QU'IL FAIT :\n    10\t//   GET /api/hls-key?v=<base|path>\n    11\t//     - <base>  : nom de la vidéo (ex \"MonFilm\")        -> clé lue dans pages/Videos/<base>/.hlskey.bin\n    12\t//     - <path>  : chemin complet de la clé dans le repo  -> doit rester sous pages/Videos/ et finir par .hlskey.bin\n    13\t//   Renvoie les 16 octets bruts en application/octet-stream.\n    14\t//\n    15\t// LE GARDE-FOU (gate) — honnêteté sur la LIMITE :\n    16\t//   On n'a PAS de système de login. On ne peut donc pas authentifier un utilisateur. Le seul rempart possible\n    17\t//   sans login est de vérifier l'EN-TÊTE Origin/Referer de la requête : un navigateur honnête envoie l'origine\n    18\t//   de la page qui fait le fetch. On n'accepte que les origines du site (ALLOWED_ORIGINS) OU le même domaine\n    19\t//   que la requête (same-origin), plus le localhost de dev. CORS est renvoyé en miroir pour que hls.js du site\n    20\t//   puisse lire la réponse.\n    21\t//   LIMITE RÉELLE : Origin/Referer est posé par le navigateur, pas infalsifiable hors navigateur (un curl peut\n    22\t//   mentir). Ce gate bloque l'usage de la clé par un AUTRE SITE dans un vrai navigateur (le cas courant du vol\n    23\t//   de bande passante / hotlinking), pas un attaquant déterminé en ligne de commande. Pour un vrai secret, il\n    24\t//   faudrait un login + clé signée à durée de vie courte. Ici l'objectif est : segments publics anonymisés +\n    25\t//   clé non énumérable + non hotlinkable depuis un autre site. C'est le bon compromis sans backend d'auth.\n    26\timport { verifyToken } from './hls-token.js'\n    27\t\n    28\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n    29\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    30\tconst VIDEOS_PREFIX = 'pages/'\n    31\tconst KEY_FILE = '.hlskey.bin'\n    32\t\n    33\t// Domaines autorisés à fetcher la clé. Le domaine de prod du site est ajoutable via SITE_ORIGINS (CSV).\n    34\t// localhost couvre le dev (local-server.mjs sur n'importe quel port).\n    35\tfunction allowedOrigins() {\n    36\t  const fromEnv = (process.env.SITE_ORIGINS || '').split(',').map((s) => s.trim()).filter(Boolean)\n    37\t  return new Set([...fromEnv])\n    38\t}\n    39\tconst isLocalhost = (origin) => /^https?:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?$/i.test(origin || '')\n    40\t\n    41\t// Résout le param ?v= en chemin de clé dans le repo. Refuse tout ce qui sort de pages/Videos/.\n    42\tfunction keyPathFor(v) {\n    43\t  if (!v || typeof v !== 'string') return null\n    44\t  if (v.includes('..') || v.startsWith('/')) return null\n    45\t  // cas 1 : chemin complet déjà fourni (doit pointer la clé sous pages/Videos/)\n    46\t  if (v.startsWith(VIDEOS_PREFIX)) {\n    47\t    if (!v.endsWith(KEY_FILE)) return null\n    48\t    return v\n    49\t  }\n    50\t  // cas 2 : base name simple (ou sous-dossier relatif sous Videos) -> on compose le chemin canonique\n    51\t  if (/[\\\\:]/.test(v)) return null\n    52\t  return `${VIDEOS_PREFIX}${v}/${KEY_FILE}`\n    53\t}\n    54\t\n    55\t// Origine effective de la requête (Origin sinon dérivée du Referer).\n    56\tfunction requestOrigin(req) {\n    57\t  const o = req.headers.origin\n    58\t  if (o) return o\n    59\t  const ref = req.headers.referer || req.headers.referrer\n    60\t  if (ref) { try { const u = new URL(ref); return `${u.protocol}//${u.host}` } catch { /* ignore */ } }\n    61\t  return null\n    62\t}\n    63\t\n    64\texport default async function handler(req, res) {\n    65\t  const token = process.env.GITHUB_TOKEN\n    66\t  if (!token) return res.status(500).end()\n    67\t  if (req.method === 'OPTIONS') {\n    68\t    // préflight CORS éventuel\n    69\t    const o = requestOrigin(req)\n    70\t    if (o) res.setHeader('Access-Control-Allow-Origin', o)\n    71\t    res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS')\n    72\t    res.setHeader('Access-Control-Allow-Headers', 'Range')\n    73\t    return res.status(204).end()\n    74\t  }\n    75\t  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n    76\t\n    77\t  // --- VOIE 1 : token de download (plan §12) -----------------------------------------------------\n    78\t  //   ffmpeg/VLC en ligne de commande n'envoient pas d'Origin. On les laisse passer s'ils présentent un\n    79\t  //   token signé valide et non expiré (?token=...). Le token est lié à UNE vidéo et à durée limitée ; la\n    80\t  //   clé n'est de toute façon utile qu'avec les segments de cette vidéo. Si pas de token -> gate Origin.\n    81\t  const dlToken = (req.query.token || '').toString()\n    82\t  let tokenOk = false\n    83\t  if (dlToken) {\n    84\t    const v = verifyToken(dlToken)\n    85\t    // un token valide doit viser une fiche média ; la clé demandée doit rester sous pages/Videos/.\n    86\t    if (v.ok && typeof v.path === 'string' && v.path.startsWith('pages/') && v.path.endsWith('.media.json')) tokenOk = true\n    87\t    else if (!v.ok && v.reason === 'expired') return res.status(410).end()\n    88\t  }\n    89\t\n    90\t  // --- VOIE 2 : gate Origin/Referer : refuse les fetch venant d'un autre site (anti-hotlinking) ----\n    91\t  const origin = requestOrigin(req)\n    92\t  const allow = allowedOrigins()\n    93\t  if (!tokenOk) {\n    94\t    // Pas d'Origin/Referer du tout : navigation directe / certains clients. On l'AUTORISE seulement si\n    95\t    // aucune liste de domaines n'est configurée (mode dev permissif) ; sinon on exige une origine connue.\n    96\t    const sameSite = origin && (allow.has(origin) || isLocalhost(origin) || (req.headers.host && origin === `https://${req.headers.host}`) || (req.headers.host && origin === `http://${req.headers.host}`))\n    97\t    if (origin) {\n    98\t      if (!sameSite) return res.status(403).end()\n    99\t      res.setHeader('Access-Control-Allow-Origin', origin)\n   100\t      res.setHeader('Vary', 'Origin')\n   101\t    } else if (allow.size > 0) {\n   102\t      // domaines configurés mais requête sans origine et sans token -> on refuse (probable accès hors navigateur).\n   103\t      return res.status(403).end()\n   104\t    }\n   105\t  } else if (origin) {\n   106\t    // token valide ET origine présente (cas navigateur authentifié par token) : on renvoie le CORS miroir.\n   107\t    res.setHeader('Access-Control-Allow-Origin', origin)\n   108\t    res.setHeader('Vary', 'Origin')\n   109\t  }\n   110\t\n   111\t  const keyPath = keyPathFor((req.query.v || '').toString())\n   112\t  if (!keyPath) return res.status(400).end()\n   113\t\n   114\t  try {\n   115\t    // LECTURE DU BINAIRE — POURQUOI EN DEUX TEMPS :\n   116\t    //   La Contents API de GitHub CORROMPT le binaire (elle traite le contenu comme du texte : les octets\n   117\t    //   hauts deviennent U+FFFD, un blob de 16 octets ressort à ~30 octets), que ce soit en mode raw OU en\n   118\t    //   JSON base64. La SEULE lecture fiable d'un binaire est la git/blobs API. On l'utilise donc :\n   119\t    //     1) Contents API juste pour récupérer le SHA du fichier (la métadonnée .sha est fiable) ;\n   120\t    //     2) git/blobs/<sha> pour récupérer le contenu base64 INTACT, qu'on décode nous-mêmes.\n   121\t    const meta = await fetch(`https://api.github.com/repos/${REPO}/contents/${encodeURI(keyPath)}?ref=${BRANCH}`, {\n   122\t      headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' },\n   123\t    })\n   124\t    if (!meta.ok) return res.status(meta.status === 404 ? 404 : 502).end()\n   125\t    const sha = (await meta.json()).sha\n   126\t    if (!sha) return res.status(502).end()\n   127\t    const r = await fetch(`https://api.github.com/repos/${REPO}/git/blobs/${sha}`, {\n   128\t      headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' },\n   129\t    })\n   130\t    if (!r.ok) return res.status(502).end()\n   131\t    const j = await r.json()\n   132\t    const buf = Buffer.from(j.content || '', j.encoding === 'base64' ? 'base64' : 'utf8')\n   133\t    if (buf.length !== 16) return res.status(502).end() // une clé AES-128 fait exactement 16 octets\n   134\t    res.setHeader('Content-Type', 'application/octet-stream')\n   135\t    res.setHeader('Cache-Control', 'no-store') // la clé ne se met jamais en cache CDN\n   136\t    res.setHeader('Content-Length', String(buf.length))\n   137\t    return res.status(200).send(buf)\n   138\t  } catch { return res.status(500).end() }\n   139\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f671b-d4fe-76d0-a6f4-1f8b5364967c"}}}
