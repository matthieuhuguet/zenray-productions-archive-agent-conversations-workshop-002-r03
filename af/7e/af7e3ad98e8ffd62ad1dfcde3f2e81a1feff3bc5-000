\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n    20\tconst OWNER = 'matthieuhuguet'\n    21\t\n    22\tconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n    23\t\n    24\tasync function readManifest(token, p) {\n    25\t  try {\n    26\t    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(p)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    27\t    if (!r.ok) return null\n    28\t    return await r.json()\n    29\t  } catch { return null }\n    30\t}\n    31\tasync function treeUnder(token, dir) {\n    32\t  try {\n    33\t    const r = await fetch(`https://api.github.com/repos/${REPO}/git/trees/${BRANCH}?recursive=1`, { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' } })\n    34\t    if (!r.ok) return []\n    35\t    const j = await r.json()\n    36\t    const pre = dir + '/'\n    37\t    return (j.tree || []).filter((x) => x.type === 'blob' && x.path.startsWith(pre)).map((x) => x.path)\n    38\t  } catch { return [] }\n    39\t}\n    40\tconst baseName = (p) => { const n = p.split('/').pop(); return n.replace(/\\.(mp4|mov|m4v|avi|mkv)\\.media\\.json$/i, '').replace(/\\.[^.]+\\.(img|media|file)\\.json$/i, '').replace(/\\.[^.]+$/, '') }\n    41\t\n    42\t// Construit { title, description, image, url } pour le type de partage demandé. `image` doit être une URL\n    43\t// ABSOLUE (les crawlers ne résolvent pas les chemins relatifs) et directement fetchable sans JS/auth.\n    44\tasync function metaFor(token, origin, type, q) {\n    45\t  const DEFAULT = { title: 'ZenRayProgress — Matthieu Huguet', description: 'ZenRayProgress — LifeOS de Matthieu Huguet : objectifs, séquence de cartes et agenda hebdomadaire, persistant.', image: `${origin}/favicon.png`, url: origin }\n    46\t  try {\n    47\t    if (type === 'watch') {\n    48\t      const rawToken = (q.v || '').toString()\n    49\t      const p = (await resolveShareToken(rawToken, { expectedKind: 'video' })).path\n    50\t      if (!p) return DEFAULT\n    51\t      const m = await readManifest(token, p)\n    52\t      if (!m) return DEFAULT\n    53\t      const title = m.title || baseName(p)\n    54\t      return { title, description: `Vidéo ZenRay${m.duration ? ` · ${Math.floor(m.duration / 60)}:${String(Math.round(m.duration % 60)).padStart(2, '0')}` : ''}`, image: m.poster || DEFAULT.image, url: `${origin}/watch?v=${encodeURIComponent(q.v)}` }\n    55\t    }\n    56\t    if (type === 'view') {\n    57\t      const rawToken = (q.v || '').toString()\n    58\t      const p = (await resolveShareToken(rawToken, { expectedKind: 'image' })).path\n    59\t      if (!p) return DEFAULT\n    60\t      const m = await readManifest(token, p)\n    61\t      if (!m) return DEFAULT\n    62\t      const title = baseName(p)\n    63\t      const image = m.thumb ? `${origin}/api/shared-media?path=${encodeURIComponent(p)}&kind=thumb&share=${encodeURIComponent(rawToken)}` : DEFAULT.image\n    64\t      return { title, description: 'Image partagée sur ZenRay', image, url: `${origin}/view?v=${encodeURIComponent(q.v)}` }\n    65\t    }\n    66\t    if (type === 'folder') {\n    67\t      const rawToken = (q.d || '').toString()\n    68\t      const dir = (await resolveShareToken(rawToken, { expectedKind: 'folder' })).path\n    69\t      if (!dir) return DEFAULT\n    70\t      const title = dir.split('/').pop()\n    71\t      const children = await treeUnder(token, dir)\n    72\t      // 1re image ou 1re vidéo (avec poster) trouvée -> vignette représentative de la galerie.\n    73\t      let image = DEFAULT.image\n    74\t      for (const c of children) {\n    75\t        if (c.endsWith('.img.json')) {\n    76\t          const m = await readManifest(token, c)\n    77\t          if (m && m.thumb) { image = `${origin}/api/shared-media?path=${encodeURIComponent(c)}&kin