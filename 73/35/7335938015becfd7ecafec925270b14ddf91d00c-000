ard.sh install-root`), qui désactive l'incognito Chrome et pose la policy Chrome. Sinon, ajuster la liste `BLOCKED_PATTERNS` au fil de l'usage."},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":295,"cache_read_input_tokens":259962,"output_tokens":1872,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":295,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1872,"cache_read_input_tokens":259962,"cache_creation_input_tokens":295,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":295},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcraK4Mu1NKNkGa2pYvPb","type":"assistant","uuid":"1ae209dc-8284-41fc-af3c-588bdb101916","timestamp":"2026-07-09T13:38:26.757Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"6b5850df-ed76-4f8a-abbb-20924e727fbf","version":"2.1.202","gitBranch":"main"}
