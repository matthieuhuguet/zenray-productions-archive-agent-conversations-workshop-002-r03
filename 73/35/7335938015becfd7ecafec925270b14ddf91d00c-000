{"parentUuid":"ceb86200-55a6-4685-8e58-10003ac8793e","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_011Ccrb1u3hmgTHTrpo1ygP5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GbCUBnbRiL6YEdhkHNMg4a","name":"Write","input":{"file_path":"/Users/zenray/Create/Build/Memory/Tools/FocusGuard/SocialMediaGuard.sh","content":"#!/bin/zsh\nset -euo pipefail\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\n# ═══════════════════════════════════════════════════════════════════════════\n#  SOCIAL MEDIA GUARD\n#  Ferme en continu les créateurs (YouTube + Instagram/TikTok/X/Facebook) que\n#  Matthieu a choisi de ne plus regarder. Au lieu d'un blocage sec, l'onglet\n#  bascule sur une page à compte à rebours : après WAIT_MINUTES, un bouton\n#  ouvre le contenu pour REWARD_MINUTES, puis l'onglet est de nouveau fermé.\n#\n#  Plan du fichier :\n#    1. Configuration          — chemins, durées, navigateurs\n#    2. Liste des créateurs    — BLOCKED_PATTERNS (source unique éditable)\n#    3. Outils                 — dates, texte, encodage URL\n#    4. Fichiers & migration   — dossiers, mot de passe, anciens noms\n#    5. On / Off               — désactivé, suspendu, fenêtre horaire\n#    6. Moteur de décision     — un texte correspond-il à un créateur bloqué ?\n#    7. Récompense (grâce)     — accès temporaire gagné, par créateur\n#    8. Page de blocage        — le HTML affiché dans l'onglet\n#    9. Contrôle navigateurs   — lister les onglets, en rediriger un\n#   10. Boucle de surveillance — la passe qui tourne toutes les 2 s\n#   11. Installation           — service utilisateur (+ couche root optionnelle)\n#   12. Commandes              — status, suspend, disable/enable, uninstall\n#   13. Point d'entrée         — aiguillage de la ligne de commande\n#\n#  Usage : SocialMediaGuard.sh <commande>\n#    install-user | status | enable | disable | suspend [min] |\n#    enforce | watch-tabs | close-tabs | uninstall-user |\n#    install-root | uninstall-root | cleanup-root\n# ═══════════════════════════════════════════════════════════════════════════\n\n\n# ── 1. Configuration ───────────────────────────────────────────────────────\n\nOWNER=\"zenray\"\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\n\nSECRET_FILE=\"$FOCUS_DIR/.SocialMediaGuardPassword\"     # mot de passe local (git-ignoré)\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"          # état interne (git-ignoré)\nDISABLED_FILE=\"$STATE_DIR/disabled\"                    # présent = garde-fou coupé\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"                # epoch de fin de suspension\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"   # la page affichée dans l'onglet\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\nILLUSTRATION_URL=\"file://$MEMORY_ROOT/ArtDirection/output_v3.png\"\n\n# Durées (réglables via variables d'environnement dans le plist).\nWAIT_MINUTES=\"${SMG_WAIT_MINUTES:-30}\"      # attente avant de pouvoir ouvrir\nREWARD_MINUTES=\"${SMG_REWARD_MINUTES:-30}\"  # durée d'accès une fois gagné\nSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # fenêtre active : 0→24 = permanent\nEND_HOUR=\"${SMG_END_HOUR:-24}\"\n\n# Service de fond (LaunchAgent).\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\nUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n\n# Couche root optionnelle (hosts + policy Chrome), inactive sans sudo.\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\n# Navigateurs pilotés. Tous les Chromium partagent le vocabulaire AppleScript\n# de Google Chrome (« using terms from »), Safari a le sien.\nCHROMIUM_BROWSERS=(\n  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n  \"Vivaldi\" \"Opera\" \"Opera GX\"\n)\n\n\n# ── 2. Liste des créateurs bloqués (source unique de vérité) ────────────────\n#\n# Chaque motif est cherché en sous-chaîne, insensible à la casse ET aux\n# séparateurs (voir Normalize), dans deux choses :\n#   1) l'URL de l'onglet, tous réseaux confondus — bloque YouTube, Instagram,\n#      TikTok, Facebook et X dès que le motif est le pseudo du compte ;\n#   2) l'identité renvoyée par yt-dlp pour une page /watch (nom de chaîne,\n#      uploader…) — attrape toutes les vidéos et chaînes secondaires d'un\n#      créateur, même sans connaître leur pseudo exact.\n# Sûreté : un motif qui ne correspond à rien ne bloque rien (échec bénin).\n# On peut donc être large sur les NOMS et rester précis (pseudo concaténé ou\n# URL) pour ne jamais bloquer un tiers par erreur.\n\nBLOCKED_PATTERNS=(\n  # --- Ici Japon ---\n  \"youtube.com/@icijaponcorp\"  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"  \"ici japon\"\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"  \"siliconcarne\"  \"silicon carne\"  \"carlosdiaz\"  \"carlos diaz\"\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"  \"oussamaammar\"  \"oussama ammar\"\n  # --- Yomi Denzel ---\n  \"youtube.com/@yomidenzel\"  \"youtube.com/yomidenzel\"  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n  \"yomidenzel\"  \"yomi.denzel\"  \"yomi denzel\"\n  # --- Antoine Blanco (+ chaîne business) ---\n  \"youtube.com/@antoineblanco\"  \"youtube.com/@antoineblanco99\"  \"youtube.com/@antoineblancobusiness\"\n  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"  \"antoineblanco\"  \"antoine blanco\"\n  # --- Sixtine Moullé-Berteaux ---\n  \"youtube.com/@sixtinemoulleberteaux\"  \"sixtinemoulleberteaux\"  \"sixtine.moulleberteaux\"\n  \"sixtine moulle\"  \"sixtine moullé\"\n  # --- Wallerand Moullé-Berteaux ---\n  \"wallerandmoulleberteaux\"  \"wallerand.moulleberteaux\"  \"wallerand moulle\"  \"wallerand moullé\"\n  # --- Eric Larchevêque ---\n  \"ericlarcheveque\"  \"eric larcheveque\"  \"eric l'archeveque\"  \"eric larchevêque\"\n  # --- Guillaume Moubèche ---\n  \"guillaumemoubeche\"  \"guillaume moubeche\"  \"guillaume moubèche\"\n  # --- Alex Hitchens (+ chaînes secondaires via identité) ---\n  \"alexhitchens\"  \"alex hitchens\"\n  # --- Julien Chieze (actu jeux vidéo) ---\n  \"julienchieze\"  \"julien chieze\"\n  # --- HugoDécrypte (actu, toutes ses chaînes) ---\n  \"youtube.com/@hugodecrypte\"  \"youtube.com/@hugodecrypteactus\"  \"youtube.com/@hugodecryptegrandsformats\"\n  \"hugodecrypte\"  \"hugo decrypte\"  \"hugo décrypte\"\n  # --- Le Crayon (actu/médias) ---\n  \"youtube.com/@lecrayon\"  \"le crayon\"\n  # --- La Chapelle Radio / Hugo Bentz ---\n  \"youtube.com/@la-chapelle-radio-hugo-bentz\"  \"la chapelle radio\"  \"hugo bentz\"\n  # --- Matthieu Stefani / Génération Do It Yourself ---\n  \"matthieu stefani\"  \"generation do it yourself\"  \"génération do it yourself\"  \"gdiy\"\n  # --- Pauline Laigneau ---\n  \"youtube.com/@paulinelaigneau\"  \"pauline laigneau\"\n  # --- Les Découvreurs ---\n  \"youtube.com/@les_decouvreurs\"  \"les decouvreurs\"  \"les découvreurs\"\n  # --- Théophile Eliet (pseudo à tiret, géré par Normalize) ---\n  \"youtube.com/@theophile-eliet\"  \"theophile eliet\"  \"théophile eliet\"\n  # --- Le Précepteur ---\n  \"le precepteur\"  \"le précepteur\"\n  # --- My Better Self ---\n  \"mybetterself\"  \"my better self\"\n  # --- LouisSan (+ chaînes secondaires : LouisSanCorp…) ---\n  \"louissan\"  \"louissancorp\"\n  # --- Sphère business / make-money / mindset / manosphère (NOMS seuls) ---\n  \"iman gadzhi\"  \"imangadzhi\"  \"andrew tate\"  \"tristan tate\"  \"cobratate\"\n  \"enzo honore\"  \"enzo honoré\"  \"franck nicolas\"  \"idriss aberkane\"  \"anthony bourbon\"\n  \"hasheur\"  \"owen simonin\"  \"lorenzo ferrante\"  \"mick levy\"  \"younes belghazi\"\n  \"yann darwin\"  \"yan darwin\"  \"raoul pop\"  \"david laroche\"  \"fabien snauwaert\"\n  \"romain pichon\"  \"tugan bara\"  \"tugan.baranovsky\"  \"morgan prével\"  \"morgan prevel\"\n  \"valentin decker\"  \"jean rivière\"  \"jeremy kohlmann\"  \"aurelien amacker\"  \"aurélien amacker\"\n  \"squeezie\"  \"naval ravikant\"  \"navalravikant\"  \"laurent alexandre\"  \"alexandre cicoupoulos\"\n)\n\n\n# ── 3. Outils ──────────────────────────────────────────────────────────────\n\nSay()      { printf '%s\\n' \"$*\"; }\nNowEpoch() { date '+%s'; }\n\n# Retire casse ET séparateurs : « Theophile-Eliet », « theophile.eliet » et\n# « theophile eliet » deviennent tous « theophileeliet ». Un seul endroit qui\n# neutralise toute la classe de bugs de séparateur (tiret vs point vs espace).\nNormalize() {\n  local s=\"${1:l}\"\n  printf '%s' \"${s//[-._ ]/}\"\n}\n\nUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\nUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))'         \"$1\"; }\n\n# Valeur (décodée) d'un paramètre $2 dans la query string de l'URL $1.\nExtractParam() {\n  local u=\"$1\" name=\"$2\" q pair\n  q=\"${u#*\\?}\"\n  [[ \"$q\" == \"$u\" ]] && return 0          # pas de '?' -> aucune query\n  for pair in ${(s:&:)q}; do\n    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n  done\n}\n\n# Version normalisée de chaque motif, calculée UNE fois au chargement (pas dans\n# la boucle qui tourne toutes les 2 s) pour éviter des dizaines de forks inutiles.\nNORMALIZED_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\"); done\nunset _p\n\n\n# ── 4. Fichiers & migration ────────────────────────────────────────────────\n\n# Renomme les fichiers des anciennes versions (YouTube*, puis SocialMediaFocus*)\n# vers les noms actuels, pour ne pas perdre le mot de passe local ni la grâce en\n# cours. Idempotent : après migration les anciens n'existent plus. N'écrase\n# jamais un fichier déjà présent au nouveau nom.\nMigrateLegacy() {\n  local old\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardPassword\" \"$FOCUS_DIR/.YouTubeFocusGuardPassword\"; do\n    [[ -f \"$old\" && ! -f \"$SECRET_FILE\" ]] && mv \"$old\" \"$SECRET_FILE\" 2>/dev/null\n  done\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardState\" \"$FOCUS_DIR/.YouTubeFocusGuardState\"; do\n    [[ -d \"$old\" && ! -d \"$STATE_DIR\" ]] && mv \"$old\" \"$STATE_DIR\" 2>/dev/null\n  done\n  rm -f \"$FOCUS_DIR/YouTubeBlocked.html\" 2>/dev/null\n  return 0\n}\n\nEnsureDirs() {\n  MigrateLegacy\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\n# Génère un mot de passe local au premier lancement (Matthieu ne le mémorise\n# pas ; l'assistant le relit sur disque si un vrai déblocage est nécessaire).\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    chown \"${OWNER}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\n# Barrière anti-réflexe pour les commandes sensibles (suspend/disable/uninstall).\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${SMG_PASSWORD:-}\" ]]; then\n    input=\"$SMG_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo; IFS= read -r input; stty echo\n    printf '\\n' >&2\n  fi\n  [[ \"$input\" == \"$expected\" ]] || { Say \"Wrong focus password.\"; exit 2; }\n}\n\n\n# ── 5. On / Off ────────────────────────────────────────────────────────────\n\nIsDisabled() { [[ -f \"$DISABLED_FILE\" ]]; }\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until; until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Fenêtre horaire active (par défaut 0→24, donc toujours).\nIsProtectedNow() {\n  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\n# Faut-il bloquer maintenant ? Non si coupé ou suspendu ou hors fenêtre.\nShouldBlock() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\n\n# ── 6. Moteur de décision : ce texte correspond-il à un créateur bloqué ? ───\n\n# Test élémentaire, forme brute OU forme normalisée. GrantGrace (§7) et\n# TextMatchesBlocked (ci-dessous) l'utilisent tous les deux : ils DOIVENT\n# s'accorder sur « quels motifs ce texte déclenche », sinon une récompense\n# accordée laisserait passer un motif qui ne matche qu'après normalisation\n# (ex. « silicon carne » avec espace) -> reblocage immédiat malgré la grâce.\nPatternMatches() {\n  local lpattern=\"$1\" npattern=\"$2\" text=\"$3\" ntext=\"$4\"\n  [[ \"$text\" == *\"$lpattern\"* ]] && return 0\n  [[ -n \"$npattern\" && \"$ntext\" == *\"$npattern\"* ]] && return 0\n  return 1\n}\n\n# Vrai si le texte (URL ou identité yt-dlp) désigne un créateur bloqué ET\n# non couvert par une récompense en cours.\nTextMatchesBlocked() {\n  local raw=\"$1\" text=\"${1:l}\" ntext anyGrace=0 i n\n  local -a graceFiles\n  ntext=\"$(Normalize \"$raw\")\"\n  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$text\" \"$ntext\"; then\n      (( anyGrace )) && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\" && continue\n      return 0\n    fi\n  done\n  return 1\n}\n\n# Pages YouTube dont yt-dlp peut résoudre la vraie chaîne (une vidéo ne porte\n# pas toujours le pseudo dans son URL).\nIsResolvableYouTubeUrl() {\n  local url=\"${1:l}\"\n  case \"$url\" in\n    *youtube.com/watch\\?*|*youtube.com/shorts/*|*youtube.com/live/*|*youtube.com/post/*|*youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Identité réelle derrière une URL YouTube : d'abord un test direct sur l'URL\n# (pseudo visible), sinon interrogation yt-dlp (nom de chaîne, uploader…),\n# mise en cache pour ne pas refaire l'appel réseau à chaque passe.\nYouTubeIdentityForUrl() {\n  local url=\"$1\"\n  TextMatchesBlocked \"$url\" && { printf '%s\\n' \"$url\"; return 0; }\n  IsResolvableYouTubeUrl \"$url\" || return 1\n\n  local ytdlp cacheDir cache json identity\n  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n  [[ -n \"$ytdlp\" ]] || return 1\n\n  cacheDir=\"$STATE_DIR/youtube-identity-cache\"; mkdir -p \"$cacheDir\"\n  cache=\"$cacheDir/$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}').txt\"\n  [[ -s \"$cache\" ]] && { cat \"$cache\"; return 0; }\n\n  json=\"$(\"$ytdlp\" --dump-single-json --no-playlist --skip-download \\\n    --socket-timeout 4 --extractor-retries 1 --retries 1 \"$url\" 2>/dev/null || true)\"\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n      .uploader_url, .creator, .webpage_url, .original_url ]\n    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n\n# ── 7. Récompense (grâce) : accès temporaire gagné, par créateur ────────────\n\n# Chemin du marqueur de grâce d'un motif (nom de fichier sûr, sans fork shasum).\nGraceFileFor() {\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n}\n\n# Vrai si ce motif bénéficie d'une récompense encore valable.\nPatternIsGraced() {\n  local f until; f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Accorde REWARD_MINUTES à tous les motifs que l'URL cible déclenche — et à eux\n# seuls : gagner l'accès à un créateur ne débloque jamais les autres.\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\" \\\n      && printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n  done\n}\n\n# URL de la page de blocage pour une cible, horodatée (permet de recalculer le\n# temps restant même après un rechargement de l'onglet).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n\n# ── 8. Page de blocage (le HTML affiché dans l'onglet) ─────────────────────\n# Anglais, ton neutre. Chiffres en Anthropic Serif, texte en Anthropic Sans.\n\nEnsureBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  /* Les chiffres : toujours en Serif. */\n  .timer { font-family:\"AnthropicSerif\", serif; font-weight:300;\n           font-size:clamp(64px, 12vw, 168px); line-height:1; color:#f4f4f4;\n           font-variant-numeric:tabular-nums; margin:0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .head { font-weight:300; font-size:clamp(22px, 2.4vw, 34px); color:#efefef; margin:6px 0 0 }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n  <section id=\"waitBox\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"timer\" id=\"countdown\">--:--</p>\n    <p class=\"cap\">until this opens</p>\n  </section>\n  <section id=\"rewardBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Time's up.</p>\n    <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open now</a>\n    <p class=\"cap\">Open for <span class=\"num\">$REWARD_MINUTES</span> min, then it closes.</p>\n  </section>\n  <section id=\"closedBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Closed.</p>\n  </section>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || '';\n  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n  var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n  var waitBox = document.getElementById('waitBox');\n  var rewardBox = document.getElementById('rewardBox');\n  var closedBox = document.getElementById('closedBox');\n  if (!target || !startedSec) { waitBox.style.display = 'none'; closedBox.style.display = 'block'; return; }\n  var el = document.getElementById('countdown');\n  function fmt(s) { var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }\n  function tick() {\n    var remain = WAIT_SECONDS - (Math.floor(Date.now()/1000) - startedSec);\n    if (remain <= 0) {\n      waitBox.style.display = 'none';\n      document.getElementById('rewardLink').href =\n        location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n      rewardBox.style.display = 'block';\n      return;\n    }\n    el.textContent = fmt(remain);\n    setTimeout(tick, 1000);\n  }\n  tick();\n})();\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\n\n# ── 9. Contrôle des navigateurs ────────────────────────────────────────────\n\n# Liste les onglets ouverts : \"browser<TAB>window<TAB>tab<TAB>url\" par ligne.\n# UN osascript par navigateur RÉELLEMENT lancé (pgrep) — jamais de référence à\n# une app absente (qui déclencherait un dialogue « Where is X? » bloquant), et\n# un navigateur qui échoue n'empêche pas de lire les autres.\nListBrowserTabs() {\n  local b\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    osascript <<APPLESCRIPT 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\nusing terms from application \"Google Chrome\"\n  tell application \"$b\"\n    repeat with W from 1 to (count of windows)\n      repeat with I from 1 to (count of tabs of window W)\n        try\n          set Output to Output & \"$b\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nreturn Output\nAPPLESCRIPT\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\ntell application \"Safari\"\n  repeat with W from 1 to (count of windows)\n    repeat with I from 1 to (count of tabs of window W)\n      try\n        set Output to Output & \"Safari\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn Output\nAPPLESCRIPT\n  fi\n}\n\n# Change l'URL d'un onglet précis (vers la page de blocage, ou vers le vrai\n# contenu à la levée d'une récompense). Chromium via « using terms from »,\n# Safari via son propre dictionnaire.\nRedirectBrowserTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set W to (item 2 of argv) as integer\n  set I to (item 3 of argv) as integer\n  set DestUrl to item 4 of argv\n  if BrowserName is \"Safari\" then\n    tell application \"Safari\" to set URL of tab I of window W to DestUrl\n  else\n    using terms from application \"Google Chrome\"\n      tell application BrowserName to set URL of tab I of window W to DestUrl\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\n# Décide et agit pour UN onglet :\n#  - déjà sur la page de blocage avec unlock=1 (bouton cliqué, attente écoulée)\n#    -> accorde la récompense et ouvre le vrai contenu ;\n#  - sur un réseau social pointant un créateur bloqué -> bascule sur la page de\n#    blocage (avec la cible + l'horodatage de départ du compte à rebours).\nHandleTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n    local target startedAt\n    target=\"$(ExtractParam \"$url\" u)\"\n    startedAt=\"$(ExtractParam \"$url\" t)\"\n    [[ -n \"$target\" ]] || return 0\n    if [[ \"$startedAt\" =~ ^[0-9]+$ && $(( $(NowEpoch) - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n      GrantGrace \"$target\"\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n    else\n      # unlock prématuré/malformé : on repart d'un compte à rebours honnête.\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n    fi\n    return 0\n  fi\n\n  local lurl=\"${url:l}\"\n  case \"$lurl\" in\n    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n    *) return 0 ;;\n  esac\n\n  local identity=\"$url\"\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    [[ -n \"$identity\" ]] || identity=\"$url\"\n  fi\n\n  TextMatchesBlocked \"$identity\" \\\n    && RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n}\n\n# Une passe complète sur tous les onglets de tous les navigateurs lancés.\nEnforceTabs() {\n  EnsureBlockPage\n  local browser windowIndex tabIndex url\n  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n    HandleTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$url\"\n  done < <(ListBrowserTabs)\n}\n\n\n# ── 10. Boucle de surveillance ─────────────────────────────────────────────\n\n# Passe unique (utilisée aussi par la couche root, qui nettoie hosts/policy).\nEnforce() {\n  EnsureSecret\n  ShouldBlock && EnforceTabs\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\n# Service utilisateur : surveille en continu (2 s quand actif, 60 s sinon).\nWatchTabs() {\n  EnsureSecret\n  while true; do\n    if ShouldBlock; then EnforceTabs; sleep 2; else sleep 60; fi\n  done\n}\n\n\n# ── 11. Installation ───────────────────────────────────────────────────────\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$USER_LOG</string>\n  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS garde un drapeau « disabled » PAR LABEL, distinct de notre DISABLED_FILE :\n  # si ce garde-fou a déjà été arrêté une fois, ce bit persiste et refait échouer\n  # le chargement (I/O error) tant qu'on ne le relève pas explicitement ici.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\n# Couche root optionnelle : /etc/hosts + policy Chrome (dont IncognitoModeAvailability=1,\n# qui force la navigation en fenêtre normale, donc visible par la surveillance).\n\nFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n\nStripHostsBlock() {\n  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"; cp \"$tmp\" \"$HOSTS_FILE\"; rm -f \"$tmp\"; FlushDns\n}\n\n# Motifs ressemblant à des URL -> entrées Chrome URLBlocklist (couvre l'incognito).\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=(); local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\"); done\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry; BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"; printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"; fi\n  fi\n  tmp=\"$(mktemp)\"\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key><integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"; done\n  printf '  </array>\\n</dict>\\n</plist>\\n' >> \"$tmp\"\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"; rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"; chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state; state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else rm -f \"$CHROME_POLICY_FILE\"; fi\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root install needs admin rights.\"; exit 1; }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>enforce</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>StartInterval</key><integer>60</integer>\n  <key>StandardOutPath</key><string>/var/log/SocialMediaGuard.log</string>\n  <key>StandardErrorPath</key><string>/var/log/SocialMediaGuard.err.log</string>\n</dict>\n</plist>\nPLIST\n  chown root:wheel \"$ROOT_PLIST\"; chmod 644 \"$ROOT_PLIST\"; plutil -lint \"$ROOT_PLIST\" >/dev/null\n}\n\nInstallRoot() { EnsureSecret; CleanupRoot; }\n\nCleanupRoot() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root cleanup needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root network guard removed. UI guard is active through the user agent.\"\n}\n\nUninstallRoot() {\n  RequireGuardPassword\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root uninstall needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root host guard uninstalled.\"\n}\n\n\n# ── 12. Commandes ──────────────────────────────────────────────────────────\n\nSuspend() {\n  RequireGuardPassword\n  local minutes=\"${1:-30}\"\n  [[ \"$minutes\" =~ '^[0-9]+$' ]] || { Say \"Minutes must be a number.\"; exit 1; }\n  EnsureDirs\n  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard suspended for $minutes minutes.\"\n}\n\nDisable() {\n  RequireGuardPassword\n  EnsureDirs\n  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n  Enforce\n  Say \"Guard disabled.\"\n}\n\nEnable() {\n  EnsureDirs\n  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard enabled.\"\n}\n\nStatus() {\n  local userLoaded=\"no\" rootLoaded=\"no\" chromePolicy=\"no\"\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n  launchctl print \"system/$ROOT_LABEL\"        >/dev/null 2>&1 && rootLoaded=\"yes\"\n  [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1 && chromePolicy=\"yes\"\n\n  Say \"protected_hours=$(IsProtectedNow && printf yes || printf no)\"\n  Say \"disabled=$(IsDisabled && printf yes || printf no)\"\n  Say \"suspended=$(IsSuspended && printf yes || printf no)\"\n  Say \"user_tab_guard_loaded=$userLoaded\"\n  Say \"root_host_guard_loaded=$rootLoaded\"\n  Say \"hosts_block_present=$(grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && printf yes || printf no)\"\n  Say \"chrome_policy_present=$chromePolicy\"\n  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n  Say \"blocked_patterns=${#BLOCKED_PATTERNS[@]}\"\n}\n\n\n# ── 13. Point d'entrée ─────────────────────────────────────────────────────\n\ncase \"${1:-status}\" in\n  install-user)   InstallUser ;;\n  install-root)   InstallRoot ;;\n  enforce)        Enforce ;;\n  watch-tabs)     WatchTabs ;;\n  close-tabs)     EnforceTabs ;;\n  suspend)        Suspend \"${2:-30}\" ;;\n  disable)        Disable ;;\n  enable)         Enable ;;\n  status)         Status ;;\n  uninstall-user) UninstallUser ;;\n  uninstall-root) UninstallRoot ;;\n  cleanup-root)   CleanupRoot ;;\n  *)\n    Say \"Usage: $0 install-user|status|enable|disable|suspend [min]|enforce|watch-tabs|close-tabs|uninstall-user|install-root|uninstall-root|cleanup-root\"\n    exit 1 ;;\nesac\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6789,"cache_read_input_tokens":303396,"output_tokens":17254,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6789,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":17254,"cache_read_input_tokens":303396,"cache_creation_input_tokens":6789,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6789},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Ccrb1r1PteXxV98rNhHZZ","attributionSkill":"think-of-everything","type":"assistant","uuid":"2c6acbc7-1c9a-4a3c-b149-49165938d5b3","timestamp":"2026-07-09T13:50:05.676Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"6b5850df-ed76-4f8a-abbb-20924e727fbf","version":"2.1.202","gitBranch":"