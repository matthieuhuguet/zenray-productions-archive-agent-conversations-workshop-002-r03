\"* ]] && return 0\n419\t  done\n420\t  return 1\n421\t}\n422\t\n423\t# Construit les clauses AppleScript « if U contains \"motif\" then return true »\n424\t# à partir de la SEULE liste ci-dessus (consommateur n°1 : la surveillance d'onglets).\n425\tBuildMatchClauses() {\n426\t  local p esc\n427\t  for p in \"${BLOCKED_PATTERNS[@]}\"; do\n428\t    esc=\"${p//\\\\/\\\\\\\\}\"; esc=\"${esc//\\\"/\\\\\\\"}\"\n429\t    printf '        if U contains \"%s\" then return true\\n' \"$esc\"\n430\t  done\n431\t}\n432\t\n433\t# Construit la liste Chrome URLBlocklist (couche root optionnelle) à partir des\n434\t# motifs qui ressemblent à des URL (ceux contenant « / »). Couvre l'incognito Chrome.\n435\tBuildChromeBlocklist() {\n436\t  CHROME_BLOCKLIST=()\n437\t  local p\n438\t  for p in \"${BLOCKED_PATTERNS[@]}\"; do\n439\t    [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\")\n440\t  done\n441\t}\n442\t\n443\tIsResolvableYouTubeUrl() {\n444\t  local url=\"${1:l}\"\n445\t  [[ \"$url\" == *\"youtube.com/watch?\"* ]] && return 0\n446\t  [[ \"$url\" == *\"youtube.com/shorts/\"* ]] && return 0\n447\t  [[ \"$url\" == *\"youtube.com/live/\"* ]] && return 0\n448\t  [[ \"$url\" == *\"youtube.com/post/\"* ]] && return 0\n449\t  [[ \"$url\" == *\"youtu.be/\"* ]] && return 0\n450\t  return 1\n451\t}\n452\t\n453\tYouTubeIdentityForUrl() {\n454\t  local url=\"$1\"\n455\t  TextMatchesBlockedYoutube \"$url\" && {\n456\t    printf '%s\\n' \"$url\"\n457\t    return 0\n458\t  }\n459\t  IsResolvableYouTubeUrl \"$url\" || return 1\n460\t\n461\t  local ytdlp cacheDir key cache json identity\n462\t  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n463\t  [[ -n \"$ytdlp\" ]] || return 1\n464\t\n465\t  cacheDir=\"$STATE_DIR/youtube-identity-cache\"\n466\t  mkdir -p \"$cacheDir\"\n467\t  key=\"$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}')\"\n468\t  cache=\"$cacheDir/$key.txt\"\n469\t  if [[ -s \"$cache\" ]]; then\n470\t    cat \"$cache\"\n471\t    return 0\n472\t  fi\n473\t\n474\t  json=\"$(\"$ytdlp\" \\\n475\t    --dump-single-json \\\n476\t    --no-playlist \\\n477\t    --skip-download \\\n478\t    --socket-timeout 4 \\\n479\t    --extractor-retries 1 \\\n480\t    --retries 1 \\\n481\t    \"$url\" 2>/dev/null || true)\"\n482\t\n483\t  identity=\"$(printf '%s' \"$json\" | jq -r '\n484\t    [\n485\t      .channel,\n486\t      .uploader,\n487\t      .channel_id,\n488\t      .uploader_id,\n489\t      .channel_url,\n490\t      .uploader_url,\n491\t      .creator,\n492\t      .webpage_url,\n493\t      .original_url\n494\t    ]\n495\t    | map(select(type == \"string\" and length > 0))\n496\t    | join(\" \")\n497\t  ' 2>/dev/null || true)\"\n498\t\n499\t  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n500\t  printf '%s\\n' \"$identity\"\n501\t}\n502\t\n503\tListBrowserTabs() {\n504\t  osascript <<'APPLESCRIPT' 2>/dev/null || true\n505\tset Output to \"\"\n506\tset T to ASCII character 9\n507\t\n508\tif application \"Google Chrome\" is running then\n509\t  tell application \"Google Chrome\"\n510\t    set WindowCount to count of windows\n511\t    repeat with W from 1 to WindowCount\n512\t      set TabCount to count of tabs of window W\n513\t      repeat with I from 1 to TabCount\n514\t        try\n515\t          set U to URL of tab I of window W as text\n516\t          set Output to Output & \"chrome\" & T & W & T & I & T & U & linefeed\n517\t        end try\n518\t      end repeat\n519\t    end repeat\n520\t  end tell\n521\tend if\n522\t\n523\tif application \"Safari\" is running then\n524\t  tell application \"Safari\"\n525\t    set WindowCount to count of windows\n526\t    repeat with W from 1 to WindowCount\n527\t      set TabCount to count of tabs of window W\n528\t      repeat with I from 1 to TabCount\n529\t        try\n530\t          set U to URL of tab I of window W as text\n531\t          set Output to Output & \"safari\" & T & W & T & I & T & U & linefeed\n532\t        end try\n533\t      end repeat\n534\t    end repeat\n535\t  end tell\n536\tend if\n537\t\n538\treturn Output\n539\tAPPLESCRIPT\n540\t}\n541\t\n542\tRedirectBrowserTab() {\n543\t  local browser=\"$1\"\n544\t  local windowIndex=\"$2\"\n545\t  local tabIndex=\"$3\"\n546\t  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$BLOCK_PAGE_URL\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\n547\ton run argv\n548\t  set BrowserName to item 1 of argv\n549\t  set WindowIndex to (item 2 of argv) as integer\n550\t  set TabIndex to (item 3 of argv) as integer\n551\t  set BlockPageUrl to item 4 of argv\n552\t\n553\t  if BrowserName is \"chrome\" then\n554\t    tell application \"Google Chrome\"\n555\t      set URL of tab TabIndex of window WindowIndex to BlockPageUrl\n556\t    end tell\n557\t  else if BrowserName is \"safari\" then\n558\t    tell application \"Safari\"\n559\t      set URL of tab TabIndex of window WindowIndex to BlockPageUrl\n560\t    end tell\n561\t  end if\n562\tend run\n563\tAPPLESCRIPT\n564\t}\n565\t\n566\tCloseResolvedYouTubeTabs() {\n567\t  local browser windowIndex tabIndex url identity\n568\t  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n569\t    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n570\t    [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]] && continue\n571\t    [[ \"${url:l}\" == *\"youtube.com\"* || \"${url:l}\" == *\"youtu.be\"* ]] || continue\n572\t\n573\t    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n574\t    if TextMatchesBlockedYoutube \"$identity\"; then\n575\t      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\"\n576\t    fi\n577\t  done < <(ListBrowserTabs)\n578\t}\n579\t\n580\t# Redirige les onglets bloqués d'un navigateur de la famille Chromium (Chrome,\n581\t# Brave, Edge, Vivaldi, Opera…). Le « using terms from Google Chrome » compile\n582\t# le vocabulaire d'onglets de Chrome et le cible sur l'app passée en argument.\n583\tRunChromiumBlock() {\n584\t  local ap=\"$1\" clauses=\"$2\"\n585\t  osascript <<APPLESCRIPT >/dev/null 2>&1 || true\n586\ton ShouldBlock(U)\n587\t  if U starts with \"$BLOCK_PAGE_URL\" then return false\n588\t  ignoring case\n589\t$clauses\n590\t  end ignoring\n591\t  return false\n592\tend ShouldBlock\n593\t\n594\tusing terms from application \"Google Chrome\"\n595\t  tell application \"$ap\"\n596\t    repeat with W in windows\n597\t      set TabCount to count of tabs of W\n598\t      repeat with I from 1 to TabCount\n599\t        try\n600\t          set U to URL of tab I of W as text\n601\t          if my ShouldBlock(U) then set URL of tab I of W to \"$BLOCK_PAGE_URL\"\n602\t        end try\n603\t      end repeat\n604\t    end repeat\n605\t  end tell\n606\tend using terms from\n607\tAPPLESCRIPT\n608\t}\n609\t\n610\tRunSafariBlock() {\n611\t  local clauses=\"$1\"\n612\t  osascript <<APPLESCRIPT >/dev/null 2>&1 || true\n613\ton ShouldBlock(U)\n614\t  if U starts with \"$BLOCK_PAGE_URL\" then return false\n615\t  ignoring case\n616\t$clauses\n617\t  end ignoring\n618\t  return false\n619\tend ShouldBlock\n620\t\n621\ttell application \"Safari\"\n622\t  repeat with W in windows\n623\t    set TabCount to count of tabs of W\n624\t    repeat with I from 1 to TabCount\n625\t      try\n626\t        set U to URL of tab I of W as text\n627\t        if my ShouldBlock(U) then set URL of tab I of W to \"$BLOCK_PAGE_URL\"\n628\t      end try\n629\t    end repeat\n630\t  end repeat\n631\tend tell\n632\tAPPLESCRIPT\n633\t}\n634\t\n635\tCloseBrowserTabs() {\n636\t  EnsureBlockPage\n637\t  local clauses ap\n638\t  clauses=\"$(BuildMatchClauses)\"\n639\t  # Famille Chromium : partagent le dictionnaire AppleScript de Google Chrome.\n640\t  for ap in \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\" \\\n641\t            \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\" \\\n642\t            \"Vivaldi\" \"Opera\" \"Opera GX\"; do\n643\t    pgrep -x \"$ap\" >/dev/null 2>&1 || continue\n644\t    RunChromiumBlock \"$ap\" \"$clauses\"\n645\t  done\n646\t  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n647\t    RunSafariBlock \"$clauses\"\n648\t  fi\n649\t  CloseResolvedYouTubeTabs\n650\t}\n651\t\n652\tEnforce() {\n653\t  EnsureSecret\n654\t  if ShouldBlock; then\n655\t    CloseBrowserTabs\n656\t  fi\n657\t  RemoveHostsBlock\n658\t  RemoveChromePolicy\n659\t}\n660\t\n661\tWatchTabs() {\n662\t  EnsureSecret\n663\t  while true; do\n664\t    if ShouldBlock; then\n665\t      CloseBrowserTabs\n666\t      sleep 2\n667\t    else\n668\t      sleep 60\n669\t    fi\n670\t  done\n671\t}\n672\t\n673\tWriteUserPlist() {\n674\t  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n675\t  cat > \"$USER_PLIST\" <<PLIST\n676\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n677\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n678\t<plist version=\"1.0\">\n679\t<dict>\n680\t  <key>Label</key>\n681\t  <string>$USER_LABEL</string>\n682\t  <key>ProgramArguments</key>\n683\t  <array>\n684\t    <string>$SCRIPT_PATH</string>\n685\t    <string>watch-tabs</string>\n686\t  </array>\n687\t  <key>RunAtLoad</key>\n688\t  <true/>\n689\t  <key>KeepAlive</key>\n690\t  <true/>\n691\t  <key>StandardOutPath</key>\n692\t  <string>$HOME/Library/Logs/YoutubeFocusGuard.tabs.log</string>\n693\t  <key>StandardErrorPath</key>\n694\t  <string>$HOME/Library/Logs/YoutubeFocusGuard.tabs.err.log</string>\n695\t</dict>\n696\t</plist>\n697\tPLIST\n698\t  plutil -lint \"$USER_PLIST\" >/dev/null\n699\t}\n700\t\n701\tInstallUser() {\n702\t  EnsureSecret\n703\t  WriteUserPlist\n704\t  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n705\t  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n706\t  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n707\t  Say \"User tab guard installed.\"\n708\t}\n709\t\n710\tWriteRootPlist() {\n711\t  [[ \"$EUID\" -eq 0 ]] || {\n712\t    Say \"Root install needs admin rights.\"\n713\t    exit 1\n714\t  }\n715\t  cat > \"$ROOT_PLIST\" <<PLIST\n716\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n717\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n718\t<plist version=\"1.0\">\n719\t<dict>\n720\t  <key>Label</key>\n721\t  <string>$ROOT_LABEL</string>\n722\t  <key>ProgramArguments</key>\n723\t  <array>\n724\t    <string>$SCRIPT_PATH</string>\n725\t    <string>enforce</string>\n726\t  </array>\n727\t  <key>RunAtLoad</key>\n728\t  <true/>\n729\t  <key>StartInterval</key>\n730\t  <integer>60</integer>\n731\t  <key>StandardOutPath</key>\n732\t  <string>/var/log/YoutubeFocusGuard.log</string>\n733\t  <key>StandardErrorPath</key>\n734\t  <string>/var/log/YoutubeFocusGuard.err.log</string>\n735\t</dict>\n736\t</plist>\n737\tPLIST\n738\t  chown root:wheel \"$ROOT_PLIST\"\n739\t  chmod 644 \"$ROOT_PLIST\"\n740\t  plutil -lint \"$ROOT_PLIST\" >/dev/null\n741\t}\n742\t\n743\tInstallRoot() {\n744\t  EnsureSecret\n745\t  CleanupRoot\n746\t}\n747\t\n748\tCleanupRoot() {\n749\t  [[ \"$EUID\" -eq 0 ]] || {\n750\t    Say \"Root cleanup needs admin rights.\"\n751\t    exit 1\n752\t  }\n753\t  RemoveHostsBlock\n754\t  RemoveChromePolicy\n755\t  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n756\t  rm -f \"$ROOT_PLIST\"\n757\t  Say \"Root network guard removed. UI guard is active through the user agent.\"\n758\t}\n759\t\n760\tSuspend() {\n761\t  RequireGuardPassword\n762\t  local minutes until\n763\t  minutes=\"${1:-30}\"\n764\t  [[ \"$minutes\" =~ '^[0-9]+$' ]] || {\n765\t    Say \"Minutes must be a number.\"\n766\t    exit 1\n767\t  }\n768\t  EnsureDirs\n769\t  until=\"$(( $(NowEpoch) + minutes * 60 ))\"\n770\t  printf '%s\\n' \"$until\" > \"$SUSPEND_FILE\"\n771\t  Enforce\n772\t  Say \"Guard suspended for $minutes minutes.\"\n773\t}\n774\t\n775\tDisable() {\n776\t  RequireGuardPassword\n777\t  EnsureDirs\n778\t  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n779\t  Enforce\n780\t  Say \"Guard disabled.\"\n781\t}\n782\t\n783\tEnable() {\n784\t  EnsureDirs\n785\t  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n786\t  Enforce\n787\t  Say \"Guard enabled.\"\n788\t}\n789\t\n790\tStatus() {\n791\t  local protected disabled suspended hostsBlock chromePolicy userLoaded rootLoaded\n792\t  protected=\"no\"\n793\t  disabled=\"no\"\n794\t  suspended=\"no\"\n795\t  hostsBlock=\"no\"\n796\t  chromePolicy=\"no\"\n797\t  userLoaded=\"no\"\n798\t  rootLoaded=\"no\"\n799\t\n800\t  IsProtectedNow && protected=\"yes\"\n801\t  IsDisabled && disabled=\"yes\"\n802\t  IsSuspended && suspended=\"yes\"\n803\t  grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && hostsBlock=\"yes\"\n804\t  if [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1; then\n805\t    chromePolicy=\"yes\"\n806\t  fi\n807\t  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n808\t  launchctl print \"system/$ROOT_LABEL\" >/dev/null 2>&1 && rootLoaded=\"yes\"\n809\t\n810\t  Say \"protected_hours=$protected\"\n811\t  Say \"disabled=$disabled\"\n812\t  Say \"suspended=$suspended\"\n813\t  Say \"user_tab_guard_loaded=$userLoaded\"\n814\t  Say \"root_host_guard_loaded=$rootLoaded\"\n815\t  Say \"hosts_block_present=$hostsBlock\"\n816\t  Say \"chrome_policy_present=$chromePolicy\"\n817\t  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n818\t  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n819\t}\n820\t\n821\tUninstallUser() {\n822\t  RequireGuardPassword\n823\t  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n824\t  rm -f \"$USER_PLIST\"\n825\t  Say \"User tab guard uninstalled.\"\n826\t}\n827\t\n828\tUninstallRoot() {\n829\t  RequireGuardPassword\n830\t  [[ \"$EUID\" -eq 0 ]] || {\n831\t    Say \"Root uninstall needs admin rights.\"\n832\t    exit 1\n833\t  }\n834\t  RemoveHostsBlock\n835\t  RemoveChromePolicy\n836\t  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n837\t  rm -f \"$ROOT_PLIST\"\n838\t  Say \"Root host guard uninstalled.\"\n839\t}\n840\t\n841\tcase \"${1:-status}\" in\n842\t  install-user)\n843\t    InstallUser\n844\t    ;;\n845\t  install-root)\n846\t    InstallRoot\n847\t    ;;\n848\t  enforce)\n849\t    Enforce\n850\t    ;;\n851\t  watch-tabs)\n852\t    WatchTabs\n853\t    ;;\n854\t  close-tabs)\n855\t    CloseBrowserTabs\n856\t    ;;\n857\t  suspend)\n858\t    Suspend \"${2:-30}\"\n859\t    ;;\n860\t  disable)\n861\t    Disable\n862\t    ;;\n863\t  enable)\n864\t    Enable\n865\t    ;;\n866\t  status)\n867\t    Status\n868\t    ;;\n869\t  uninstall-user)\n870\t    UninstallUser\n871\t    ;;\n872\t  uninstall-root)\n873\t    UninstallRoot\n874\t    ;;\n875\t  cleanup-root)\n876\t    CleanupRoot\n877\t    ;;\n878\t  *)\n879\t    Say \"Usage: $0 install-user|install-root|status|enable|disable|suspend [minutes]|enforce|watch-tabs|close-tabs|uninstall-user|uninstall-root|cleanup-root\"\n880\t    exit 1\n881\t    ;;\n882\tesac\n883\t"}]},"uuid":"c4328d5f-5ed2-4a57-a3a3-b07aede26833","timestamp":"2026-07-08T16:32:57.048Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Memory/Tools/FocusGuard/YoutubeFocusGuard.sh","content":"#!/bin/zsh\nset -euo pipefail\n\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\nSECRET_FILE=\"$FOCUS_DIR/.YouTubeFocusGuardPassword\"\nSTATE_DIR=\"$FOCUS_DIR/.YouTubeFocusGuardState\"\nDISABLED_FILE=\"$STATE_DIR/disabled\"\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/YouTubeBlocked.html\"\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\nILLUSTRATION_FILE=\"$MEMORY_ROOT/ArtDirection/output_v3.png\"\nILLUSTRATION_URL=\"file://$ILLUSTRATION_FILE\"\n\n# Blocage permanent (24/7) : ces chaînes/comptes sont fermés en continu, plus de fenêtre horaire.\nSTART_HOUR=\"${YOUTUBE_GUARD_START_HOUR:-0}\"\nEND_HOUR=\"${YOUTUBE_GUARD_END_HOUR:-24}\"\n\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_YOUTUBE_FOCUS_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_YOUTUBE_FOCUS_GUARD_END\"\n\nUSER_LABEL=\"com.zenray.youtube-focus-guard.tabs\"\nROOT_LABEL=\"com.zenray.youtube-focus-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/YoutubeFocusGuard.sh\"\n\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-focus-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\n\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\nEnsureBlockPage() {\n  EnsureDirs\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>YouTube closed</title>\n  <style>\n    @font-face {\n      font-family: \"Anthropic Sans\";\n      src: url(\"file:///Users/zenray/Library/Fonts/AnthropicSans-Light.ttf\") format(\"truetype\");\n      font-weight: 300;\n    }\n    :root {\n      color-scheme: dark;\n      background: #242424;\n      color: #f2f2f2;\n    }\n    * {\n      box-sizing: border-box;\n    }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      background: #242424;\n      font-family: \"Anthropic Sans\", system-ui, sans-serif;\n    }\n    main {\n      width: min(1500px, calc(100vw - 48px));\n      text-align: center;\n    }\n    .art {\n      display: block;\n      width: min(720px, calc(100vw - 120px));\n      margin: 0 auto 28px;\n      border-radius: 8px;\n      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.22);\n    }\n    h1 {\n      margin: 0;\n      color: #efefef;\n      font-size: clamp(36px, 4.2vw, 78px);\n      font-weight: 300;\n      line-height: 1.08;\n      text-transform: uppercase;\n    }\n    p {\n      margin: 0 0 28px;\n      color: #c9c9c9;\n      font-size: clamp(18px, 2vw, 34px);\n      font-weight: 300;\n      line-height: 1.2;\n      text-transform: uppercase;\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"Illustration\" />\n    <p>Profil createur — on ne regarde plus</p>\n    <h1>Ces chaines sont fermees</h1>\n  </main>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\nSay() {\n  printf '%s\\n' \"$*\"\n}\n\nEnsureDirs() {\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\nInstallOwner() {\n  printf 'zenray'\n}\n\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    local owner\n    owner=\"$(InstallOwner)\"\n    chown \"${owner}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${YOUTUBE_GUARD_PASSWORD:-}\" ]]; then\n    input=\"$YOUTUBE_GUARD_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo\n    IFS= read -r input\n    stty echo\n    printf '\\n' >&2\n  fi\n  if [[ \"$input\" != \"$expected\" ]]; then\n    Say \"Wrong focus password.\"\n    exit 2\n  fi\n}\n\nIsDisabled() {\n  [[ -f \"$DISABLED_FILE\" ]]\n}\n\nNowEpoch() {\n  date '+%s'\n}\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until now\n  until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  now=\"$(NowEpoch)\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$now\" -lt \"$until\" ]]\n}\n\nIsProtectedNow() {\n  local hour\n  hour=\"$(date '+%H')\"\n  hour=\"${hour#0}\"\n  [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\nShouldBlock() {\n  IsDisabled && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\nFlushDns() {\n  dscacheutil -flushcache 2>/dev/null || true\n  killall -HUP mDNSResponder 2>/dev/null || true\n}\n\nStripHostsBlock() {\n  local source=\"$1\"\n  awk -v start=\"$HOSTS_MARK_START\" -v end=\"$HOSTS_MARK_END\" '\n    $0 == start {skip = 1; next}\n    $0 == end {skip = 0; next}\n    skip != 1 {print}\n  ' \"$source\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  {\n    cat \"$tmp\"\n    printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    for domain in \"${HOST_DOMAINS[@]}\"; do\n      printf '0.0.0.0\\t%s\\n' \"$domain\"\n      printf '::1\\t%s\\n' \"$domain\"\n    done\n    printf '%s\\n' \"$HOSTS_MARK_END\"\n  } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"\n  rm -f \"$tmp\" \"$tmp.new\"\n  FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  cp \"$tmp\" \"$HOSTS_FILE\"\n  rm -f \"$tmp\"\n  FlushDns\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry\n  BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then\n      cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"\n      printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else\n      printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"\n    fi\n  fi\n  tmp=\"$(mktemp)\"\n  # IncognitoModeAvailability=1 -> incognito Chrome désactivé, donc tout passe en\n  # fenêtre normale, vue par la surveillance d'onglets (couvre la navigation privée).\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key>\n  <integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do\n    printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"\n  done\n  cat >> \"$tmp\" <<'PLIST'\n  </array>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"\n  rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"\n  chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state\n  state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then\n    cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else\n    rm -f \"$CHROME_POLICY_FILE\"\n  fi\n}\n\n# =========================================================================\n# SOURCE UNIQUE DE VÉRITÉ des blocages (avant : dupliquée à 3 endroits).\n# Chaque motif est cherché en sous-chaîne, insensible à la casse, dans :\n#   1) l'URL de l'onglet (tous navigateurs) -> couvre YouTube + Instagram +\n#      TikTok + Facebook + X/Twitter dès que le motif est le pseudo du compte.\n#   2) l'identité renvoyée par yt-dlp pour une page /watch (chaîne, uploader,\n#      channel_url…) -> attrape TOUTES les vidéos et chaînes secondaires d'un\n#      créateur même sans connaître leur pseudo exact (ex. « Alex Hitchens - … »).\n# Règle de sûreté : un motif qui ne correspond à rien ne bloque rien (échec\n# bénin). On peut donc être large sur les NOMS ; on reste précis (pseudo\n# concaténé ou URL) pour éviter tout blocage collatéral d'un tiers.\n# =========================================================================\nBLOCKED_PATTERNS=(\n  # --- Ici Japon (existant, conservé) ---\n  \"youtube.com/@icijaponcorp\"\n  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"\n  \"ici japon\"\n\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"\n  \"siliconcarne\"\n  \"silicon carne\"\n  \"carlosdiaz\"\n  \"carlos diaz\"\n\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"\n  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"\n  \"oussamaammar\"\n  \"oussama ammar\"\n\n  # --- Yomi Denzel ---\n  \"youtube.com/@yomidenzel\"\n  \"youtube.com/yomidenzel\"\n  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n  \"yomidenzel\"\n  \"yomi.denzel\"\n  \"yomi denzel\"\n\n  # --- Antoine Blanco (+ chaîne business) ---\n  \"youtube.com/@antoineblanco\"\n  \"youtube.com/@antoineblanco99\"\n  \"youtube.com/@antoineblancobusiness\"\n  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"\n  \"antoineblanco\"\n  \"antoine blanco\"\n\n  # --- Sixtine Moullé-Berteaux ---\n  \"youtube.com/@sixtinemoulleberteaux\"\n  \"sixtinemoulleberteaux\"\n  \"sixtine.moulleberteaux\"\n  \"sixtine moulle\"\n  \"sixtine moullé\"\n\n  # --- Wallerand Moullé-Berteaux ---\n  \"wallerandmoulleberteaux\"\n  \"wallerand.moulleberteaux\"\n  \"wallerand moulle\"\n  \"wallerand moullé\"\n\n  # --- Eric Larchevêque ---\n  \"ericlarcheveque\"\n  \"eric larcheveque\"\n  \"eric l'archeveque\"\n  \"eric larchevêque\"\n\n  # --- Guillaume Moubèche ---\n  \"guillaumemoubeche\"\n  \"guillaume moubeche\"\n  \"guillaume moubèche\"\n\n  # --- Alex Hitchens (+ chaînes secondaires captées par identité) ---\n  \"alexhitchens\"\n  \"alex hitchens\"\n\n  # --- Julien Chieze (actu jeux vidéo) ---\n  \"julienchieze\"\n  \"julien chieze\"\n\n  # --- HugoDécrypte (actu, toutes ses chaînes) ---\n  \"youtube.com/@hugodecrypte\"\n  \"youtube.com/@hugodecrypteactus\"\n  \"youtube.com/@hugodecryptegrandsformats\"\n  \"hugodecrypte\"\n  \"hugo decrypte\"\n  \"hugo décrypte\"\n\n  # --- Le Crayon (actu/médias) ---\n  \"youtube.com/@lecrayon\"\n  \"le crayon\"\n\n  # --- Sphère business / make-money / mindset / manosphère (backstop identité) ---\n  # NOMS uniquement : n'agissent que si la chaîne visitée porte ce nom.\n  # Matthieu peut en retirer/ajouter librement, aucun effet de bord sur les tiers.\n  \"iman gadzhi\"\n  \"imangadzhi\"\n  \"andrew tate\"\n  \"tristan tate\"\n  \"cobratate\"\n  \"theophile eliet\"\n  \"théophile eliet\"\n  \"enzo honore\"\n  \"enzo honoré\"\n  \"franck nicolas\"\n  \"idriss aberkane\"\n  \"anthony bourbon\"\n  \"hasheur\"\n  \"owen simonin\"\n  \"lorenzo ferrante\"\n  \"mick levy\"\n  \"younes belghazi\"\n  \"yann darwin\"\n  \"raoul pop\"\n  \"david laroche\"\n  \"fabien snauwaert\"\n  \"romain pichon\"\n  \"tugan bara\"\n  \"tugan.baranovsky\"\n  \"morgan prével\"\n  \"morgan prevel\"\n  \"valentin decker\"\n  \"jean rivière\"\n  \"jeremy kohlmann\"\n  \"aurelien amacker\"\n  \"aurélien amacker\"\n)\n\nTextMatchesBlockedYoutube() {\n  local text=\"${1:l}\"\n  local pattern\n  for pattern in \"${BLOCKED_PATTERNS[@]}\"; do\n    [[ \"$text\" == *\"${pattern:l}\"* ]] && return 0\n  done\n  return 1\n}\n\n# Construit les clauses AppleScript « if U contains \"motif\" then return true »\n# à partir de la SEULE liste ci-dessus (consommateur n°1 : la surveillance d'onglets).\nBuildMatchClauses() {\n  local p esc\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do\n    esc=\"${p//\\\\/\\\\\\\\}\"; esc=\"${esc//\\\"/\\\\\\\"}\"\n    printf '        if U contains \"%s\" then return true\\n' \"$esc\"\n  done\n}\n\n# Construit la liste Chrome URLBlocklist (couche root optionnelle) à partir des\n# motifs qui ressemblent à des URL (ceux contenant « / »). Couvre l'incognito Chrome.\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=()\n  local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do\n    [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\")\n  done\n}\n\nIsResolvableYouTubeUrl() {\n  local url=\"${1:l}\"\n  [[ \"$url\" == *\"youtube.com/watch?\"* ]] && return 0\n  [[ \"$url\" == *\"youtube.com/shorts/\"* ]] && return 0\n  [[ \"$url\" == *\"youtube.com/live/\"* ]] && return 0\n  [[ \"$url\" == *\"youtube.com/post/\"* ]] && return 0\n  [[ \"$url\" == *\"youtu.be/\"* ]] && return 0\n  return 1\n}\n\nYouTubeIdentityForUrl() {\n  local url=\"$1\"\n  TextMatchesBlockedYoutube \"$url\" && {\n    printf '%s\\n' \"$url\"\n    return 0\n  }\n  IsResolvableYouTubeUrl \"$url\" || return 1\n\n  local ytdlp cacheDir key cache json identity\n  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n  [[ -n \"$ytdlp\" ]] || return 1\n\n  cacheDir=\"$STATE_DIR/youtube-identity-cache\"\n  mkdir -p \"$cacheDir\"\n  key=\"$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}')\"\n  cache=\"$cacheDir/$key.txt\"\n  if [[ -s \"$cache\" ]]; then\n    cat \"$cache\"\n    return 0\n  fi\n\n  json=\"$(\"$ytdlp\" \\\n    --dump-single-json \\\n    --no-playlist \\\n    --skip-download \\\n    --socket-timeout 4 \\\n    --extractor-retries 1 \\\n    --retries 1 \\\n    \"$url\" 2>/dev/null || true)\"\n\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [\n      .channel,\n      .uploader,\n      .channel_id,\n      .uploader_id,\n      .channel_url,\n      .uploader_url,\n      .creator,\n      .webpage_url,\n      .original_url\n    ]\n    | map(select(type == \"string\" and length > 0))\n    | join(\" \")\n  ' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\nListBrowserTabs() {\n  osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\n\nif application \"Google Chrome\" is running then\n  tell application \"Google Chrome\"\n    set WindowCount to count of windows\n    repeat with W from 1 to WindowCount\n      set TabCount to count of tabs of window W\n      repeat with I from 1 to TabCount\n        try\n          set U to URL of tab I of window W as text\n          set Output to Output & \"chrome\" & T & W & T & I & T & U & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend if\n\nif application \"Safari\" is running then\n  tell application \"Safari\"\n    set WindowCount to count of windows\n    repeat with W from 1 to WindowCount\n      set TabCount to count of tabs of window W\n      repeat with I from 1 to TabCount\n        try\n          set U to URL of tab I of window W as text\n          set Output to Output & \"safari\" & T & W & T & I & T & U & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend if\n\nreturn Output\nAPPLESCRIPT\n}\n\nRedirectBrowserTab() {\n  local browser=\"$1\"\n  local windowIndex=\"$2\"\n  local tabIndex=\"$3\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$BLOCK_PAGE_URL\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set WindowIndex to (item 2 of argv) as integer\n  set TabIndex to (item 3 of argv) as integer\n  set BlockPageUrl to item 4 of argv\n\n  if BrowserName is \"chrome\" then\n    tell application \"Google Chrome\"\n      set URL of tab TabIndex of window WindowIndex to BlockPageUrl\n    end tell\n  else if BrowserName is \"safari\" then\n    tell application \"Safari\"\n      set URL of tab TabIndex of window WindowIndex to BlockPageUrl\n    end tell\n  end if\nend run\nAPPLESCRIPT\n}\n\nCloseResolvedYouTubeTabs() {\n  local browser windowIndex tabIndex url identity\n  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n    [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]] && continue\n    [[ \"${url:l}\" == *\"youtube.com\"* || \"${url:l}\" == *\"youtu.be\"* ]] || continue\n\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    if TextMatchesBlockedYoutube \"$identity\"; then\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\"\n    fi\n  done < <(ListBrowserTabs)\n}\n\n# Redirige les onglets bloqués d'un navigateur de la famille Chromium (Chrome,\n# Brave, Edge, Vivaldi, Opera…). Le « using terms from Google Chrome » compile\n# le vocabulaire d'onglets de Chrome et le cible sur l'app passée en argument.\nRunChromiumBlock() {\n  local ap=\"$1\" clauses=\"$2\"\n  osascript <<APPLESCRIPT >/dev/null 2>&1 || true\non ShouldBlock(U)\n  if U starts with \"$BLOCK_PAGE_URL\" then return false\n  ignoring case\n$clauses\n  end ignoring\n  return false\nend ShouldBlock\n\nusing terms from application \"Google Chrome\"\n  tell application \"$ap\"\n    repeat with W in windows\n      set TabCount to count of tabs of W\n      repeat with I from 1 to TabCount\n        try\n          set U to URL of tab I of W as text\n          if my ShouldBlock(U) then set URL of tab I of W to \"$BLOCK_PAGE_URL\"\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nAPPLESCRIPT\n}\n\nRunSafariBlock() {\n  local clauses=\"$1\"\n  osascript <<APPLESCRIPT >/dev/null 2>&1 || true\non ShouldBlock(U)\n  if U starts with \"$BLOCK_PAGE_URL\" then return false\n  ignoring case\n$clauses\n  end ignoring\n  return false\nend ShouldBlock\n\ntell application \"Safari\"\n  repeat with W in windows\n    set TabCount to count of tabs of W\n    repeat with I from 1 to TabCount\n      try\n        set U to URL of tab I of W as text\n        if my ShouldBlock(U) then set URL of tab I of W to \"$BLOCK_PAGE_URL\"\n      end try\n    end repeat\n  end repeat\nend tell\nAPPLESCRIPT\n}\n\nCloseBrowserTabs() {\n  EnsureBlockPage\n  local clauses ap\n  clauses=\"$(BuildMatchClauses)\"\n  # Famille Chromium : partagent le dictionnaire AppleScript de Google Chrome.\n  for ap in \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\" \\\n            \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\" \\\n            \"Vivaldi\" \"Opera\" \"Opera GX\"; do\n    pgrep -x \"$ap\" >/dev/null 2>&1 || continue\n    RunChromiumBlock \"$ap\" \"$clauses\"\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    RunSafariBlock \"$clauses\"\n  fi\n  CloseResolvedYouTubeTabs\n}\n\nEnforce() {\n  EnsureSecret\n  if ShouldBlock; then\n    CloseBrowserTabs\n  fi\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\nWatchTabs() {\n  EnsureSecret\n  while true; do\n    if ShouldBlock; then\n      CloseBrowserTabs\n      sleep 2\n    else\n      sleep 60\n    fi\n  done\n}\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key>\n  <string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array>\n    <string>$SCRIPT_PATH</string>\n    <string>watch-tabs</string>\n  </array>\n  <key>RunAtLoad</key>\n  <true/>\n  <key>KeepAlive</key>\n  <true/>\n  <key>StandardOutPath</key>\n  <string>$HOME/Library/Logs/YoutubeFocusGuard.tabs.log</string>\n  <key>StandardErrorPath</key>\n  <string>$HOME/Library/Logs/YoutubeFocusGuard.tabs.err.log</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  WriteUserPlist\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  Say \"User tab guard installed.\"\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || {\n    Say \"Root install needs admin rights.\"\n    exit 1\n  }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key>\n  <string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array>\n    <string>$SCRIPT_PATH</string>\n    <string>enforce</string>\n  </array>\n  <key>RunAtLoad</key>\n  <true/>\n  <key>StartInterval</key>\n  <integer>60</integer>\n  <key>StandardOutPath</key>\n  <string>/var/log/YoutubeFocusGuard.log</string>\n  <key>StandardErrorPath</key>\n  <string>/var/log/YoutubeFocusGuard.err.log</string>\n</dict>\n</plist>\nPLIST\n  chown root:wheel \"$ROOT_PLIST\"\n  chmod 644 \"$ROOT_PLIST\"\n  plutil -lint \"$ROOT_PLIST\" >/dev/null\n}\n\nInstallRoot() {\n  EnsureSecret\n  CleanupRoot\n}\n\nCleanupRoot() {\n  [[ \"$EUID\" -eq 0 ]] || {\n    Say \"Root cleanup needs admin rights.\"\n    exit 1\n  }\n  RemoveHostsBlock\n  RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root network guard removed. UI guard is active through the user agent.\"\n}\n\nSuspend() {\n  RequireGuardPassword\n  local minutes until\n  minutes=\"${1:-30}\"\n  [[ \"$minutes\" =~ '^[0-9]+$' ]] || {\n    Say \"Minutes must be a number.\"\n    exit 1\n  }\n  EnsureDirs\n  until=\"$(( $(NowEpoch) + minutes * 60 ))\"\n  printf '%s\\n' \"$until\" > \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard suspended for $minutes minutes.\"\n}\n\nDisable() {\n  RequireGuardPassword\n  EnsureDirs\n  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n  Enforce\n  Say \"Guard disabled.\"\n}\n\nEnable() {\n  EnsureDirs\n  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard enabled.\"\n}\n\nStatus() {\n  local protected disabled suspended hostsBlock chromePolicy userLoaded rootLoaded\n  protected=\"no\"\n  disabled=\"no\"\n  suspended=\"no\"\n  hostsBlock=\"no\"\n  chromePolicy=\"no\"\n  userLoaded=\"no\"\n  rootLoaded=\"no\"\n\n  IsProtectedNow && protected=\"yes\"\n  IsDisabled && disabled=\"yes\"\n  IsSuspended && suspended=\"yes\"\n  grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && hostsBlock=\"yes\"\n  if [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1; then\n    chromePolicy=\"yes\"\n  fi\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n  launchctl print \"system/$ROOT_LABEL\" >/dev/null 2>&1 && rootLoaded=\"yes\"\n\n  Say \"protected_hours=$protected\"\n  Say \"disabled=$disabled\"\n  Say \"suspended=$suspended\"\n  Say \"user_tab_guard_loaded=$userLoaded\"\n  Say \"root_host_guard_loaded=$rootLoaded\"\n  Say \"hosts_block_present=$hostsBlock\"\n  Say \"chrome_policy_present=$chromePolicy\"\n  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\nUninstallRoot() {\n  RequireGuardPassword\n  [[ \"$EUID\" -eq 0 ]] || {\n    Say \"Root uninstall needs admin rights.\"\n    exit 1\n  }\n  RemoveHostsBlock\n  RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root host guard uninstalled.\"\n}\n\ncase \"${1:-status}\" in\n  install-user)\n    InstallUser\n    ;;\n  install-root)\n    InstallRoot\n    ;;\n  enforce)\n    Enforce\n    ;;\n  watch-tabs)\n    WatchTabs\n    ;;\n  close-tabs)\n    CloseBrowserTabs\n    ;;\n  suspend)\n    Suspend \"${2:-30}\"\n    ;;\n  disable)\n    Disable\n    ;;\n  enable)\n    Enable\n    ;;\n  status)\n    Status\n    ;;\n  uninstall-user)\n    UninstallUser\n    ;;\n  uninstall-root)\n    UninstallRoot\n    ;;\n  cleanup-root)\n    CleanupRoot\n    ;;\n  *)\n    Say \"Usage: $0 install-user|install-root|status|enable|disable|suspend [minutes]|enforce|watch-tabs|close-tabs|uninstall-user|uninstall-root|cleanup-root\"\n    exit 1\n    ;;\nesac\n","numLines":883,"startLine":1,"totalLines":883}},"sourceToolAssistantUUID":"176107c3-3759-4c24-be40-19f72f7d0e5b","userType":"external","entrypoint"