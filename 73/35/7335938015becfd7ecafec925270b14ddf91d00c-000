ript]\n        try? p.run()\n    }\n\n    @objc func openDashboard() {\n        let res = resourcesDir()\n        let profile = (NSHomeDirectory() as NSString)\n            .appendingPathComponent(\"Library/Application Support/ClaudeSyncApp\")\n        let script = \"\"\"\n        DIR='\\(res)'\n        PORT=\\(PORT)\n        if ! /usr/bin/nc -z 127.0.0.1 $PORT 2>/dev/null; then\n          /usr/bin/nohup /usr/bin/python3 \"$DIR/server.py\" >/tmp/zenray-claudesync.server.log 2>&1 &\n          for i in $(/usr/bin/seq 1 50); do /usr/bin/nc -z 127.0.0.1 $PORT 2>/dev/null && break; /bin/sleep 0.1; done\n        fi\n        URL=\"http://localhost:$PORT\"\n        CHROME=\"/Applications/Google Chrome.app\"\n        if [ -d \"$CHROME\" ]; then\n          /usr/bin/open -na \"$CHROME\" --args --app=\"$URL\" --window-size=1140,860 --user-data-dir='\\(profile)'\n        else\n          /usr/bin/open \"$URL\"\n        fi\n        \"\"\"\n        runShell(script)\n    }\n\n    @objc func openLogin() {\n        runShell(\"/usr/bin/open 'https://claude.ai'\")\n    }\n\n    @objc func quit() { NSApp.terminate(nil) }\n}\n\nlet app = NSApplication.shared\napp.setActivationPolicy(.accessory) // barre de menu seulement, pas d'icône Dock\nlet delegate = AppDelegate()\napp.delegate = delegate\napp.run()\n","numLines":79,"startLine":1,"totalLines":79}},"sourceToolAssistantUUID":"0ccd11c3-a816-4fe5-8d1b-058963c3cf83","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"6b5850df-ed76-4f8a-abbb-20924e727fbf","version":"2.1.202","gitBranch":"main"}
