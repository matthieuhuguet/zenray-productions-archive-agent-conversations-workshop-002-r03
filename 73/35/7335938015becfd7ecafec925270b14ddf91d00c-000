\t\n438\t  # --- Sixtine Moullé-Berteaux ---\n439\t  \"youtube.com/@sixtinemoulleberteaux\"\n440\t  \"sixtinemoulleberteaux\"\n441\t  \"sixtine.moulleberteaux\"\n442\t  \"sixtine moulle\"\n443\t  \"sixtine moullé\"\n444\t\n445\t  # --- Wallerand Moullé-Berteaux ---\n446\t  \"wallerandmoulleberteaux\"\n447\t  \"wallerand.moulleberteaux\"\n448\t  \"wallerand moulle\"\n449\t  \"wallerand moullé\"\n450\t\n451\t  # --- Eric Larchevêque ---\n452\t  \"ericlarcheveque\"\n453\t  \"eric larcheveque\"\n454\t  \"eric l'archeveque\"\n455\t  \"eric larchevêque\"\n456\t\n457\t  # --- Guillaume Moubèche ---\n458\t  \"guillaumemoubeche\"\n459\t  \"guillaume moubeche\"\n460\t  \"guillaume moubèche\"\n461\t\n462\t  # --- Alex Hitchens (+ chaînes secondaires captées par identité) ---\n463\t  \"alexhitchens\"\n464\t  \"alex hitchens\"\n465\t\n466\t  # --- Julien Chieze (actu jeux vidéo) ---\n467\t  \"julienchieze\"\n468\t  \"julien chieze\"\n469\t\n470\t  # --- HugoDécrypte (actu, toutes ses chaînes) ---\n471\t  \"youtube.com/@hugodecrypte\"\n472\t  \"youtube.com/@hugodecrypteactus\"\n473\t  \"youtube.com/@hugodecryptegrandsformats\"\n474\t  \"hugodecrypte\"\n475\t  \"hugo decrypte\"\n476\t  \"hugo décrypte\"\n477\t\n478\t  # --- Le Crayon (actu/médias) ---\n479\t  \"youtube.com/@lecrayon\"\n480\t  \"le crayon\"\n481\t\n482\t  # --- Sphère business / make-money / mindset / manosphère (backstop identité) ---\n483\t  # NOMS uniquement : n'agissent que si la chaîne visitée porte ce nom.\n484\t  # Matthieu peut en retirer/ajouter librement, aucun effet de bord sur les tiers.\n485\t  \"iman gadzhi\"\n486\t  \"imangadzhi\"\n487\t  \"andrew tate\"\n488\t  \"tristan tate\"\n489\t  \"cobratate\"\n490\t  \"theophile eliet\"\n491\t  \"théophile eliet\"\n492\t  \"enzo honore\"\n493\t  \"enzo honoré\"\n494\t  \"franck nicolas\"\n495\t  \"idriss aberkane\"\n496\t  \"anthony bourbon\"\n497\t  \"hasheur\"\n498\t  \"owen simonin\"\n499\t  \"lorenzo ferrante\"\n500\t  \"mick levy\"\n501\t  \"younes belghazi\"\n502\t  \"yann darwin\"\n503\t  \"raoul pop\"\n504\t  \"david laroche\"\n505\t  \"fabien snauwaert\"\n506\t  \"romain pichon\"\n507\t  \"tugan bara\"\n508\t  \"tugan.baranovsky\"\n509\t  \"morgan prével\"\n510\t  \"morgan prevel\"\n511\t  \"valentin decker\"\n512\t  \"jean rivière\"\n513\t  \"jeremy kohlmann\"\n514\t  \"aurelien amacker\"\n515\t  \"aurélien amacker\"\n516\t\n517\t  # --- La Chapelle Radio / Hugo Bentz ---\n518\t  \"youtube.com/@la-chapelle-radio-hugo-bentz\"\n519\t  \"la chapelle radio\"\n520\t  \"hugo bentz\"\n521\t\n522\t  # --- Matthieu Stefani / Génération Do It Yourself (GDIY) ---\n523\t  \"matthieu stefani\"\n524\t  \"generation do it yourself\"\n525\t  \"génération do it yourself\"\n526\t  \"gdiy\"\n527\t\n528\t  # --- Pauline Laigneau ---\n529\t  \"youtube.com/@paulinelaigneau\"\n530\t  \"pauline laigneau\"\n531\t\n532\t  # --- Yan Darwin (variante orthographe) ---\n533\t  \"yan darwin\"\n534\t\n535\t  # --- Les Découvreurs ---\n536\t  \"youtube.com/@les_decouvreurs\"\n537\t  \"les decouvreurs\"\n538\t  \"les découvreurs\"\n539\t\n540\t  # --- Théophile Eliet (handle a tiret, cf. Normalize ci-dessous) ---\n541\t  \"youtube.com/@theophile-eliet\"\n542\t\n543\t  # --- Laurent Alexandre ---\n544\t  \"laurent alexandre\"\n545\t\n546\t  # --- Alexandre Cicoupoulos ---\n547\t  \"alexandre cicoupoulos\"\n548\t\n549\t  # --- Le Précepteur ---\n550\t  \"le precepteur\"\n551\t  \"le précepteur\"\n552\t\n553\t  # --- My Better Self ---\n554\t  \"mybetterself\"\n555\t  \"my better self\"\n556\t\n557\t  # --- Squeezie ---\n558\t  \"squeezie\"\n559\t\n560\t  # --- Naval Ravikant ---\n561\t  \"naval ravikant\"\n562\t  \"navalravikant\"\n563\t\n564\t  # --- LouisSan (+ toutes chaines secondaires : LouisSanCorp etc., captees par le radical commun) ---\n565\t  \"louissan\"\n566\t  \"louissancorp\"\n567\t)\n568\t\n569\t# Ignore tirets/points/underscores/espaces : un pseudo peut s'écrire\n570\t# \"theophile-eliet\", \"theophile.eliet\" ou \"theophile eliet\" selon la\n571\t# plateforme. Normaliser les DEUX côtés (texte lu + motif) neutralise toute\n572\t# la classe de bugs de séparateur en un seul endroit, plutôt que d'écrire\n573\t# 3 variantes par créateur.\n574\tNormalize() {\n575\t  local s=\"${1:l}\"\n576\t  s=\"${s//[-._ ]/}\"\n577\t  printf '%s' \"$s\"\n578\t}\n579\t\n580\t# Précalculé une seule fois au chargement du script (pas dans la boucle de\n581\t# surveillance qui tourne toutes les 2s) : évite ~90 forks inutiles en continu.\n582\tNORMALIZED_PATTERNS=()\n583\tfor _p in \"${BLOCKED_PATTERNS[@]}\"; do\n584\t  NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\")\n585\tdone\n586\tunset _p\n587\t\n588\t# Assainit un motif en nom de fichier sûr (pas de fork shasum, la grâce est rare).\n589\tGraceFileFor() {\n590\t  local safe\n591\t  safe=\"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n592\t  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$safe\"\n593\t}\n594\t\n595\t# Un motif \"gracié\" (récompense en cours) n'est temporairement plus bloquant.\n596\tPatternIsGraced() {\n597\t  local f until now\n598\t  f=\"$(GraceFileFor \"$1\")\"\n599\t  [[ -f \"$f\" ]] || return 1\n600\t  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n601\t  now=\"$(NowEpoch)\"\n602\t  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n603\t  [[ \"$now\" -lt \"$until\" ]]\n604\t}\n605\t\n606\t# Un seul et même test de correspondance (brut OU normalisé), utilisé à la\n607\t# fois par GrantGrace et TextMatchesBlocked. Les deux DOIVENT être\n608\t# d'accord sur \"quels motifs ce texte déclenche\" : sinon une grâce accordée\n609\t# ne couvre pas un motif qui ne matche que via la forme normalisée (bug\n610\t# constaté en test : \"silicon carne\" avec espace ne matche qu'une fois\n611\t# l'espace supprimé -> grâce partielle -> reblocage immédiat malgré la\n612\t# récompense gagnée).\n613\tPatternMatches() {\n614\t  local lpattern=\"$1\" npattern=\"$2\" text=\"$3\" ntext=\"$4\"\n615\t  [[ \"$text\" == *\"$lpattern\"* ]] && return 0\n616\t  [[ -n \"$npattern\" && \"$ntext\" == *\"$npattern\"* ]] && return 0\n617\t  return 1\n618\t}\n619\t\n620\t# Accorde REWARD_MINUTES à tous les motifs que l'URL cible fait matcher\n621\t# (jamais un blocage global : gagner l'accès à un créateur ne débloque pas les autres).\n622\tGrantGrace() {\n623\t  local target=\"$1\" ltarget nltarget until i n\n624\t  ltarget=\"${target:l}\"\n625\t  nltarget=\"$(Normalize \"$target\")\"\n626\t  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n627\t  EnsureDirs\n628\t  n=${#BLOCKED_PATTERNS[@]}\n629\t  for (( i = 1; i <= n; i++ )); do\n630\t    PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\" \\\n631\t      && printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n632\t  done\n633\t}\n634\t\n635\tTextMatchesBlocked() {\n636\t  local raw=\"$1\"\n637\t  local text=\"${raw:l}\"\n638\t  local ntext anyGrace=0 i n\n639\t  local -a graceFiles\n640\t  ntext=\"$(Normalize \"$raw\")\"\n641\t  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n642\t  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n643\t  n=${#BLOCKED_PATTERNS[@]}\n644\t  for (( i = 1; i <= n; i++ )); do\n645\t    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$text\" \"$ntext\"; then\n646\t      (( anyGrace )) && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\" && continue\n647\t      return 0\n648\t    fi\n649\t  done\n650\t  return 1\n651\t}\n652\t\n653\tUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\n654\tUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))' \"$1\"; }\n655\t\n656\t# Lit un paramètre de query string ($2) depuis une URL ($1), décodé.\n657\tExtractParam() {\n658\t  local u=\"$1\" name=\"$2\" q pair\n659\t  q=\"${u#*\\?}\"\n660\t  [[ \"$q\" == \"$u\" ]] && return 0\n661\t  for pair in ${(s:&:)q}; do\n662\t    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n663\t  done\n664\t}\n665\t\n666\t# URL de la page de garde pour une cible donnée, avec l'horodatage de départ\n667\t# du compte à rebours (permet de recalculer le temps écoulé après reload).\n668\tGateUrlFor() {\n669\t  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n670\t}\n671\t\n672\t# Construit la liste Chrome URLBlocklist (couche root optionnelle) à partir des\n673\t# motifs qui ressemblent à des URL (ceux contenant « / »). Couvre l'incognito Chrome.\n674\tBuildChromeBlocklist() {\n675\t  CHROME_BLOCKLIST=()\n676\t  local p\n677\t  for p in \"${BLOCKED_PATTERNS[@]}\"; do\n678\t    [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\")\n679\t  done\n680\t}\n681\t\n682\tIsResolvableYouTubeUrl() {\n683\t  local url=\"${1:l}\"\n684\t  [[ \"$url\" == *\"youtube.com/watch?\"* ]] && return 0\n685\t  [[ \"$url\" == *\"youtube.com/shorts/\"* ]] && return 0\n686\t  [[ \"$url\" == *\"youtube.com/live/\"* ]] && return 0\n687\t  [[ \"$url\" == *\"youtube.com/post/\"* ]] && return 0\n688\t  [[ \"$url\" == *\"youtu.be/\"* ]] && return 0\n689\t  return 1\n690\t}\n691\t\n692\tYouTubeIdentityForUrl() {\n693\t  local url=\"$1\"\n694\t  TextMatchesBlocked \"$url\" && {\n695\t    printf '%s\\n' \"$url\"\n696\t    return 0\n697\t  }\n698\t  IsResolvableYouTubeUrl \"$url\" || return 1\n699\t\n700\t  local ytdlp cacheDir key cache json identity\n701\t  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n702\t  [[ -n \"$ytdlp\" ]] || return 1\n703\t\n704\t  cacheDir=\"$STATE_DIR/youtube-identity-cache\"\n705\t  mkdir -p \"$cacheDir\"\n706\t  key=\"$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}')\"\n707\t  cache=\"$cacheDir/$key.txt\"\n708\t  if [[ -s \"$cache\" ]]; then\n709\t    cat \"$cache\"\n710\t    return 0\n711\t  fi\n712\t\n713\t  json=\"$(\"$ytdlp\" \\\n714\t    --dump-single-json \\\n715\t    --no-playlist \\\n716\t    --skip-download \\\n717\t    --socket-timeout 4 \\\n718\t    --extractor-retries 1 \\\n719\t    --retries 1 \\\n720\t    \"$url\" 2>/dev/null || true)\"\n721\t\n722\t  identity=\"$(printf '%s' \"$json\" | jq -r '\n723\t    [\n724\t      .channel,\n725\t      .uploader,\n726\t      .channel_id,\n727\t      .uploader_id,\n728\t      .channel_url,\n729\t      .uploader_url,\n730\t      .creator,\n731\t      .webpage_url,\n732\t      .original_url\n733\t    ]\n734\t    | map(select(type == \"string\" and length > 0))\n735\t    | join(\" \")\n736\t  ' 2>/dev/null || true)\"\n737\t\n738\t  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n739\t  printf '%s\\n' \"$identity\"\n740\t}\n741\t\n742\t# Familles de navigateurs couvertes. Tous les Chromium partagent le\n743\t# vocabulaire d'onglets de Google Chrome via « using terms from ».\n744\tCHROMIUM_BROWSERS=(\n745\t  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n746\t  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n747\t  \"Vivaldi\" \"Opera\" \"Opera GX\"\n748\t)\n749\t\n750\tListBrowserTabs() {\n751\t  local b\n752\t  # UN osascript PAR navigateur réellement lancé (pgrep). Jamais de référence à\n753\t  # une app non installée -> plus de dialogue \"Where is X?\" ; et un navigateur\n754\t  # qui échoue (permission refusée) n'entraîne pas la perte des onglets des autres.\n755\t  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n756\t    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n757\t    osascript <<APPLESCRIPT 2>/dev/null || true\n758\tset Output to \"\"\n759\tset T to ASCII character 9\n760\tusing terms from application \"Google Chrome\"\n761\t  tell application \"$b\"\n762\t    repeat with W from 1 to (count of windows)\n763\t      repeat with I from 1 to (count of tabs of window W)\n764\t        try\n765\t          set U to URL of tab I of window W as text\n766\t          set Output to Output & \"$b\" & T & W & T & I & T & U & linefeed\n767\t        end try\n768\t      end repeat\n769\t    end repeat\n770\t  end tell\n771\tend using terms from\n772\treturn Output\n773\tAPPLESCRIPT\n774\t  done\n775\t  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n776\t    osascript <<'APPLESCRIPT' 2>/dev/null || true\n777\tset Output to \"\"\n778\tset T to ASCII character 9\n779\ttell application \"Safari\"\n780\t  repeat with W from 1 to (count of windows)\n781\t    repeat with I from 1 to (count of tabs of window W)\n782\t      try\n783\t        set U to URL of tab I of window W as text\n784\t        set Output to Output & \"Safari\" & T & W & T & I & T & U & linefeed\n785\t      end try\n786\t    end repeat\n787\t  end repeat\n788\tend tell\n789\treturn Output\n790\tAPPLESCRIPT\n791\t  fi\n792\t}\n793\t\n794\t# Redirige UN onglet vers destUrl (page de garde ou, à la levée d'une\n795\t# récompense, l'URL réelle du contenu). Générique à toute la famille Chromium\n796\t# via « using terms from », branche dédiée pour Safari (dictionnaire propre).\n797\tRedirectBrowserTab() {\n798\t  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n799\t  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\n800\ton run argv\n801\t  set BrowserName to item 1 of argv\n802\t  set WindowIndex to (item 2 of argv) as integer\n803\t  set TabIndex to (item 3 of argv) as integer\n804\t  set DestUrl to item 4 of argv\n805\t\n806\t  if BrowserName is \"Safari\" then\n807\t    tell application \"Safari\"\n808\t      set URL of tab TabIndex of window WindowIndex to DestUrl\n809\t    end tell\n810\t  else\n811\t    using terms from application \"Google Chrome\"\n812\t      tell application BrowserName\n813\t        set URL of tab TabIndex of window WindowIndex to DestUrl\n814\t      end tell\n815\t    end using terms from\n816\t  end if\n817\tend run\n818\tAPPLESCRIPT\n819\t}\n820\t\n821\t# Décide et agit pour un seul onglet :\n822\t# - onglet déjà sur la page de garde avec \"unlock=1\" (bouton récompense cliqué,\n823\t#   30 min bien écoulées) -> grâce accordée, redirection vers le vrai contenu.\n824\t# - onglet sur un site/pseudo bloqué -> redirection vers la page de garde,\n825\t#   avec l'URL cible + l'horodatage de départ du compte à rebours.\n826\tHandleTab() {\n827\t  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n828\t\n829\t  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n830\t    if [[ \"$url\" == *\"unlock=1\"* ]]; then\n831\t      local target startedAt now\n832\t      target=\"$(ExtractParam \"$url\" u)\"\n833\t      startedAt=\"$(ExtractParam \"$url\" t)\"\n834\t      now=\"$(NowEpoch)\"\n835\t      if [[ -n \"$target\" && \"$startedAt\" =~ ^[0-9]+$ && $(( now - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n836\t        GrantGrace \"$target\"\n837\t        RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n838\t      else\n839\t        # Lien \"unlock\" prématuré ou malformé : retour à un compte à rebours honnête.\n840\t        [[ -n \"$target\" ]] && RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n841\t      fi\n842\t    fi\n843\t    return 0\n844\t  fi\n845\t\n846\t  local lurl=\"${url:l}\"\n847\t  case \"$lurl\" in\n848\t    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n849\t    *) return 0 ;;\n850\t  esac\n851\t\n852\t  local identity=\"$url\"\n853\t  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n854\t    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n855\t    [[ -n \"$identity\" ]] || identity=\"$url\"\n856\t  fi\n857\t\n858\t  if TextMatchesBlocked \"$identity\"; then\n859\t    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n860\t  fi\n861\t}\n862\t\n863\tEnforceTabs() {\n864\t  EnsureBlockPage\n865\t  local browser windowIndex tabIndex url\n866\t  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n867\t    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n868\t    HandleTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$url\"\n869\t  done < <(ListBrowserTabs)\n870\t}\n871\t\n872\tEnforce() {\n873\t  EnsureSecret\n874\t  if ShouldBlock; then\n875\t    EnforceTabs\n876\t  fi\n877\t  RemoveHostsBlock\n878\t  RemoveChromePolicy\n879\t}\n880\t\n881\tWatchTabs() {\n882\t  EnsureSecret\n883\t  while true; do\n884\t    if ShouldBlock; then\n885\t      EnforceTabs\n886\t      sleep 2\n887\t    else\n888\t      sleep 60\n889\t    fi\n890\t  done\n891\t}\n892\t\n893\tWriteUserPlist() {\n894\t  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n895\t  cat > \"$USER_PLIST\" <<PLIST\n896\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n897\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n898\t<plist version=\"1.0\">\n899\t<dict>\n900\t  <key>Label</key>\n901\t  <string>$USER_LABEL</string>\n902\t  <key>ProgramArguments</key>\n903\t  <array>\n904\t    <string>$SCRIPT_PATH</string>\n905\t    <string>watch-tabs</string>\n906\t  </array>\n907\t  <key>RunAtLoad</key>\n908\t  <true/>\n909\t  <key>KeepAlive</key>\n910\t  <true/>\n911\t  <key>StandardOutPath</key>\n912\t  <string>$HOME/Library/Logs/SocialMediaFocusGuard.tabs.log</string>\n913\t  <key>StandardErrorPath</key>\n914\t  <string>$HOME/Library/Logs/SocialMediaFocusGuard.tabs.err.log</string>\n915\t</dict>\n916\t</plist>\n917\tPLIST\n918\t  plutil -lint \"$USER_PLIST\" >/dev/null\n919\t}\n920\t\n921\tInstallUser() {\n922\t  EnsureSecret\n923\t  WriteUserPlist\n924\t  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n925\t  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n926\t  # macOS garde un override \"disabled\" persistant PAR LABEL, distinct de notre\n927\t  # propre $DISABLED_FILE : si ce garde-fou a déjà été arrêté une fois, ce\n928\t  # bit reste posé même après un nouveau bootstrap et refait échouer le\n929\t  # chargement (I/O error) tant qu'il n'est pas explicitement relevé ici.\n930\t  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n931\t  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n932\t  Say \"User tab guard installed.\"\n933\t}\n934\t\n935\tWriteRootPlist() {\n936\t  [[ \"$EUID\" -eq 0 ]] || {\n937\t    Say \"Root install needs admin rights.\"\n938\t    exit 1\n939\t  }\n940\t  cat > \"$ROOT_PLIST\" <<PLIST\n941\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n942\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n943\t<plist version=\"1.0\">\n944\t<dict>\n945\t  <key>Label</key>\n946\t  <string>$ROOT_LABEL</string>\n947\t  <key>ProgramArguments</key>\n948\t  <array>\n949\t    <string>$SCRIPT_PATH</string>\n950\t    <string>enforce</string>\n951\t  </array>\n952\t  <key>RunAtLoad</key>\n953\t  <true/>\n954\t  <key>StartInterval</key>\n955\t  <integer>60</integer>\n956\t  <key>StandardOutPath</key>\n957\t  <string>/var/log/SocialMediaFocusGuard.log</string>\n958\t  <key>StandardErrorPath</key>\n959\t  <string>/var/log/SocialMediaFocusGuard.err.log</string>\n960\t</dict>\n961\t</plist>\n962\tPLIST\n963\t  chown root:wheel \"$ROOT_PLIST\"\n964\t  chmod 644 \"$ROOT_PLIST\"\n965\t  plutil -lint \"$ROOT_PLIST\" >/dev/null\n966\t}\n967\t\n968\tInstallRoot() {\n969\t  EnsureSecret\n970\t  CleanupRoot\n971\t}\n972\t\n973\tCleanupRoot() {\n974\t  [[ \"$EUID\" -eq 0 ]] || {\n975\t    Say \"Root cleanup needs admin rights.\"\n976\t    exit 1\n977\t  }\n978\t  RemoveHostsBlock\n979\t  RemoveChromePolicy\n980\t  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n981\t  rm -f \"$ROOT_PLIST\"\n982\t  Say \"Root network guard removed. UI guard is active through the user agent.\"\n983\t}\n984\t\n985\tSuspend() {\n986\t  RequireGuardPassword\n987\t  local minutes until\n988\t  minutes=\"${1:-30}\"\n989\t  [[ \"$minutes\" =~ '^[0-9]+$' ]] || {\n990\t    Say \"Minutes must be a number.\"\n991\t    exit 1\n992\t  }\n993\t  EnsureDirs\n994\t  until=\"$(( $(NowEpoch) + minutes * 60 ))\"\n995\t  printf '%s\\n' \"$until\" > \"$SUSPEND_FILE\"\n996\t  Enforce\n997\t  Say \"Guard suspended for $minutes minutes.\"\n998\t}\n999\t\n1000\tDisable() {\n1001\t  RequireGuardPassword\n1002\t  EnsureDirs\n1003\t  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n1004\t  Enforce\n1005\t  Say \"Guard disabled.\"\n1006\t}\n1007\t\n1008\tEnable() {\n1009\t  EnsureDirs\n1010\t  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n1011\t  Enforce\n1012\t  Say \"Guard enabled.\"\n1013\t}\n1014\t\n1015\tStatus() {\n1016\t  local protected disabled suspended hostsBlock chromePolicy userLoaded rootLoaded\n1017\t  protected=\"no\"\n1018\t  disabled=\"no\"\n1019\t  suspended=\"no\"\n1020\t  hostsBlock=\"no\"\n1021\t  chromePolicy=\"no\"\n1022\t  userLoaded=\"no\"\n1023\t  rootLoaded=\"no\"\n1024\t\n1025\t  IsProtectedNow && protected=\"yes\"\n1026\t  IsDisabled && disabled=\"yes\"\n1027\t  IsSuspended && suspended=\"yes\"\n1028\t  grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && hostsBlock=\"yes\"\n1029\t  if [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1; then\n1030\t    chromePolicy=\"yes\"\n1031\t  fi\n1032\t  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n1033\t  launchctl print \"system/$ROOT_LABEL\" >/dev/null 2>&1 && rootLoaded=\"yes\"\n1034\t\n1035\t  Say \"protected_hours=$protected\"\n1036\t  Say \"disabled=$disabled\"\n1037\t  Say \"suspended=$suspended\"\n1038\t  Say \"user_tab_guard_loaded=$userLoaded\"\n1039\t  Say \"root_host_guard_loaded=$rootLoaded\"\n1040\t  Say \"hosts_block_present=$hostsBlock\"\n1041\t  Say \"chrome_policy_present=$chromePolicy\"\n1042\t  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n1043\t  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n1044\t}\n1045\t\n1046\tUninstallUser() {\n1047\t  RequireGuardPassword\n1048\t  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n1049\t  rm -f \"$USER_PLIST\"\n1050\t  Say \"User tab guard uninstalled.\"\n1051\t}\n1052\t\n1053\tUninstallRoot() {\n1054\t  RequireGuardPassword\n1055\t  [[ \"$EUID\" -eq 0 ]] || {\n1056\t    Say \"Root uninstall needs admin rights.\"\n1057\t    exit 1\n1058\t  }\n1059\t  RemoveHostsBlock\n1060\t  RemoveChromePolicy\n1061\t  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n1062\t  rm -f \"$ROOT_PLIST\"\n1063\t  Say \"Root host guard uninstalled.\"\n1064\t}\n1065\t\n1066\tcase \"${1:-status}\" in\n1067\t  install-user)\n1068\t    InstallUser\n1069\t    ;;\n1070\t  install-root)\n1071\t    InstallRoot\n1072\t    ;;\n1073\t  enforce)\n1074\t    Enforce\n1075\t    ;;\n1076\t  watch-tabs)\n1077\t    WatchTabs\n1078\t    ;;\n1079\t  close-tabs)\n1080\t    EnforceTabs\n1081\t    ;;\n1082\t  suspend)\n1083\t    Suspend \"${2:-30}\"\n1084\t    ;;\n1085\t  disable)\n1086\t    Disable\n1087\t    ;;\n1088\t  enable)\n1089\t    Enable\n1090\t    ;;\n1091\t  status)\n1092\t    Status\n1093\t    ;;\n1094\t  uninstall-user)\n1095\t    UninstallUser\n1096\t    ;;\n1097\t  uninstall-root)\n1098\t    UninstallRoot\n1099\t    ;;\n1100\t  cleanup-root)\n1101\t    CleanupRoot\n1102\t    ;;\n1103\t  *)\n1104\t    Say \"Usage: $0 install-user|install-root|status|enable|disable|suspend [minutes]|enforce|watch-tabs|close-tabs|uninstall-user|uninstall-root|cleanup-root\"\n1105\t    exit 1\n1106\t    ;;\n1107\tesac\n1108\t"}]},"uuid":"d4d18cdf-d932-4dc1-8f7f-2001dbf78b5c","timestamp":"2026-07-09T13:45:36.138Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Memory/Tools/FocusGuard/SocialMediaFocusGuard.sh","content":"#!/bin/zsh\nset -euo pipefail\n\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\nSECRET_FILE=\"$FOCUS_DIR/.SocialMediaFocusGuardPassword\"\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaFocusGuardState\"\nDISABLED_FILE=\"$STATE_DIR/disabled\"\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\n\n# Anciens noms (époque \"YouTube only\") : migrés une fois vers les nouveaux,\n# pour ne pas perdre le mot de passe local ni l'état de grâce en cours.\nLEGACY_SECRET_FILE=\"$FOCUS_DIR/.YouTubeFocusGuardPassword\"\nLEGACY_STATE_DIR=\"$FOCUS_DIR/.YouTubeFocusGuardState\"\nLEGACY_BLOCK_PAGE_FILE=\"$FOCUS_DIR/YouTubeBlocked.html\"\nILLUSTRATION_FILE=\"$MEMORY_ROOT/ArtDirection/output_v3.png\"\nILLUSTRATION_URL=\"file://$ILLUSTRATION_FILE\"\n\n# Blocage permanent (24/7) : ces chaînes/comptes sont fermés en continu, plus de fenêtre horaire.\nSTART_HOUR=\"${SMFG_START_HOUR:-0}\"\nEND_HOUR=\"${SMFG_END_HOUR:-24}\"\n\n# Mécanique friction + récompense méritée (remplace le blocage sec) :\n# 30 min d'attente affichée (assez long pour se fermer l'onglet soi-même, ou\n# faire autre chose d'abord) puis, si vraiment voulu, 30 min d'accès gagné.\nWAIT_MINUTES=\"${SMFG_WAIT_MINUTES:-30}\"\nREWARD_MINUTES=\"${SMFG_REWARD_MINUTES:-30}\"\n\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_FOCUS_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_FOCUS_GUARD_END\"\n\nUSER_LABEL=\"com.zenray.social-media-focus-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-focus-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaFocusGuard.sh\"\n\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-focus-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\n\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\nEnsureBlockPage() {\n  EnsureDirs\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Contenu ferme</title>\n  <style>\n    @font-face {\n      font-family: \"Anthropic Sans\";\n      src: url(\"file:///Users/zenray/Library/Fonts/AnthropicSans-Light.ttf\") format(\"truetype\");\n      font-weight: 300;\n    }\n    :root {\n      color-scheme: dark;\n      background: #242424;\n      color: #f2f2f2;\n    }\n    * {\n      box-sizing: border-box;\n    }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      background: #242424;\n      font-family: \"Anthropic Sans\", system-ui, sans-serif;\n    }\n    main {\n      width: min(1500px, calc(100vw - 48px));\n      text-align: center;\n    }\n    .art {\n      display: block;\n      width: min(720px, calc(100vw - 120px));\n      margin: 0 auto 28px;\n      border-radius: 8px;\n      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.22);\n    }\n    h1 {\n      margin: 0;\n      color: #efefef;\n      font-size: clamp(30px, 3.6vw, 62px);\n      font-weight: 300;\n      line-height: 1.12;\n      text-transform: uppercase;\n    }\n    p {\n      margin: 0 0 28px;\n      color: #c9c9c9;\n      font-size: clamp(16px, 1.6vw, 26px);\n      font-weight: 300;\n      line-height: 1.35;\n      text-transform: none;\n    }\n    .eyebrow {\n      font-family: \"Anthropic Sans\", system-ui, sans-serif;\n      color: #cc7c5e;\n      font-size: 13px;\n      font-weight: 500;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      margin: 0 0 14px;\n    }\n    .timer {\n      font-size: clamp(48px, 9vw, 128px);\n      font-weight: 300;\n      color: #efefef;\n      margin-bottom: 10px;\n      font-variant-numeric: tabular-nums;\n    }\n    .btn {\n      display: inline-block;\n      margin-top: 6px;\n      padding: 14px 30px;\n      border-radius: 999px;\n      background: #efefef;\n      color: #242424;\n      text-decoration: none;\n      font-weight: 500;\n      letter-spacing: .01em;\n    }\n    .note {\n      margin-top: 14px;\n      font-size: 14px;\n      color: #8c857d;\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"Illustration\" />\n    <div id=\"waitBox\">\n      <p class=\"eyebrow\">Garde-fou createur</p>\n      <div class=\"timer\" id=\"countdown\">--:--</div>\n      <h1>Va d'abord avancer un exercice Unreal ou Houdini</h1>\n      <p>Dans $WAIT_MINUTES minutes, si tu en as vraiment besoin, tu auras gagne le droit de voir ce contenu.</p>\n    </div>\n    <div id=\"rewardBox\" style=\"display:none\">\n      <p class=\"eyebrow\">Recompense meritee</p>\n      <h1>Temps ecoule</h1>\n      <p>Acces valable $REWARD_MINUTES minutes, puis refermeture automatique.</p>\n      <a id=\"rewardLink\" class=\"btn\" href=\"#\">Ouvrir maintenant</a>\n    </div>\n    <div id=\"closedBox\" style=\"display:none\">\n      <h1>Ces chaines sont fermees</h1>\n      <p>Profil createur, on ne regarde plus.</p>\n    </div>\n  </main>\n  <script>\n  (function () {\n    var params = new URLSearchParams(location.search);\n    var target = params.get('u') || '';\n    var startedSec = parseInt(params.get('t') || '0', 10) || 0;\n    var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n    var waitBox = document.getElementById('waitBox');\n    var rewardBox = document.getElementById('rewardBox');\n    var closedBox = document.getElementById('closedBox');\n    if (!target || !startedSec) {\n      waitBox.style.display = 'none';\n      closedBox.style.display = 'block';\n      return;\n    }\n    var countdownEl = document.getElementById('countdown');\n    function fmt(s) {\n      var m = Math.floor(s / 60), r = s % 60;\n      return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r;\n    }\n    function tick() {\n      var now = Math.floor(Date.now() / 1000);\n      var remain = WAIT_SECONDS - (now - startedSec);\n      if (remain <= 0) {\n        waitBox.style.display = 'none';\n        var link = document.getElementById('rewardLink');\n        link.href = location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n        rewardBox.style.display = 'block';\n        return;\n      }\n      countdownEl.textContent = fmt(remain);\n      setTimeout(tick, 1000);\n    }\n    tick();\n  })();\n  </script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\nSay() {\n  printf '%s\\n' \"$*\"\n}\n\n# Renomme les anciens fichiers \"YouTube*\" vers les nouveaux \"SocialMedia*\".\n# Idempotent : après migration les anciens n'existent plus, les tests échouent\n# vite. Ne touche jamais un nouveau fichier déjà présent (pas d'écrasement).\nMigrateLegacy() {\n  [[ -f \"$LEGACY_SECRET_FILE\" && ! -f \"$SECRET_FILE\" ]] && mv \"$LEGACY_SECRET_FILE\" \"$SECRET_FILE\" 2>/dev/null\n  [[ -d \"$LEGACY_STATE_DIR\" && ! -d \"$STATE_DIR\" ]] && mv \"$LEGACY_STATE_DIR\" \"$STATE_DIR\" 2>/dev/null\n  [[ -f \"$LEGACY_BLOCK_PAGE_FILE\" ]] && rm -f \"$LEGACY_BLOCK_PAGE_FILE\" 2>/dev/null\n  return 0\n}\n\nEnsureDirs() {\n  MigrateLegacy\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\nInstallOwner() {\n  printf 'zenray'\n}\n\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    local owner\n    owner=\"$(InstallOwner)\"\n    chown \"${owner}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${SMFG_PASSWORD:-}\" ]]; then\n    input=\"$SMFG_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo\n    IFS= read -r input\n    stty echo\n    printf '\\n' >&2\n  fi\n  if [[ \"$input\" != \"$expected\" ]]; then\n    Say \"Wrong focus password.\"\n    exit 2\n  fi\n}\n\nIsDisabled() {\n  [[ -f \"$DISABLED_FILE\" ]]\n}\n\nNowEpoch() {\n  date '+%s'\n}\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until now\n  until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  now=\"$(NowEpoch)\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$now\" -lt \"$until\" ]]\n}\n\nIsProtectedNow() {\n  local hour\n  hour=\"$(date '+%H')\"\n  hour=\"${hour#0}\"\n  [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\nShouldBlock() {\n  IsDisabled && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\nFlushDns() {\n  dscacheutil -flushcache 2>/dev/null || true\n  killall -HUP mDNSResponder 2>/dev/null || true\n}\n\nStripHostsBlock() {\n  local source=\"$1\"\n  awk -v start=\"$HOSTS_MARK_START\" -v end=\"$HOSTS_MARK_END\" '\n    $0 == start {skip = 1; next}\n    $0 == end {skip = 0; next}\n    skip != 1 {print}\n  ' \"$source\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  {\n    cat \"$tmp\"\n    printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    for domain in \"${HOST_DOMAINS[@]}\"; do\n      printf '0.0.0.0\\t%s\\n' \"$domain\"\n      printf '::1\\t%s\\n' \"$domain\"\n    done\n    printf '%s\\n' \"$HOSTS_MARK_END\"\n  } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"\n  rm -f \"$tmp\" \"$tmp.new\"\n  FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  cp \"$tmp\" \"$HOSTS_FILE\"\n  rm -f \"$tmp\"\n  FlushDns\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry\n  BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then\n      cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"\n      printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else\n      printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"\n    fi\n  fi\n  tmp=\"$(mktemp)\"\n  # IncognitoModeAvailability=1 -> incognito Chrome désactivé, donc tout passe en\n  # fenêtre normale, vue par la surveillance d'onglets (couvre la navigation privée).\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key>\n  <integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do\n    printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"\n  done\n  cat >> \"$tmp\" <<'PLIST'\n  </array>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"\n  rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"\n  chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state\n  state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then\n    cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else\n    rm -f \"$CHROME_POLICY_FILE\"\n  fi\n}\n\n# =========================================================================\n# SOURCE UNIQUE DE VÉRITÉ des blocages (avant : dupliquée à 3 endroits).\n# Chaque motif est cherché en sous-chaîne, insensible à la casse, dans :\n#   1) l'URL de l'onglet (tous navigateurs) -> couvre YouTube + Instagram +\n#      TikTok + Facebook + X/Twitter dès que le motif est le pseudo du compte.\n#   2) l'identité renvoyée par yt-dlp pour une page /watch (chaîne, uploader,\n#      channel_url…) -> attrape TOUTES les vidéos et chaînes secondaires d'un\n#      créateur même sans connaître leur pseudo exact (ex. « Alex Hitchens - … »).\n# Règle de sûreté : un motif qui ne correspond à rien ne bloque rien (échec\n# bénin). On peut donc être large sur les NOMS ; on reste précis (pseudo\n# concaténé ou URL) pour éviter tout blocage collatéral d'un tiers.\n# =========================================================================\nBLOCKED_PATTERNS=(\n  # --- Ici Japon (existant, conservé) ---\n  \"youtube.com/@icijaponcorp\"\n  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"\n  \"ici japon\"\n\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"\n  \"siliconcarne\"\n  \"silicon carne\"\n  \"carlosdiaz\"\n  \"carlos diaz\"\n\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"\n  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"\n  \"oussamaammar\"\n  \"oussama ammar\"\n\n  # --- Yomi Denzel ---\n  \"youtube.com/@yomidenzel\"\n  \"youtube.com/yomidenzel\"\n  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n  \"yomidenzel\"\n  \"yomi.denzel\"\n  \"yomi denzel\"\n\n  # --- Antoine Blanco (+ chaîne business) ---\n  \"youtube.com/@antoineblanco\"\n  \"youtube.com/@antoineblanco99\"\n  \"youtube.com/@antoineblancobusiness\"\n  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"\n  \"antoineblanco\"\n  \"antoine blanco\"\n\n  # --- Sixtine Moullé-Berteaux ---\n  \"youtube.com/@sixtinemoulleberteaux\"\n  \"sixtinemoulleberteaux\"\n  \"sixtine.moulleberteaux\"\n  \"sixtine moulle\"\n  \"sixtine moullé\"\n\n  # --- Wallerand Moullé-Berteaux ---\n  \"wallerandmoulleberteaux\"\n  \"wallerand.moulleberteaux\"\n  \"wallerand moulle\"\n  \"wallerand moullé\"\n\n  # --- Eric Larchevêque ---\n  \"ericlarcheveque\"\n  \"eric larcheveque\"\n  \"eric l'archeveque\"\n  \"eric larchevêque\"\n\n  # --- Guillaume Moubèche ---\n  \"guillaumemoubeche\"\n  \"guillaume moubeche\"\n  \"guillaume moubèche\"\n\n  # --- Alex Hitchens (+ chaînes secondaires captées par identité) ---\n  \"alexhitchens\"\n  \"alex hitchens\"\n\n  # --- Julien Chieze (actu jeux vidéo) ---\n  \"julienchieze\"\n  \"julien chieze\"\n\n  # --- HugoDécrypte (actu, toutes ses chaînes) ---\n  \"youtube.com/@hugodecrypte\"\n  \"youtube.com/@hugodecrypteactus\"\n  \"youtube.com/@hugodecryptegrandsformats\"\n  \"hugodecrypte\"\n  \"hugo decrypte\"\n  \"hugo décrypte\"\n\n  # --- Le Crayon (actu/médias) ---\n  \"youtube.com/@lecrayon\"\n  \"le crayon\"\n\n  # --- Sphère business / make-money / mindset / manosphère (backstop identité) ---\n  # NOMS uniquement : n'agissent que si la chaîne visitée porte ce nom.\n  # Matthieu peut en retirer/ajouter librement, aucun effet de bord sur les tiers.\n  \"iman gadzhi\"\n  \"imangadzhi\"\n  \"andrew tate\"\n  \"tristan tate\"\n  \"cobratate\"\n  \"theophile eliet\"\n  \"théophile eliet\"\n  \"enzo honore\"\n  \"enzo honoré\"\n  \"franck nicolas\"\n  \"idriss aberkane\"\n  \"anthony bourbon\"\n  \"hasheur\"\n  \"owen simonin\"\n  \"lorenzo ferrante\"\n  \"mick levy\"\n  \"younes belghazi\"\n  \"yann darwin\"\n  \"raoul pop\"\n  \"david laroche\"\n  \"fabien snauwaert\"\n  \"romain pichon\"\n  \"tugan bara\"\n  \"tugan.baranovsky\"\n  \"morgan prével\"\n  \"morgan prevel\"\n  \"valentin decker\"\n  \"jean rivière\"\n  \"jeremy kohlmann\"\n  \"aurelien amacker\"\n  \"aurélien amacker\"\n\n  # --- La Chapelle Radio / Hugo Bentz ---\n  \"youtube.com/@la-chapelle-radio-hugo-bentz\"\n  \"la chapelle radio\"\n  \"hugo bentz\"\n\n  # --- Matthieu Stefani / Génération Do It Yourself (GDIY) ---\n  \"matthieu stefani\"\n  \"generation do it yourself\"\n  \"génération do it yourself\"\n  \"gdiy\"\n\n  # --- Pauline Laigneau ---\n  \"youtube.com/@paulinelaigneau\"\n  \"pauline laigneau\"\n\n  # --- Yan Darwin (variante orthographe) ---\n  \"yan darwin\"\n\n  # --- Les Découvreurs ---\n  \"youtube.com/@les_decouvreurs\"\n  \"les decouvreurs\"\n  \"les découvreurs\"\n\n  # --- Théophile Eliet (handle a tiret, cf. Normalize ci-dessous) ---\n  \"youtube.com/@theophile-eliet\"\n\n  # --- Laurent Alexandre ---\n  \"laurent alexandre\"\n\n  # --- Alexandre Cicoupoulos ---\n  \"alexandre cicoupoulos\"\n\n  # --- Le Précepteur ---\n  \"le precepteur\"\n  \"le précepteur\"\n\n  # --- My Better Self ---\n  \"mybetterself\"\n  \"my better self\"\n\n  # --- Squeezie ---\n  \"squeezie\"\n\n  # --- Naval Ravikant ---\n  \"naval ravikant\"\n  \"navalravikant\"\n\n  # --- LouisSan (+ toutes chaines secondaires : LouisSanCorp etc., captees par le radical commun) ---\n  \"louissan\"\n  \"louissancorp\"\n)\n\n# Ignore tirets/points/underscores/espaces : un pseudo peut s'écrire\n# \"theophile-eliet\", \"theophile.eliet\" ou \"theophile eliet\" selon la\n# plateforme. Normaliser les DEUX côtés (texte lu + motif) neutralise toute\n# la classe de bugs de séparateur en un seul endroit, plutôt que d'écrire\n# 3 variantes par créateur.\nNormalize() {\n  local s=\"${1:l}\"\n  s=\"${s//[-._ ]/}\"\n  printf '%s' \"$s\"\n}\n\n# Précalculé une seule fois au chargement du script (pas dans la boucle de\n# surveillance qui tourne toutes les 2s) : évite ~90 forks inutiles en continu.\nNORMALIZED_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do\n  NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\")\ndone\nunset _p\n\n# Assainit un motif en nom de fichier sûr (pas de fork shasum, la grâce est rare).\nGraceFileFor() {\n  local safe\n  safe=\"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$safe\"\n}\n\n# Un motif \"gracié\" (récompense en cours) n'est temporairement plus bloquant.\nPatternIsGraced() {\n  local f until now\n  f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  now=\"$(NowEpoch)\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$now\" -lt \"$until\" ]]\n}\n\n# Un seul et même test de correspondance (brut OU normalisé), utilisé à la\n# fois par GrantGrace et TextMatchesBlocked. Les deux DOIVENT être\n# d'accord sur \"quels motifs ce texte déclenche\" : sinon une grâce accordée\n# ne couvre pas un motif qui ne matche que via la forme normalisée (bug\n# constaté en test : \"silicon carne\" avec espace ne matche qu'une fois\n# l'espace supprimé -> grâce partielle -> reblocage immédiat malgré la\n# récompense gagnée).\nPatternMatches() {\n  local lpattern=\"$1\" npattern=\"$2\" text=\"$3\" ntext=\"$4\"\n  [[ \"$text\" == *\"$lpattern\"* ]] && return 0\n  [[ -n \"$npattern\" && \"$ntext\" == *\"$npattern\"* ]] && return 0\n  return 1\n}\n\n# Accorde REWARD_MINUTES à tous les motifs que l'URL cible fait matcher\n# (jamais un blocage global : gagner l'accès à un créateur ne débloque pas les autres).\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"\n  nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\" \\\n      && printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n  done\n}\n\nTextMatchesBlocked() {\n  local raw=\"$1\"\n  local text=\"${raw:l}\"\n  local ntext anyGrace=0 i n\n  local -a graceFiles\n  ntext=\"$(Normalize \"$raw\")\"\n  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$text\" \"$ntext\"; then\n      (( anyGrace )) && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\" && continue\n      return 0\n    fi\n  done\n  return 1\n}\n\nUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\nUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))' \"$1\"; }\n\n# Lit un paramètre de query string ($2) depuis une URL ($1), décodé.\nExtractParam() {\n  local u=\"$1\" name=\"$2\" q pair\n  q=\"${u#*\\?}\"\n  [[ \"$q\" == \"$u\" ]] && return 0\n  for pair in ${(s:&:)q}; do\n    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n  done\n}\n\n# URL de la page de garde pour une cible donnée, avec l'horodatage de départ\n# du compte à rebours (permet de recalculer le temps écoulé après reload).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n# Construit la liste Chrome URLBlocklist (couche root optionnelle) à partir des\n# motifs qui ressemblent à des URL (ceux contenant « / »). Couvre l'incognito Chrome.\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=()\n  local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do\n    [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\")\n  done\n}\n\nIsResolvableYouTubeUrl() {\n  local url=\"${1:l}\"\n  [[ \"$url\" == *\"youtube.com/watch?\"* ]] && return 0\n  [[ \"$url\" == *\"youtube.com/shorts/\"* ]] && return 0\n  [[ \"$url\" == *\"youtube.com/live/\"* ]] && return 0\n  [[ \"$url\" == *\"youtube.com/post/\"* ]] && return 0\n  [[ \"$url\" == *\"youtu.be/\"* ]] && return 0\n  return 1\n}\n\nYouTubeIdentityForUrl() {\n  local url=\"$1\"\n  TextMatchesBlocked \"$url\" && {\n    printf '%s\\n' \"$url\"\n    return 0\n  }\n  IsResolvableYouTubeUrl \"$url\" || return 1\n\n  local ytdlp cacheDir key cache json identity\n  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n  [[ -n \"$ytdlp\" ]] || return 1\n\n  cacheDir=\"$STATE_DIR/youtube-identity-cache\"\n  mkdir -p \"$cacheDir\"\n  key=\"$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}')\"\n  cache=\"$cacheDir/$key.txt\"\n  if [[ -s \"$cache\" ]]; then\n    cat \"$cache\"\n    return 0\n  fi\n\n  json=\"$(\"$ytdlp\" \\\n    --dump-single-json \\\n    --no-playlist \\\n    --skip-download \\\n    --socket-timeout 4 \\\n    --extractor-retries 1 \\\n    --retries 1 \\\n    \"$url\" 2>/dev/null || true)\"\n\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [\n      .channel,\n      .uploader,\n      .channel_id,\n      .uploader_id,\n      .channel_url,\n      .uploader_url,\n      .creator,\n      .webpage_url,\n      .original_url\n    ]\n    | map(select(type == \"string\" and length > 0))\n    | join(\" \")\n  ' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n# Familles de navigateurs couvertes. Tous les Chromium partagent le\n# vocabulaire d'onglets de Google Chrome via « using terms from ».\nCHROMIUM_BROWSERS=(\n  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n  \"Vivaldi\" \"Opera\" \"Opera GX\"\n)\n\nListBrowserTabs() {\n  local b\n  # UN osascript PAR navigateur réellement lancé (pgrep). Jamais de référence à\n  # une app non installée -> plus de dialogue \"Where is X?\" ; et un navigateur\n  # qui échoue (permission refusée) n'entraîne pas la perte des onglets des autres.\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    osascript <<APPLESCRIPT 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\nusing terms from application \"Google Chrome\"\n  tell application \"$b\"\n    repeat with W from 1 to (count of windows)\n      repeat with I from 1 to (count of tabs of window W)\n        try\n          set U to URL of tab I of window W as text\n          set Output to Output & \"$b\" & T & W & T & I & T & U & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nreturn Output\nAPPLESCRIPT\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\ntell application \"Safari\"\n  repeat with W from 1 to (count of windows)\n    repeat with I from 1 to (count of tabs of window W)\n      try\n        set U to URL of tab I of window W as text\n        set Output to Output & \"Safari\" & T & W & T & I & T & U & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn Output\nAPPLESCRIPT\n  fi\n}\n\n# Redirige UN onglet vers destUrl (page de garde ou, à la levée d'une\n# récompense, l'URL réelle du contenu). Générique à toute la famille Chromium\n# via « using terms from », branche dédiée pour Safari (dictionnaire propre).\nRedirectBrowserTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set WindowIndex to (item 2 of argv) as integer\n  set TabIndex to (item 3 of argv) as integer\n  set DestUrl to item 4 of argv\n\n  if BrowserName is \"Safari\" then\n    tell application \"Safari\"\n      set URL of tab TabIndex of window WindowIndex to DestUrl\n    end tell\n  else\n    using terms from application \"Google Chrome\"\n      tell application BrowserName\n        set URL of tab TabIndex of window WindowIndex to DestUrl\n      end tell\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\n# Décide et agit pour un seul onglet :\n# - onglet déjà sur la page de garde avec \"unlock=1\" (bouton récompense cliqué,\n#   30 min bien écoulées) -> grâce accordée, redirection vers le vrai contenu.\n# - onglet sur un site/pseudo bloqué -> redirection vers la page de garde,\n#   avec l'URL cible + l'horodatage de départ du compte à rebours.\nHandleTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    if [[ \"$url\" == *\"unlock=1\"* ]]; then\n      local target startedAt now\n      target=\"$(ExtractParam \"$url\" u)\"\n      startedAt=\"$(ExtractParam \"$url\" t)\"\n      now=\"$(NowEpoch)\"\n      if [[ -n \"$target\" && \"$startedAt\" =~ ^[0-9]+$ && $(( now - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n        GrantGrace \"$target\"\n        RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n      else\n        # Lien \"unlock\" prématuré ou malformé : retour à un compte à rebours honnête.\n        [[ -n \"$target\" ]] && RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n      fi\n    fi\n    return 0\n  fi\n\n  local lurl=\"${url:l}\"\n  case \"$lurl\" in\n    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n    *) return 0 ;;\n  esac\n\n  local identity=\"$url\"\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    [[ -n \"$identity\" ]] || identity=\"$url\"\n  fi\n\n  if TextMatchesBlocked \"$identity\"; then\n    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n  fi\n}\n\nEnforceTabs() {\n  EnsureBlockPage\n  local browser windowIndex tabIndex url\n  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n    HandleTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$url\"\n  done < <(ListBrowserTabs)\n}\n\nEnforce() {\n  EnsureSecret\n  if ShouldBlock; then\n    EnforceTabs\n  fi\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\nWatchTabs() {\n  EnsureSecret\n  while true; do\n    if ShouldBlock; then\n      EnforceTabs\n      sleep 2\n    else\n      sleep 60\n    fi\n  done\n}\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key>\n  <string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array>\n    <string>$SCRIPT_PATH</string>\n    <string>watch-tabs</string>\n  </array>\n  <key>RunAtLoad</key>\n  <true/>\n  <key>KeepAlive</key>\n  <true/>\n  <key>StandardOutPath</key>\n  <string>$HOME/Library/Logs/SocialMediaFocusGuard.tabs.log</string>\n  <key>StandardErrorPath</key>\n  <string>$HOME/Library/Logs/SocialMediaFocusGuard.tabs.err.log</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS garde un override \"disabled\" persistant PAR LABEL, distinct de notre\n  # propre $DISABLED_FILE : si ce garde-fou a déjà été arrêté une fois, ce\n  # bit reste posé même après un nouveau bootstrap et refait échouer le\n  # chargement (I/O error) tant qu'il n'est pas explicitement relevé ici.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || {\n    Say \"Root install needs admin rights.\"\n    exit 1\n  }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key>\n  <string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array>\n    <string>$SCRIPT_PATH</string>\n    <string>enforce</string>\n  </array>\n  <key>RunAtLoad</key>\n  <true/>\n  <key>StartInterval</key>\n  <integer>60</integer>\n  <key>StandardOutPath</key>\n  <string>/var/log/SocialMediaFocusGuard.log</string>\n  <key>StandardErrorPath</key>\n  <string>/var/log/SocialMediaFocusGuard.err.log</string>\n</dict>\n</plist>\nPLIST\n  chown root:wheel \"$ROOT_PLIST\"\n  chmod 644 \"$ROOT_PLIST\"\n  plutil -lint \"$ROOT_PLIST\" >/dev/null\n}\n\nInstallRoot() {\n  EnsureSecret\n  CleanupRoot\n}\n\nCleanupRoot() {\n  [[ \"$EUID\" -eq 0 ]] || {\n    Say \"Root cleanup needs admin rights.\"\n    exit 1\n  }\n  RemoveHostsBlock\n  RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root network guard removed. UI guard is active through the user agent.\"\n}\n\nSuspend() {\n  RequireGuardPassword\n  local minutes until\n  minutes=\"${1:-30}\"\n  [[ \"$minutes\" =~ '^[0-9]+$' ]] || {\n    Say \"Minutes must be a number.\"\n    exit 1\n  }\n  EnsureDirs\n  until=\"$(( $(NowEpoch) + minutes * 60 ))\"\n  printf '%s\\n' \"$until\" > \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard suspended for $minutes minutes.\"\n}\n\nDisable() {\n  RequireGuardPassword\n  EnsureDirs\n  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n  Enforce\n  Say \"Guard disabled.\"\n}\n\nEnable() {\n  EnsureDirs\n  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard enabled.\"\n}\n\nStatus() {\n  local protected disabled suspended hostsBlock chromePolicy userLoaded rootLoaded\n  protected=\"no\"\n  disabled=\"no\"\n  suspended=\"no\"\n  hostsBlock=\"no\"\n  chromePolicy=\"no\"\n  userLoaded=\"no\"\n  rootLoaded=\"no\"\n\n  IsProtectedNow && protected=\"yes\"\n  IsDisabled && disabled=\"yes\"\n  IsSuspended && suspended=\"yes\"\n  grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && hostsBlock=\"yes\"\n  if [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1; then\n    chromePolicy=\"yes\"\n  fi\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n  launchctl print \"system/$ROOT_LABEL\" >/dev/null 2>&1 && rootLoaded=\"yes\"\n\n  Say \"protected_hours=$protected\"\n  Say \"disabled=$disabled\"\n  Say \"suspended=$suspended\"\n  Say \"user_tab_guard_loaded=$userLoaded\"\n  Say \"root_host_guard_loaded=$rootLoaded\"\n  Say \"hosts_block_present=$hostsBlock\"\n  Say \"chrome_policy_present=$chromePolicy\"\n  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\nUninstallRoot() {\n  RequireGuardPassword\n  [[ \"$EUID\" -eq 0 ]] || {\n    Say \"Root uninstall needs admin rights.\"\n    exit 1\n  }\n  RemoveHostsBlock\n  RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root host guard uninstalled.\"\n}\n\ncase \"${1:-status}\" in\n  install-user)\n    InstallUser\n    ;;\n  install-root)\n    InstallRoot\n    ;;\n  enforce)\n    Enforce\n    ;;\n  watch-tabs)\n    WatchTabs\n    ;;\n  close-tabs)\n    EnforceTabs\n    ;;\n  suspend)\n    Suspend \"${2:-30}\"\n    ;;\n  disable)\n    Disable\n    ;;\n  enable)\n    Enable\n    ;;\n  status)\n    Status\n    ;;\n  uninstall-user)\n    UninstallUser\n    ;;\n  uninstall-root)\n    UninstallRoot\n    ;;\n  cleanup-root)\n    CleanupRoot\n    ;;\n  *)\n    Say \"Usage: $0 install-user|install-root|status|enable|disable|suspend [minutes]|enforce|watch-tabs|close-tabs|uninstall-user|uninstall-root|cleanup-root\"\n    exit 1\n    ;;\nesac\n","numLines":1108,"startLine":1,"totalLines":1108}},"sourceToolAssistantUUID":"49103489-939c-420e-99b0-93f465ebb29f","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"6b5850df-ed76-4f8a-abbb-20924e727fbf","version":"2.1.202","gitBranch":"main"}
