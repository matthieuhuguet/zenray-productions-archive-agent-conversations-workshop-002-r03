  killall -HUP mDNSResponder 2>/dev/null || true\n191\t}\n192\t\n193\tStripHostsBlock() {\n194\t  local source=\"$1\"\n195\t  awk -v start=\"$HOSTS_MARK_START\" -v end=\"$HOSTS_MARK_END\" '\n196\t    $0 == start {skip = 1; next}\n197\t    $0 == end {skip = 0; next}\n198\t    skip != 1 {print}\n199\t  ' \"$source\"\n200\t}\n201\t\n202\tApplyHostsBlock() {\n203\t  [[ \"$EUID\" -eq 0 ]] || return 0\n204\t  local tmp\n205\t  tmp=\"$(mktemp)\"\n206\t  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n207\t  {\n208\t    cat \"$tmp\"\n209\t    printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n210\t    for domain in \"${HOST_DOMAINS[@]}\"; do\n211\t      printf '0.0.0.0\\t%s\\n' \"$domain\"\n212\t      printf '::1\\t%s\\n' \"$domain\"\n213\t    done\n214\t    printf '%s\\n' \"$HOSTS_MARK_END\"\n215\t  } > \"$tmp.new\"\n216\t  cp \"$tmp.new\" \"$HOSTS_FILE\"\n217\t  rm -f \"$tmp\" \"$tmp.new\"\n218\t  FlushDns\n219\t}\n220\t\n221\tRemoveHostsBlock() {\n222\t  [[ \"$EUID\" -eq 0 ]] || return 0\n223\t  local tmp\n224\t  tmp=\"$(mktemp)\"\n225\t  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n226\t  cp \"$tmp\" \"$HOSTS_FILE\"\n227\t  rm -f \"$tmp\"\n228\t  FlushDns\n229\t}\n230\t\n231\tApplyChromePolicy() {\n232\t  [[ \"$EUID\" -eq 0 ]] || return 0\n233\t  local tmp\n234\t  mkdir -p \"/Library/Managed Preferences\"\n235\t  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n236\t    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then\n237\t      cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"\n238\t      printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n239\t    else\n240\t      printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"\n241\t    fi\n242\t  fi\n243\t  tmp=\"$(mktemp)\"\n244\t  cat > \"$tmp\" <<'PLIST'\n245\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n246\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n247\t<plist version=\"1.0\">\n248\t<dict>\n249\t  <key>URLBlocklist</key>\n250\t  <array>\n251\tPLIST\n252\t  for entry in \"${CHROME_BLOCKLI