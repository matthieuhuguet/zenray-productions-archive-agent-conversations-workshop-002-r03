E_GUARD_END_HOUR:-19}\"\n\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_YOUTUBE_FOCUS_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_YOUTUBE_FOCUS_GUARD_END\"\n\nUSER_LABEL=\"com.zenray.youtube-focus-guard.tabs\"\nROOT_LABEL=\"com.zenray.youtube-focus-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/YoutubeFocusGuard.sh\"\n\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-focus-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\n\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\nEnsureBlockPage() {\n  EnsureDirs\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>YouTube closed</title>\n  <style>\n    @font-face {\n      font-family: \"Anthropic Sans\";\n      src: url(\"file:///Users/zenray/Library/Fonts/AnthropicSans-Light.ttf\") format(\"truetype\");\n      font-weight: 300;\n    }\n    :root {\n      color-scheme: dark;\n      background: #242424;\n      color: #f2f2f2;\n    }\n    * {\n      box-sizing: border-box;\n    }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      background: #242424;\n      font-family: \"Anthropic Sans\", system-ui, sans-serif;\n    }\n    main {\n      width: min(1500px, calc(100vw - 48px));\n      text-align: center;\n    }\n    .art {\n      display: block;\n      width: min(720px, calc(100vw - 120px));\n      margin: 0 auto 28px;\n      border-radius: 8px;\n      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.22);\n    }\n    h1 {\n      margin: 0;\n      color: #efefef;\n      font-size: clamp(36px, 4.2vw, 78px);\n      font-weight: 300;\n      line-height: 1.08;\n      text-transform: uppercase;\n    }\n    p {\n      margin: 0 0 28px;\n      color: #c9c9c9;\n      font-size: clamp(18px, 2vw, 34px);\n      font-weight: 300;\n      line-height: 1.2;\n      text-transform: uppercase;\n    }\n  </style>\n</head>\n<body>\n  <main>\n    <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"Illustration\" />\n    <p>Blocked from 09:00 to 19:00</p>\n    <h1>These channels are closed</h1>\n  </main>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\nSay() {\n  printf '%s\\n' \"$*\"\n}\n\nEnsureDirs() {\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\nInstallOwner() {\n  printf 'zenray'\n}\n\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    local owner\n    owner=\"$(InstallOwner)\"\n    chown \"${owner}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${YOUTUBE_GUARD_PASSWORD:-}\" ]]; then\n    input=\"$YOUTUBE_GUARD_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo\n    IFS= read -r input\n    stty echo\n    printf '\\n' >&2\n  fi\n  if [[ \"$input\" != \"$expected\" ]]; then\n    Say \"Wrong focus password.\"\n    exit 2\n  fi\n}\n\nIsDisabled() {\n  [[ -f \"$DISABLED_FILE\" ]]\n}\n\nNowEpoch() {\n  date '+%s'\n}\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until now\n  until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  now=\"$(NowEpoch)\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$now\" -lt \"$until\" ]]\n}\n\nIsProtectedNow() {\n  local hour\n  hour=\"$(date '+%H')\"\n  hour=\"${hour#0}\"\n  [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\nShouldBlock() {\n  IsDisabled && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\nFlushDns() {\n  dscacheutil -flushcache 2>/dev/null || true\n  killall -HUP mDNSResponder 2>/dev/null || true\n}\n\nStripHostsBlock() {\n  local source=\"$1\"\n  awk -v start=\"$HOSTS_MARK_START\" -v end=\"$HOSTS_MARK_END\" '\n    $0 == start {skip = 1; next}\n    $0 == end {skip = 0; next}\n    skip != 1 {print}\n  ' \"$source\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  {\n    cat \"$tmp\"\n    printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    for domain in \"${HOST_DOMAINS[@]}\"; do\n      printf '0.0.0.0\\t%s\\n' \"$domain\"\n      printf '::1\\t%s\\n' \"$domain\"\n    done\n    printf '%s\\n' \"$HOSTS_MARK_END\"\n  } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"\n  rm -f \"$tmp\" \"$tmp.new\"\n  FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  cp \"$tmp\" \"$HOSTS_FILE\"\n  rm -f \"$tmp\"\n  FlushDns\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then\n      cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"\n      printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else\n      printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"\n    fi\n  fi\n  tmp=\"$(mktemp)\"\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do\n    printf '    <string>%s</string>\\n' \"$entry\" >> 