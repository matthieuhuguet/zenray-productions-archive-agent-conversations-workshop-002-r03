" class=\"btn\" href=\"#\">Ouvrir maintenant</a>\n156\t    </div>\n157\t    <div id=\"closedBox\" style=\"display:none\">\n158\t      <h1>Ces chaines sont fermees</h1>\n159\t      <p>Profil createur, on ne regarde plus.</p>\n160\t    </div>\n161\t  </main>\n162\t  <script>\n163\t  (function () {\n164\t    var params = new URLSearchParams(location.search);\n165\t    var target = params.get('u') || '';\n166\t    var startedSec = parseInt(params.get('t') || '0', 10) || 0;\n167\t    var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n168\t    var waitBox = document.getElementById('waitBox');\n169\t    var rewardBox = document.getElementById('rewardBox');\n170\t    var closedBox = document.getElementById('closedBox');\n171\t    if (!target || !startedSec) {\n172\t      waitBox.style.display = 'none';\n173\t      closedBox.style.display = 'block';\n174\t      return;\n175\t    }\n176\t    var countdownEl = document.getElementById('countdown');\n177\t    function fmt(s) {\n178\t      var m = Math.floor(s / 60), r = s % 60;\n179\t      return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r;\n180\t    }\n181\t    function tick() {\n182\t      var now = Math.floor(Date.now() / 1000);\n183\t      var remain = WAIT_SECONDS - (now - startedSec);\n184\t      if (remain <= 0) {\n185\t        waitBox.style.display = 'none';\n186\t        var link = document.getElementById('rewardLink');\n187\t        link.href = location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n188\t        rewardBox.style.display = 'block';\n189\t        return;\n190\t      }\n191\t      countdownEl.textContent = fmt(remain);\n192\t      setTimeout(tick, 1000);\n193\t    }\n194\t    tick();\n195\t  })();\n196\t  </script>\n197\t</body>\n198\t</html>\n199\tHTML\n200\t  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n201\t}\n202\t\n203\tSay() {\n204\t  printf '%s\\n' \"$*\"\n205\t}\n206\t\n207\t# Renomme les anciens fichiers \"YouTube*\" vers les nouveaux \"SocialMedia*\".\n208\t# Idempotent : après migration les anciens n'existent plus, les tests échouent\n209\t# vite. Ne touche jamais un nouveau fichier déjà présent (pas d'écrasement).\n210\tMigrateLegacy() {\n211\t  [[ -f \"$LEGACY_SECRET_FILE\" && ! -f \"$SECRET_FILE\" ]] && mv \"$LEGACY_SECRET_FILE\" \"$SECRET_FILE\" 2>/dev/null\n212\t  [[ -d \"$LEGACY_STATE_DIR\" && ! -d \"$STATE_DIR\" ]] && mv \"$LEGACY_STATE_DIR\" \"$STATE_DIR\" 2>/dev/null\n213\t  [[ -f \"$LEGACY_BLOCK_PAGE_FILE\" ]] && rm -f \"$LEGACY_BLOCK_PAGE_FILE\" 2>/dev/null\n214\t  return 0\n215\t}\n216\t\n217\tEnsureDirs() {\n218\t  MigrateLegacy\n219\t  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n220\t  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n221\t}\n222\t\n223\tInstallOwner() {\n224\t  printf 'zenray'\n225\t}\n226\t\n227\tEnsureSecret() {\n228\t  EnsureDirs\n229\t  EnsureBlockPage\n230\t  if [[ ! -f \"$SECRET_FILE\" ]]; then\n231\t    umask 077\n232\t    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n233\t    printf '\\n' >> \"$SECRET_FILE\"\n234\t  fi\n235\t  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n236\t  if [[ \"$EUID\" -eq 0 ]]; then\n237\t    local owner\n238\t    owner=\"$(InstallOwner)\"\n239\t    chown \"${owner}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n240\t  fi\n241\t}\n242\t\n243\tRequireGuardPassword() {\n244\t  EnsureSecret\n245\t  local expected input\n246\t  expected=\"$(cat \"$SECRET_FILE\")\"\n247\t  if [[ -n \"${SMFG_PASSWORD:-}\" ]]; then\n248\t    input=\"$SMFG_PASSWORD\"\n249\t  else\n250\t    printf 'Focus password: ' >&2\n251\t    stty -echo\n252\t    IFS= read -r input\n253\t    stty echo\n254\t    printf '\\n' >&2\n255\t  fi\n256\t  if [[ \"$input\" != \"$expected\" ]]; then\n257\t    Say \"Wrong focus password.\"\n258\t    exit 2\n259\t  fi\n260\t}\n261\t\n262\tIsDisabled() {\n263\t  [[ -f \"$DISABLED_FILE\" ]]\n264\t}\n265\t\n266\tNowEpoch() {\n267\t  date '+%s'\n268\t}\n269\t\n270\tIsSuspended() {\n271\t  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n272\t  local until now\n273\t  until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n274\t  now=\"$(NowEpoch)\"\n275\t  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n276\t  [[ \"$now\" -lt \"$until\" ]]\n277\t}\n278\t\n279\tIsProtectedNow() {\n280\t  local hour\n281\t  hour=\"$(date '+%H')\"\n282\t  hour=\"${hour#0}\"\n283\t  [[ -z \"$hour\" ]] && hour=0\n284\t  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n285\t}\n286\t\n287\tShouldBlock() {\n288\t  IsDisabled && return 1\n289\t  IsSuspended && return 1\n290\t  IsProtectedNow\n291\t}\n292\t\n293\tFlushDns() {\n294\t  dscacheutil -flushcache 2>/dev/null || true\n295\t  killall -HUP mDNSResponder 2>/dev/null || true\n296\t}\n297\t\n298\tStripHostsBlock() {\n299\t  local source=\"$1\"\n300\t  awk -v start=\"$HOSTS_MARK_START\" -v end=\"$HOSTS_MARK_END\" '\n301\t    $0 == start {skip = 1; next}\n302\t    $0 == end {skip = 0; next}\n303\t    skip != 1 {print}\n304\t  ' \"$source\"\n305\t}\n306\t\n307\tApplyHostsBlock() {\n308\t  [[ \"$EUID\" -eq 0 ]] || return 0\n309\t  local tmp\n310\t  tmp=\"$(mktemp)\"\n311\t  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n312\t  {\n313\t    cat \"$tmp\"\n314\t    printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n315\t    for domain in \"${HOST_DOMAINS[@]}\"; do\n316\t      printf '0.0.0.0\\t%s\\n' \"$domain\"\n317\t      printf '::1\\t%s\\n' \"$domain\"\n318\t    done\n319\t    printf '%s\\n' \"$HOSTS_MARK_END\"\n320\t  } > \"$tmp.new\"\n321\t  cp \"$tmp.new\" \"$HOSTS_FILE\"\n322\t  rm -f \"$tmp\" \"$tmp.new\"\n323\t  FlushDns\n324\t}\n325\t\n326\tRemoveHostsBlock() {\n327\t  [[ \"$EUID\" -eq 0 ]] || return 0\n328\t  local tmp\n329\t  tmp=\"$(mktemp)\"\n330\t  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n331\t  cp \"$tmp\" \"$HOSTS_FILE\"\n332\t  rm -f \"$tmp\"\n333\t  FlushDns\n334\t}\n335\t\n336\tApplyChromePolicy() {\n337\t  [[ \"$EUID\" -eq 0 ]] || return 0\n338\t  local tmp entry\n339\t  BuildChromeBlocklist\n340\t  mkdir -p \"/Library/Managed Preferences\"\n341\t  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n342\t    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then\n343\t      cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"\n344\t      printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n345\t    else\n346\t      printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"\n347\t    fi\n348\t  fi\n349\t  tmp=\"$(mktemp)\"\n350\t  # IncognitoModeAvailability=1 -> incognito Chrome désactivé, donc tout passe en\n351\t  # fenêtre normale, vue par la surveillance d'onglets (couvre la navigation privée).\n352\t  cat > \"$tmp\" <<'PLIST'\n353\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n354\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n355\t<plist version=\"1.0\">\n356\t<dict>\n357\t  <key>IncognitoModeAvailability</key>\n358\t  <integer>1</integer>\n359\t  <key>URLBlocklist</key>\n360\t  <array>\n361\tPLIST\n362\t  for entry in \"${CHROME_BLOCKLIST[@]}\"; do\n363\t    printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"\n364\t  done\n365\t  cat >> \"$tmp\" <<'PLIST'\n366\t  </array>\n367\t</dict>\n368\t</plist>\n369\tPLIST\n370\t  plutil -lint \"$tmp\" >/dev/null\n371\t  cp \"$tmp\" \"$CHROME_POLICY_FILE\"\n372\t  rm -f \"$tmp\"\n373\t  chown root:wheel \"$CHROME_POLICY_FILE\"\n374\t  chmod 644 \"$CHROME_POLICY_FILE\"\n375\t  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n376\t}\n377\t\n378\tRemoveChromePolicy() {\n379\t  [[ \"$EUID\" -eq 0 ]] || return 0\n380\t  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n381\t  local state\n382\t  state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n383\t  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then\n384\t    cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n385\t  else\n386\t    rm -f \"$CHROME_POLICY_FILE\"\n387\t  fi\n388\t}\n389\t\n390\t# =========================================================================\n391\t# SOURCE UNIQUE DE VÉRITÉ des