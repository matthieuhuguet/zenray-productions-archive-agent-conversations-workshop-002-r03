'wb') as ff:\n            ff.write(base64.b64decode(data + '='*pad))\n        font_paths[name] = path\n        print(f\"  {name} → {path}\")\n\n# ── 2. Définir les éléments texte (coordonnées SVG × SCALE) ──────────────────\n# SVG : y = baseline\nELEMS = [\n    {'text': 'ZenRayProgress', 'x': 294*SCALE, 'y': 248*SCALE,\n     'font': font_paths['ARMed'],   'size': int(112*SCALE), 'spacing': -1*SCALE},\n    {'text': 'Every files,',    'x': 150*SCALE, 'y': 430*SCALE,\n     'font': font_paths['ARXBold'], 'size': int(112*SCALE), 'spacing': -2*SCALE},\n    {'text': 'in a tab.',       'x': 150*SCALE, 'y': 612*SCALE,\n     'font': font_paths['ARSerif'], 'size': int(112*SCALE), 'spacing': -1*SCALE},\n]\n\n# ── 3. Calculer position X de chaque caractère ───────────────────────────────\ndef char_positions(elem):\n    font = ImageFont.truetype(elem['font'], elem['size'])\n    x = elem['x']\n    y = elem['y']\n    chars = []\n    for ch in elem['text']:\n        bb = font.getbbox(ch)\n        adv = bb[2] - bb[0]\n        chars.append({'ch': ch, 'x': x, 'y': y, 'font': font})\n        x += adv + elem['spacing']\n    return chars\n\nall_chars = []\nfor elem in ELEMS:\n    all_chars.extend(char_positions(elem))\n\nprint(f\"Total chars: {len(all_chars)}\")\n\n# ── 4. Ordre de révélation aléatoire ─────────────────────────────────────────\nindices = list(range(len(all_chars)))\nrandom.shuffle(indices)\n\nHALF   = FPS        # 60 frames = 1s (seconde moitié)\nPOP_F  = 6          # durée animation par lettre (frames)\nSPREAD = HALF - POP_F  # étalement des starts = 54 frames\n\n# Frame de départ de chaque char dans la seconde moitié\nstarts = {}\nfor rank, idx in enumerate(indices):\n    starts[idx] = int(rank / (len(indices)-1) * SPREAD)\n\ndef ss(t): return max(0.0, min(1.0, t*t*(3-2*t)))\n\n# ── 5. Fonction de dessin d'un char avec shadow ───────────────────────────────\ndef draw_char(canvas, ch, cx, cy, font, alpha, scale=1.0):\n    if alpha <= 0 or scale <= 0: return\n    bb  = font.getbbox(ch)\n    pad = SHADOW * 2 + 4\n    lw  = int((bb[2]-bb[0]) * scale) + pad*2 + 10\n    lh  = int((bb[3]-bb[1]) * scale) + pad*2 + 10\n    if lw <= 0 or lh <= 0: return\n    tmp = Image.new(\"RGBA\", (lw, lh), (0,0,0,0))\n    # Draw at natural size then scale\n    nat = Image.new(\"RGBA\", (bb[2]-bb[0]+pad*2, bb[3]-bb[1]+pad*2), (0,0,0,0))\n    ImageDraw.Draw(nat).text((pad-bb[0], pad-bb[1]), ch, font=font, fill=(0,0,0,alpha))\n    shadow = nat.filter(ImageFilter.GaussianBlur(SHADOW))\n    nat2   = Image.new(\"RGBA\", nat.size, (0,0,0,0))\n    ImageDraw.Draw(nat2).text((pad-bb[0], pad-bb[1]), ch, font=font, fill=(255,255,255,alpha))\n    combined = Image.alpha_composite(shadow, nat2)\n    if scale != 1.0:\n        nw = max(1, int(combined.width*scale))\n        nh = max(1, int(combined.height*scale))\n        combined = combined.resize((nw, nh), Image.LANCZOS)\n    dx = int(cx + bb[0] - pad - (combined.width-nat.width)//2)\n    dy = int(cy + bb[1] - pad - (combined.height-nat.height)//2)\n    if dx < 0 or dy < 0: return\n    if dx+combined.width > W or dy+combined.height > H: return\n    canvas.alpha_composite(combined, (max(0,dx), max(0,dy)))\n\n# ── 6. Extraire 60 premières frames du pulse ─────────────────────────────────\nprint(\"Extracting pulse frames (first 1s)...\")\nsubprocess.run([\n    'ffmpeg','-y','-i', PULSE,\n    '-frames:v', str(FPS),\n    '-vsync','0',\n    f'{PDIR}/frame_%04d.png'\n], check=True, capture_output=True)\npulse_frames = sorted(os.listdir(PDIR))[:FPS]\nprint(f\"  Got {len(pulse_frames)} pulse frames\")\n\n# ── 7. Copier pulse frames comme frames 0-59 ─────────────────────────────────\nfor i, pf in enumerate(pulse_frames):\n    src = Image.open(f\"{PDIR}/{pf}\").convert(\"RGBA\")\n    if src.size != (W, H):\n        src = src.resize((W, H), Image.LANCZOS)\n    src.save(f\"{FDIR}/frame_{i:04d}.png\")\n\n# ── 8. Générer frames 60-119 : révélation lettre par lettre ─────────────────\nprint(\"Rendering letter reveal frames...\")\nfor frame in range(HALF):\n    img  = Image.new(\"RGBA\", (W, H), (0,0,0,0))\n\n    for ci, char in enumerate(all_chars):\n        elapsed = frame - starts[ci]\n        if elapsed < 0: continue\n\n        t = min(elapsed / POP_F, 1.0)\n        # Scale : 0 → 1.15 → 0.95 → 1.0 (bounce rapide)\n        if t < 0.4:\n            sc = ss(t/0.4) * 1.15\n        elif t < 0.7:\n            sc = 1.15 - (ss((t-0.4)/0.3)) * 0.20\n        else:\n            sc = 0.95 + ss((t-0.7)/0.3) * 0.05\n        alpha = int(min(255, elapsed/POP_F * 255 * 2))\n\n        draw_char(img, char['ch'], char['x'], char['y'], char['font'], alpha, sc)\n\n    img.save(f\"{FDIR}/frame_{FPS+frame:04d}.png\")\n\n# ── 9. Assembler ─────────────────────────────────────────────────────────────\nprint(\"Assembling ProRes 4444...\")\nsubprocess.run([\n    'ffmpeg','-y','-r',str(FPS),\n    '-i',f'{FDIR}/frame_%04d.png',\n    '-c:v','prores_ks','-profile:v','4444',\n    '-pix_fmt','yuva444p10le', OUT\n], check=True, capture_output=True)\nprint(f\"Done → {OUT}\")\n","userModified":false},"sourceToolAssistantUUID":"d16e6c9e-de29-4e8c-8ca0-ea37bc928308","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"ac6ab641-5815-4e7c-ac18-2f752a288b3e","version":"2.1.161","gitBranch":"main","slug":"scalable-leaping-kay"}
