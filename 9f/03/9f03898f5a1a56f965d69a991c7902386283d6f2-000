dint(2, 7)):\n        x1  = rng.randint(0, W-20)\n        y1  = rng.randint(0, H-20)\n        x2  = x1 + rng.randint(10, 400)\n        y2  = y1 + rng.randint(2, 60)\n        col = rng.choice(COLORS)\n        alp = rng.randint(20, 90)\n        draw.rectangle([x1, y1, x2, y2], fill=(*col, alp))\n\n    # ── 3. Barcodes ───────────────────────────────────────────────────────────\n    for _ in range(rng.randint(0, 3)):\n        bx  = rng.randint(0, W-250)\n        by  = rng.randint(0, H-180)\n        bh  = rng.randint(60, 180)\n        col = rng.choice([WHITE, RED])\n        alp = rng.randint(80, 200)\n        for _ in range(rng.randint(6, 22)):\n            lx = bx + rng.randint(0, 200)\n            lw = rng.randint(2, 14)\n            draw.rectangle([lx, by, lx+lw, by+bh], fill=(*col, alp))\n\n    # ── 4. Texte CODE (petites lignes) ────────────────────────────────────────\n    for _ in range(rng.randint(2, 6)):\n        cx  = rng.randint(0, W-600)\n        cy  = rng.randint(0, H-200)\n        col = rng.choice(COLORS)\n        alp = rng.randint(100, 220)\n        for i in range(rng.randint(1, 6)):\n            line = rng.choice(CODE_LINES)\n            draw.text((cx, cy+i*38), line, font=rng.choice([F_CODE, F_SMALL]),\n                      fill=(*col, alp))\n\n    # ── 5. Mots BIG ───────────────────────────────────────────────────────────\n    for _ in range(rng.randint(2, 5)):\n        word = rng.choice(BIG_WORDS)\n        x    = rng.randint(-50, W-300)\n        y    = rng.randint(-20, H-100)\n        col  = rng.choice(COLORS)\n        alp  = rng.randint(80, 230)\n        draw.text((x, y), word, font=F_MED, fill=(*col, alp))\n\n    # ── 6. Mot HUGE tourné ────────────────────────────────────────────────────\n    if rng.random() < 0.65:\n        word  = rng.choice(HUGE_WORDS)\n        angle = rng.choice([0, 0, 90, -90, rng.randint(-20, 20)])\n        col   = rng.choice([WHITE, RED, CYAN])\n        alp   = rng.randint(40, 160)\n        layer = rotated_text(word, rng.choice([F_HUGE, F_BIG]), col, alp, angle)\n        # Décaler aléatoirement\n        dx = rng.randint(-400, 400)\n        dy = rng.randint(-300, 300)\n        img.alpha_composite(layer, (max(0,dx), max(0,dy)) if dx>=0 and dy>=0\n                            else (0,0))\n\n    # ── 7. Aberration : décalage rouge/noir ──────────────────────────────────\n    if rng.random() < 0.45:\n        shift = rng.randint(3, 18)\n        arr   = np.array(img)\n        ghost = np.zeros_like(arr)\n        ghost[:, shift:, 0] = arr[:, :-shift, 0]\n        ghost[:, shift:, 3] = (arr[:, :-shift, 3] * 0.35).astype(np.uint8)\n        img.alpha_composite(Image.fromarray(ghost, 'RGBA'))\n\n    # ── 8. Flash rouge ou noir ────────────────────────────────────────────────\n    if rng.random() < 0.12:\n        col = rng.choice([RED, BLACK])\n        alp = rng.randint(8, 30)\n        draw.rectangle([0, 0, W, H], fill=(*col, alp))\n\n    return img\n\n# ── Render ────────────────────────────────────────────────────────────────────\nrng_main = random.Random(42)\nfor frame in range(TOTAL):\n    seed = rng_main.randint(0, 2**31)\n    draw_frame(seed).save(f\"{OUT_DIR}/frame_{frame:04d}.png\")\n\nprint(f\"Frames: {TOTAL} ({TOTAL/FPS:.1f}s)\")\nsubprocess.run([\n    'ffmpeg','-y','-r',str(FPS),\n    '-i',f'{OUT_DIR}/frame_%04d.png',\n    '-c:v','prores_ks','-profile:v','4444',\n    '-pix_fmt','yuva444p10le', OUT\n], check=True, capture_output=True)\nprint(f\"Done → {OUT}\")\n","structuredPatch":[{"oldStart":127,"oldLines":7,"newStart":127,"newLines":7,"lines":["     if rng.random() < 0.65:","         word  = rng.choice(HUGE_WORDS)","         angle = rng.choice([0, 0, 90, -90, rng.randint(-20, 20)])","-        col   = rng.choice([WHITE, RED, CYAN])","+        col   = rng.choice([WHITE, RED, DARKRED])","         alp   = rng.randint(40, 160)","         layer = rotated_text(word, rng.choice([F_HUGE, F_BIG]), col, alp, angle)","         # Décaler aléatoirement"]}],"userModified":false,"replaceAll":false},"so