r w,_ in WORDS]\ntotal_w = sum(wws) + GAP_W*(len(WORDS)-1)\nx = (W-total_w)//2\npositions = []\nfor i,(w,c) in enumerate(WORDS):\n    positions.append((x, baseline, c))\n    x += wws[i] + GAP_W\n\nn = len(WORDS)\nline_last_done = (n-1)*WORD_DELAY + ANIM_F\nexit_tail = (n-1)*EXIT_DELAY + EXIT_F\nHOLD_F = max(TARGET - line_last_done - exit_tail, 2)\nall_done = line_last_done + HOLD_F\nTOTAL = all_done + (n-1)*EXIT_DELAY + EXIT_F\nprint(f\"  {TOTAL} frames = {TOTAL/FPS:.2f}s  hold={HOLD_F}f\")\n\nDIRS = ['left','right','top']\ndirs = [random.choice(DIRS) for _ in WORDS]\n\nOUT_DIR = '/tmp/creal_frames'\nOUT = '/Users/zenray/Create/Build/Productions/VideoZenRayProgress/Credit Realisation.mov'\nos.makedirs(OUT_DIR, exist_ok=True)\nfor f in os.listdir(OUT_DIR): os.remove(f\"{OUT_DIR}/{f}\")\n\nfor frame in range(TOTAL):\n    img = Image.new(\"RGBA\",(W,H),(0,0,0,0))\n    for wi,(word,color) in enumerate(WORDS):\n        fx,fy,_ = positions[wi]\n        e_in = frame - wi*WORD_DELAY\n        if e_in < 0: continue\n        if e_in >= ANIM_F:\n            px,py = fx,fy; alpha=255\n        else:\n            t_pos = eo(e_in/ANIM_F); t_alf = ss(e_in/ANIM_F)\n            d = dirs[wi]\n            ox = -OFFSET_IN if d=='left' else (OFFSET_IN if d=='right' else 0)\n            oy = -OFFSET_IN if d=='top' else 0\n            px = int(fx+ox*(1-t_pos)); py = int(fy+oy*(1-t_pos))\n            alpha = int(255*t_alf)\n        e_out = frame-(all_done+wi*EXIT_DELAY)\n        dy = 0\n        if e_out>=0:\n            t_out = sss(min(e_out/EXIT_F,1.0))\n            alpha = int(255*(1-t_out))\n            dy = int(-OFFSET_OUT*ss(min(e_out/EXIT_F,1.0)))\n        draw_word(img, word, px, py+dy, font, alpha)\n    img.save(f\"{OUT_DIR}/frame_{frame:04d}.png\")\n\nsubprocess.run(['ffmpeg','-y','-r',str(FPS),'-i',f'{OUT_DIR}/frame_%04d.png',\n    '-c:v','prores_ks','-profile:v','4444','-pix_fmt','yuva444p10le',OUT],\n    check=True, capture_output=True)\nprint(f\"Done → {OUT}\")\nEOF","description