    if dx >= 0 and dy >= 0:\n        canvas.alpha_composite(shadow, (dx, dy))\n\n    ImageDraw.Draw(canvas).text((x, y), text, font=font, fill=(255, 255, 255, alpha))\n\n# ─── Layout helpers ──────────────────────────────────────────────────────────\ndef word_positions(words):\n    sizes = []\n    for w in words:\n        bb = font.getbbox(w)\n        sizes.append((bb[2]-bb[0], bb[3]-bb[1]))\n    total_w = sum(s[0] for s in sizes) + GAP_W*(len(sizes)-1)\n    x = (W - total_w) // 2\n    y = (H - sizes[0][1]) // 2\n    pos = []\n    for s in sizes:\n        pos.append((x, y))\n        x += s[0] + GAP_W\n    return pos, sizes\n\ndef ease_out(t): return 1-(1-min(max(t,0),1))**4\ndef ease_in(t):  return min(max(t,0),1)**3\n\ndef start_offset(direction, fx, fy):\n    if direction == 'left':   return (fx - OFFSET_IN, fy)\n    if direction == 'right':  return (fx + OFFSET_IN, fy)\n    if direction == 'top':    return (fx, fy - OFFSET_IN)\n    if direction == 'bottom': return (fx, fy + OFFSET_IN)\n\n# ─── SECTION 1 : \"Before you create\" — 48 frames (2s) ───────────────────────\nS1_WORDS   = [\"Before\", \"you\", \"create\"]\nS1_DIRS    = [\"left\", \"top\", \"right\"]\nS1_DELAY   = 7\nS1_ENTRY_F = 9\nS1_EXIT_F  = 10\nS1_TOTAL   = 48\nS1_EXIT_START = S1_TOTAL - S1_EXIT_F  # 38\n\n# ─── GAP — 24 frames (1s) ────────────────────────────────────────────────────\nGAP_F = 24\n\n# ─── SECTION 2 : 3 phrases \"you\" — 72 frames (3s), 24f chacune ──────────────\nDIR_PAIRS = [('left','top'), ('right','bottom'), ('top','left')]\nrandom.shuffle(DIR_PAIRS)\n\nYOU_PHRASES   = [\"you test,\", \"you shape,\", \"you break things.\"]\nS2_PER_F      = 24\nS2_ENTRY_F    = 7\nS2_EXIT_F     = 7\nS2_WORD_DELAY = 3\nS2_START      = S1_TOTAL + GAP_F   # 72\n\nTOTAL = S2_START + len(YOU_PHRASES) * S2_PER_F  # 144\nprint(f\"Total: {TOTAL} frames ({TOTAL/FPS:.1f}s)\")\n\nfor frame in range(TOTAL):\n    img = Image.new(\"RGBA\", (W, H), (0, 0, 0, 0))\n\n    # ── SECTION 1 ──\n    if frame < S1_TOTAL:\n        pos, sizes = word_positions(S1_WORDS)\n        alpha = 255\n        dy = 0\n        e_out = frame - S1_EXIT_START\n        if e_out >= 0:\n            t_out = ease_in(min(e_out / S1_EXIT_F, 1.0))\n            alpha = int(255*(1-t_out))\n            dy    = int(-OFFSET_OUT*t_out)\n\n        if alpha > 0:\n            for i, word in enumerate(S1_WORDS):\n                fx, fy = pos[i]\n                elapsed = frame - i*S1_DELAY\n                if elapsed < 0: continue\n                t_in = ease_out(min(elapsed/S1_ENTRY_F, 1.0))\n                sx, sy = start_offset(S1_DIRS[i], fx, fy)\n                px = int(sx + (fx-sx)*t_in)\n                py = int(sy + (fy-sy)*t_in) + dy\n                draw_word(img, word, px, py, alpha)\n\n    # ── SECTION 2 ──\n    for pi, phrase in enumerate(YOU_PHRASES):\n        ph_start = S2_START + pi*S2_PER_F\n        ph_exit  = ph_start + S2_PER_F - S2_EXIT_F\n        elapsed_phrase = frame - ph_start\n        if elapsed_phrase < 0 or frame >= ph_start + S2_PER_F:\n            continue\n\n        words = phrase.split()\n        pos, sizes = word_positions(words)\n        pair = DIR_PAIRS[pi]\n\n        alpha = 255\n        dy = 0\n        e_out = frame - ph_exit\n        if e_out >= 0:\n            t_out = ease_in(min(e_out/S2_EXIT_F, 1.0))\n            alpha = int(255*(1-t_out))\n            dy    = int(-OFFSET_OUT*t_out)\n\n        if alpha <= 0: continue\n\n        for i, word in enumerate(words):\n            fx, fy = pos[i]\n            elapsed = elapsed_phrase - i*S2_WORD_DELAY\n            if elapsed < 0: continue\n            rng = random.Random(pi*100+i)\n            direction = rng.choice(pair)\n            t_in = ease_out(min(elapsed/S2_ENTRY_F, 1.0))\n            sx, sy = start_offset(direction, fx, fy)\n            px = int(sx + (fx-sx)*t_in)\n            py = int(sy + (fy-sy)*t_in) + dy\n            draw_word(img, word, px, py, alpha)\n\n    img.save(f\"{OUT_DIR}/frame_{frame:04d}.png\")\n\nprint(\"Assembling ProRes 4444...\")\nsubprocess.run([\n    \"ffmpeg\", \"-y\", \"-r\", str(FPS),\n    \"-i\", f\"{OUT_DIR}/frame_%04d.png\",\n    \"-c:v\", \"prores_ks\", \"-profile:v\", \"4444\",\n    \"-pix_fmt\", \"yuva444p10le\", OUT_VIDEO\n], check=True, capture_output=True)\nprint(f\"Done → {OUT_VIDEO}\")\n","structuredPatch":[{"oldStart":16,"oldLines":7,"newStart":16,"newLines":7,"lines":[" GAP_W      = 28"," OFFSET_IN  = 150"," OFFSET_OUT = 100","-SHADOW_R   = 30   # drop shadow blur radius (centré, offset 0,0)","+SHADOW_R   = 20   # drop shadow blur radius (centré, offset 0,0)"," "," # ─── Drop shadow helper ───────────────────────────────────────────────────────"," def draw_word(canvas, text, x, y, alpha):"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"dccc757c-cee9-42ac-8752-3aa366a5927e","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"ac6ab641-5815-4e7c-ac18-2f752a288b3e","version":"2.1.161","gitBranch":"main","slug":"scalable-leaping-kay"}
