────\ndef center(path):\n    img = Image.open(path).convert(\"RGBA\")\n    r   = min(W/img.width, H/img.height)\n    nw,nh = int(img.width*r), int(img.height*r)\n    out = Image.new(\"RGBA\",(W,H),(0,0,0,0))\n    out.alpha_composite(img.resize((nw,nh),Image.LANCZOS), ((W-nw)//2,(H-nh)//2))\n    return out\n\nimg_c = center(BASE+'540be75f-2ae3-471a-ba0b-134b019db4f1.png')\nimg_d = center(BASE+'2d8f29f5_transparent.png')\n\n# ── Timeline : 4 segments, boundaries en frames ───────────────────────────────\n# [0,24) = Notion logo (1s)\n# [24,72) = N Rotate (2s)\n# [72,96) = ZenRay Block (1s)\n# [96,120) = App icon (1s)\nBOUNDS  = [0, 24, 72, 96, 120]\nSOURCES = [\n    [notion_frame],   # statique → liste 1 élément\n    nrot,             # 48 frames vidéo\n    [img_c],\n    [img_d],\n]\n\ndef seg_alpha(f, i):\n    \"\"\"Alpha du segment i au frame f — crossfade centré aux boundaries.\"\"\"\n    s, e = BOUNDS[i], BOUNDS[i+1]\n    first, last = (i == 0), (i == len(SOURCES)-1)\n    # fade-in : distance depuis (s - FADE//2), sauf premier segment (depuis s)\n    d_in  = (f - s) if first else (f - (s - FADE//2))\n    # fade-out : distance jusqu'à (e + FADE//2), sauf dernier (jusqu'à e)\n    d_out = (e - f) if last  else ((e + FADE//2) - f)\n    return max(0.0, min(d_in/FADE, d_out/FADE, 1.0))\n\ndef seg_frame(f, i):\n    s   = BOUNDS[i]\n    src = SOURCES[i]\n    idx = max(0, min(f - s, len(src)-1))\n    return src[idx]\n\ndef apply_alpha(img, alpha):\n    if alpha >= 1.0: return img\n    r,g,b,a = img.split()\n    a = a.point(lambda x: int(x*alpha))\n    return Image.merge(\"RGBA\",(r,g,b,a))\n\n# ── Render ────────────────────────────────────────────────────────────────────\nprint(\"Rendering frames...\")\nfor frame in range(TOTAL):\n    canvas = Image.new(\"RGBA\",(W,H),(0,0,0,0))\n    for i in range(len(SOURCES)):\n        a = seg_alpha(frame, i)\n        if a <= 0: continue\n        canvas.alpha_composite(apply_alpha(seg_frame(frame, i), a))\n    canvas.save(f\"{FDIR}/frame_{frame:04d}.png\")\n\nprint(\"Assembling ProRes 4444...\")\nsubprocess.run([\n    'ffmpeg','-y','-r',str(FPS),\n    '-i',f'{FDIR}/frame_%04d.png',\n    '-c:v','prores_ks','-profile:v','4444',\n    '-pix_fmt','yuva444p10le', OUT\n], check=True, capture_output=True)\nprint(f\"Done → {OUT}  (5s @ {FPS}fps)\")\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"3a512dfd-892a-4be2-9f1b-5898dc0cf45f","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"ac6ab641-5815-4e7c-ac18-2f752a288b3e","version":"2.1.161","gitBranch":"main","slug":"scalable-leaping-kay"}
