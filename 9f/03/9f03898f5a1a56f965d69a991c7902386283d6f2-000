 H   = 1920, 1080\nFPS    = 60\nSCALE  = 1.5\nSHADOW = 7\nHALF   = FPS        # 60 frames = 1s chaque moitié\n\nos.makedirs(FDIR, exist_ok=True)\nos.makedirs(PDIR, exist_ok=True)\nfor f in os.listdir(FDIR): os.remove(f\"{FDIR}/{f}\")\nfor f in os.listdir(PDIR): os.remove(f\"{PDIR}/{f}\")\n\n# ── Extraire fonts & image depuis SVG ────────────────────────────────────────\nprint(\"Extracting SVG assets...\")\nwith open(SVG) as f:\n    svg_content = f.read()\n\nfont_paths = {}\nfor block in re.findall(r'@font-face\\s*\\{([^}]+)\\}', svg_content):\n    nm = re.search(r\"font-family:'([^']+)'\", block)\n    dt = re.search(r\"base64,([A-Za-z0-9+/=\\n\\r\\t ]+)\", block)\n    if nm and dt:\n        name = nm.group(1)\n        data = re.sub(r'\\s','', dt.group(1))\n        path = f'/tmp/font_{name}.ttf'\n        with open(path,'wb') as ff:\n            ff.write(base64.b64decode(data + '=='*2))\n        font_paths[name] = path\n        print(f\"  font: {name}\")\n\n# Image embedded\nimg_m = re.search(r'<image[^>]*href=\"data:image/png;base64,([^\"]+)\"[^>]*x=\"(\\d+)\"[^>]*y=\"(\\d+)\"[^>]*width=\"(\\d+)\"[^>]*height=\"(\\d+)\"', svg_content)\nif not img_m:\n    img_m = re.search(r'<image[^>]*x=\"(\\d+)\"[^>]*y=\"(\\d+)\"[^>]*width=\"(\\d+)\"[^>]*height=\"(\\d+)\"[^>]*href=\"data:image/png;base64,([^\"]+)\"', svg_content)\n    if img_m:\n        ix,iy,iw,ih,idata = img_m.group(1,2,3,4,5)\n    else:\n        ix=iy=iw=ih=None; idata=None\nelse:\n    idata,ix,iy,iw,ih = img_m.group(1,2,3,4,5)\n\nemb_img = None\nif idata:\n    raw = re.sub(r'\\s','', idata)\n    with open('/tmp/svg_emb.png','wb') as ff:\n        ff.write(base64.b64decode(raw + '=='*2))\n    emb_img = Image.open('/tmp/svg_emb.png').convert(\"RGBA\")\n    ix,iy,iw,ih = int(ix)*SCALE, int(iy)*SCALE, int(iw)*SCALE, int(ih)*SCALE\n    emb_img = emb_img.resize((int(iw), int(ih)), Image.LANCZOS)\n    print(f\"  image: {emb_img.size} at ({ix},{iy})\")\n\n# ── Couche statique bg+icon via rsvg (alignement pixel-perfect) ──────────────\nwith open(SVG) as f:\n    svg_content2 = f.read()\nno_text_svg = re.sub(r'<text[^>]*>.*?</text>', '', svg_content2, flags=re.DOTALL)\nwith open('/tmp/thumb_notxt.svg','w') as f:\n    f.write(no_text_svg)\nsubprocess.run(['rsvg-convert','-w',str(W),'-h',str(H),\n                '/tmp/thumb_notxt.svg','-o','/tmp/thumb_notxt.png'], check=True)\nBG_LAYER = Image.open('/tmp/thumb_notxt.png').convert(\"RGBA\")\nprint(f\"  bg layer: {BG_LAYER.size}\")\n\ndef make_bg(alpha=255):\n    bg = BG_LAYER.copy()\n    if alpha < 255:\n        r,g,b,a = bg.split()\n        a = a.point(lambda x: x*alpha//255)\n        bg = Image.merge(\"RGBA\",(r,g,b,a))\n    return bg\n\n# ── Texte : positions caractère par caractère ─────────────────────────────────\nELEMS = [\n    {'text':'ZenRayProgress','x':294*SCALE,'y':248*SCALE,\n     'font':font_paths['ARMed'],   'size':int(112*SCALE),'spacing':-1*SCALE},\n    {'text':'Every files,',  'x':150*SCALE,'y':430*SCALE,\n     'font':font_paths['ARXBold'], 'size':int(112*SCALE),'spacing':-2*SCALE},\n    {'text':'in a tab.',     'x':150*SCALE,'y':612*SCALE,\n     'font':font_paths['ARSerif'], 'size':int(112*SCALE),'spacing':-1*SCALE},\n]\n\nall_chars = []\nfor elem in ELEMS:\n    font = ImageFont.truetype(elem['font'], elem['size'])\n    x = elem['x']\n    for ch in elem['text']:\n        # advance width via getlength (plus précis que getbbox pour le spacing)\n        adv = font.getlength(ch)\n        all_chars.append({'ch':ch,'x':x,'y':elem['y'],'font':font})\n        x += adv + elem['spacing']\n\n# Retirer espaces de la liste de révélation (invisibles)\nreveal_chars = [c for c in all_chars if c['ch'].strip()]\nprint(f\"  chars to reveal: {len(reveal_chars)}\")\n\n# ── Ordre aléatoire de révélation ─────────────────────────────────────────────\nrandom.shuffle(reveal_chars)\nSPREAD  = HALF - 15        # frames d'étalement (0→45)\nSTART_F = 5                # première lettre à la frame 5 de la 2e moitié\n\ndef reveal_start(rank, n):\n    return START_F + int(rank/(n-1) * SPREAD)\n\nchar_starts = {id(c): reveal_start(i, len(reveal_chars))\n               for i,c in enumerate(reveal_chars)}\n\n# ── Helpers ───────────────────────────────────────────────────────────────────\ndef ss(t): return max(0.0, min(1.0, t*t*(3-2*t)))\n\ndef draw_char(canvas, ch, cx, cy, font, alpha, scale=1.0):\n    \"\"\"cx,cy = left-baseline (SVG convention : y = baseline).\"\"\"\n    if alpha <= 0 or not ch.strip(): return\n    # getbbox avec anchor ls : coordonnées relatives à la baseline gauche\n    bb = font.getbbox(ch, anchor=\"ls\")   # (l, top_neg, r, bottom_pos)\n    if bb[2] - bb[0] <= 0: return\n    pad = SHADOW*2+4\n    lw  = bb[2]-bb[0]+pad*2\n    lh  = bb[3]-bb[1]+pad*2\n    if lw<=0 or lh<=0: return\n    # Dans l'image locale : la baseline est à y = pad - bb[1]\n    lx, ly = pad - bb[0], pad - bb[1]\n    nat = Image.new(\"RGBA\",(lw,lh),(0,0,0,0))\n    ImageDraw.Draw(nat).text((lx,ly), ch, font=font, fill=(0,0,0,alpha), anchor=\"ls\")\n    shd = nat.filter(ImageFilter.GaussianBlur(SHADOW))\n    txt = Image.new(\"RGBA\", nat.size, (0,0,0,0))\n    ImageDraw.Draw(txt).text((lx,ly), ch, font=font, fill=(255,255,255,alpha), anchor=\"ls\")\n    combined = Image.alpha_composite(shd, txt)\n    if scale != 1.0:\n        nw = max(1, int(combined.width*scale))\n        nh = max(1, int(combined.height*scale))\n        combined = combined.resize((nw, nh), Image.LANCZOS)\n        ox = (combined.width  - lw)//2\n        oy = (combined.height - lh)//2\n    else:\n        ox = oy = 0\n    # Coordonnées canvas : cx+bb[0]-pad = left edge de l'image locale sur le canvas\n    dx = int(cx + bb[0] - pad - ox)\n    dy = int(cy + bb[1] - pad - oy)   # bb[1] négatif → monte au-dessus de la baseline\n    cx2,cy2 = max(0,dx), max(0,dy)\n    cr = combined.crop((cx2-dx, cy2-dy,\n                        min(combined.width, W-dx),\n                        min(combined.height, H-dy)))\n    if cr.width>0 and cr.height>0:\n        canvas.alpha_composite(cr, (cx2, cy2))\n\nPOP_F = 6   # frames d'animation par lettre\n\ndef char_at(frame_in_half, ch):\n    \"\"\"Retourne (alpha, scale) pour un caractère à une frame donnée.\"\"\"\n    start = char_starts.get(id(ch))\n    if start is None:  # espace = toujours skip\n        return 0, 1.0\n    e = frame_in_half - start\n    if e < 0:\n        return 0, 1.0\n    t = min(e / POP_F, 1.0)\n    # Bounce : 0→1.18→0.94→1.0\n    if   t < 0.45: sc = ss(t/0.45) * 1.18\n    elif t < 0.72: sc = 1.18 - ss((t-0.45)/0.27)*0.24\n    else:          sc = 0.94 + ss((t-0.72)/0.28)*0.06\n    alpha = int(min(255, t*255*2))\n    return alpha, sc\n\n# ── 1. Extraire 60 premières frames du pulse ──────────────────────────────────\nprint(\"Extracting pulse frames...\")\nsubprocess.run([\n    'ffmpeg','-y','-i',PULSE,'-frames:v',str(HALF),\n    '-vsync','0', f'{PDIR}/frame_%04d.png'\n], check=True, capture_output=True)\npulse_frames = sorted(os.listdir(PDIR))[:HALF]\nprint(f\"  {len(pulse_frames)} frames\")\n\nfor i, pf in enumerate(pulse_frames):\n    src = Image.open(f\"{PDIR}/{pf}\").convert(\"RGBA\")\n    if src.size != (W,H): src = src.resize((W,H), Image.LANCZOS)\n    src.save(f\"{FDIR}/frame_{i:04d}.png\")\n\n# ── 2. Générer 2e moitié : révélation complète du SVG ────────────────────────\nprint(\"Rendering reveal frames...\")\nBG_FADEIN = 15    # frames pour fade-in du background\nIMG_START  = 8    # frame d'apparition de l'image\n\nfor fi in range(HALF):\n    # Background\n    bg_alpha = int(min(255, fi/BG_FADEIN*255))\n    canvas   = make_bg(bg_alpha)\n\n    # Image embedded\n    if emb_img and fi >= IMG_START:\n        e   = fi - IMG_START\n        t   = min(e/POP_F, 1.0)\n        if   t < 0.45: sc = ss(t/0.45)*1.18\n        elif t < 0.72: sc = 1.18 - ss((t-0.45)/0.27)*0.24\n        else:          sc = 0.94 + ss((t-0.72)/0.28)*0.06\n        ia  = int(min(255, t*510))\n        sz  = max(1, int(iw*sc)), max(1, int(ih*sc))\n        tmp = emb_img.resize(sz, Image.LANCZOS)\n        r,g,b,a = tmp.split()\n        a = a.point(lambda x: x*ia//255)\n        tmp = Image.merge(\"RGBA\",(r,g,b,a))\n        ox  = int(ix - (sz[0]-iw)//2)\n        oy  = int(iy - (sz[1]-ih)//2)\n        if ox>=0 and oy>=0:\n            canvas.alpha_composite(tmp, (ox,oy))\n\n    # Lettres\n    for ch in reveal_chars:\n        alpha, scale = char_at(fi, ch)\n        draw_char(canvas, ch['ch'], ch['x'], ch['y'], ch['font'], alpha, scale)\n\n    canvas.save(f\"{FDIR}/frame_{HALF+fi:04d}.png\")\n\n# ── 3. Assembler ─────────────────────────────────────────────────────────────\nprint(\"Assembling ProRes 4444...\")\nsubprocess.run([\n    'ffmpeg','-y','-r',str(FPS),\n    '-i',f'{FDIR}/frame_%04d.png',\n    '-c:v','prores_ks','-profile:v','4444',\n    '-pix_fmt','yuva444p10le', OUT\n], check=True, capture_output=True)\nprint(f\"Done → {OUT}  ({2*HALF/FPS:.1f}s @ {FPS}fps)\")\n","structuredPatch":[{"oldStart":194,"oldLines":23,"newStart":194,"newLines":7,"lines":["     bg_alpha = int(min(255, fi/BG_FADEIN*255))","     canvas   = make_bg(bg_alpha)"," ","-    # Image embedded","-    if emb_img and fi >= IMG_START:","-        e   = fi - IMG_START","-        t   = min(e/POP_F, 1.0)","-        if   t < 0.45: sc = ss(t/0.45)*1.18","-        elif t < 0.72: sc = 1.18 - ss((t-0.45)/0.27)*0.24","-        else:          sc = 0.94 + ss((t-0.72)/0.28)*0.06","-        ia  = int(min(255, t*510))","-        sz  = max(1, int(iw*sc)), max(1, int(ih*sc))","-        tmp = emb_img.resize(sz, Image.LANCZOS)","-        r,g,b,a = tmp.split()","-        a = a.point(lambda x: x*ia//255)","-        tmp = Image.merge(\"RGBA\",(r,g,b,a))","-        ox  = int(ix - (sz[0]-iw)//2)","-        oy  = int(iy - (sz[1]-ih)//2)","-        if ox>=0 and oy>=0:","-            canvas.alpha_composite(tmp, (ox,oy))","+    # Image embedded : gérée par rsvg dans BG_LAYER → rien à faire ici"," ","     # Lettres","     for ch in reveal_chars:"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"d7ce29d3-e24f-4