{"parentUuid":"57a0d7f2-8978-4da3-864f-c9a39898b0aa","isSidechain":false,"attachment":{"type":"file","filename":"/tmp/cube_flip.py","content":{"type":"text","file":{"filePath":"/tmp/cube_flip.py","content":"from PIL import Image, ImageFilter\nimport os, subprocess\nimport numpy as np\n\nBASE    = '/Users/zenray/Create/Build/Productions/VideoZenRayProgress/Frames_ZenRayProgress/'\nOUT_DIR = '/tmp/cube_flip_frames'\nOUT     = BASE + 'TransitionNotionZenRayProgress.mov'\n\nW, H  = 1920, 1080\nFPS   = 24\nTOTAL = FPS * 2\nSIZE  = 600\n\nos.makedirs(OUT_DIR, exist_ok=True)\nfor f in os.listdir(OUT_DIR): os.remove(f\"{OUT_DIR}/{f}\")\n\nsubprocess.run(['rsvg-convert','-w',str(SIZE),'-h',str(SIZE), BASE+'Notion-logo.svg',  '-o','/tmp/img1.png'], check=True)\nsubprocess.run(['rsvg-convert','-w',str(SIZE),'-h',str(SIZE), BASE+'ZenRay Block.svg', '-o','/tmp/img2.png'], check=True)\n\ndef squircle_bg(size):\n    ys, xs = np.mgrid[0:size, 0:size]\n    dx = np.abs((xs - size//2) / (size//2))\n    dy = np.abs((ys - size//2) / (size//2))\n    alpha = np.where(dx**5 + dy**5 <= 1.0, 255, 0).astype(np.uint8)\n    bg = Image.new(\"RGBA\", (size, size), (255, 255, 255, 255))\n    bg.putalpha(Image.fromarray(alpha))\n    return bg\n\ndef load(path):\n    img = Image.open(path).convert(\"RGBA\")\n    img.thumbnail((SIZE, SIZE), Image.LANCZOS)\n    sq = Image.new(\"RGBA\", (SIZE, SIZE), (0,0,0,0))\n    sq.paste(img, ((SIZE-img.width)//2,(SIZE-img.height)//2), img)\n    # Fond squircle blanc derrière\n    bg = squircle_bg(SIZE)\n    result = Image.alpha_composite(bg, sq)\n    return result\n\nimg1 = load('/tmp/img1.png')\nimg2 = load('/tmp/img2.png')\n\ndef smoothstep(t): return t*t*(3-2*t)\n\nMAX_ROT  = 18\nMAX_BLUR = 8\n\nfor frame in range(TOTAL):\n    t  = frame / (TOTAL - 1)   # 0 → 1\n\n    # Alpha : overlap court au centre (20% de la durée)\n    OVERLAP = 0.15\n    a1 = max(0.0, min(1.0, (0.5 + OVERLAP - t) / (0.5 + OVERLAP)))\n    a2 = max(0.0, min(1.0, (t - (0.5 - OVERLAP)) / (0.5 + OVERLAP)))\n    a1 = smoothstep(a1)\n    a2 = smoothstep(a2)\n\n    canvas = Image.new(\"RGBA\", (W, H), (0,0,0,0))\n\n    # IMG1\n    if a1 > 0.01:\n        rot1  = MAX_ROT * smoothstep(1-a1)\n        blur1 = MAX_BLUR * smoothstep(1-a1)\n        sz1   = int(SIZE * (1.0 + 0.06*(1-a1)))\n        i1 = img1.resize((sz1,sz1), Image.LANCZOS)\n        i1 = i1.rotate(-rot1, resample=Image.BICUBIC)\n        if blur1 > 0.4: i1 = i1.filter(ImageFilter.GaussianBlur(blur1))\n        r,g,b,a = i1.split()\n        a = a.point(lambda x: int(x * a1))\n        canvas.alpha_composite(Image.merge(\"RGBA\",(r,g,b,a)), ((W-sz1)//2,(H-sz1)//2))\n\n    # IMG2\n    if a2 > 0.01:\n        rot2  = MAX_ROT * smoothstep(1-a2)\n        blur2 = MAX_BLUR * smoothstep(1-a2)\n        sz2   = int(SIZE * (1.0 - 0.06*(1-a2)))\n        i2 = img2.resize((sz2,sz2), Image.LANCZOS)\n        i2 = i2.rotate(rot2, resample=Image.BICUBIC)\n        if blur2 > 0.4: i2 = i2.filter(ImageFilter.GaussianBlur(blur2))\n        r,g,b,a = i2.split()\n        a = a.point(lambda x: int(x * a2))\n        canvas.alpha_composite(Image.merge(\"RGBA\",(r,g,b,a)), ((W-sz2)//2,(H-sz2)//2))\n\n    canvas.save(f\"{OUT_DIR}/frame_{frame:04d}.png\")\n\nprint(\"Assembling...\")\nsubprocess.run([\n    \"ffmpeg\",\"-y\",\"-r\",str(FPS),\n    \"-i\",f\"{OUT_DIR}/frame_%04d.png\",\n    \"-c:v\",\"prores_ks\",\"-profile:v\",\"4444\",\n    \"-pix_fmt\",\"yuva444p10le\", OUT\n], check=True, capture_output=True)\nprint(f\"Done → {OUT}\")\n","numLines":93,"startLine":1,"totalLines":93}},"displayPath":"../../../../../tmp/cube_flip.py"},"type":"attachment","uuid":"08f71328-e0a2-4bd5-bb1a-cf69827a3949","timestamp":"2026-06-04T15:05:33.969Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"ac6ab641-5815-4e7c-ac18-2f752a288b3e","version":"2.1.161","gitBranch":"main","slug":"scalable-leaping-kay"}
{"parentUuid":"08f71328-e0a2-4bd5-bb1a-cf69827a3949","isSidechain":false,"attachment":{"type":"file","filename":"/tmp/iris_transition.py","content":{"type":"text","file":{"filePath":"/tmp/iris_transition.py","content":"from PIL import Image, ImageFilter\nimport numpy as np, os, subprocess\n\nBASE    = '/Users/zenray/Create/Build/Productions/VideoZenRayProgress/Frames_ZenRayProgress/'\nOUT_DIR = '/tmp/iris_frames'\nOUT     = BASE + 'Iris Transition.mov'\n\nW, H  = 1920, 1080\nFPS   = 24\nTOTAL = FPS * 3   # 72 frames\nSIZE  = 600\n\nos.makedirs(OUT_DIR, exist_ok=True)\nfor f in os.listdir(OUT_DIR): os.remove(f\"{OUT_DIR}/{f}\")\n\nsubprocess.run(['rsvg-convert','-w',str(SIZE),'-h',str(SIZE), BASE+'ZenRay Block.svg', '-o','/tmp/iris1.png'], check=True)\n\ndef load(path):\n    img = Image.open(path).convert(\"RGBA\")\n    img.thumbnail((SIZE, SIZE), Image.LANCZOS)\n    sq = Image.new(\"RGBA\", (SIZE, SIZE), (0,0,0,0))\n    sq.paste(img, ((SIZE-img.width)//2,(SIZE-img.height)//2), img)\n    return sq\n\nimg1 = load('/tmp/iris1.png')\nimg2 = load(BASE + '2d8f29f5_transparent.png')\n\n# Distance rounded-rect depuis le centre (0=centre, 1=bord)\ncx, cy = SIZE//2, SIZE//2\nys, xs = np.mgrid[0:SIZE, 0:SIZE]\n# SDF rounded rectangle normalisé\nR = 0.25  # rayon des coins (fraction de la demi-taille)\nnx = np.abs((xs - cx) / cx)   # 0=centre, 1=bord\nny = np.abs((ys - cy) / cy)\nqx = np.maximum(nx - (1.0 - R), 0.0)\nqy = np.maximum(ny - (1.0 - R), 0.0)\ndist = (np.sqrt(qx**2 + qy**2) - R) + 1.0   # 0 au centre, 1 au bord\ndist = np.clip(dist / dist.max(), 0, 1)\ndist_norm = dist\n\nFEATHER = 0.10\n\n# 3 phases :\n# 0.00→0.55 : iris se referme (bords → centre)\n# 0.55→0.75 : centre restant fade out\n# 0.75→1.00 : img2 fade in\nP1_END = 0.55\nP2_END = 0.75\n\ndef ss(t): return np.clip(t*t*(3-2*t), 0, 1)\ndef ss1(t): return float(np.clip(t*t*(3-2*t), 0, 1))\n\nfor frame in range(TOTAL):\n    t  = frame / (TOTAL - 1)\n\n    canvas = Image.new(\"RGBA\", (W, H), (0,0,0,0))\n    px = (W-SIZE)//2\n    py = (H-SIZE)//2\n\n    # ── PHASE 1+2 : img1 ──\n    if t < P2_END:\n        # Fond blanc carré arrondi (squircle n=5)\n        _ys, _xs = np.mgrid[0:SIZE, 0:SIZE]\n        _dx = np.abs((_xs - SIZE//2) / (SIZE//2))\n        _dy = np.abs((_ys - SIZE//2) / (SIZE//2))\n        _sq_alpha = np.where(_dx**5 + _dy**5 <= 1.0, 255, 0).astype(np.uint8)\n        white_bg = Image.new(\"RGBA\", (SIZE, SIZE), (255, 255, 255, 255))\n        white_bg.putalpha(Image.fromarray(_sq_alpha))\n        i1 = Image.alpha_composite(white_bg, img1)\n        r,g,b,a = i1.split()\n        a_arr = np.array(a, dtype=np.float32) / 255.0\n\n        if t <= P1_END:\n            # Iris : threshold recule de 1 → 0\n            progress  = ss1(t / P1_END)          # 0→1\n            threshold = 1.0 - progress            # 1→0\n            mask = ss((dist_norm - (1.0 - threshold)) / FEATHER + 0.5)\n        else:\n            # Centre restant disparaît globalement\n            progress2 = ss1((t - P1_END) / (P2_END - P1_END))\n            mask = np.ones((SIZE, SIZE), dtype=np.float32) * (1.0 - progress2)\n\n        a_new = (a_arr * mask * 255).astype(np.uint8)\n        i1 = Image.merge(\"RGBA\", (r, g, b, Image.fromarray(a_new)))\n        canvas.alpha_composite(i1, (px, py))\n\n    # ── PHASE 3 : img2 ──\n    if t > P2_END:\n        progress3 = ss1((t - P2_END) / (1.0 - P2_END))\n        a2 = int(255 * progress3)\n        i2 = img2.copy()\n        r,g,b,a = i2.split()\n        a = a.point(lambda x: x * a2 // 255)\n        canvas.alpha_composite(Image.merge(\"RGBA\",(r,g,b,a)), (px, py))\n\n    canvas.save(f\"{OUT_DIR}/frame_{frame:04d}.png\")\n\nprint(\"Assembling...\")\nsubprocess.run([\n    \"ffmpeg\",\"-y\",\"-r\",str(FPS),\n    \"-i\",f\"{OUT_DIR}/frame_%04d.png\",\n    \"-c:v\",\"prores_ks\",\"-profile:v\",\"4444\",\n    \"-pix_fmt\",\"yuva444p10le\", OUT\n], check=True, capture_output=True)\nprint(f\"Done → {OUT}\")\n","numLines":106,"startLine":1,"totalLines":106}},"displayPath"