" $i).avif\"\n    avifenc --min 25 --max 25 --speed 10 --jobs 1 \"$png\" \"$OUT\" >/dev/null 2>&1\n    if [[ -s \"$OUT\" ]]; then\n        TOTAL_AVIF=$((TOTAL_AVIF + $(stat -f %z \"$OUT\")))\n    fi\ndone\n\n# Validate we produced at least the first frame\nMAIN_AVIF=\"$DIR/${NAME}_f0001.avif\"\nif [[ ! -s \"$MAIN_AVIF\" ]]; then\n    echo \"FAIL_ENCODE $VIDEO\"\n    exit 1\nfi\n\nORIG_SIZE=$(stat -f %z \"$VIDEO\")\n# Delete original video (gain disk)\nrm -f \"$VIDEO\"\n\n# Update Eagle metadata.json: ext -> avif, size -> main avif size, optional folder move\nMAIN_SIZE=$(stat -f %z \"$MAIN_AVIF\")\npython3 - \"$META\" \"$MAIN_SIZE\" \"$FOLDER_ID\" \"$NAME\" \"$EXTRACTED\" \"$TOTAL_AVIF\" <<'PY'\nimport json, sys, os, time\nmeta, main_size, folder_id, name, n_frames, total_size = sys.argv[1:7]\nmain_size, n_frames, total_size = int(main_size), int(n_frames), int(total_size)\n\nwith open(meta, 'r') as f:\n    d = json.load(f)\n\nd['ext'] = 'avif'\nd['size'] = main_size\nd['modificationTime'] = int(time.time() * 1000)\n# Add note in annotation about the frames\nnote = f\"[Auto-converted from video: {n_frames} AVIF frames @ 10s intervals, total {total_size} bytes]\"\nd['annotation'] = (d.get('annotation', '') + \" \" + note).strip()\nif folder_id:\n    folders = d.get('folders', []) or []\n    if folder_id not in folders:\n        folders.append(folder_id)\n    d['folders'] = folders\n\ntmp = meta + '.tmp'\nwith open(tmp, 'w') as f:\n    json.dump(d, f, separators=(',', ':'))\nos.replace(tmp, meta)\nPY\n\nGAIN=$(( ORIG_SIZE > 0 ? 100 - TOTAL_AVIF * 100 / ORIG_SIZE : 0 ))\necho \"OK ${GAIN}% ${EXTRACTED}fr $((ORIG_SIZE/1048576))MB→$((TOTAL_AVIF/1048576))MB $VIDEO\"\n"}}
