//\n// La normalisation est SANS RISQUE : sur un chemin sans accent, NFC ne change rien.\nconst nfc = (p) => typeof p === 'string' ? p.normalize('NFC') : p\n\nconst rawJsonAt = async (token, path) => {\n  const chemin = nfc(path)\n  const parRaw = async () => {\n    try {\n      const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(chemin)}`, { cache: 'no-store', headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n      if (r.ok) return { lu: true, valeur: await r.json() }\n      return { lu: false, statut: r.status }\n    } catch { return { lu: false, statut: 0 } }\n  }\n  const parApi = async () => {\n    try {\n      const c = await gh(token, `contents/${encodeURI(chemin)}?ref=${BRANCH}`)\n      if (!c.ok) return { lu: false, statut: c.status }\n      const j = await c.json()\n      if (!j || typeof j.content !== 'string') return { lu: false, statut: 0 }\n      return { lu: true, valeur: JSON.parse(b64d(j.content)) }\n    } catch { return { lu: false, statut: 0 } }\n  }\n\n  // ═══ UN ÉCHEC DE LECTURE N'EST PAS UNE ABSENCE ═════════════════════════════════════════════════\n  //\n  // BUG RÉEL, deux fois de suite : « invalid-source » à 02h22, puis « missing-source » à 02h29, sur\n  // des fichiers dont la chaîne ENTIÈRE — lien, registre, source — se lisait en 200 par les deux\n  // voies quelques minutes plus tard. Le lot était annulé alors que rien ne manquait.\n  //\n  // MON PREMIER CORRECTIF ÉTAIT À MOITIÉ FAIT, et c'est ce qui a laissé le second incident passer :\n  // je ne repliais que sur un 404. Or `raw.githubusercontent.com` est un CDN qui rend aussi des 403\n  // quand il limite le débit, des 429, des 5xx quand il réplique. Tous ces cas retournaient `null`,\n  // et l'appelant en concluait « source absente » — un verdict définitif sur une panne passagère.\n  //\n  // TROIS VOIES, DANS CET ORDRE. Le chemin normal reste `raw` : gratuit, hors quota, servi par un\n  // CDN. Sur ÉCHEC, quel qu'i