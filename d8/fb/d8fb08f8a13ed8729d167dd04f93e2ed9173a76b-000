ev local = gate serveur désactivé). Sur 401, on demande le secret UNE fois (prompt), on le stocke, on rejoue.\n//\n// Les médias chargés comme src DOM (<img>/<video>/hls.js) NE passent PAS par fetch et sont EXEMPTÉS côté serveur\n// (PUBLIC_ROUTES), donc rien à faire pour eux.\n\nconst KEY = 'zr:apiSecret'\nexport const getApiSecret = () => { try { return localStorage.getItem(KEY) || '' } catch { return '' } }\nexport const setApiSecret = (v) => { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY) } catch {} }\n\nconst isApiUrl = (url) => {\n  if (typeof url !== 'string') return false\n  if (url.startsWith('/api/')) return true\n  try { return new URL(url, location.href).origin === location.origin && new URL(url, location.href).pathname.startsWith('/api/') } catch { return false }\n}\n\n// Demande le code via le pavé PIN React (PinGate -> window.__zrRequestPin). Concurrence : tous les 401 simultanés\n// partagent la MÊME demande (un seul modal). Repli sur prompt natif si le modal n'est pas encore monté.\nlet pinInFlight = null\n// PAGES DE PARTAGE PUBLIC (/watch, /folder) : on ne réclame JAMAIS le code du drive à un visiteur du lien.\n// Si un appel /api y renvoie 401, on échoue silencieusement (la lecture publique des manifestes ne devrait\n// jamais 401 ; ce garde-fou évite tout window.prompt « Code du drive » chez la personne avec qui on partage).\nconst isSharePage = () => { try { return location.pathname === '/watch' || location.pathname === '/folder' || location.pathname === '/view' } catch { return false } }\nasync function requestPin(hadSecret) {\n  if (isSharePage()) return ''\n  if (typeof window !== 'undefined' && window.__zrRequestPin) {\n    if (!pinInFlight) pinInFlight = Promise.resolve(window.__zrRequestPin(hadSecret)).finally(() => { pinInFlight = null })\n    return pinInFlight\n  }\n  try { return window.prompt('Code du drive ZenRay :') || '' } catch { return '' }\n}\n\nexport function installApiAuth() {\n  if (typeof window === 'undefined' || window.__zrApiAuth) return\n  window.__zrApiAuth = true\n  const orig = window.fetch.bind(window)\n  window.fetch = async (input, init = {}) => {\n    const url = typeof input === 'string' ? input : (input && input.url) || ''\n    const api = isApiUrl(url)\n    const withSecret = (i) => { const s = getApiSecret(); return s ? { ...i, headers: { ...((i && i.headers) || {}), 'x-zr-auth': s } } : i }\n    let res = await orig(input, api ? withSecret(init) : init)\n    // 401 sur un /api : le serveur exige le code et on ne l'a pas (ou il est faux) -> pavé PIN, puis on rejoue.\n    if (api && res && res.status === 401) {\n      const entered = await requestPin(!!getApiSecret())\n      if (entered) { setApiSecret(entered); res = await orig(input, withSecret(init)) }\n    }\n    return res\n  }\n}\n// Pavé PIN (style Finder macOS / Notion) pour déverrouiller le drive ZenRay.\n// Remplace le window.prompt de apiAuth.js : ce dernier appelle window.__zrRequestPin(hadSecret) qui renvoie une\n// Promise résolue avec le code saisi (ou '' si annulé). Le code saisi devient le secret x-zr-auth (= ZENRAY_API_SECRET\n// côté Vercel) -> il gate à la fois l'accès /api ET la clé de déchiffrement (/api/media-key). Une seule source de vérité.\nimport React, { useState, useEffect, useRef, useCallback } from 'react'\nimport Icon from './Icon.jsx'\n\nconst FONTS = { sans: \"var(--zr-police-sans)\", serif: \"var(--zr-police-serif)\" }\n\nexport default function PinGate({ t }) {\n  const [show, setShow] = useState(false)\n  const [pin, setPin] = useState('')\n  const [retry, setRetry] = useState(false) // un secret était déjà posé et a échoué -> mauvais code\n  const [shake, setShake] = useState(false)\n  const resolveRef = useRef(null)\n\n  const close = useCallback((val) => {\n    setShow(false); setPin('')\n    const r = resolveRef.current; resolveRef.current = null\n    if (r) r(val)\n  }, [])\n\n  // Point d'entrée appelé par apiAuth.js sur 401.\n  useEffect(() => {\n    window.__zrRequestPin = (hadSecret) => new Promise((resolve) => {\n      resolveRef.current = resolve; setPin(''); setRetry(!!hadSecret); setShow(true)\n    })\n    return () => { try { delete window.__zrRequestPin } catch {} }\n  }, [])\n\n  const submit = useCallback(() => {\n    if (!pin) { setShake(true); setTimeout(() => setShake(false), 360); return }\n    close(pin)\n  }, [pin, close])\n\n  // Clavier physique : chiffres, retour arrière, Entrée, Échap.\n  useEffect(() => {\n    if (!show) return\n    const onKey = (e) => {\n      if (e.key >= '0' && e.key <= '9') { setPin((p) => (p.length < 16 ? p + e.key : p)); setRetry(false) }\n      else if (e.key === 'Backspace') setPin((p) => p.slice(0, -1))\n      else if (e.key === 'Enter') submit()\n      else if (e.key === 'Escape') close('')\n    }\n    window.addEventListener('keydown', onKey)\n    return () => window.removeEventListener('keydown', onKey)\n  }, [show, submit, close])\n\n  if (!show) return null\n\n  const accent = (t && t.accent) || '#0A84FF'\n  const textP = (t && t.textPrimary) || '#1d1d1f'\n  const textS = (t && t.textSecondary) || '#8a8a8e'\n  const press = (d) => { setPin((p) => (p.length < 16 ? p + d : p)); setRetry(false) }\n\n  const keyBtn = {\n    width: 64, height: 64, borderRadius: 99, border: 'none', cursor: 'pointer',\n    background: 'rgba(120,120,128,0.16)', color: textP, fontFamily: FONTS.sans, fontSize: 25, fontWeight: 400,\n    display: 'inline-flex', alignItems: 'center', justifyContent: 'center', transition: 'transform .08s, background .12s',\n  }\n\n  return (\n    <>\n      <div onClick={() => close('')} style={{ position: 'fixed', inset: 0, zIndex: 2000, background: 'rgba(0,0,0,0.32)', backdropFilter: 'blur(3px)', WebkitBackdropFilter: 'blur(3px)' }} />\n      <div className=\"zr-glass-thick\" role=\"dialog\" aria-modal=\"true\"\n        style={{ position: 'fixed', top: '50%', left: '50%', transform: 'translate(-50%,-50%)', zIndex: 2001, width: 'min(340px, 92vw)', borderRadiu