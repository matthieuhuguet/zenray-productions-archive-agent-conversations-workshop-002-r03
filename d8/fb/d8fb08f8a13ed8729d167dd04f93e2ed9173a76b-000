120,120,128,0.26)')} onMouseLeave={(e) => (e.currentTarget.style.background = 'rgba(120,120,128,0.16)')}>0</button>\n          <button onClick={() => setPin((p) => p.slice(0, -1))} onMouseDown={(e) => e.preventDefault()} title=\"Effacer\" style={{ ...keyBtn, background: 'transparent', fontSize: 24, color: textS }}>⌫</button>\n        </div>\n\n        <button onClick={submit} disabled={!pin} style={{ width: '100%', padding: '13px', borderRadius: 14, border: 'none', cursor: pin ? 'pointer' : 'default', background: pin ? accent : 'rgba(120,120,128,0.18)', color: pin ? '#fff' : textS, fontFamily: FONTS.sans, fontWeight: 600, fontSize: 'var(--zr-ui-xl)', transition: 'background .15s' }}>\n          Déverrouiller\n        </button>\n\n        <style>{`\n          @keyframes pinPop{from{opacity:0;transform:translate(-50%,-48%) scale(0.96)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}\n          @keyframes pinShake{10%,90%{transform:translate(calc(-50% - 1px),-50%)}30%,70%{transform:translate(calc(-50% + 6px),-50%)}50%{transform:translate(calc(-50% - 6px),-50%)}}\n        `}</style>\n      </div>\n    </>\n  )\n}\n// Résolution/persistance de la vue courante (Dashboard/Create/Tables/…) dans localStorage.\n// Migration unique depuis l'ancienne clé zr:tabs (UI multi-onglets retirée) : lue une seule fois puis\n// supprimée immédiatement, pour ne jamais écraser zr:view à un reload ultérieur (régression corrigée\n// le 2026-07-16 : zr:tabs n'était jamais supprimé, donc chaque reload revenait à la vue figée dedans).\nexport function resolveInitialView(storage) {\n  try {\n    const a = JSON.parse(storage.getItem('zr:tabs'))\n    if (Array.isArray(a) && a[0] && a[0].view) { storage.removeItem('zr:tabs'); return a[0].view }\n  } catch {}\n  try { return storage.getItem('zr:view') || 'board' } catch { return 'board' }\n}\n\nexport function persistView(storage, view) {\n  try { storage.setItem('zr:view', view) } catch {}\n}\n","stderr":"","aggregated_output":"import { defin