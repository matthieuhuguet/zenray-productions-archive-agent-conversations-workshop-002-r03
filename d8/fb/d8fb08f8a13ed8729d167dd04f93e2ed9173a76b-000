matthieuhuguet/zenray-data), CONTENT_BRANCH (main).\nimport { createHash } from 'node:crypto'\nimport { instrument } from './cmdlog.js'\nimport { isExposedTreeNode } from './nodeTreeFilter.js'\nimport { collectSubtreeBlobPaths } from './repoSubtree.js'\nimport { deplacerDansRegistre, deplacerPlusieurs } from './eagleRegistry.js'\nimport { authorizeShareAccess } from './share-token.js'\nimport { reserveEagleFolderTarget, reserveEagleLeafTarget } from './eagleBatch.js'\nconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\nconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n\n// Wrapper fetch brut sur le repo content. Instrumenté ci-dessous : chaque écriture (PUT/POST/DELETE)\n// est journalisée dans le Repo Commands log (les GET ne le sont pas).\nconst ghRaw = (token, path, init = {}) =>\n  fetch(`https://api.github.com/repos/${REPO}/${path}`, {\n    ...init,\n    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) },\n  })\nconst gh = instrument(ghRaw, {\n  repoOf: () => REPO,\n  pathOf: (args) => args[1],\n  initOf: (args) => args[2] || {},\n})\nconst b64e = (s) => Buffer.from(s, 'utf8').toString('base64')\nconst b64d = (s) => Buffer.from(s, 'base64').toString('utf8')\nconst EAGLE_LINK_TYPE = 'zenray-eagle-link/v1'\nconst EAGLE_FOLDER_LINK_TYPE = 'zenray-eagle-folder-link/v1'\nconst EAGLE_FOLDER_LINK_FILE = '.zreagle-folder.json'\nconst EAGLE_FOLDER_RESOURCE_FILE = '.zreagle-resource.json'\nconst EAGLE_RESOURCE_DIR = 'pages/.zr-resources'\nconst EAGLE_LINK_RE = /\\.(img|media|file|canvas|ref|embed|db)\\.json$/\nconst isEagleLink = (value) => !!(value && value.type === EAGLE_LINK_TYPE && typeof value.resourceId === 'string')\nconst resourcePathOf = (id) => `${EAGLE_RESOURCE_DIR}/${id}.json`\nconst resourceIdOf = () => `zr_${globalThis.crypto.randomUUID().replace(/-/g, '')}`\nconst jsonBlob = async (token, value) => {\n  const r = await gh(token, 'git/blobs', { 