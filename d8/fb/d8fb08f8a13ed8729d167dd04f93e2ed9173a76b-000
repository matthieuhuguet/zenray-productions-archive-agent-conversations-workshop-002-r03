puis : vignette 1080p nette\n    // en fondu -> plein format superposé en douceur. L'œil ne voit qu'une image qui apparaît.\n    if (page === null) body = <div style={box} />\n    else if (page.img || page.thumb) body = (\n      <div style={{ position: 'relative', ...box }}>\n        {page.thumb && <FadeImg key={'t' + page.thumb} src={page.thumb} alt={name} />}\n        {page.img && <FadeImg key={'f' + page.img} src={page.img} alt={name} overlay={!!page.thumb} />}\n      </div>\n    )\n    else body = <div style={{ color: '#fff', opacity: 0.7 }}>image introuvable</div>\n  } else if (type === 'page') {\n    if (page === null) body = <div style={{ color: '#fff', opacity: 0.7 }}>chargement…</div>\n    else if (page.img) body = <img src={page.img} alt={name} style={{ maxWidth: '92vw', maxHeight: '82vh', objectFit: 'contain', borderRadius: RADII.md, boxShadow: '0 20px 60px rgba(0,0,0,0.5)' }} />\n    else body = <div className=\"zr-quicklook-chrome\" style={{ maxWidth: 'min(820px,90vw)', maxHeight: '82vh', overflow: 'auto', padding: '28px 34px', borderRadius: RADII.lg, color: '#ECECEA', whiteSpace: 'pre-wrap', fontSize: 'var(--zr-ui-xl)', lineHeight: 1.6 }}>{(page.md || '').slice(0, 6000)}</div>\n  } else if (type === 'file') {\n    const f = file\n    const mime = (f && f.mime) || ''\n    if (!f || (f.prog != null && !f.url)) body = <div style={{ color: '#fff', opacity: 0.7 }}>reconstitution…{f && f.prog != null ? ` ${Math.round(f.prog * 100)}%` : ''}</div>\n    else if (f.err) body = <div style={{ color: '#fff', opacity: 0.7 }}>erreur de reconstitution</div>\n    else if (f.tooBig) body = <div style={{ color: '#fff', opacity: 0.7 }}>trop volumineux pour l’aperçu — Entrée pour télécharger</div>\n    else if (f.unsupported) body = <div style={{ color: '#fff', opacity: 0.7 }}>aperçu indisponible pour ce type — Entrée pour ouvrir</div>\n    // LIB (docx/xlsx/heic/tiff/epub/3D) : décodeur dynamique lazy. AVANT le branchement image (heic a mime image/* mais exige heic2any).\n    else if (f.url && LIB_KINDS.has(f.kind)) body = <React.Suspense fallback={<div style={{ color: '#fff', opacity: 0.7 }}>décodage…</div>}><LazyLibPreview url={f.url} name={item.name} kind={f.kind} /></React.Suspense>\n    else if (f.url && mime.startsWith('image/')) body = <img src={f.url} alt={name} style={{ maxWidth: '92vw', maxHeight: '82vh', objectFit: 'contain', borderRadius: RADII.md, boxShadow: '0 20px 60px rgba(0,0,0,0.5)' }} />\n    else if (f.url && mime.startsWith('video/') && !f.playErr) body = <video src={f.url} controls autoPlay onError={() => setFile((x) => (x ? { ...x, playErr: true } : x))} style={{ maxWidth: '92vw', maxHeight: '82vh', borderRadius: RADII.md, background: '#000' }} />\n    else if (f.url && f.playErr) body = <div style={{ color: '#fff', opacity: 0.7, textAlign: 'center', lineHeight: 1.6 }}>Codec non lisible par le navigateur (.mov ProRes/HEVC).<br />Entrée pour télécharger.</div>\n    else if (f.url && mime.startsWith('audio/')) body = <audio src={f.url} controls autoPlay style={{ width: 460 }} />\n    else if (f.url && mime === 'application/pdf') body = <iframe title={name} src={f.url} style={{ width: '82vw', height: '82vh', border: 'none', borderRadius: RADII.md, background: '#fff' }} />\n    else if (f.url && f.text != null) body = <div className=\"zr-quicklook-chrome\" style={{ maxWidth: 'min(820px,90vw)', maxHeight: '82vh', overflow: 'auto', padding: '28px 34px', borderRadius: RADII.lg, color: '#ECECEA', whiteSpace: 'pre-wrap', fontFamily: 'var(--zr-police-sans)', fontSize: 'var(--zr-ui-md)', lineHeight: 1.55 }}>{(f.text || '').slice(0, 100000)}</div>\n    else body = <div style={{ color: '#fff', opacity: 0.7 }}>aperçu indisponible</div>\n  } else if (type === 'db') {\n    body = <div className=\"zr-quicklook-chrome\" style={{ padding: '40px 56px', borderRadius: RADII.lg, color: '#fff', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}><Icon name=\"tablecells\" size={46} grad /><div>Table — Entrée pour ouvrir</div></div>\n  } else {\n    body = <div className=\"zr-quicklook-chrome\" style={{ padding: '40px 56px', borderRadius: RADII.lg, color: '#fff', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}><Icon name=\"folder\" size={46} grad /><div>Dossier — Entrée pour ouvrir</div></div>\n  }\n\n  // Provenance du média, UNIFIÉE en une liste de segments {label,color} pour image/file/media -> rendue\n  // derrière une pastille toggle (masquée par défaut depuis 2026-07-12 : le texte technique cassait le\n  // design minimaliste ; on garde l'info, accessible en un clic). [] si inconnue (ex. manifeste image pas\n  // encore chargé) -> aucune pastille affichée.\n  // 100% des types passent par le même helper (spec pastilles 2026-07-20) : vert = jsDelivr,\n  // bleu = raw.github/API REST, jaune = proxy Vercel. Pour un .file.json le manifeste est déjà\n  // chargé dans `file`? Non -- il n'est pas conservé ici : nodeType 'file' suffit (chunks raw.github).\n  const srcSegs = type === 'image' ? mediaSourceSegments(page && page.manifest, 'image')\n    : type === 'file' ? mediaSourceSegments({ mode: 'chunked' }, 'file')\n    : type === 'media' ? mediaSourceSegments(mediaManifest)\n    : []\n\n  return (\n    <div className=\"zr-quicklook-backdrop\" onClick={onClose} style={{ position: 'fixed', inset: 0, zIndex: 200, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center' }}>\n      {/* nav gauche/droite */}\n      <button onClick={(e) => { e.stopPropagation(); onPrev() }} style={navBtn('left')}><Icon name=\"chevron.left\" size={24} weight={1.8} color=\"#fff\" /></button>\n      <button onClick={(e) => { e.stopPropagation(); onNext() }} style={navBtn('right')}><Icon name=\"chevron.right\" size={24} weight={1.8} color=\"#fff\" /></button>\n      <div onClick={(e) => e.stopPropagation()} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 14 }}>\n        {body}\n        <div style={{ display: 'flex', alignItems: 'center', gap: 14, color: '#fff' }}>\n          <span style={{ fontSize: 'var(--zr-ui-lg)', fontWeight: 600, maxWidth: '70vw', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{name}</span>\n          {/* BADGE SOURCE CDN — d'où vient RÉELLEMENT le média (jsDelivr chiffré / raw.github / YouTube / …).\n              MASQUÉ par défaut (2026-07-12, demande Matthieu : le texte technique cassait le minimalisme) :\n              on n'affiche qu'une petite PASTILLE de la couleur de la source ; clic -> déplie le texte complet ;\n              re-clic -> replie. srcSegs (calculé plus haut) porte la vraie provenance, jamais figée. */}\n          {srcSegs.length > 0 && (\n            showSrc ? (\n              <span onClick={(e) => { e.stopPropagation(); setShowSrc(false) }} title=\"Masquer la source\" style={{ display: 'inline-flex', alignItems: 'center', gap: 8, fontFamily: \"var(--zr-police-sans)\", fontSize: 'var(--zr-ui-xs)', color: 'rgba(255,255,255,0.82)', background: 'rgba(255,255,255,0.12)', border: '1px solid rgba(255,255,255,0.18)', borderRadius: 999, padding: '4px 11px', cursor: 'pointer' }}>\n                {srcSegs.map((s, i) => (\n                  <React.Fragment key={i}>\n                    {i > 0 && <span style={{ opacity: 0.5 }}>·</span>}\n                    <span style={{ display: 'inline-flex', alignItems: 'center', gap: 4 }}><i style={{ width: 7, height: 7, borderRadius: '50%', background: s.color }} />{s.label}</span>\n                  </React.Fragment>\n                ))}\n              </span>\n            ) : (\n              <button onClick={(e) => { e.stopPropagation(); setShowSrc(true) }} title=\"Afficher la source du média\" aria-label=\"Afficher la source du média\" style={{ background: 'transparent', border: 'none', padding: 4, cursor: 'pointer', display: 'inline-flex', alignItems: 'center', lineHeight: 0 }}>\n                <i style={{ width: 9, height: 9, borderRadius: '50%', background: srcSegs[0].color, boxShadow: '0 0 0 3px rgba(255,255,255,0.14)' }} />\n              </button>\n            )\n          )}\n          {/* TRIER — à GAUCHE de « Télécharger », comme demandé le 2026-08-30. Ce bouton n'envoie\n              PAS la photo : il pose une référence de ~150 octets dans l'espace de tri, l'original\n              ne bougeant pas de son dossier. C'est ce qui permet de trier en plusieurs tas sans\n              jamais dupliquer un octet ni perdre le rangement d'origine. */}\n          {estTriable(item) && tri && tri.espaces && tri.espaces.length > 0 && (\n            <BoutonTri tri={tri} item={item} />\n          )}\n          {(type === 'image' || type === 'file') && item.contentPath && <button onClick={(e) => { e.stopPropagation(); downloadMedia(item.contentPath, item.name).catch(() => {}) }} style={{ background: 'rgba(255,255,255,0.16)', color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 14px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600 }}>Télécharger</button>}\n          <button onClick={(e) => { e.stopPropagation(); onOpen() }} style={{ background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 16px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600 }}>Ouvrir</button>\n        </div>\n      </div>\n      <div style={{ position: 'fixed', top: 18, right: 22, color: 'rgba(255,255,255,0.6)', fontSize: 'var(--zr-ui-sm)', fontFamily: 'var(--zr-police-sans)' }}>Espace/Échap fermer · ←/→ naviguer</div>\n    </div>\n  )\n}\n\n// Quick Look resolves the placement before it mounts its media effects.  This\n// prevents the previous double-hop (link manifest, then target manifest) and\n// gives Space the same HLS/MSE/YouTube/file path as the normal viewer.\nexport default function QuickLookOverlay({ item, ...props }) {\n  // ═══ NE JAMAIS RENDRE UN ÉCRAN VIDE EN ATTENDANT UNE RÉPONSE DÉJÀ CONNUE ═══════════════════════\n  //\n  // RÉGRESSION DE VITESSE mesurée le 2026-08-31 : ouvrir un aperçu prenait près de deux secondes,\n  // là où il doit s'ouvrir en un dixième. Le budget, mesuré et non supposé :\n  //\n  //   un aller-retour vers l'API      150 à 250 ms\n  //   déchiffrer une vignette 1080      0,1 ms\n  //   déchiffrer un plein format 4 Mo   0,9 ms\n  //\n  // Le déchiffrement n'est donc RIEN : ce sont les allers-retours qui coûtent tout. Or ce composant\n  // en payait un ici même, en rendant `<div />` — un écran vide — pendant que la résolution du lien\n  // partait sur le réseau. Le corps, qui sait déjà afficher la vignette du cache puis le plein\n  // format, ne démarrait qu'après.\n  //\n  // CE QUI REND L'ATTENTE INUTILE : la grille vient d'afficher cette même image, donc la réponse est\n  // déjà en mémoire dans neuf cas sur dix. `eaglePathConnu` la rend sans attendre. Et quand elle\n  // n'est pas connue, on monte quand même le corps avec le chemin d'origine plutôt qu'un écran vide :\n  // `readImgManifestCached` sait résoudre un lien tout seul, elle le faisait déjà avant ce composant.\n  const dejaConnu = eaglePathConnu(item?.contentPath)\n  const [resolved, setResolved] = useState(dejaConnu || null)\n  useEffect(() => {\n    let live = true\n    const connu = eaglePathConnu(item?.contentPath)\n    setResolved(connu || null)\n    if (connu) return () => { live = false }\n    resolveEaglePath(item?.contentPath).then((value) => { if (live) setResolved(value) })\n    return () => { live = false }\n  }, [item?.contentPath])\n  if (!item) return null\n  // La résolution n'est pas encore revenue : on affiche le corps AVEC le chemin d'origine plutôt\n  // qu'un vide. Pour une image ordinaire — l'immense majorité — c'est déjà le bon chemin, et le\n  // premier pixel arrive sans avoir rien attendu.\n  if (!resolved) return <QuickLookBody {...props} item={item} />\n  if (resolved.error) return <div style={{ position: 'fixed', inset: 0, zIndex: 9999, display: 'grid', placeItems: 'center', background: 'rgba(0,0,0,.82)', color: '#fff' }}>Lien média indisponible.</div>\n  return <QuickLookBody {...props} item={{ ...item, contentPath: resolved.path }} />\n}\nfunction navBtn(side) {\n  return { position: 'fixed', top: '50%', [side]: 24, transform: 'translateY(-50%)', background: 'rgba(255,255,255,0.14)', border: 'none', color: '#fff', width: 48, height: 48, borderRadius: 99, cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 201 }\n}\n\n\n// ═══ LE BOUTON DE TRI DU QUICK LOOK ═════════════════════════════════════════════════════════════\n//\n// UN SEUL ESPACE : un bouton, un clic, c'est fini. PLUSIEURS ESPACES : le clic vise le dernier tas\n// rempli (on continue le tri en cours, c'est le geste de la rafale) et un chevron ouvre la liste.\n// Deux formes plutôt qu'une seule générique, parce qu'un menu déroulant pour un unique choix est\n// un clic volé à chaque image, et que ce bouton sert précisément à aller vite.\n//\n// LE GARDE CONTRE LE DOUBLE ENVOI. Une image triée deux fois par un double-clic involontaire\n// créerait deux références dans le même tas, avec un nom dédoublonné, donc un doublon silencieux\n// qu'on ne remarque qu'au comptage. Le bouton se verrouille le temps du geste.\nexport function BoutonTri({ tri, item }) {\n  const [ouvert, setOuvert] = React.useState(false)\n  const [enCours, setEnCours] = React.useState(false)\n  const [fait, setFait] = React.useState(null)\n  const espaces = tri.espaces || []\n  const defaut = tri.defaut || espaces[espaces.length - 1]\n\n","exit_code":0,"duration":{"secs":0,"nanos":1000},"formatted_output":"import React, { useEffect, useState } from 'react'\nimport { PALETTE, RADII } from '../theme.js'\nimport Icon from './Icon.jsx'\nimport { readImgManifestCached, shardImgUrl, isEncrypted, resolveFullUrl, resolveThumbUrl, prefetchThumbImages, downloadMedia } from './ImageNodeViewer.jsx'\nimport { resolveDisplayUrl } from '../media/imageCacheIDB.js'\nimport { downloadUrls } from '../lib/archiveChunks.js'\nimport { assembleBlobUrl } from '../lib/fetchAsset.js'\nimport { mimeForName, isNativePreview, kindForName } from '../lib/fileKinds.js'\nimport { lazyRetry } from '../lib/lazyRetry.js'\nimport { readPageCached } from '../lib/manifestReadCache.js'\nimport { resolveEaglePath, eaglePathConnu } from '../lib/eagleLink.js'\nimport { mediaSourceSegments } from '../lib/mediaProvenance.js'\nimport { estTriable } from '../lib/dossiersDeTri.js'\nimport { registerRawMedia } from '../lib/vidStream.js'\nimport { loadChunked } from '../media/chunked.js'\nconst LazyLibPreview = lazyRetry(() => import('./LibFilePreview.jsx'))\nconst LazyVideoPlayer2 = lazyRetry(() => import('./VideoPlayer2.jsx'))\nconst LazyGmapsViewer = lazyRetry(() => import('./GmapsViewer.jsx')) // liens Google Maps intégrés (2026-07-04)\n\n// C211a — Quick Look plein écran façon macOS (geste signature Eagle). ESPACE ouvre, ←/→ navigue, Échap/Espace ferme, Enter ouvre en grand.\n// item = { name, contentPath, type }. onPrev/onNext naviguent dans la grille. onOpen ouvre réellement le nœud.\nconst enc = encodeURIComponent\nconst streamUrl = (p) => `/api/stream?path=${enc(p)}`\nconst rd = (p) => readPageCached(`/api/page?action=read&path=${enc(p)}`)\nconst firstImg = (md) => { const m = /!\\[[^\\]]*\\]\\(([^)]+)\\)/.exec(md || ''); return m ? m[1] : null }\n\n// ARCHIVE (.file.json) : reconstitution à la volée des chunks 19 Mo -> aperçu, comme la vue Downloads.\n// Résolution des URLs via archiveChunks.js (source unique) -> CORRIGE au passage un bug latent : l'ancien\n// code ici ne lisait que m.chunks et IGNORAIT parts[], donc un gros fichier v4 multi-shards ne s'aperçevait\n// pas. downloadUrls gère v2/v3/v4. Assemblage Blob borné (cap mémoire) via fetchAsset.\nconst FILE_PREVIEW_MAX = 500 * 1e6\n// MIME + catégorie déduits de l'EXTENSION via la SOURCE UNIQUE fileKinds.js (partagée avec l'upload). Les manifestes\n// blob-raw (ZenRayShards) portent parfois un mime générique (octet-stream/video/mp4) -> on fait toujours confiance\n// à l'extension pour l'aperçu. Garantit zéro divergence avec les futurs uploads.\nconst mimeFromName = (name) => { const m = mimeForName(name); return m === 'application/octet-stream' ? '' : m }\nconst effectiveMime = (m, name) => mimeFromName(name || m.name) || (m.mime && m.mime !== 'application/octet-stream' && m.mime !== 'video/mp4' ? m.mime : '')\n// Catégories à viewer LIB (décodeur dynamique lazy) — voir LibFilePreview.\nconst LIB_KINDS = new Set(['image-lib', 'doc-lib', 'sheet-lib', 'epub-lib', '3d-lib'])\n// Aperçu possible : natif (audio/vidéo/image/pdf/texte-code, zéro dépendance) OU lib (docx/xlsx/heic/epub/3D, lazy).\n// Exclus -> download seul : slides-lib (pptx, pas de lib fiable), archive (zip…), binary.\nconst filePreviewable = (name, mime, size) => (size == null || size <= FILE_PREVIEW_MAX) && (isNativePreview(name || '') || LIB_KINDS.has(kindForName(name || '')) || (!!mime && (/^(image|video|audio|text)\\//.test(mime) || mime === 'application/pdf')))\n// PROVENANCE RÉELLE de l'image affichée (2026-07-11, fix pastilles obsolètes) — pas un texte figé : dérivée\n//   du manifeste, donc toujours exacte, y compris pour les vieilles images jamais migrées.\n//   - non chiffrée (public, pas d'iv) : jsDelivr en clair, une seule source.\n//   - chiffrée + cdnChunks[] (schéma 2026-07-07+, TOUT nouvel upload) : jsDelivr chiffré pour la vignette\n//     ET l'original (découpé en morceaux ≤19 Mo) -> plus JAMAIS de raw.github, une seule pastille suffit.\n//   - chiffrée + cdnPath seul (ancien schéma, jamais migré, décision Matthieu) : la vignette reste jsDelivr,\n//     mais l'ORIGINAL passe par raw.github en premier (repli jsDelivr) -> deux sources réellement distinctes,\n//     deux pastilles.\n//   - privée/legacy (pas de vis, ou vis:'private') : proxy /api/shard (token serveur), jamais de CDN public.\n// Image en fondu simple (2026-07-13) : invisible tant qu'elle n'est pas décodée, puis fade-in 180 ms.\n// Remplace l'ancien duo flou + spinner (qui créait une saccade au passage vignette -> plein format).\n// `overlay` = se superpose à la vignette déjà affichée (le plein format arrive par-dessus, en douceur).\nfunction FadeImg({ src, alt, overlay = false }) {\n  const [ready, setReady] = useState(false)\n  // Image déjà décodée (cache navigateur / objectURL local) : `complete` est vrai dès le montage et\n  // onLoad peut ne jamais tirer -> sans cette garde l'image resterait invisible (opacity 0) à jamais.\n  const check = (el) => { if (el && el.complete && el.naturalWidth > 0) setReady(true) }\n  return (\n    <img ref={check} src={src} alt={alt} onLoad={() => setReady(true)}\n      style={{\n        width: '100%', height: '100%', display: 'block', objectFit: 'contain',\n        borderRadius: RADII.md, boxShadow: '0 20px 60px rgba(0,0,0,0.5)',\n        opacity: ready ? 1 : 0, transition: 'opacity 180ms ease',\n        ...(overlay ? { position: 'absolute', inset: 0 } : null),\n      }} />\n  )\n}\n\n// (2026-07-20) imageSourceSegments a été GÉNÉRALISÉE à tous les types de médias et déplacée dans\n// src/lib/mediaProvenance.js (mediaSourceSegments) -- couleurs canoniques vert jsDelivr / bleu\n// raw.github / jaune Vercel, spec Matthieu. L'ancienne implémentation locale (image seulement,\n// jsDelivr en bleu, legacy en violet) est remplacée, pas dupliquée.\n\nasync function assembleFileUrl(m, mime, onProg) {\n  // ZenRayShards blob-raw : parts[] = [{url,...}] (un blob direct par part) -> URLs directes, dans l'ordre.\n  // Archive v2/v3/v4 : downloadUrls(m) (chunks 19 Mo). Le mime passé prime (déduit de l'extension).\n  const urls = (m.type === 'blob-raw' && Array.isArray(m.parts) && m.parts.length && m.parts[0] && m.parts[0].url)\n    ? m.parts.map((p) => p.url)\n    : downloadUrls(m)\n  return assembleBlobUrl({ urls, mime: mime || m.mime || 'application/octet-stream', onProgress: onProg })\n}\n\nfunction QuickLookBody({ t, item, prefetchImagePaths = [], prettyName, onPrev, onNext, onClose, onOpen, tri }) {\n  const [page, setPage] = useState(null) // { img, md } pour un .md\n  const [file, setFile] = useState(null) // archive .file.json : { mime, url?, prog?, err?, unsupported?, tooBig?, text?, playErr? }\n  const [mediaMime, setMediaMime] = useState(null) // mime réel d'un .media.json (le nom du nœud n'a pas l'extension)\n  const [mediaManifest, setMediaManifest] = useState(null) // manifeste complet -> dispatch sur m.type (youtube vidéo/audio vs média chiffré local)\n  const [showSrc, setShowSrc] = useState(false) // badge de provenance (jsDelivr/…) : masqué par défaut (design minimaliste, 2026-07-12), dépliable au clic sur la pastille\n  // Hors-Vercel (2026-07-20) : un .media.json PUBLIC chiffré est enregistré auprès du SW range-shim\n  // (même pont que le lecteur vidéo/audio) -> l'aperçu QuickLook lit ses octets DIRECTEMENT depuis\n  // jsDelivr, déchiffrés côté client. mediaSwUrl=null tant que non résolu (ou manifeste privé/échec\n  // SW) -> repli /api/stream, l'aperçu n'est jamais cassé.\n  const [mediaSwUrl, setMediaSwUrl] = useState(null)\n  // PDF/HTML/texte (2026-07-21) : blob déchiffré CLIENT (loadChunked -> jsDelivr + AES-GCM), état\n  // générique { kind, url?, text?, err?, prog }. Deux bugs réels fermés ici : (1) l'ancien\n  // /api/stream échouait sur tout fichier > ~4 Mo (réponse Vercel plafonnée ~4,5 Mo) ; (2) le catch\n  // SILENCIEUX affichait \"Déchiffrement du PDF…\" à l'infini au lieu de l'erreur -- toute erreur est\n  // désormais montrée. Les .html (296 Ko de Matthieu) et textes ont enfin un aperçu ; les binaires\n  // sans viewer (fbx/hda/zip) affichent un message honnête au lieu d'un <video> cassé.\n  const [docPreview, setDocPreview] = useState(null)\n  useEffect(() => {\n    setMediaSwUrl(null)\n    const m = mediaManifest\n    if (!m || m.vis !== 'public' || !m.cdnRepo || !Array.isArray(m.parts) || !m.parts.length) return undefined\n    let live = true\n    registerRawMedia(m, item?.contentPath || '').then((u) => { if (live) setMediaSwUrl(u) }).catch(() => {})\n    return () => { live = false }\n  }, [mediaManifest]) // eslint-disable-line react-hooks/exhaustive-deps\n  useEffect(() => {\n    setDocPreview(null)\n    const m = mediaManifest\n    if (!m || !item?.contentPath) return undefined\n    const nm = m.name || ''\n    const mm = m.mime || ''\n    const kind = (mm === 'application/pdf' || /\\.pdf$/i.test(nm)) ? 'pdf'\n      : (mm === 'text/html' || /\\.html?$/i.test(nm)) ? 'html'\n      : (mm.startsWith('text/') || /\\.(md|txt|json|csv|js|jsx|ts|css|py|sh|xml|yml|yaml)$/i.test(nm)) ? 'text'\n      : null\n    if (!kind) return undefined\n    let live = true\n    let objUrl = null\n    setDocPreview({ kind, prog: 0 })\n    loadChunked(item.contentPath, (r) => { if (live) setDocPreview((prev) => prev && !prev.url && !prev.err ? { ...prev, prog: r } : prev) })\n      .then(async ({ url, blob }) => {\n        if (!live) { URL.revokeObjectURL(url); return }\n        objUrl = url\n        if (kind === 'text') {\n          const text = await blob.text()\n          if (live) setDocPreview({ kind, text: text.slice(0, 400000) })\n        } else {\n          setDocPreview({ kind, url })\n        }\n      })\n      .catch((e) => { if (live) setDocPreview({ kind, err: String(e?.message || e) }) })\n    return () => { live = false; if (objUrl) URL.revokeObjectURL(objUrl) }\n  }, [mediaManifest]) // eslint-disable-line react-hooks/exhaustive-deps\n\n  // Fenêtre glissante indépendante du scroll : 96 images avant + 96 après sont téléchargées et\n  // décodées en 1080p. À chaque flèche les URLs communes restent en cache ; seule la nouvelle\n  // bordure travaille. Le plein format reste réservé à l'image active.\n  const prefetchKey = prefetchImagePaths.join('|')\n  useEffect(() => {\n    if (!prefetchImagePaths.length) return\n    const ctrl = new AbortController()\n    // Laisser l'effet de l'image active démarrer son plein format avant les quatre workers voisins.\n    const id = setTimeout(() => prefetchThumbImages(prefetchImagePaths, ctrl.signal, 192).catch(() => {}), 60)\n    return () => { clearTimeout(id); ctrl.abort() }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [prefetchKey])\n\n  useEffect(() => {\n    let live = true\n    let revoke = null\n    setPage(null); setFile(null); setMediaMime(null); setMediaManifest(null); setShowSrc(false)\n    if (item && item.type === 'media' && item.contentPath) {\n      rd(item.contentPath).then((j) => { try { const m = JSON.parse(j.markdown); if (live) { setMediaMime(m.mime || ''); setMediaManifest(m) } } catch {} })\n    }\n    if (item && item.type === 'page' && item.contentPath) {\n      rd(item.contentPath).then((j) => { if (live && j && j.markdown != null) setPage({ img: firstImg(j.markdown), md: j.markdown }) })\n    } else if (item && item.type === 'image' && item.contentPath) {\n      // Instantané façon Eagle : manifest depuis le cache mémoire de la grille (zéro réseau si déjà vu),\n      // puis URL d'affichage depuis le cache persistant IndexedDB (objectURL local, pas de re-download à froid).\n      ;(async () => {\n        const m = await readImgManifestCached(item.contentPath)\n        if (!m) { if (live) setPage({ manifest: null, img: null }); return }\n        // CHIFFRÉ : AFFICHAGE PROGRESSIF (2026-07-11, fix lenteur perçue) — la vignette (petite, souvent déjà\n        //   déchiffrée par la grille avant l'appui sur Espace -> cache RAM hit quasi instantané) s'affiche\n        //   D'ABORD, floutée, pendant que l'ORIGINAL complet (potentiellement 8K/40 Mo, jamais recompressé —\n        //   décision Matthieu 2026-07-07, on ne réintroduit PAS de dérivé) se récupère + déchiffre en fond.\n        //   AVANT ce fix : rien ne s'affichait avant la fin du décryptage complet -> impression de lenteur sur\n        //   les gros originaux, alors que la vignette était déjà prête. `gotFull` évite qu'un thumb qui arrive\n        //   APRÈS le plein format (rare : plein déjà en cache) ne fasse régresser l'affichage en netteté.\n        if (isEncrypted(m)) {\n          let gotFull = false\n          resolveThumbUrl(m).then((tu) => { if (live && tu && !gotFull) setPage({ manifest: m, thumb: tu, img: null }) })\n          const u = await resolveFullUrl(m)\n          gotFull = true\n          if (live) setPage((prev) => ({ manifest: m, thumb: (prev && prev.thumb) || null, img: u || null }))\n          return\n        }\n        const url = shardImgUrl(m)\n        if (!url) { if (live) setPage({ manifest: m, img: null }); return }\n        const { src, revoke: rv } = await resolveDisplayUrl(url)\n        revoke = rv\n        if (live) setPage({ manifest: m, img: src })\n        else if (rv) rv()\n      })()\n    } else if (item && item.type === 'file' && item.contentPath) {\n      // Archive chunkée : lire le manifeste, reconstituer, prévisualiser selon le mime.\n      setFile({ prog: 0 })\n      ;(async () => {\n        const j = await rd(item.contentPath)\n        let m = null; try { m = JSON.parse(j.markdown) } catch {}\n        if (!m) { if (live) setFile({ err: true }); return }\n        const mime = effectiveMime(m, item.name) || m.mime || ''\n        if (!filePreviewable(item.name, mime, m.size)) { if (live) setFile({ mime, ...(m.size > FILE_PREVIEW_MAX ? { tooBig: true } : { unsupported: true }) }); return }\n        try {\n          const url = await assembleFileUrl(m, mime, (x) => { if (live) setFile((f) => (f && f.prog != null ? { ...f, prog: x } : f)) })\n          if (url.startsWith('blob:')) revoke = () => URL.revokeObjectURL(url)\n          const kind = kindForName(item.name)\n          // texte/code (py, cpp, md, json, yaml…) -> on lit le contenu pour l'afficher en <pre>.\n          const text = kind === 'text' ? await (await fetch(url)).text() : null\n          if (live) setFile({ mime, url, text, kind }); else if (revoke) revoke()\n        } catch { if (live) setFile({ mime, err: true }) }\n      })()\n    }\n    return () => { live = false; if (revoke) revoke() }\n  }, [item && item.contentPath])\n\n  useEffect(() => {\n    const h = (e) => {\n      if (e.key === 'Escape' || e.code === 'Space') { e.preventDefault(); onClose() }\n      else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); onNext() }\n      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); onPrev() }\n      else if (e.key === 'Enter') { e.preventDefault(); onOpen() }\n    }\n    window.addEventListener('keydown', h, true)\n    return () => window.removeEventListener('keydown', h, true)\n  }, [onPrev, onNext, onClose, onOpen])\n\n  if (!item) return null\n  const name = prettyName ? prettyName(item.name) : item.name\n  const type = item.type\n\n  let body\n  if (type === 'media') {\n    // LIEN YOUTUBE (vidéo OU audio — un seul champ, manifest.type==='youtube', distingué par audioOnly) :\n    // AUCUN binaire déchiffrable à /api/stream (le contenu vit sur YouTube), donc on NE PASSE PAS par le flux\n    // chiffré ci-dessous — on réutilise TEL QUEL le même lecteur que partout ailleurs dans l'app (VideoPlayer2,\n    // qui bascule lui-même entre le cadre vidéo 16:9 et le widget audio compact selon manifest.audioOnly).\n    // Bug trouvé le 2026-07-04 (Matthieu) : ce Quick Look ignorait ce type et retombait sur un <video>/<audio>\n    // natif pointé vers /api/stream, qui n'a rien à servir pour un lien externe -> lecteur bloqué à 0:00.\n    if (mediaManifest && mediaManifest.type === 'youtube' && mediaManifest.videoId) {\n      body = (\n        <div style={{ width: 'min(900px, 88vw)' }}>\n          <React.Suspense fallback={<div style={{ color: '#fff', opacity: 0.7 }}>chargement…</div>}>\n            <LazyVideoPlayer2 t={t} path={item.contentPath} manifest={mediaManifest} shared />\n          </React.Suspense>\n        </div>\n      )\n    } else if (mediaManifest && mediaManifest.type === 'gmaps' && mediaManifest.embedUrl) {\n      // LIEN GOOGLE MAPS (2026-07-04) : même logique que YouTube ci-dessus — aucun binaire à /api/stream, on\n      // réutilise le lecteur dédié (GmapsViewer) directement dans Quick Look.\n      body = (\n        <div style={{ width: 'min(900px, 88vw)' }}>\n          <React.Suspense fallback={<div style={{ color: '#fff', opacity: 0.7 }}>chargement…</div>}>\n            <LazyGmapsViewer t={t} path={item.contentPath} manifest={mediaManifest} shared />\n          </React.Suspense>\n        </div>\n      )\n    } else {\n      // .media.json chiffré. VOIE PRINCIPALE (2026-07-20, dépréciation du streaming Vercel) :\n      // public -> mediaSwUrl (SW range-shim, octets jsDelivr déchiffrés client) dès qu'il est résolu.\n      // REPLI : /api/stream (privé, SW indisponible, résolution encore en vol). Le PDF reste sur\n      // /api/stream volontairement : l'iframe du viewer PDF fait un GET plein-corps dont la\n      // sémantique n'est pas garantie par le range-shim -- choix conservateur, pas un oubli.\n      const nm = item.name || ''\n      const mm = mediaMime || ''\n      const mediaUrl = mediaSwUrl || (item.contentPath ? streamUrl(item.contentPath) : null)\n      const isAudioMedia = mm.startsWith('audio/') || /\\.(mp3|wav|m4a|flac|ogg|aac)$/i.test(nm)\n      const isVideoMedia = mm.startsWith('video/') || mediaManifest?.type === 'dash' || mediaManifest?.type === 'hls' || Array.isArray(mediaManifest?.ladder)\n      const waitBox = (label) => <div style={{ width: '82vw', height: '70vh', display: 'grid', placeItems: 'center', color: '#fff', opacity: .78, fontSize: 'var(--zr-ui-md)' }}>{label}</div>\n      body = docPreview\n        ? (docPreview.err\n            ? waitBox(`Aperçu indisponible : ${docPreview.err}`)\n            : docPreview.kind === 'pdf'\n              ? (docPreview.url ? <iframe title={name} src={docPreview.url} style={{ width: '82vw', height: '86vh', border: 'none', borderRadius: RADII.md, background: '#fff' }} /> : waitBox(`Déchiffrement… ${Math.round((docPreview.prog || 0) * 100)}%`