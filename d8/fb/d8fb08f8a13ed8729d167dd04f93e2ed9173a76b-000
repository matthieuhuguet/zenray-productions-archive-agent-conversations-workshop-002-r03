{"timestamp":"2026-08-30T17:50:33.010Z","ordinal":173,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a053cb-6232-7282-a447-3833f24e8247","call_id":"call_AjTsRAuuwRJAammK1U9N4rXv","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// Pages ZenRay (coeur type Notion) : CRUD de fichiers markdown dans un repo GitHub dedie = drive permanente.\n// Env Vercel : GITHUB_TOKEN (scope repo). CONTENT_REPO (defaut matthieuhuguet/zenray-data), CONTENT_BRANCH (main).\nimport { createHash } from 'node:crypto'\nimport { instrument } from './cmdlog.js'\nimport { isExposedTreeNode } from './nodeTreeFilter.js'\nimport { collectSubtreeBlobPaths } from './repoSubtree.js'\nimport { deplacerDansRegistre, deplacerPlusieurs } from './eagleRegistry.js'\nimport { authorizeShareAccess } from './share-token.js'\nimport { reserveEagleFolderTarget, reserveEagleLeafTarget } from './eagleBatch.js'\nconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\nconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n\n// Wrapper fetch brut sur le repo content. Instrumenté ci-dessous : chaque écriture (PUT/POST/DELETE)\n// est journalisée dans le Repo Commands log (les GET ne le sont pas).\nconst ghRaw = (token, path, init = {}) =>\n  fetch(`https://api.github.com/repos/${REPO}/${path}`, {\n    ...init,\n    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) },\n  })\nconst gh = instrument(ghRaw, {\n  repoOf: () => REPO,\n  pathOf: (args) => args[1],\n  initOf: (args) => args[2] || {},\n})\nconst b64e = (s) => Buffer.from(s, 'utf8').toString('base64')\nconst b64d = (s) => Buffer.from(s, 'base64').toString('utf8')\nconst EAGLE_LINK_TYPE = 'zenray-eagle-link/v1'\nconst EAGLE_FOLDER_LINK_TYPE = 'zenray-eagle-folder-link/v1'\nconst EAGLE_FOLDER_LINK_FILE = '.zreagle-folder.json'\nconst EAGLE_FOLDER_RESOURCE_FILE = '.zreagle-resource.json'\nconst EAGLE_RESOURCE_DIR = 'pages/.zr-resources'\nconst EAGLE_LINK_RE = /\\.(img|media|file|canvas|ref|embed|db)\\.json$/\nconst isEagleLink = (value) => !!(value && value.type === EAGLE_LINK_TYPE && typeof value.resourceId === 'string')\nconst resourcePathOf = (id) => `${EAGLE_RESOURCE_DIR}/${id}.json`\nconst resourceIdOf = () => `zr_${globalThis.crypto.randomUUID().replace(/-/g, '')}`\nconst jsonBlob = async (token, value) => {\n  const r = await gh(token, 'git/blobs', { method: 'POST', body: JSON.stringify({ content: b64e(JSON.stringify(value, null, 2)), encoding: 'base64' }) })\n  if (!r.ok) return null\n  return (await r.json()).sha\n}\n// ═══ UN CHEMIN SE NORMALISE EN NFC AVANT DE PARTIR SUR LE RÉSEAU (2026-08-31) ═══════════════════\n//\n// BUG RÉEL, mesuré : le même chemin rend 200 en forme COMPOSÉE et 404 en forme DÉCOMPOSÉE.\n//\n//   .../29%20Ao%C3%BBt%202026/…      -> 200\n//   .../29%20Aou%CC%82t%202026/…     -> 404\n//\n// macOS écrit les accents décomposés (« û » = « u » + accent combinant), GitHub les stocke composés.\n// Les deux s'affichent à l'identique et ne sont PAS la même chaîne d'octets, donc pas la même URL.\n// Un chemin passé par le système de fichiers du Mac, un presse-papier ou un glisser-déposer peut\n// arriver ici décomposé, et la lecture échoue alors sur un fichier qui existe pourtant.\n//\n// Ce que ça coûtait : « 0/13 lien(s) créé(s) » sur un dossier nommé « 29 Août 2026 », avec l'erreur\n// `invalid-source` — un manifeste déclaré illisible alors qu'il se lit parfaitement.\n//\n// La normalisation est SANS RISQUE : sur un chemin sans accent, NFC ne change rien.\nconst nfc = (p) => typeof p === 'string' ? p.normalize('NFC') : p\n\nconst rawJsonAt = async (token, path) => {\n  const chemin = nfc(path)\n  const parRaw = async () => {\n    try {\n      const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(chemin)}`, { cache: 'no-store', headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n      if (r.ok) return { lu: true, valeur: await r.json() }\n      return { lu: false, statut: r.status }\n    } catch { return { lu: false, statut: 0 } }\n  }\n  const parApi = async () => {\n    try {\n      const c = await gh(token, `contents/${encodeURI(chemin)}?ref=${BRANCH}`)\n      if (!c.ok) return { lu: false, statut: c.status }\n      const j = await c.json()\n      if (!j || typeof j.content !== 'string') return { lu: false, statut: 0 }\n      return { lu: true, valeur: JSON.parse(b64d(j.content)) }\n    } catch { return { lu: false, statut: 0 } }\n  }\n\n  // ═══ UN ÉCHEC DE LECTURE N'EST PAS UNE ABSENCE ═════════════════════════════════════════════════\n  //\n  // BUG RÉEL, deux fois de suite : « invalid-source » à 02h22, puis « missing-source » à 02h29, sur\n  // des fichiers dont la chaîne ENTIÈRE — lien, registre, source — se lisait en 200 par les deux\n  // voies quelques minutes plus tard. Le lot était annulé alors que rien ne manquait.\n  //\n  // MON PREMIER CORRECTIF ÉTAIT À MOITIÉ FAIT, et c'est ce qui a laissé le second incident passer :\n  // je ne repliais que sur un 404. Or `raw.githubusercontent.com` est un CDN qui rend aussi des 403\n  // quand il limite le débit, des 429, des 5xx quand il réplique. Tous ces cas retournaient `null`,\n  // et l'appelant en concluait « source absente » — un verdict définitif sur une panne passagère.\n  //\n  // TROIS VOIES, DANS CET ORDRE. Le chemin normal reste `raw` : gratuit, hors quota, servi par un\n  // CDN. Sur ÉCHEC, quel qu'il soit, on retente une fois après un court délai : la plupart des\n  // hoquets de réplication durent moins que ça. Si l'échec persiste, on lit par l'API `contents`,\n  // qui n'a pas de cache et voit l'arbre git directement.\n  //\n  // CE QUE ÇA NE MASQUE PAS : un fichier réellement absent rend 404 des trois côtés, et le verdict\n  // « absent » reste juste. Ce filet ne fabrique aucune donnée, il distingue seulement « n'existe\n  // pas » de « n'a pas pu être lu maintenant ».\n  //\n  // LE COÛT NE SE PAIE QUE SUR L'ÉCHEC. Le chemin qui marche coûte exactement ce qu'il coûtait.\n  let r = await parRaw()\n  if (r.lu) return r.valeur\n  if (r.statut !== 404) {\n    await sleep(180)\n    r = await parRaw()\n    if (r.lu) return r.valeur\n  }\n  const a = await parApi()\n  return a.lu ? a.valeur : null\n}\n// Resolve a logical directory through the nearest Eagle folder placement. The\n// marker points to a stable resourceId; the registry owns the movable sourceDir.\nasync function resolveEagleFolderDir(token, logicalDir) {\n  const segs = logicalDir.split('/')\n  for (let i = segs.length; i >= 2; i--) {\n    const root = segs.slice(0, i).join('/')\n    const marker = await rawJsonAt(token, `${root}/${EAGLE_FOLDER_LINK_FILE}`)\n    if (!marker || marker.type !== EAGLE_FOLDER_LINK_TYPE || typeof marker.resourceId !== 'string') continue\n    const registry = await rawJsonAt(token, resourcePathOf(marker.resourceId))\n    if (!registry || registry.resourceId !== marker.resourceId || typeof registry.sourceDir !== 'string') return { error: 'orphan-folder-link' }\n    const suffix = segs.slice(i).join('/')\n    return { logicalRoot: root, sourceRoot: registry.sourceDir, physicalDir: suffix ? `${registry.sourceDir}/${suffix}` : registry.sourceDir, resourceId: marker.resourceId }\n  return txt\n}\n\nexport default async function handler(req, res) {\n  const token = process.env.GITHUB_TOKEN\n  if (!token) return res.status(200).json({ error: 'no-token' })\n  res.setHeader('Cache-Control', 'no-store')\n\n  try {\n    if (req.method === 'GET') {\n      const action = (req.query.action || 'list').toString()\n      if (action === 'ratelimit') {\n        // Compteur de quota LIVE : l'endpoint GitHub /rate_limit NE CONSOMME PAS le quota REST -> gratuit à\n        // interroger. On renvoie le coeur (core) : restantes / plafond / heure de reset (epoch secondes).\n        const r = await fetch('https://api.github.com/rate_limit', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' } })\n        if (!r.ok) return res.status(200).json({ error: 'github' })\n        const j = await r.json()\n        const c = (j.resources && j.resources.core) || j.rate || {}\n        return res.status(200).json({ remaining: c.remaining, limit: c.limit, reset: c.reset })\n      }\n      if (action === 'list') {\n        const dir = (req.query.dir || 'pages').toString()\n        if (!['pages', 'databases', 'build'].includes(dir)) return res.status(400).json({ error: 'bad-dir' })\n        const ext = dir === 'pages' ? '.md' : '.json'\n        const r = await gh(token, `contents/${dir}?ref=${BRANCH}`)\n        if (r.status === 404) return res.status(200).json({ pages: [], items: [] })\n        if (!r.ok) return res.status(200).json({ pages: [], items: [], error: 'github', ...rlInfo(r) })\n        const arr = await r.json()\n        const items = (Array.isArray(arr) ? arr : []).filter((x) => x.type === 'file' && x.name.endsWith(ext) && x.name !== '.keep.md' && x.name !== '.keep')\n          .map((x) => ({ path: x.path, name: x.name.slice(0, -ext.length), sha: x.sha }))\n        return res.status(200).json({ pages: items, items })\n      }\n      // Enfants DIRECTS d'un dossier. FIX 1000 (2026-06-11) : l'API Contents PLAFONNE à 1000 entrées par dossier\n      // (limite GitHub dure, non paginable) -> les gros dossiers tronquaient et les vidéos (noms en fin de tri)\n      // disparaissaient. On passe par git/trees NON récursif sur le tree-ish `branche:chemin` : TOUTES les entrées\n      // du dossier (limite ~100k/dossier). Fallback Contents conservé si le tree-ish échoue.\n      if (action === 'children') {\n        const dir = (req.query.dir || 'pages').toString().replace(/\\/+$/, '')\n        // Memory (dossier LIVE, repo distinct, lecture seule) : arbre filesystem PLAT, aucun filtre\n        // d'extension (contrairement à NODE_RE ci-dessous, pensé pour les nœuds Notion de zenray-data) —\n        // Memory contient des fichiers de toute nature (.md/.py/.pdf/.json/sans extension…), tous affichés tels quels.\n        if (dir === 'Memory' || dir.startsWith('Memory/')) {\n          if (dir.includes('..')) return res.status(400).json({ error: 'bad-dir' })\n          const sub = dir === 'Memory' ? '' : dir.slice('Memory/'.length)\n          const cacheKey = 'children:' + dir\n          const cached = memoryCacheGet(cacheKey)\n          if (cached) return res.status(200).json({ entries: cached, complete: true, cached: true })\n          const rt = await ghMemory(token, `git/trees/${encodeURIComponent('main:' + sub)}`)\n          if (rt.status === 404) return res.status(200).json({ entries: [] })\n          if (!rt.ok) return res.status(200).json({ entries: [], error: 'github', ...rlInfo(rt) })\n          const jt = await rt.json()\n          const entries = (jt.tree || [])\n            .map((x) => ({ name: x.path, path: `${dir}/${x.path}`, type: x.type === 'tree' ? 'dir' : 'file' }))\n          memoryCacheSet(cacheKey, entries)\n          return res.status(200).json({ entries, complete: true, truncated: !!jt.truncated })\n        }\n        if (!/^(pages|build|databases)(\\/|$)/.test(dir) || dir.includes('..')) return res.status(400).json({ error: 'bad-dir' })\n        const folderResolution = await resolveEagleFolderDir(token, dir)\n        if (folderResolution.error) return res.status(200).json({ entries: [], error: folderResolution.error })\n        const physicalDir = folderResolution.physicalDir\n        const share = (req.query.share || '').toString()\n        if (share && physicalDir !== dir && !(await authorizeShareAccess(share, physicalDir))) return res.status(403).json({ entries: [], error: 'link-outside-share' })\n        // .plan.json ajouté le 2026-07-20 -- 4e occurrence de cette même liste trouvée dans ce fichier\n        // (la 1ère fois j'avais seulement corrigé INDEX_NODE_RE, en manquant celle-ci -- exactement le\n        // piège du commentaire de stripLeafExt (create/node.js) : sans elle, un plan.json restait invisible\n        // dans le Finder normal (action=children, navigation directe vers Create/Calendar), même une fois\n        // visible depuis l'index de recherche.\n        const NODE_RE = /\\.(md|db\\.json|media\\.json|img\\.json|canvas\\.json|ref\\.json|embed\\.json|file\\.json|plan\\.json)$/\n        const rt = await gh(token, `git/trees/${encodeURIComponent(BRANCH + ':' + physicalDir)}`)\n        if (rt.ok) {\n          const jt = await rt.json()\n          const entries = (jt.tree || [])\n            .filter((x) => x.path !== '.zr-resources' && (x.type === 'tree' || (x.type === 'blob' && NODE_RE.test(x.path))))\n            .map((x) => ({ name: x.path, path: `${dir}/${x.path}`, type: x.type === 'tree' ? 'dir' : 'file' }))\n          return res.status(200).json({ entries, complete: true, truncated: !!jt.truncated, ...(physicalDir !== dir ? { eagleSource: physicalDir } : {}) })\n        }\n        if (rt.status === 404) return res.status(200).json({ entries: [] })\n        const r = await gh(token, `contents/${encodeURI(physicalDir)}?ref=${BRANCH}`)\n        if (r.status === 404) return res.status(200).json({ entries: [] })\n        if (!r.ok) return res.status(200).json({ entries: [], error: 'github', ...rlInfo(r) })\n        const arr = await r.json()\n        const entries = (Array.isArray(arr) ? arr : [])\n          .filter((x) => x.name !== '.zr-resources' && (x.type === 'dir' || (x.type === 'file' && NODE_RE.test(x.name))))\n          .map((x) => ({ name: x.name, path: `${dir}/${x.name}`, type: x.type }))\n        return res.status(200).json({ entries })\n      }\n      if (action === 'tree') {\n        const dir = (req.query.dir || 'pages').toString()\n        const folderResolution = await resolveEagleFolderDir(token, dir)\n        if (folderResolution.error) return res.status(200).json({ paths: [], error: folderResolution.error })\n        const physicalDir = folderResolution.physicalDir\n        const share = (req.query.share || '').toString()\n        if (share && physicalDir !== dir && !(await authorizeShareAccess(share, physicalDir))) return res.status(403).json({ paths: [], error: 'link-outside-share' })\n\n        // UN DOSSIER PRÉCIS PREND SON PROPRE SOUS-ARBRE, jamais l'arbre entier du dépôt filtré après\n        // coup. Bug réel, payé le 2026-08-29 : un lien de partage sur `pages/Photos/DJI/29 Août 2026`\n        // rendait « Empty folder » alors que les 749 manifestes venaient d'être commités — la cause\n        // n'était pas ce dossier, elle était globale : `git/trees/${BRANCH}?recursive=1` est TRONQUÉ sur\n        // ce dépôt (mesuré le 2026-08-05, 44 015 entrées sur 135 588), et TOUT `pages/Photos/DJI`\n        // tombait après la coupure. Le partage d'un dossier, la vue `trash` (App.jsx, `dir=trash`) et\n        // tout futur appelant qui précise `dir` héritaient donc silencieusement du même risque.\n        //\n        // `dir === 'pages'` (la valeur par défaut, sans dossier précisé) garde l'ancien chemin en\n        // dessous : ces appels globaux savent déjà qu'ils sont best-effort et se complètent côté\n        // client par l'union avec l'index de recherche CDN, exhaustif lui (searchIndexClient.js).\n        // Changer cette moitié-là n'était pas demandé et n'aurait rien réparé de plus.\n        if (dir !== 'pages') {\n          const scoped = await scopedNodePathsUnder(token, physicalDir, isExposedTreeNode)\n          const paths = scoped.map((p) => dir + p.slice(physicalDir.length))\n          const body = JSON.stringify({ paths, truncated: false })\n          const etag = 'W/\"' + createHash('sha1').update(body).digest('base64url') + '\"'\n          res.setHeader('ETag', etag)\n          res.setHeader('Cache-Control', 'no-cache')\n          if (req.headers['if-none-match'] === etag) return res.status(304).end()\n          res.setHeader('Content-Type', 'application/json; charset=utf-8')\n          return res.status(200).send(body)\n        }\n\n        const r = await gh(token, `git/trees/${BRANCH}?recursive=1`)\n        if (!r.ok) { const rl = rlInfo(r); return res.status(200).json({ paths: [], ...(rl.rateLimited ? { error: 'github', ...rl } : {}) }) }\n        const j = await r.json()\n        // Phase 1 OS : exposer tous les types de nœuds (page/db/media/image/canvas/embed) + marqueurs de\n        // dossier (.zrfolder.json, .zrmusic.json). Prédicat testé dans server/nodeTreeFilter.js — voir ce\n        // fichier pour l'historique des deux régressions déjà trouvées ici (dossier vide 2026-07-12,\n        // routage Music 2026-07-16).\n        const paths = (j.tree || []).filter((x) => x.type === 'blob' && x.path.startsWith(physicalDir + '/') && isExposedTreeNode(x.path)).map((x) => dir + x.path.slice(physicalDir.length))\n\n        // ETAG, ET C'EST UN CORRECTIF DE FACTURE, PAS UNE OPTIMISATION DE CONFORT.\n        //\n        // Mesuré le 2026-07-30 : cette réponse pèse 3,02 Mo, et le client la redemande toutes les\n        // 25 secondes (App.jsx, `setInterval(loadPaths, 25000)`). Cela fait 435 Mo par heure de\n        // session, soit les 32,53 Go de « Fast Origin Transfer » qui ont fait dépasser le plan\n        // Vercel de 3,25 fois et bloqué tout déploiement pendant quatre jours.\n        //\n        // Le compteur touché est celui de l'ORIGINE, pas celui du CDN, parce qu'une réponse de\n        // fonction en `no-store` ne peut jamais être servie depuis le cache : chaque appel traverse\n        // l'origine intégralement. Un `Cache-Control: no-store` interdit même au navigateur de\n        // garder de quoi revalider, donc il ne peut pas envoyer `If-None-Match` et le 304 devient\n        // structurellement impossible. `no-cache` dit tout autre chose : garde-le, mais demande-moi\n        // avant de t'en servir. C'est exactement ce qu'il nous faut.\n        //\n        // L'appel à GitHub reste payé (il faut bien