même fonction servait déjà l'indexation d'un déplacement\n   141\t// (isNode = INDEX_NODE_RE) ; `action=tree&dir=…` en avait besoin aussi et faisait l'inverse — un seul\n   142\t// `git/trees/${BRANCH}?recursive=1` SANS BORNE, filtré après coup par préfixe. Sur ce dépôt, cet appel\n   143\t// est TRONQUÉ (mesuré le 2026-08-05, 44 015 entrées sur 135 588) et un dossier entier peut disparaître\n   144\t// sans un mot dès que ses fichiers tombent après la coupure. Bug réel, payé le 2026-08-29 sur un lien\n   145\t// de partage : `pages/Photos/DJI/29 Août 2026` rendait « Empty folder » alors que les 749 manifestes\n   640\t      }\n   641\t      // Resolve an Eagle placement once, before any viewer is chosen.  Links are\n   642\t      // flattened at creation, but the bounded loop also keeps old/corrupt data\n   643\t      // harmless instead of allowing a recursive viewer fetch.\n   644\t      if (action === 'resolve-link') {\n   645\t        const requested = (req.query.path || '').toString()\n   646\t        if (!safe(requested) || !EAGLE_LINK_RE.test(requested)) return res.status(400).json({ ok: false, error: 'bad-path' })\n   647\t        const fileResolution = await resolveEagleFilePath(token, requested)\n   648\t        if (fileResolution.error) return res.status(200).json({ ok: false, error: fileResolution.error })\n   649\t        let path = fileResolution.physicalPath\n   650\t        const share = (req.query.share || '').toString()\n   651\t        if (share && path !== requested && !(await authorizeShareAccess(share, path))) return res.status(200).json({ ok: false, error: 'link-outside-share' })\n   652\t        for (let depth = 0; depth < 4; depth++) {\n   653\t          const rr = await gh(token, `contents/${encodeURI(path)}?ref=${BRANCH}`)\n   654\t          if (!rr.ok) return res.status(200).json({ ok: false, error: 'missing' })\n   655\t          let manifest\n   656\t          try { manifest = JSON.parse(b64d((await rr.json()).content)) } catch { return res.status(200).json({ ok: false, error: 'invalid-manifest' }) }\n   657\t          if (!isEagleLink(manifest)) return res.status(200).json({ ok: true, path, linked: path !== requested })\n   658\t          const rp = resourcePathOf(manifest.resourceId)\n   659\t          const resourceR = await gh(token, `contents/${encodeURI(rp)}?ref=${BRANCH}`)\n   660\t          if (!resourceR.ok) return res.status(200).json({ ok: false, error: 'orphan-link', resourceId: manifest.resourceId })\n   661\t          let resource\n   662\t          try { resource = JSON.parse(b64d((await resourceR.json()).content)) } catch { return res.status(200).json({ ok: false, error: 'invalid-resource' }) }\n   663\t          if (!resource || resource.resourceId !== manifest.resourceId || !safe(resource.sourcePath)) return res.status(200).json({ ok: false, error: 'invalid-resource' })\n   664\t          // A public folder link never becomes a capability for a private target.\n   665\t          // The route gate has already authorised `requested`; this second check\n   666\t          // proves that the canonical resource remains in exactly that scope.\n   667\t          if (share && !(await authorizeShareAccess(share, resource.sourcePath))) return res.status(200).json({ ok: false, error: 'link-outside-share' })\n   668\t          path = resource.sourcePath\n   669\t        }\n   670\t        return res.status(200).json({ ok: false, error: 'link-cycle' })\n   671\t      }\n   672\t      if (action === 'eagle-locations') {\n   673\t        const requestedPath = (req.query.path || '').toString()\n   674\t        const requestedDir = (req.query.dir || '').toString().replace(/\\/+$/, '')\n   675\t        let resourceId = null\n  3020\t    if (e.r && e.p) return `/api/shard?repo=${encodeURIComponent(e.r)}&path=${encodeURIComponent(e.p)}`\n  3021\t    return undefined\n  3022\t  }\n  3023\t  // IV de la vignette chiffrée pour ce résultat de recherche (présent uniquement pour les vignettes publiques\n  3024\t  //   chiffrées). undefined sinon -> ImgNodeThumb traite thumbUrl comme du clair direct (inchangé).\n  3025\t  const thumbIvFor = (p) => { const e = searchThumbs && searchThumbs[p]; return (e && e.iv) || undefined }\n  3026\t  const searchEntries = useMemo(() => (\n  3027\t    !qDebounced ? [] : (filtered || []).map((p) => { const type = typeOfPath(p); return { name: stripLeafExt(p).split('/').pop(), contentPath: p, hasKids: false, dir: stripLeafExt(p), type, isDb: type === 'db', isMedia: type === 'media', isImage: type === 'image', isCanvas: type === 'canvas', isEmbed: type === 'embed', thumbUrl: type === 'image' ? thumbUrlFor(p) : undefined, thumbIv: type === 'image' ? thumbIvFor(p) : undefined } })\n  3028\t  ), [filtered, qDebounced, searchThumbs])\n  3029\t  // ═══ LA GRILLE RELIT SES MANIFESTES, ET C'EST CE QUI REND L'APERÇU INSTANTANÉ ═════════════════\n  3030\t  //\n  3031\t  // J'avais posé ici un `entreesAvecVignette` qui donnait à chaque tuile une `thumbUrl` tirée de\n  3032\t  // l'index, pour éviter qu'elle lise son manifeste. L'intention était bonne, l'effet était l'inverse.\n  3033\t  //\n  3034\t  // CE QUE ÇA A COÛTÉ, mesuré le 2026-08-31 : `ImgNodeThumb` ne lit le manifeste QUE s'il n'a pas\n  3035\t  // d'URL directe (`const useManif = !hasDirect`). En lui en fournissant une, la grille cessait de\n  3036\t  // remplir le cache des manifestes — et le Quick Look, qui s'appuyait dessus pour s'ouvrir sans\n  3037\t  // réseau, devait alors payer un aller-retour de 150 à 250 ms par image. Un parcours à la flèche\n  3038\t  // devenait inutilisable.\n  3039\t  //\n  3040\t  // Le coût n'était pas supprimé, il était DÉPLACÉ de la grille (où il est parallèle et invisible)\n  3041\t  // vers l'aperçu (où il est en série et bloquant). Les vignettes des liens, elles, n'ont jamais eu\n  3042\t  // besoin de ce raccourci : `readImgManifestCached` résout un lien toute seule.\n  3043\t  const entreesAvecVignette = dirEntries || []\n  3044\t\n  3045\t  // ═══ UNE PROP RECRÉÉE À CHAQUE RENDU REND UN COMPOSANT LOURD INUTILISABLE ═════════════════════\n  3046\t  //\n  3047\t  // RÉGRESSION SIGNALÉE le 2026-08-31 à 02h45 : « input lag énorme de une à deux secondes lorsque\n  3048\t  // j'appuie sur espace, et pareil sur flèche gauche ou droite ». Le Quick Look sert précisément à\n  3049\t  // parcourir des images vite.\n  3050\t  //\n   315\t// have been cached as `null` (missing) BEFORE copyNode wrote it -> permanently grey tile). Remove\n   316\t// the offending entry to allow a clean re-fetch. Preferred over a global clear (which would throw\n   317\t// away hundreds of valid manifests and trigger a fetch burst -> rate-limit risk).\n   318\texport function invalidateManifest(path) { if (path) _cache.delete(path) }\n   319\t\n   320\t// Manifest read that REUSES the in-memory cache populated by grid thumbnails.\n   321\t// QuickLook (Space) must be instant: if the grid already displayed this node, its .img.json is\n   322\t// already in _cache -> zero network round-trip. Otherwise read + cache for next time.\n   323\texport async function readImgManifestCached(path) {\n   324\t  if (_cache.has(path)) return _cache.get(path)\n   325\t  try {\n   326\t    let m = await readImgManifest(path)\n   327\t    // Grid thumbnails also resolve placements. Keep the cache under the placement\n   328\t    // path so an Eagle image appears instantly without a second manifest route.\n   329\t    if (m && m.type === 'zenray-eagle-link/v1') {\n   330\t      const r = await fetch(`/api/page?action=resolve-link&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((x) => x.json())\n   331\t      if (!r?.ok || !r.path || r.path === path) return null\n   332\t      m = await readImgManifestCached(r.path)\n   333\t    }\n   334\t    _cache.set(path, m); return m\n   335\t  } catch { return null } // failure: not cached, will retry\n   336\t}\n   337\t\n   338\t// BOUNDED manifest read queue: without it, showing N search results fires N SIMULTANEOUS .img.json\n   339\t// fetches -> burst -> rate-limit -> slow thumbnails. Cap in-flight reads at MANIFEST_CONC; the rest wait.\n   340\tconst MANIFEST_CONC = 6\n   510\t// E (thumbnail from the v2 index): if `thumbUrl` is provided (thumbnail URL precomputed by the\n   511\t// search index), use it DIRECTLY as the source -> ZERO .img.json manifest fetch. The FULL image\n   512\t// (for QuickLook/hover) is then resolved LAZILY on hover only (manifest read on demand), not on\n   513\t// mount. If `thumbUrl` is absent -> current behavior unchanged (lazy manifest read gated on viewport).\n   514\texport function ImgNodeThumb({ path, thumbUrl, thumbIv, size = 54, radius = 7, priority = false, onProvenance }) {\n   515\t  const ref = React.useRef(null)\n   516\t  const hasDirect = !!thumbUrl\n   517\t  // The Finder icon grid uses large slots (typically 70px+); its images should look like Finder/Eagle\n   518\t  // thumbnails, respecting landscape/portrait geometry. Small list/dock icons intentionally stay square\n   519\t  // so their surrounding rows never change shape.\n   520\t  const preserveAspect = size >= 56\n   521\t  const inView = useInView(ref)\n   522\t  // RENAME = \"missing\" media (grey thumbnail): the v2 index hands a direct URL that points at the\n   523\t  //   OLD path (delta.json not propagated yet) -> the CDN .webp 404s. directFailed then switches to\n   524\t  //   the live manifest (/api, no-store, authoritative, immediate) = correct thumbnail right away,\n   525\t  //   without waiting ~5 min of CDN cache. Reset when the (path, thumbUrl) pair changes.\n   526\t  const [directFailed, setDirectFailed] = React.useState(false)\n   527\t  React.useEffect(() => { setDirectFailed(false) }, [path, thumbUrl])\n   528\t  const useManif = !hasDirect || directFailed\n   529\t  // Only read the manifest when there is NO usable direct URL (otherwise zero network for the thumbnail).\n   530\t  const m = useManifest(path, useManif && (inView || _c