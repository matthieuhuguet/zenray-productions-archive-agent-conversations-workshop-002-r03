ed.map((p) => dir + p.slice(physicalDir.length))\n          const body = JSON.stringify({ paths, truncated: false })\n          const etag = 'W/\"' + createHash('sha1').update(body).digest('base64url') + '\"'\n          res.setHeader('ETag', etag)\n          res.setHeader('Cache-Control', 'no-cache')\n          if (req.headers['if-none-match'] === etag) return res.status(304).end()\n          res.setHeader('Content-Type', 'application/json; charset=utf-8')\n          return res.status(200).send(body)\n        }\n\n        const r = await gh(token, `git/trees/${BRANCH}?recursive=1`)\n        if (!r.ok) { const rl = rlInfo(r); return res.status(200).json({ paths: [], ...(rl.rateLimited ? { error: 'github', ...rl } : {}) }) }\n        const j = await r.json()\n        // Phase 1 OS : exposer tous les types de nœuds (page/db/media/image/canvas/embed) + marqueurs de\n        // dossier (.zrfolder.json, .zrmusic.json). Prédicat testé dans server/nodeTreeFilter.js — voir ce\n        // fichier pour l'historique des deux régressions déjà trouvées ici (dossier vide 2026-07-12,\n        // routage Music 2026-07-16).\n        const paths = (j.tree || []).filter((x) => x.type === 'blob' && x.path.startsWith(physicalDir + '/') && isExposedTreeNode(x.path)).map((x) => dir + x.path.slice(physicalDir.length))\n\n        // ETAG, ET C'EST UN CORRECTIF DE FACTURE, PAS UNE OPTIMISATION DE CONFORT.\n        //\n        // Mesuré le 2026-07-30 : cette réponse pèse 3,02 Mo, et le client la redemande toutes les\n        // 25 secondes (App.jsx, `setInterval(loadPaths, 25000)`). Cela fait 435 Mo par heure de\n        // session, soit les 32,53 Go de « Fast Origin Transfer » qui ont fait dépasser le plan\n        // Vercel de 3,25 fois et bloqué tout déploiement pendant quatre jours.\n        //\n        // Le compteur touché est celui de l'ORIGINE, pas celui du CDN, parce qu'une réponse de\n        // fonction en `no-store` ne peut jamais être servie depuis le cache : chaque appel traverse