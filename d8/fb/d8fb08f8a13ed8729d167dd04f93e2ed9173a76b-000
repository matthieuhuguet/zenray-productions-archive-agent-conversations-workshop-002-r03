rn { physicalDir: logicalDir }\n}\nasync function resolveEagleFilePath(token, logicalPath) {\n  const slash = logicalPath.lastIndexOf('/')\n  if (slash < 0) return { physicalPath: logicalPath }\n  const folder = await resolveEagleFolderDir(token, logicalPath.slice(0, slash))\n  if (folder.error) return folder\n  return {\n    ...folder,\n    physicalPath: `${folder.physicalDir}/${logicalPath.slice(slash + 1)}`,\n  }\n}\n\n// .plan.json (ZenRay Plan, 2026-07-20) ajouté ici -- même piège que server/nodeTreeFilter.js : un noeud\n// absent de cette regex reste invisible à l'indexation, même s'il existe bel et bien sur GitHub.\nconst INDEX_NODE_RE = /\\.(md|db\\.json|media\\.json|img\\.json|canvas\\.json|ref\\.json|embed\\.json|file\\.json|plan\\.json)$/\n\n// UN DOSSIER PRÉCIS SE LIT PAR SON PROPRE SOUS-ARBRE, jamais par l'arbre entier du dépôt filtré\n// ensuite. Généralisé le 2026-08-29 : la même fonction servait déjà l'indexation d'un déplacement\n// (isNode = INDEX_NODE_RE) ; `action=tree&dir=…` en avait besoin aussi et faisait l'inverse — un seul\n// `git/trees/${BRANCH}?recursive=1` SANS BORNE, filtré après coup par préfixe. Sur ce dépôt, cet appel\n// est TRONQUÉ (mesuré le 2026-08-05, 44 015 entrées sur 135 588) et un dossier entier peut disparaître\n// sans un mot dès que ses fichiers tombent après la coupure. Bug réel, payé le 2026-08-29 sur un lien\n// de partage : `pages/Photos/DJI/29 Août 2026` rendait « Empty folder » alors que les 749 manifestes\n// étaient bien commités, parce que TOUT le sous-arbre `pages/Photos/DJI` tombait après la troncature.\n//\n// Le prédicat est un paramètre et non figé sur INDEX_NODE_RE, pour que l'appelant décide ce qui compte\n// comme nœud visible : l'indexation d'un déplacement ignore les marqueurs de dossier vide\n// (.zrfolder.json) à dessein, alors que `action=tree` doit les garder (`isExposedTreeNode`), sans quoi\n// un dossier vide fraîchement créé redeviendrait invisible — exactement la régression du 2026-07-12\n// que