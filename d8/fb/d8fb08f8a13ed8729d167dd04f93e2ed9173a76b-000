é d'API, rien à téléverser sur le drive.\n    // Récupérées via la recherche d'images du site puis converties en AVIF CRF 25, le réglage\n    // validé de Matthieu.\n    visuels: ['/goals/witcher.avif', '/goals/exp33.avif'],\n  },\n  {\n    cle: 'japonais', nom: 'Japonais',\n    pourquoi: 'C’est ton multiplicateur Japon : amitiés, culture, réseau, dating, travail, sentiment d’appartenance. Gros bottleneck actuel.',\n    veut: ['Hideo Kojima', 'Miyazaki', 'Ichiban'],\n    visuels: ['/goals/kojima.avif', '/goals/miyazaki.avif', { src: '/goals/ichiban.avif', cadrage: '36% center' }],\n  },\n  {\n    cle: 'sport', nom: 'Sport',\n    pourquoi: 'Infrastructure biologique. Énergie, santé, physique, confiance. Important mais il n’a pas besoin de monopoliser ta journée.',\n    veut: ['Geralt', 'Cloud'],\n    visuels: [{ src: '/goals/geralt.avif', cadrage: 'center 18%' }, '/goals/cloud.avif'],\n  },\n  {\n    cle: 'love', nom: 'Japan in love',\n    pourquoi: 'À poursuivre activement, mais pas à mettre au centre du système, parce que le résultat dépend aussi d’une autre personne.',\n    veut: ['Kasumi', 'Hikari'],\n    visuels: ['/goals/kasumi.avif', '/goals/hikari.avif'],\n  },\n]\n\n// Retire les guillemets que porte souvent le texte sélectionné, de tous types (« », \" \", “ ”).\n// Au DISPLAY seulement : le fichier garde ce qui a été enregistré, on ne réécrit rien rétroactivement.\nconst sansGuillemets = (txt) => String(txt || '').replace(/^[\\s«\"“”']+|[\\s»\"“”']+$/g, '')\n\n// GRADIENT BLEU-VERT DES TITRES D'AXE (2026-08-12, remplace le rouge éditorial sur retour de\n// Matthieu). Une seule chaîne, réutilisée pour l'axe actif ET les autres — le DÉLAVÉ de l'inactif\n// n'est plus une couleur différente (l'ancien `color-mix` sur un hex) mais la MÊME image de fond à\n// opacité réduite : un dégradé n'a pas d'équivalent `color-mix`, l'opacité est le seul levier qui\n// l'éclaircit sans le désaturer bizarrement.\nconst GRADIENT_AXE = 'linear-gradient(120deg, #2f6fed 0%, #22c98a 100%)'\n\nexport default function GoalsView({ t }) {\n  const [data, setData] = React.useState(null)      // null = pas encore lu\n  const [actif, setActif] = React.useState(AXES[0].cle)\n  const shaRef = React.useRef(null)\n\n  React.useEffect(() => {\n    let vivant = true\n    readJson(GOALS_PATH).then(({ data: lu, sha }) => {\n      if (!vivant) return\n      shaRef.current = sha\n      setData(lu && typeof lu === 'object' ? lu : { v: 1, quotes: [], images: {} })\n    }).catch(() => { if (vivant) setData({ v: 1, quotes: [], images: {} }) })\n    return () => { vivant = false }\n  }, [])\n\n  // Une citation ajoutée AILLEURS (clic droit dans un Markdown) doit apparaître ici sans recharger.\n  // Même convention événementielle que le reste du dépôt (`zr:create-music`, `zr:page-float`).\n  React.useEffect(() => {\n    const surAjout = () => {\n      readJson(GOALS_PATH).then(({ data: lu, sha }) => { shaRef.current = sha; if (lu) setData(lu) }).catch(() => {})\n    }\n    window.addEventListener('zr:goals-changed', surAjout)\n    return () => window.removeEventListener('zr:goals-changed', surAjout)\n  }, [])\n\n  const retirerCitation = async (id) => {\n    const suivant = { ...data, quotes: (data.quotes || []).filter((q) => q.id !== id) }\n    setData(suivant)   // optimiste : le geste répond tout de suite, l'écriture suit\n    const res = await saveJsonWithRetry(GOALS_PATH, (cur) => ({ ...(cur || {}), v: 1, quotes: (cur?.quotes || []).filter((q) => q.id !== id) }), { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n    else notify({ kind: 'error', label: 'Goals', title: 'Suppression non enregistrée', body: 'La citation revient au prochain chargement.' })\n  }\n\n  const axeActif = AXES.find((a) => a.cle === actif) || AXES[0]\n  const citations = (data?.quotes || [])\n  // Les visuels EMBARQUÉS (`public/goals/`) d'abord ; `goals.json` peut les surcharger plus tard\n  // sans toucher au code, quand Matthieu voudra ses propres images pour un axe.\n  const visuelsActifs = (data?.images && data.images[actif]) || axeActif.visuels || []\n  // Le nombre de volets SUIT le nombre d'images, il n'est jamais figé à trois : deux jaquettes\n  // découpent le cadre en deux, trois en trois. Un axe sans image garde deux emplacements, pour\n  // que la composition tienne malgré tout au premier rendu.\n  const nbVolets = Math.max(2, visuelsActifs.length || axeActif.veut.length || 2)\n\n  return (\n    <div style={{ maxWidth: 1180, margin: '0 auto', padding: 'clamp(28px, 4vw, 44px) 0 clamp(40px, 5vw, 56px)', fontFamily: \"var(--zr-police-sans)\" }}>\n\n      {/* ─── HAUT : le sélecteur à gauche, les images à droite ───────────────────────────────\n          `minmax(0, …)` sur les deux colonnes : sans lui, un titre long pousse la grille au-delà de\n          son conteneur au lieu de se replier (piège de grille déjà payé ailleurs dans ce dépôt). */}\n      <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1fr)', gap: 'clamp(20px, 3vw, 44px)', alignItems: 'start', minHeight: 340 }}>\n\n        <div>\n\n          {AXES.map((axe) => {\n            const estActif = axe.cle === actif\n            return (\n              <button key={axe.cle} type=\"button\" onClick={() => setActif(axe.cle)}\n                aria-pressed={estActif}\n                style={{\n                  display: 'block', width: '100%', textAlign: 'left', padding: '9px 0',\n                  border: 0, background: 'transparent', cursor: 'pointer',\n                  // BLACK (900, correction du 2026-08-12 : Matthieu revient sur le Semibold, va au\n                  // poids maximal de la fonte variable AnthropicSans) et une piste desserrée\n                  // (-.015em au lieu de -.038em) : demande explicite de Matthieu, « plus d'espace »\n                  // dans la police autant qu'entre les lignes.\n                  font: `900 clamp(28px, 3.6vw, 50px)/1.2 var(--zr-police-titre)`,\n                  letterSpacing: '-.015em', textTransform: 'uppercase',\n                  backgroundImage: GRADIENT_AXE, WebkitBackgroundClip: 'text', backgroundClip: 'text',\n                  color: 'transparent', WebkitTextFillColor: 'transparent',\n                  opacity: estActif ? 1 : 0.3,\n                  transition: 'opacity .18s ease',\n                }}>\n                {axe.nom}\n              </button>\n            )\n          })}\n        </div>\n\n        {/* IMAGES · UN SEUL CADRE 16:9, découpé par un slash. Montage à la Photoshop : le\n            séparateur fait ZÉRO pixel, les volets se touchent, aucun filet.\n            `clip-path` plutôt que des conteneurs voisins : c'est le seul moyen d'obtenir une arête\n            oblique NETTE et PARTAGÉE. Les polygones voisins réutilisent EXACTEMENT les mêmes\n            abscisses, ce qui garantit le zéro pixel — un demi-point d'écart laisserait un liseré de\n            fond visible entre deux volets.\n\n            CHAQUE IMAGE EST CENTRÉE SUR SA PROPRE TRANCHE (correction du 2026-08-11). Avant, le\n            fond couvrait tout le cadre et je le décalais à la main (38/50/58 %) : une valeur\n            devinée, et surtout un cadrage calculé sur le rectangle ENTIER, donc jamais sur la\n            tranche réellement visible. Désormais chaque volet porte un enfant dimensionné à la\n            BOÎTE de sa tranche (obliques comprises), et l'image y est en `cover` centrée. C'est\n            exactement « tu prends une ligne, tu la divises en N, tu redivises chaque part en deux »\n            : le milieu de chaque part devient le centre de son image. */}\n        <div style={{\n          position: 'relative', width: '100%', aspectRatio: '16 / 9',\n          borderRadius: 4, overflow: 'hidden',\n          background: t.cardBg, border: visuelsActifs.length ? 'none' : `1px solid ${t.border}`,\n          boxShadow: visuelsActifs.length ? '0 22px 50px -22px rgba(0,0,0,.5)' : 'none',\n        }}>\n          {Array.from({ length: nbVolets }).map((_, i) => {\n            // Un visuel est soit un chemin, soit `{ src, cadrage }` quand son sujet n'est pas au\n            // centre de l'image — le cadrage est alors la `background-position` de CE volet.\n            // Ajouté le 2026-08-11 : le visage de Geralt était coupé en haut, celui d'Ichiban sur\n            // le côté ; un `center center` uniforme ne pouvait pas les rattraper tous les deux.\n            const brut = visuelsActifs[i] || null\n            const src = typeof brut === 'string' ? brut : (brut && brut.src) || null\n            const cadrage = (brut && brut.cadrage) || 'center center'\n            const P = 7                        // pente du slash, en % de la largeur\n            const pas = 100 / nbVolets\n            const g = pas * i                  // frontière gauche, à mi-hauteur\n            const d = pas * (i + 1)            // frontière droite, à mi-hauteur\n            // Les volets extrêmes vont au bord du cadre ; seules les frontières INTERNES penchent.\n            const hg = i === 0 ? 0 : g + P                 // haut-gauche\n            const bg = i === 0 ? 0 : g - P                 // bas-gauche\n            const hd = i === nbVolets - 1 ? 100 : d + P    // haut-droit\n            const bd = i === nbVolets - 1 ? 100 : d - P    // bas-droit\n            // Boîte englobante de la tranche : le polygone penche, donc son enveloppe déborde des\n            // frontières à mi-hauteur de la pente, des deux côtés.\n            const bLeft = Math.min(hg, bg)\n            const bRight = Math.max(hd, bd)\n            return (\n              <div key={i} style={{\n                position: 'absolute', inset: 0,\n                clipPath: `polygon(${hg}% 0, ${hd}% 0, ${bd}% 100%, ${bg}% 100%)`,\n                display: 'grid', placeItems: 'center',\n              }}>\n                {src ? (\n                  <div style={{\n                    position: 'absolute', top: 0, bottom: 0,\n                    left: `${bLeft}%`, width: `${bRight - bLeft}%`,\n                    background: `url(${src}) ${cadrage} / cover no-repeat`,\n                  }} />\n                ) : (\n                  <span style={{ font: `400 11px/1.4 var(--zr-police-sans)`, color: t.textSecondary, textAlign: 'center', padding: 10 }}>\n                    {axeActif.veut[i] || ''}\n                  </span>\n                )}\n              </div>\n            )\n          })}\n        </div>\n      </div>\n\n      {/* ─── BAS : le descriptif de l'axe choisi, puis les citations ─────────────────────────── */}\n      <div style={{ marginTop: 'clamp(32px, 4vw, 56px)', borderTop: `1px solid ${t.border}`, paddingTop: 26 }}>\n\n        {/* LE DESCRIPTIF, en h3 : c'est le titre de niveau du bloc bas, pas un paragraphe\n            courant. Medium (500), le plafond de graisse du projet — la levée du « jamais de gras »\n            vaut pour les TITRES d'axes en haut, pas pour ce texte-ci. */}\n        <h3 style={{\n          margin: '0 0 26px', maxWidth: '58ch',\n          font: `500 clamp(14px, 1.35vw, 17px)/1.5 var(--zr-police-sans)`, color: t.textPrimary,\n        }}>{axeActif.pourquoi}</h3>\n\n        {/* LA SECTION CITATIONS EXISTE, MAIS NE S'ANNONCE PAS (2026-08-11, « tu n'écris pas\n            citations »). Une citation se reconnaît sans étiquette ; le libellé, le compteur et la\n            source datée ont été retirés dans le même mouvement de dépouillement. */}\n        {data === null ? (\n          <p style={{ font: `400 13px/1.5 var(--zr-police-sans)`, color: t.textSecondary, margin: 0 }}>lecture…</p>\n        ) : citations.length === 0 ? (\n          // L'état vide DIT le geste : sans lui, la fonctionnalité existe sans que rien ne l'annonce.\n          <p style={{ font: `400 13px/1.6 var(--zr-police-sans)`, color: t.textSecondary, margin: 0, maxWidth: '60ch' }}>\n            Sélectionne du texte dans une page Markdown, clic droit, « Envoyer vers Goals ».\n          </p>\n        ) : (\n          <div style={{ display: 'grid', gap: 14 }}>\n            {citations.map((q) => (\n              <div key={q.id} style={{ display: 'flex', alignItems: 'flex-start', gap: 14 }}>\n                {/* Serif gris, 16 px, regular : la citation se lit, elle ne crie pas. Les guillemets\n                    ne sont PAS rajoutés — le texte sélectionné les porte souvent déjà, et les\n                    doubler donnait « « … » ». `sansGuillemets` nettoie aussi l'existant, sans\n                    toucher au fichier : ce qui est enregistré reste tel quel. */}\n                <blockquote style={{\n                  margin: 0, minWidth: 0, flex: 1,\n                  font: `400 16px/1.5 var(--zr-police-serif)`, color: t.textSecondary,\n                }}>\n                  {sansGuillemets(q.text)}\n                </blockquote>\n                <button type=\"button\" title=\"Retirer cette citation\" aria-label=\"Retirer cette citation\"\n                  onClick={() => retirerCitation(q.id)}\n                  style={{\n                    flexShrink: 0, width: 26, height: 26, display: 'grid', placeItems: 'center',\n                    border: 0, borderRadius: 999, background: 'transparent', color: t.textSecondary, cursor: 'pointer',\n                  }}>\n                  <Icon name=\"xmark\" size={12} />\n                </button>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n\n// AJOUT D'UNE CITATION, appelé depuis le menu contextuel de Create (sélection de texte dans un\n// Markdown). Exporté ici plutôt qu'écrit dans App.jsx : le CHEMIN et la FORME d'une citation\n// appartiennent à cette vue, et les dupliquer ailleurs créerait la seconde source de vérité que ce\n// dépôt paie déjà cher quand elle apparaît.\nexport async function ajouterCitation(texte, source) {\n  const propre = String(texte || '').replace(/\\s+/g, ' ').trim()\n  if (!propre) return false\n  const citation = {\n    id: `q-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,\n    text: propre, source: source || null, addedAt: new Date().toISOString(),\n  }\n  // `saveJsonWithRetry` sans `sha` connu : il lit l'état frais lui-même, puis ré-applique la mutation\n  // sur conflit. C'est exactement le cas ici — l'appelant (un menu contextuel) n'a jamais lu le\n  // fichier, et deux ajouts rapprochés ne doivent pas s'écraser.\n  const res = await saveJsonWithRetry(GOALS_PATH, (cur) => ({\n    ...(cur || {}), v: 1, quotes: [...((cur && cur.quotes) || []), citation],\n  }))\n  if (res.ok) {\n    window.dispatchEvent(new CustomEvent('zr:goals-changed'))\n    notify({ label: 'Goals', title: 'Citation ajoutée', body: propre.length > 70 ? `${propre.slice(0, 70)}…` : propre })\n    return true\n  }\n  notify({ kind: 'error', label: 'Goals', title: 'Citation non enregistrée', body: String(res.error || 'échec de sauvegarde') })\n  return false\n}\n"},"started_at_ms":1788112090173,"completed_at_ms":1788112090180}}
