urn { lu: true, valeur: JSON.parse(b64d(j.content)) }\n    } catch { return { lu: false, statut: 0 } }\n  }\n\n  // ═══ UN ÉCHEC DE LECTURE N'EST PAS UNE ABSENCE ═════════════════════════════════════════════════\n  //\n  // BUG RÉEL, deux fois de suite : « invalid-source » à 02h22, puis « missing-source » à 02h29, sur\n  // des fichiers dont la chaîne ENTIÈRE — lien, registre, source — se lisait en 200 par les deux\n  // voies quelques minutes plus tard. Le lot était annulé alors que rien ne manquait.\n  //\n  // MON PREMIER CORRECTIF ÉTAIT À MOITIÉ FAIT, et c'est ce qui a laissé le second incident passer :\n  // je ne repliais que sur un 404. Or `raw.githubusercontent.com` est un CDN qui rend aussi des 403\n  // quand il limite le débit, des 429, des 5xx quand il réplique. Tous ces cas retournaient `null`,\n  // et l'appelant en concluait « source absente » — un verdict définitif sur une panne passagère.\n  //\n  // TROIS VOIES, DANS CET ORDRE. Le chemin normal reste `raw` : gratuit, hors quota, servi par un\n  // CDN. Sur ÉCHEC, quel qu'il soit, on retente une fois après un court délai : la plupart des\n  // hoquets de réplication durent moins que ça. Si l'échec persiste, on lit par l'API `contents`,\n  // qui n'a pas de cache et voit l'arbre git directement.\n  //\n  // CE QUE ÇA NE MASQUE PAS : un fichier réellement absent rend 404 des trois côtés, et le verdict\n  // « absent » reste juste. Ce filet ne fabrique aucune donnée, il distingue seulement « n'existe\n  // pas » de « n'a pas pu être lu maintenant ».\n  //\n  // LE COÛT NE SE PAIE QUE SUR L'ÉCHEC. Le chemin qui marche coûte exactement ce qu'il coûtait.\n  let r = await parRaw()\n  if (r.lu) return r.valeur\n  if (r.statut !== 404) {\n    await sleep(180)\n    r = await parRaw()\n    if (r.lu) return r.valeur\n  }\n  const a = await parApi()\n  return a.lu ? a.valeur : null\n}\n// Resolve a logical directory through the nearest Eagle folder placement. The\n// marker points to a stable resourceId; the reg