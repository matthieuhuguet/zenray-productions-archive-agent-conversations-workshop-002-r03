se(await r.text()); idx = g.__zrIndex = { at: Date.now(), v: parsed.v || 1, paths: parsed.paths || [], builtAt: parsed.builtAt || null, thumbs: (parsed.thumbs && typeof parsed.thumbs === 'object') ? parsed.thumbs : {}, content: (parsed.content && typeof parsed.content === 'object') ? parsed.content : {} } }\n          catch { return res.status(200).json({ paths: [], builtAt: null, source: 'index-parse-error' }) }\n        }\n        // search-6 : mode TÊTE (head=1) -> renvoie seulement builtAt+count (quelques octets), pas les\n        // ~11-28 Mo de paths+thumbs. Le client l'appelle en rafraîchissement opportuniste : il ne re-tire\n        // le corps complet que si builtAt a changé. Premier chargement = appel complet (sans head).\n        if (req.query.head) return res.status(200).json({ v: idx.v || 1, builtAt: idx.builtAt || null, count: idx.paths.length })\n        return res.status(200).json({ v: idx.v || 1, paths: idx.paths, thumbs: idx.thumbs || {}, content: idx.content || {}, builtAt: idx.builtAt || null, count: idx.paths.length })\n      }\n      if (action === 'read') {\n        const requestedPath = (req.query.path || '').toString()\n        // Memory : lecture SEULE, toujours via raw.githubusercontent (repo privé mais accepté avec le\n        // Bearer token, testé le 2026-07-16 — HORS quota REST comme le mode raw=1 ci-dessous). Jamais de\n        // sha renvoyé : ce chemin n'a pas de pendant save/delete/move, une édition n'a aucun sens ici.\n        if (requestedPath === 'Memory' || requestedPath.startsWith('Memory/')) {\n          if (requestedPath.includes('..')) return res.status(400).json({ error: 'bad-path' })\n          const sub = requestedPath.slice('Memory/'.length)\n          try {\n            const rr = await fetch(`https://raw.githubusercontent.com/${MEMORY_REPO}/main/${encodeURI(sub)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n            if (rr.status === 404) return res.status(200).json({ markd