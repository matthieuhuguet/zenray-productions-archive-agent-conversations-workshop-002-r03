tent-type': 'application/json' }, body: JSON.stringify({ action: 'delete', path: src, sha: r.sha }) }) } }\n  1566\t  const restore = async (p) => { setStatus('restauration…'); for (const src of variants(p)) await move(src, 'pages/' + src.replace(/^trash\\//, ''), true); setStatus('restaurée ✓'); load() }\n  1567\t  // Suppression DÉFINITIVE. Pour un média, on lit le descripteur depuis trash/ pour récupérer `dir` puis on purge\n  1568\t  // les parts media/<id>/NNN.bin AVANT le descripteur (l'action delete serveur fait déjà cette purge sur un .media.json).\n  1569\t  const purge = async (p) => {\n  1570\t    if (!window.confirm('Supprimer définitivement ? (irréversible — pour un média, les fichiers binaires sont aussi supprimés)')) return\n  1571\t    setStatus('suppression…')\n  1572\t    for (const src of variants(p)) {\n  1573\t      const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(src)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n  1574\t      if (r && r.sha && !r.missing) await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'delete', path: src, sha: r.sha }) })\n  1575\t    }\n  1576\t    setStatus(''); load()\n  1577\t  }\n  1578\t  const trashLabel = (p) => p.replace(/^trash\\//, '').replace(/\\.(db|media|img)\\.json$/, '').replace(/\\.md$/, '')\n  1579\t  const trashKind = (p) => { const ty = typeOfPath(p); return ty === 'image' ? 'image' : ty === 'media' ? 'média' : ty === 'db' ? 'base' : 'page' }\n  1580\t  return (\n  1581\t    <>\n  1582\t      <SectionLabel t={t} color={t.textSecondary} nomargin>Trash <span style={{ fontFamily: FONTS.mono, fontSize: 10, opacity: 0.6 }}>· {paths ? paths.length : 0} · {status}</span></SectionLabel>\n  1583\t      <div style={{ marginTop: 14, display: 'grid', gap: 6 }}>\n  1584\t        {paths === null && <div style={{ color: t.textSecondary }}>chargement…</div>}\n  1585\t        {paths && paths.length === 0 &&