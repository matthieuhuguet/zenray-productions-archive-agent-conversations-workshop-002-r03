gify(manifest), sha: rr.sha || undefined }),\n   107\t    })\n   108\t  } catch { /* progression best-effort */ }\n   109\t}\n   110\t\n   111\t// Réécrit le placeholder en MANIFEST FINAL mse-av (remplace transcoding:true). pushToShard a déjà\n   112\t// écrit le manifest au CHEMIN CANONIQUE (dest/<base>.mp4.media.json) ; on écrase ICI le nœud placeholder\n   113\t// d'origine (celui visible dans le Finder) avec le même contenu, pour que la vidéo devienne lisible\n   114\t// SUR PLACE sans changer son chemin.\n   115\tasync function finalizePlaceholder(nodePath, manifest) {\n   116\t  try {\n   117\t    const rr = await fetch(`${API}/api/page?action=read&path=${encodeURIComponent(nodePath)}`).then((x) => x.json())\n   118\t    await fetch(`${API}/api/page`, {\n   119\t      method: 'POST', headers: { 'content-type': 'application/json' },\n   120\t      body: JSON.stringify({ action: 'save', path: nodePath, markdown: JSON.stringify(manifest, null, 2), sha: rr.sha || undefined }),\n   121\t    })\n   122\t  } catch (e) { log('finalize placeholder échec (le manifest canonique reste écrit):', String(e.message || e).slice(0, 120)) }\n   123\t}\n   124\t\n   125\t// Télécharge la SOURCE brute depuis le shard privé (chunks media/<id>/NNN.bin) et la reconstitue dans\n   126\t// un fichier temporaire. C'est le cas DRAG-DROP WEB : le front a uploadé la source chunkée et a noté\n   127\t// source:{repo,dir,parts}. /api/shard sert chaque chunk binaire (repo privé via token serveur).\n   128\tconst TMP_IN = path.join(os.tmpdir(), 'zr_mse', 'in')\n   129\tasync function downloadShardSource(src, name, log = () => {}) {\n   130\t  if (!src || !/^zenray-media-\\d{2,}$/.test(String(src.repo || '')) || !src.dir || !Array.isArray(src.parts) || !src.parts.length) return null\n   131\t  if (String(src.dir).includes('..')) return null\n   132\t  await mkdir(TMP_IN, { recursive: true })\n   133\t  const outPath = path.join(TMP_IN, `${Date.now().toString(36)}_${path.basename(name || 'source