IONS_DEST/\" 2>>\"$LOG\"\n\n# Les transcripts peuvent contenir des secrets colles dans une session.\n# On nettoie les patterns GitHub les plus courants dans le backup, jamais dans la source.\nredact_sensitive_tokens\n\n# Générer l'index README\n{\n  echo \"# conversations\"\n  echo \"\"\n  echo \"Backup automatique des conversations Claude Code. Mis à jour toutes les 30 secondes si du nouveau contenu est détecté.\"\n  echo \"\"\n  echo \"Dernière mise à jour : $TIMESTAMP\"\n  echo \"\"\n  echo \"## Projets\"\n  echo \"\"\n  for project_dir in \"$CONVERSATIONS_DEST\"/*/; do\n    [[ -d \"$project_dir\" ]] || continue\n    project=\"$(basename \"$project_dir\")\"\n    count=\"$(find \"$project_dir\" -name \"*.jsonl\" | wc -l | tr -d ' ')\"\n    echo \"- \\`$project\\` — $count sessions\"\n  done\n  echo \"\"\n  echo \"## Format\"\n  echo \"\"\n  echo \"Chaque fichier \\`.jsonl\\` est une session Claude Code : une ligne = un événement (message utilisateur, réponse Claude, appel d'outil, résultat outil).\"\n} > \"$CONVERSATIONS_DEST/README.md\"\n\n# Commit + push si changement\ngit add \"$CONVERSATIONS_DEST\"\nif git diff --cached --quiet; then\n  log \"rien à commiter\"\nelse\n  git commit -m \"backup conversations $TIMESTAMP\" --quiet\n  git pull --rebase --autostash --quiet origin main 2>>\"$LOG\" || {\n    log \"ERROR: pull/rebase post-commit impossible\"\n    git rebase --abort 2>/dev/null || true\n    exit 1\n  }\n  if git push --quiet origin main 2>>\"$LOG\"; then\n    log \"pushé vers GitHub\"\n  else\n    log \"ERROR: push GitHub refuse\"\n    exit 1\n  fi\nfi\n\nlog \"--- backup terminé ---\"\n"}}
