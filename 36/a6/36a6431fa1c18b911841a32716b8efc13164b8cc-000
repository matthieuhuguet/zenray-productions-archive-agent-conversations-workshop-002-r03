tatus(400).json({ error: 'bad-action' })\n    95\t  }\n    96\t  try {\n    97\t    // tous les repos du compte (paginé), on garde ceux du drive ZenRay\n    98\t    const repos = []\n    99\t    for (let page = 1; page <= 5; page++) {\n   100\t      const r = await gh(token, `user/repos?per_page=100&page=${page}&affiliation=owner`)\n   101\t      if (!r.ok) break\n   102\t      const arr = await r.json()\n   103\t      if (!Array.isArray(arr) || !arr.length) break\n   104\t      for (const x of arr) repos.push(x)\n   105\t      if (arr.length < 100) break\n   106\t    }\n   107\t    const drive = repos\n   108\t      .filter((x) => /^(zenray-content|zenray-progress|zenray-media-\\d+)$/.test(x.name) || x.name === 'zenray-content' || x.name === 'ZenRayProgress')\n   109\t      .map((x) => ({ name: x.name, private: !!x.private, sizeMB: +((x.size || 0) / 1024).toFixed(1), limitMB: LIMIT_MB, pct: Math.min(100, Math.round(((x.size || 0) / 1024) / LIMIT_MB * 100)), kind: /media-\\d+$/.test(x.name) ? 'media' : (x.name === 'zenray-content' ? 'content' : 'app') }))\n   110\t      .sort((a, b) => a.name.localeCompare(b.name))\n   111\t    const totalMB = +drive.reduce((n, r) => n + r.sizeMB, 0).toFixed(1)\n   112\t    return res.status(200).json({ ok: true, owner: OWNER, limitMB: LIMIT_MB, totalMB, repos: drive })\n   113\t  } catch (e) { return res.status(200).json({ error: 'fetch' }) }\n   114\t}\n"}}
