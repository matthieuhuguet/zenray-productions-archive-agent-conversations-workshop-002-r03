\t    }\n   117\t  }\n   118\t  walk(0, buf.length, (type, start, cs, ce) => {\n   119\t    if (type === 'moov') walk(cs, ce, (t2, s2, c2, e2) => { if (t2 === 'trak') walk(c2, e2, (t3, s3, c3, e3) => { if (t3 === 'mdia') walk(c3, e3, (t4, s4, c4) => { if (t4 === 'mdhd') { const ver = buf[c4]; timescale = ver === 1 ? buf.readUInt32BE(c4 + 4 + 8 + 8) : buf.readUInt32BE(c4 + 4 + 4 + 4) } }) }) })\n   120\t    else if (type === 'moof') { let dt = 0; walk(cs, ce, (t2, s2, c2, e2) => { if (t2 === 'traf') walk(c2, e2, (t3, s3, c3) => { if (t3 === 'tfdt') { const ver = buf[c3]; dt = ver === 1 ? Number(buf.readBigUInt64BE(c3 + 4)) : buf.readUInt32BE(c3 + 4) } }) }); frags.push({ b: start, dt }) }\n   121\t  })\n   122\t  const ts = timescale || 1\n   123\t  return frags.map((f) => ({ t: +(f.dt / ts).toFixed(3), b: f.b }))\n   124\t}\n   125\t\n   126\tasync function chunkStream(file, outDir, dirRel, sub, codecType) {\n   127\t  const buf = await readFile(file)\n   128\t  const fragIndex = fragIndexOf(buf)\n   129\t  const count = Math.ceil(buf.length / CHUNK)\n   130\t  const subDirRel = `${dirRel}/${sub}`\n   131\t  const subDirAbs = path.join(outDir, sub)\n   132\t  await mkdir(subDirAbs, { recursive: true })\n   133\t  const parts = []\n   134\t  for (let i = 0; i < count; i++) {\n   135\t    parts.push(pad(i))\n   136\t    await writeFile(path.join(subDirAbs, `${pad(i)}.bin`), buf.subarray(i * CHUNK, Math.min((i + 1) * CHUNK, buf.length)))\n   137\t  }\n   138\t  return { dir: subDirRel, parts, size: buf.length, count, codec: codecOf(file, codecType), fragIndex, files: parts.map((pt) => `${sub}/${pt}.bin`) }\n   139\t}\n   140\t\n   141\tasync function transcodeOne(file) {\n   142\t  const base = path.basename(file).replace(/\\.[^.]+$/, '')\n   143\t  const id = newId()\n   144\t  const outDir = path.join(WORK, 'out', id)\n   145\t  await mkdir(outDir, { recursive: true })\n   146\t  const p = probe(file)\n   147\t  console.log(`\\n${base} — ${p.duration.toFixed(0)}s, ${