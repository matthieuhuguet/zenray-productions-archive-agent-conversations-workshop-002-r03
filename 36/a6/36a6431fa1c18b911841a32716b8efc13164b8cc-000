 /api/shard?repo=zenray-media-NN&path=ab/cd/<hash>.m4s.\n    23\t//   Du coup hls.js (ou Safari) fetch chaque segment directement par cette URL : aucun serveur de\n    24\t//   segments dédié n'est nécessaire, /api/shard sert déjà les binaires privés.\n    25\t//\n    26\t// CONTRAINTES DURES respectées : shards PRIVÉS ; jamais de token committé ; gros repo via Git Data API\n    27\t// (blobs + base_tree + commit + ref force:false), JAMAIS de clone ; sharding profond ab/cd/<hash> LIBRE\n    28\t// ici (les segments ne passent pas par /api/stream, contrairement au MSE qui était bridé).\n    29\t\n    30\timport { readFile, writeFile, mkdir, readdir, stat } from 'node:fs/promises'\n    31\timport { createHash, randomBytes } from 'node:crypto'\n    32\timport path from 'node:path'\n    33\timport {\n    34\t  probe, extractSubs, ffmpegProgress, pushBlobs, activeShard, LANG_LABEL,\n    35\t} from './video-mse-lib.mjs'\n    36\t\n    37\tconst noop = () => {}\n    38\tconst newId = () => `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 9)}`\n    39\tconst sha256 = (buf) => createHash('sha256').update(buf).digest('hex')\n    40\tconst SHARD_RE = /^zenray-media-\\d{2,}$/\n    41\tconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\n    42\t// Repo PUBLIC dédié aux segments chiffrés (servis par jsDelivr). C'est le SEUL repo public du système.\n    43\tconst PUBLIC_MEDIA_REPO = process.env.PUBLIC_MEDIA_REPO || 'zenray-media-public'\n    44\tconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\n    45\t\n    46\t// Appel GitHub authentifié (helper minimal local, jumeau de ghAbs d'upload-shard.js).\n    47\tfunction gh(token, apiPath, init = {}) {\n    48\t  return fetch(`https://api.github.com/${apiPath}`, {\n    49\t    ...init,\n    50\t    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) },\n    51\t  })\n    52\t}\n    53\t\n    54\t// Garantit l'existence du repo PUBLIC zenray-media-public (private:false, auto_init), prêt à recevoir des\n    55\t// commits Git Data API (sa branche main doit porter au moins un commit). Idempotent : 422 = déjà créé.\n    56\tasync function ensurePublicRepo(token, name, log = noop) {\n    57\t  const probeRepo = await gh(token, `repos/${OWNER}/${name}`)\n    58\t  if (probeRepo.ok) return true\n    59\t  log(`  repo public ${OWNER}/${name} absent -> création...`)\n    60\t  const cr = await gh(token, 'user/repos', {\n    61\t    method: 'POST',\n    62\t    body: JSON.stringify({ name, private: false, auto_init: true, description: 'ZenRay media — segments HLS CHIFFRÉS (AES-128), servis via jsDelivr. Clés AES jamais ici (repo privé).' }),\n    63\t  })\n    64\t  if (!cr.ok && cr.status !== 422) throw new Error(`create public repo -> ${cr.status} ${(await cr.text()).slice(0, 200)}`)\n    65\t  // auto_init crée la branche main de façon asynchrone : on attend qu'elle porte un commit.\n    66\t  for (let i = 0; i < 12; i++) {\n    67\t    const rr = await gh(token, `repos/${OWNER}/${name}/git/ref/heads/main`)\n    68\t    if (rr.ok) return true\n    69\t    await sleep(1500)\n    70\t  }\n    71\t  throw new Error(`public repo ${name} pas prêt (branche main absente après attente)`)\n    72\t}\n    73\tconst HLS_TIME = 4 // secondes par segment (≈1-2 Mo à CRF 21 1080p, sous la limite confortable d'un blob GitHub)\n    74\t// Placeholder d'URI de clé écrit par ffmpeg dans les EXT-X-KEY au moment de l'encodage. On le réécrit\n    75\t// ensuite (dans pushHls) vers l'URL réelle /api/hls-key?v=<base> une fois le base name connu/encodé.\n    76\tconst KEY_URI_PLACEHOLDER = 'ZR_HLS_KEY_URI'\n    77\t// Nom du fichier clé dans le repo PRIVÉ (doit matcher server/hls-key.js KEY_FILE).\n    78\tconst KEY_FILE = '.hlskey.bin'\n    79\t\n    80\t// --- chemin shard profond ab/cd/<hash>.<ext> (jumeau de shardPathFor de universalCapture.js) -----\n    81\tfunction shardPathFor(hash, ext) {\n    82\t  return `${hash.slice(0, 2)}/${hash.slice(2, 4)}/${hash}.${ext}`\n    83\t}\n    84\t\n    85\t// --- TRANSCODE COMPLET D'UNE VIDÉO EN HLS -----------------------------------\n    86\t// Produit en local master.m3u8 + stream_*.m3u8 + init_*.mp4 + seg_*.m4s + sub_*.vtt, SANS rien pousser.\n    87\t// Renvoie l'objet `result` que pushHls() consomme. Options :\n    88\t//   { workDir, crf='21', sampleSec=null, log, onProgress(stage, pct) }\n    89\texport async function transcodeHls(file, opts = {}) {\n    90\t  const log = opts.log || noop\n    91\t  const onProgress = opts.onProgress || noop\n    92\t  const crf = String(opts.crf || '21')\n    93\t  const sampleSec = opts.sampleSec != null ? Number(opts.sampleSec) : null\n    94\t  const work = opts.workDir || '/tmp/zr_hls'\n    95\t\n    96\t  const base = path.basename(file).replace(/\\.[^.]+$/, '')\n    97\t  const id = newId()\n    98\t  const outDir = path.join(work, 'out', id)\n    99\t  await mkdir(outDir, { recursive: true })\n   100\t\n   101\t  const p = probe(file)\n   102\t  log(`${base} — ${p.duration.toFixed(0)}s, ${p.audio.length} audio, ${p.subs.length} sous-titres${sampleSec ? ` [échantillon ${sampleSec}s]` : ''}`)\n   103\t  if (!p.video.length) throw new Error('aucune piste vidéo')\n   104\t\n   105\t  const tlim = sampleSec ? ['-t', String(sampleSec)] : []\n   106\t  const outDuration = sampleSec ? Math.min(p.duration || sampleSec, sampleSec) : p.duration\n   107\t  const nAudio = p.audio.length\n   108\t\n   109\t  // 0) CHIFFREMENT AES-128 : on génère une clé aléatoire 16 octets + un IV 16 octets PROPRES à cette vidéo.\n   110\t  //    ffmpeg chiffre TOUS les segments avec cette clé (HLS EXT-X-KEY METHOD=AES-128). Le « key info file »\n   111\t  //    est un fichier texte 3 lignes que ffmpeg lit :\n   112\t  //      ligne 1 = l'URI écrite TELLE QUELLE dans la playlist (on met un placeholder, réécrit ensuite) ;\n   113\t  //      ligne 2 = le CHEMIN LOCAL du fichier de clé (ffmpeg le lit pour chiffrer, il ne le publie pas) ;\n   114\t  //      ligne 3 = l'IV en hexadécimal.\n   115\t  //    La clé brute (key.bin) part PLUS TARD dans le repo PRIVÉ (jamais public, jamais sur le CDN).\n   116\t  const aesKey = randomBytes(16)\n   117\t  const aesIv = randomBytes(16)\n   118\t  const keyFile = path.join(outDir, 'enc.key')         // clé brute, locale (ffmpeg la lit pour chiffrer)\n   119\t  const keyInfoFile = path.join(outDir, 'enc.keyinfo') // le « mode d'emploi » 3 lignes pour ffmpeg\n   120\t  await writeFile(keyFile, aesKey)\n   121\t  await writeFile(keyInfoFile, `${KEY_URI_PLACEHOLDER}\\n${keyFile}\\n${aesIv.toString('hex')}\\n`, 'utf8')\n   122\t\n   123\t  // 1) Construire les -map et le -var_stream_map dynamiquement (1 vidéo + N audios).\n   124\t  //    -g 48 = un keyframe toutes les ~2 s, aligne les segments sur -hls_time 4 (segments décodables).\n   125\t  const maps = ['-map', '0:v:0']\n   126\t  const varParts = ['v:0,agroup:aud,name:video']\n   127\t  for (let i = 0; i < nAudio; i++) {\n   128\t    const a = p.audio[i]\n   129\t    const lang = a.tags?.language || 'und'\n   130\t    maps.push('-map', `0:a:${i}`)\n   131\t    varParts.push(`a:${i},agroup:aud,language:${lang},name:a${i}${i === 0 ? ',default:yes' : ''}`)\n   132\t  }\n   133\t  const varStreamMap = varParts.join(' ')\n   134\t\n   135\t  // FORMAT DE SEGMENT = MPEG-TS (.ts), PAS fMP4. POURQUOI : ffmpeg 8.1.1 NE SAIT PAS chiffrer en AES-128\n   136\t  // des segments fMP4 (« Not yet implemented in FFmpeg, patches welcome » -> l'encodage échoue à 0 packet).\n   137\t  // Le chiffrement AES-128 standard HLS ne fonctionne qu'avec mpegts dans cette version. Le .ts est lu\n   138\t  // NATIVEMENT par Safari et par hls.js (qui déchiffre la clé AES tout seul), donc zéro perte de compat.\n   139\t  // Conséquence : plus d'init segment séparé (l'info de décodage est dans chaque .ts), donc pas d'EXT-X-MAP.\n   140\t  log(`  transcode HLS MPEG-TS chiffré AES-128 (1 vidéo + ${nAudio} audio, -hls_time ${HLS_TIME}, -g 48)...`)\n   141\t  const ffArgs = [\n   142\t    '-y', '-i', file, ...tlim,\n   143\t    ...maps,\n   144\t    '-c:v', 'libx264', '-preset', 'fast', '-crf', crf, '-pix_fmt', 'yuv420p',\n   145\t    '-g', '48', '-keyint_min', '48', '-sc_threshold', '0',\n   146\t    '-c:a', 'aac', '-ac', '2', '-b:a', '160k',\n   147\t    '-f', 'hls',\n   148\t    '-hls_time', String(HLS_TIME),\n   149\t    '-hls_playlist_type', 'vod',\n   150\t    '-hls_segment_type', 'mpegts',\n   151\t    '-hls_key_info_file', keyInfoFile, // chiffre TOUS les segments en AES-128 + écrit les EXT-X-KEY\n   152\t    '-hls_segment_filename', path.join(outDir, 'seg_%v_%03d.ts'),\n   153\t    '-master_pl_name', 'master.m3u8',\n   154\t    '-var_stream_map', varStreamMap,\n   155\t    path.join(outDir, 'stream_%v.m3u8'),\n   156\t  ]\n   157\t  await ffmpegProgress(ffArgs, outDuration, (pct) => onProgress('video', pct))\n   158\t\n   159\t  // 2) sous-titres -> VTT monolithique (extractSubs de video-mse-lib, réutilisé tel quel).\n   160\t  //    DÉCISION (RISQUE 4 du design) : VTT monolithique + playlist subs générée À LA MAIN (1 segment =\n   161\t  //    durée totale). La segmentation VTT native de ffmpeg en mode HLS est capricieuse ; cette voie est\n   162\t  //    plus simple et robuste, et lue partout (Safari natif + hls.js).\n   163\t  const subsRaw = await extractSubs(file, p, outDir, log)\n   164\t  log(`  ${subsRaw.length} sous-titre(s) VTT${subsRaw.length ? ': ' + subsRaw.map((s) => s.label).join(', ') : ''}`)\n   165\t\n   166\t  // 3) Inventaire des fichiers produits par ffmpeg dans outDir.\n   167\t  //    NB : avec -var_stream_map, ffmpeg utilise le `name:` (ex video/a0/a1) comme jeton %v, PAS un index\n   168\t  //    numérique. Donc les fichiers sont init_video.mp4, seg_a0_000.m4s, stream_a1.m3u8, etc. Les regexes\n   169\t  //    doivent matcher un jeton alphanumérique, pas \\d+.\n   170\t  const all = await readdir(outDir)\n   171\t  const segments = all.filter((f) => /\\.ts$/.test(f))\n   172\t  const inits = [] // mpegts : pas d'init segment séparé (l'init est embarqué dans chaque .ts)\n   173\t  const mediaPlaylists = all.filter((f) => /^stream_.+\\.m3u8$/.test(f))\n   174\t  if (!all.includes('master.m3u8')) throw new Error('ffmpeg HLS: master.m3u8 absent')\n   175\t  log(`  produit: master.m3u8 + ${mediaPlaylists.length} media playlists, ${segments.length} segments chiffrés`)\n   176\t\n   177\t  // métadonnées audio (info UI ; la vérité opérationnelle reste hls.audioTracks côté lecteur)\n   178\t  const audioMeta = p.audio.map((a, i) => {\n   179\t    const lang = a.tags?.language || 'und'\n   180\t    return { lang, label: (a.tags?.title) || LANG_LABEL[lang] || lang, default: i === 0 }\n   181\t  })\n   182\t  const subMeta = subsRaw.map((s) => ({ lang: s.lang, label: s.label }))\n   183\t\n   184\t  return {\n   185\t    id, base, outDir, outDuration, nAudio,\n   186\t    segments, inits, mediaPlaylists, subsRaw,\n   187\t    audioMeta, subMeta,\n   188\t    aesKey, aesIv, // clé AES-128 (16 octets) + IV : poussés dans le repo PRIVÉ par pushHls\n   189\t    dest: opts.dest || 'pages/Videos',\n   190\t  }\n   191\t}\n   192\t\n   193\t// --- RÉÉCRITURE des playlists -------------------------------------------------\n   194\t// Une media playlist (stream_N.m3u8) liste des segments par nom local + un EXT-X-MAP:URI=\"init_N.mp4\".\n   195\t// On remplace chaque référence locale par l'URL ABSOLUE de son hash sur le shard. `map` = { nomLocal -> url }.\n   196\tfunction rewriteMediaPlaylist(text, map, keyUri) {\n   197\t  return text.split('\\n').map((line) => {\n   198\t    // EXT-X-KEY:METHOD=AES-128,URI=\"ZR_HLS_KEY_URI\",IV=0x...  -> pointer l'URI vers /api/hls-key gated\n   199\t    if (line.startsWith('#EXT-X-KEY') && keyUri) {\n   200\t      return line.replace(/URI=\"([^\"]*)\"/, `URI=\"${keyUri}\"`)\n   201\t    }\n   202\t    // EXT-X-MAP:URI=\"init_0.mp4\" -> remplacer l'URI par l'URL CDN\n   203\t    const mm = /^#EXT-X-MAP:URI=\"([^\"]+)\"(.*)$/.exec(line)\n   204\t    if (mm) {\n   205\t      const url = map[mm[1].trim()]\n   206\t      return url ? `#EXT-X-MAP:URI=\"${url}\"${mm[2]}` : line\n   207\t    }\n   208\t    // ligne non-# et non vide = un nom de segment local (ex seg_0_001.m4s)\n   209\t    if (line && !line.startsWith('#')) {\n   210\t      const url = map[line.trim()]\n   211\t      return url || line\n   212\t    }\n   213\t    return line\n   214\t  }).join('\\n')\n   215\t}\n   216\t\n   217\t// Le master référence les media playlists (stream_N.m3u8) via EXT-X-STREAM-INF (URI = ligne suivante)\n   218\t// et les pistes audio/subs via EXT-X-MEDIA:...,URI=\"stream_N.m3u8\". On réécrit toutes ces URI vers\n   219\t// /api/hls?path=pages/Videos/<base>/<playlist>.m3u8 (les playlists vivent dans le repo content, servies texte).\n   220\tfunction rewriteMaster(text, playlistUrlFor) {\n   221\t  return text.split('\\n').map((line) => {\n   222\t    // EXT-X-MEDIA:...,URI=\"...\"\n   223\t    const out = line.replace(/URI=\"([^\"]+)\"/g, (full, uri) => {\n   224\t      const u = playlistUrlFor(uri.trim())\n   225\t      return u ? `URI=\"${u}\"` : full\n   226\t    })\n   227\t    if (out !== line) return out\n   228\t    // ligne non-# = URI d'un EXT-X-STREAM-INF (la media playlist vidéo)\n   229\t    if (line && !line.startsWith('#')) {\n   230\t      const u = playlistUrlFor(line.trim())\n   231\t      return u || line\n   232\t    }\n   233\t    return out\n   234\t  }).join('\\n')\n   235\t}\n   236\t\n   237\t// Génère une media playlist SUBS minimale (1 segment VTT couvrant toute la durée).\n   238\tfunction buildSubsPlaylist(durationSec, vttUrl) {\n   239\t  const dur = Math.max(1, Math.ceil(durationSec))\n   240\t  return [\n   241\t    '#EXTM3U',\n   242\t    '#EXT-X-VERSION:7',\n   243\t    `#EXT-X-TARGETDURATION:${dur}`,\n   244\t    '#EXT-X-MEDIA-SEQUENCE:0',\n   245\t    '#EXT-X-PLAYLIST-TYPE:VOD',\n   246\t    `#EXTINF:${dur.toFixed(3)},`,\n   247\t    vttUrl,\n   248\t    '#EXT-X-ENDLIST',\n   249\t    '',\n   250\t  ].join('\\n')\n   251\t}\n   252\t\n   253\t// Construit les entrées EXT-X-MEDIA SUBTITLES à injecter dans le master (groupe \"subs\").\n   254\tfunction subsMediaLines(subMeta, subsPlaylistUrls) {\n   255\t  return subMeta.map((s, i) => {\n   256\t    const def = i === 0 ? 'YES' : 'NO'\n   257\t    const autosel = i === 0 ? 'YES' : 'NO'\n   258\t    return `#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID=\"subs\",NAME=\"${s.label}\",LANGUAGE=\"${s.lang}\",DEFAULT=${def},AUTOSELECT=${autosel},FORCED=NO,URI=\"${subsPlaylistUrls[i]}\"`\n   259\t  })\n   260\t}\n   261\t\n   262\t// Rattache le groupe de sous-titres aux variantes vidéo du master (ajoute ,SUBTITLES=\"subs\" sur EXT-X-STREAM-INF).\n   263\tfunction attachSubsGroup(masterText) {\n   264\t  return masterText.split('\\n').map((line) => {\n   265\t    if (line.startsWith('#EXT-X-STREAM-INF') && !/SUBTITLES=/.test(line)) {\n   266\t      return `${line},SUBTITLES=\"subs\"`\n   267\t    }\n   268\t    return line\n   269\t  }).join('\\n')\n   270\t}\n   271\t\n   272\t// --- PUSH COMPLET HLS (archi SÉCURISÉE) --------------------------------------\n   273\t// Schéma en clair :\n   274\t//   - segments CHIFFRÉS (.m4s) + init (.mp4) + sous-titres (.vtt), nommés par leur SHA-256 (anonymisés),\n   275\t//     poussés sur le repo PUBLIC zenray-media-public via Git Data API ; URLs réécrites vers jsDelivr\n   276\t//     PINNÉ sur le commit (cache immuable, bande passante illimitée). Publics mais ILLISIBLES sans la clé.\n   277\t//   - clé AES-128 (16 octets) poussée dans le repo PRIVÉ zenray-content sous pages/Videos/<base>/.hlskey.bin.\n   278\t//   - master.m3u8 + media playlists + .media.json {type:'hls'} restent PRIVÉS (zenray-content), servis par\n   279\t//     /api/hls. L'URI de clé dans les playlists pointe /api/hls-key?v=<base> (endpoint gated).\n   280\t// Renvoie { repo, publicRepo, commitPublic, manifest, manifestPath, masterPath, keyPath, commitContent }.\n   281\texport async function pushHls(token, result, { apiBase = 'http://localhost:3000', contentRepo = 'zenray-content', publicRepo = PUBLIC_MEDIA_REPO, onProgress = noop, log = noop } = {}) {\n   282\t  const { outDir, base, dest, segments, inits, mediaPlaylists, subsRaw, outDuration, aesKey, aesIv } = result\n   283\t  const enc = encodeURIComponent\n   284\t\n   285\t  // --- 0) s'assurer que le repo PUBLIC existe et est prêt --------------------------------------\n   286\t  await ensurePublicRepo(token, publicRepo, log)\n   287\t\n   288\t  // URL jsDelivr pinnée sur le commit SHA (cache immuable). On la connaît APRÈS le commit, donc on\n   289\t  // construit d'abord la map { nomLocal -> chemin hashé } puis on assemble les URLs une fois le SHA reçu.\n   290\t  const jsdelivrUrl = (commitSha, hashPath) => `https://cdn.jsdelivr.net/gh/${OWNER}/${publicRepo}@${commitSha}/${hashPath}`\n   291\t\n   292\t  // --- 1) hasher + collecter tous les binaires (segments chiffrés + init + VTT) ----------------\n   293\t  const binBlobs = []      // { path(hashé), content(base64), encoding } -> repo public\n   294\t  const segHashPath = {}   // nom local de segment/init -> chemin hashé ab/cd/<hash>.ext\n   295\t  let totalSize = 0\n   296\t\n   297\t  const addBinary = async (localName) => {\n   298\t    const buf = await readFile(path.join(outDir, localName))\n   299\t    const ext = localName.split('.').pop()\n   300\t    const h = sha256(buf)\n   301\t    const sp = shardPathFor(h, ext)\n   302\t    segHashPath[localName] = sp\n   303\t    binBlobs.push({ path: sp, content: buf.toString('base64'), encoding: 'base64' })\n   304\t    totalSize += buf.length\n   305\t  }\n   306\t\n   307\t  for (const f of inits) await addBinary(f)\n   308\t  for (const f of segments) await addBinary(f)\n   309\t\n   310\t  // sous-titres VTT : un binaire hashé chacun (les VTT ne sont PAS chiffrés par HLS, juste anonymisés)\n   311\t  const subHashPaths = []\n   312\t  for (const s of subsRaw) {\n   313\t    const buf = await readFile(s.file)\n   314\t    const h = sha256(buf)\n   315\t    const sp = shardPathFor(h, 'vtt')\n   316\t    subHashPaths.push(sp)\n   317\t    binBlobs.push({ path: sp, content: buf.toString('base64'), encoding: 'base64' })\n   318\t    totalSize += buf.length\n   319\t  }\n   320\t\n   321\t  onProgress('uploading', 0)\n   322\t  // PUSH sur le repo PUBLIC. pushBlobs renvoie le commit SHA -> on pinne jsDelivr dessus (immuable).\n   323\t  const commitPublic = await pushBlobs(token, publicRepo, binBlobs, `hls encrypted segments: ${base}`, log)\n   324\t  log(`  ${binBlobs.length} binaires chiffrés/hashés poussés sur ${publicRepo} (commit ${commitPublic.slice(0, 7)})`)\n   325\t  onProgress('uploading', 55)\n   326\t\n   327\t  // map finale { nom local -> URL jsDelivr@sha } (segments/init) + URLs VTT\n   328\t  const segMap = {}\n   329\t  for (const [name, hp] of Object.entries(segHashPath)) segMap[name] = jsdelivrUrl(commitPublic, hp)\n   330\t  const subVttUrls = subHashPaths.map((hp) => jsdelivrUrl(commitPublic, hp))\n   331\t\n   332\t  // --- 2) réécrire les playlists ----------------------------------------------\n   333\t  const baseDirRel = `${dest}/${base}` // ex pages/Videos/<base>\n   334\t  const hlsUrl = (playlistName) => `/api/hls?path=${enc(`${baseDirRel}/${playlistName}`)}`\n   335\t  // URI de clé GATED : pointe l'endpoint privé /api/hls-key, paramétré par le base name de la vidéo.\n   336\t  const keyUri = `/api/hls-key?v=${enc(base)}`\n   337\t\n   338\t  // media playlists (vidéo + audios) : segments + EXT-X-MAP -> jsDelivr@sha ; EXT-X-KEY URI -> /api/hls-key\n   339\t  const textBlobs = [] // { path, content(utf-8) }\n   340\t  for (const pl of mediaPlaylists) {\n   341\t    const raw = await readFile(path.join(outDir, pl), 'utf8')\n   342\t    const rewritten = rewriteMediaPlaylist(raw, segMap, keyUri)\n   343\t    textBlobs.push({ path: `${baseDirRel}/${pl}`, content: rewritten, encodi