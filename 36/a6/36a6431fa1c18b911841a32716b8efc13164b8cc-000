 = useState(false)\n   603\t  useEffect(() => { if (onPathInside) setOpen(true) }, [onPathInside])\n   604\t  const on = !!node.contentPath && curPath === node.contentPath\n   605\t  const handleName = () => { if (node.contentPath) onOpen(node.contentPath); else if (hasKids) setOpen((v) => !v) }\n   606\t  return (\n   607\t    <div>\n   608\t      <div className=\"zr-treeitem\" onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}\n   609\t        onDragOver={(e) => { if (e.dataTransfer.types.includes('application/zenray-page')) { e.preventDefault(); setDragOver(true) } }}\n   610\t        onDragLeave={() => setDragOver(false)}\n   611\t        onDrop={(e) => { setDragOver(false); const d = e.dataTransfer.getData('application/zenray-page'); if (!d || !onMovePage) return; e.preventDefault(); e.stopPropagation(); try { const p = JSON.parse(d); setOpen(true); onMovePage(p.path, myPath) } catch {} }}\n   612\t        style={{ display: 'flex', alignItems: 'center', width: '100%', paddingLeft: 8 + depth * 12, paddingRight: 4, borderRadius: RADII.sm, background: dragOver ? PALETTE.primarySoft : (on ? PALETTE.primarySoft : 'transparent'), outline: dragOver ? `1px dashed ${PALETTE.primary}` : 'none' }}>\n   613\t        <span onClick={(e) => { e.stopPropagation(); if (hasKids) setOpen((v) => !v) }}\n   614\t          style={{ flex: '0 0 14px', width: 14, textAlign: 'center', cursor: hasKids ? 'pointer' : 'default', color: t.textSecondary, fontSize: 10, userSelect: 'none' }}>\n   615\t          {hasKids ? (open ? '▾' : '▸') : ''}\n   616\t        </span>\n   617\t        <button onClick={handleName} title={node.contentPath || node.name}\n   618\t          draggable={!!node.contentPath}\n   619\t          onDragStart={node.contentPath ? (e) => { e.dataTransfer.setData('application/zenray-page', JSON.stringify({ path: node.contentPath, name: node.name })); e.dataTransfer.effectAllowed = 'copy' } : undefined}\n   620\t          style={{ flex: 1, textAlign: 'left', padding: '5px 4px', background: 'transparent', border: 'none', cursor: 'pointer',\n   621\t            color: on ? PALETTE.primary : (node.contentPath ? t.textPrimary : t.textSecondary), fontFamily: FONTS.sans, fontSize: 13,\n   622\t            fontWeight: on ? 600 : (!node.contentPath && hasKids ? 600 : 400), whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>\n   623\t          {pgPretty(node.name)}{hasKids ? <span style={{ color: t.textSecondary, fontFamily: FONTS.mono, fontSize: 10, marginLeft: 6 }}>{kids.length}</span> : null}\n   624\t        </button>\n   625\t        <button onClick={(e) => { e.stopPropagation(); setOpen(true); onAddChild && onAddChild(myPath) }} title=\"Ajouter une sous-page\" className=\"zr-hover-action\"\n   626\t          style={{ flex: '0 0 auto', visibility: hover ? 'visible' : 'hidden', background: 'transparent', border: 'none', cursor: 'pointer', color: t.textSecondary, fontSize: 15, lineHeight: 1, padding: '0 4px' }}>+</button>\n   627\t      </div>\n   628\t      {open && hasKids && kids.map((k) => (\n   629\t        <TreeItem key={k} node={node.children[k]} depth={depth + 1} curPath={curPath} onOpen={onOpen} t={t} prefix={myPath} onAddChild={onAddChild} onMovePage={onMovePage} />\n   630\t      ))}\n   631\t    </div>\n   632\t  )\n   633\t}\n   634\tfunction TreeNode({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {\n   635\t  return (\n   636\t    <>\n   637\t      {Object.keys(node.children).sort((a, b) => a.localeCompare(b)).map((k) => (\n   638\t        <TreeItem key={k} node={node.children[k]} depth={depth} curPath={curPath} onOpen={onOpen} t={t} prefix={prefix} onAddChild={onAddChild} onMovePage={onMovePage} />\n   639\t      ))}\n   640\t    </>\n   641\t  )\n   642\t}\n   643\t// Grille d'icônes VIRTUALISÉE (rendu fenêtré). Au-delà de ~200 tuiles, peindre tout le DOM rame :\n   644\t// ici on ne monte QUE les rangées visibles dans le conteneur scrollable + une marge (overscan).\n   645\t// Hauteur totale simulée par un conteneur vide, le bloc rendu est décalé en translateY.\n   646\tfunction VirtualIconGrid({ entries, zoom, scrollRef, renderTile }) {\n   647\t  const GAP = 4, ROW_H = 124, OVERSCAN = 3\n   648\t  const [width, setWidth] = useState(0)\n   649\t  const [scrollTop, setScrollTop] = useState(0)\n   650\t  const [viewH, setViewH] = useState(800)\n   651\t  useEffect(() => {\n   652\t    const el = scrollRef.current\n   653\t    if (!el) return\n   654\t    const onScroll = () => setScrollTop(el.scrollTop)\n   655\t    const measure = () => { setWidth(el.clientWidth - 32); setViewH(el.clientHeight) } // -32 = padding 16 gauche+droite\n   656\t    measure()\n   657\t    el.addEventListener('scroll', onScroll, { passive: true })\n   658\t    const ro = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(measure) : null\n   659\t    if (ro) ro.observe(el)\n   660\t    window.addEventListener('resize', measure)\n   661\t    return () => { el.removeEventListener('scroll', onScroll); if (ro) ro.disconnect(); window.removeEventListener('resize', measure) }\n   662\t  }, [scrollRef])\n   663\t  const cols = Math.max(1, Math.floor((width + GAP) / (zoom + GAP))) || 1\n   664\t  const totalRows = Math.ceil(entries.length / cols)\n   665\t  const totalH = totalRows * ROW_H\n   666\t  const firstRow = Math.max(0, Math.floor(scrollTop / ROW_H) - OVERSCAN)\n   667\t  const lastRow = Math.min(totalRows, Math.ceil((scrollTop + viewH) / ROW_H) + OVERSCAN)\n   668\t  const slice = entries.slice(firstRow * cols, lastRow * cols)\n   669\t  return (\n   670\t    <div style={{ position: 'relative', height: totalH }}>\n   671\t      <div style={{ position: 'absolute', top: firstRow * ROW_H, left: 0, right: 0, display: 'grid', gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`, gap: GAP }}>\n   672\t        {slice.map((e) => renderTile(e))}\n   673\t      </div>\n   674\t    </div>\n   675\t  )\n   676\t}\n   677\tfunction Pages({ t }) {\n   678\t  const [paths, setPaths] = useState(null) // string[] full paths\n   679\t  const [cur, setCur] = useState(() => { try { const p = localStorage.getItem('zr:create:cur'); return p ? { path: p } : null } catch { return null } }) // { path } — restauré au reload\n   680\t  useEffect(() => { try { if (cur && cur.path) localStorage.setItem('zr:create:cur', cur.path); else localStorage.removeItem('zr:create:cur') } catch {} }, [cur])\n   681\t  const [status, setStatus] = useState('')\n   682\t  const [q, setQ] = useState('')\n   683\t  // vue Finder PERSISTÉE (list | icons | gallery) : le choix reste en mémoire entre dossiers/pages.\n   684\t  const [view, setViewRaw] = useState(() => { try { return localStorage.getItem('zr:create:view') || 'icons' } catch { return 'icons' } })\n   685\t  const setView = (v) => { setViewRaw(v); try { localStorage.setItem('zr:create:view', v) } catch {} }\n   686\t  const [folder, setFolder] = useState('pages') // dossier courant pour la vue Gallery (façon Finder)\n   687\t  const [uploadProgress, setUploadProgress] = useState(null) // C202 ratio 0..1 pendant un upload média chunké\n   688\t  const [dragging, setDragging] = useState(false) // capture universelle : survol d'un drop de fichiers sur le Finder\n   689\t  const [captureToast, setCaptureToast] = useState('') // petit toast (ex : vidéo à transcoder)\n   690\t  const dragDepth = useRef(0) // compteur d'entrée/sortie pour un overlay stable malgré les enfants\n   691\t  const [split, setSplit] = useState(() => { try { return localStorage.getItem('zr:split') === '1' } catch { return false } }) // C51 mode split\n   692\t  const [zoom, setZoom] = useState(() => { try { return Number(localStorage.getItem('zr:create:zoom')) || 132 } catch { return 132 } }) // C212 zoom grille\n   693\t  useEffect(() => { try { localStorage.setItem('zr:create:zoom', String(zoom)) } catch {} }, [zoom])\n   694\t  const [eagleIdx, setEagleIdx] = useState(null) // C211d/C212b index Eagle BORNÉ au dossier courant (pas global)\n   695\t  const [eagleNonce, setEagleNonce] = useState(0) // C211j force la reconstruction de l'index\n   696\t  const [smartFolders, setSmartFolders] = useState([]) // C211i smart folders\n   697\t  const smartSha = useRef(null)\n   698\t  const [smartActive, setSmartActive] = useState(null)\n   699\t  useEffect(() => { readSmartFolders().then(({ smart, sha }) => { setSmartFolders(smart); smartSha.current = sha }) }, [])\n   700\t  useEffect(() => { try { localStorage.setItem('zr:split', split ? '1' : '0') } catch {} }, [split])\n   701\t  const [peek, setPeek] = useState(null) // C50 page en aperçu latéral { path }\n   702\t  const [sort, setSort] = useState({ key: 'name', dir: 'asc' }) // C18 tri Finder\n   703\t  const [ctx, setCtx] = useState(null) // C21 menu contextuel { x, y, entry }\n   704\t  const [renaming, setRenaming] = useState(null) // C22 dir de l'entrée en cours de renommage\n   705\t  const [renameVal, setRenameVal] = useState('')\n   706\t  const [selected, setSelected] = useState(() => new Set()) // C17 sélection multiple\n   707\t  const [quick, setQuick] = useState(null) // C24 Quick Look { entry }\n   708\t  const [dropDir, setDropDir] = useState(null) // C23 cible de drop survolée\n   709\t  const lastSel = useRef(null)\n   710\t  const gridScrollRef = useRef(null) // conteneur scrollable de la grille (virtualisation >200 tuiles)\n   711\t  const shownRef = useRef([])\n   712\t  const histRef = useRef([]) // historique des pages ouvertes (bouton retour)\n   713\t  // C217 — Finder responsive : sous 860px on empile (colonnes favoris/inspecteur masquées inline, ouvrables en drawers).\n   714\t  // P9 — seuil aligné sur celui de la sidebar (860) pour supprimer la zone bâtarde 760-860 où la sidebar flottait\n   715\t  // déjà mais le Finder gardait ses colonnes inline dans un espace serré.\n   716\t  const [narrowFinder, setNarrowFinder] = useState(typeof window !== 'undefined' ? window.innerWidth < 860 : false)\n   717\t  const [drawer, setDrawer] = useState(null) // 'fav' | 'inspect' | null\n   718\t  useEffect(() => {\n   719\t    const onR = () => { const n = window.innerWidth < 860; setNarrowFinder(n); if (!n) setDrawer(null) }\n   720\t    window.addEventListener('resize', onR); return () => window.removeEventListener('resize', onR)\n   721\t  }, [])\n   722\t\n   723\t  const [tags, setTags] = useState({})       // { 'pages/x.md': 'red' } — tags couleur façon Finder\n   724\t  const [tagFilter, setTagFilter] = useState(null)\n   725\t  const [eagleView, setEagleView] = useState(null) // C211h vue système Eagle: 'untagged'|'recent-added'|'random'\n   726\t  const tagSha = useRef(null)\n   727\t  const TAGS_PATH = 'pages/.zr-tags.json'\n   728\t\n   729\t  // C27 — favoris : épingler n'importe quelle page OU dossier (y compris sous-pages) dans la barre latérale. Stocké localStorage.\n   730\t  const [favorites, setFavorites] = useState(() => { try { return JSON.parse(localStorage.getItem('zr:favorites') || '[]') } catch { return [] } })\n   731\t  useEffect(() => { try { localStorage.setItem('zr:favorites', JSON.stringify(favorites)) } catch {} }, [favorites])\n   732\t  const isFav = (dir) => favorites.some((f) => f.dir === dir)\n   733\t  const toggleFav = (e) => setFavorites((fs) => fs.some((f) => f.dir === e.dir)\n   734\t    ? fs.filter((f) => f.dir !== e.dir)\n   735\t    : [...fs, { dir: e.dir, name: e.name, contentPath: e.contentPath || null, hasKids: !!e.hasKids }])\n   736\t\n   737\t  // CHARGEMENT PARESSEUX (lazy) du Finder : on ne liste QUE les enfants du dossier courant (action 'children',\n   738\t  // Contents API non récursive) -> jamais tronqué, scalable à 45k+ nœuds. `paths` (arbre global, action 'tree')\n   739\t  // reste chargé en SECONDAIRE pour la recherche et les sélecteurs de relation (best-effort, peut être tronqué).\n   740\t  const [dirEntries, setDirEntries] = useState(null) // entrées du dossier courant (source navigation)\n   741\t  const buildDirEntries = (entries, dir) => {\n   742\t    // reconstruit des chemins synthétiques pour réutiliser entriesOfNodes (fusion jumeaux + typage)\n   743\t    const synth = []\n   744\t    for (const e of (entries || [])) synth.push(e.type === 'dir' ? `${dir}/${e.name}/\u0000` : e.path)\n   745\t    return entriesOfNodes(synth, dir)\n   746\t  }\n   747\t  const loadDir = (f) => fetch(`/api/page?action=children&dir=${encodeURIComponent(f)}`, { cache: 'no-store' })\n   748\t    .then((r) => r.json()).then((j) => setDirEntries(buildDirEntries(j.entries, f))).catch(() => setDirEntries([]))\n   749\t  const loadPaths = () => fetch('/api/page?action=tree', { cache: 'no-store' }).then((r) => r.json()).then((j) => { setPaths(j.paths || []) }).catch(() => setPaths([]))\n   750\t  // loadTree() = rafraîchit le dossier courant (rapide) + l'index global (secondaire). Appelé après chaque écriture.\n   751\t  const loadTree = () => { loadDir(folder); return loadPaths() }\n   752\t  useEffect(() => { loadPaths() }, [])\n   753\t  useEffect(() => { setDirEntries(null); loadDir(folder) }, [folder]) // changement de dossier = liste paresseuse\n   754\t  useEffect(() => { fetch(`/api/page?action=read&path=${TAGS_PATH}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => { if (j && j.markdown && !j.missing) { tagSha.current = j.sha; try { setTags(JSON.parse(j.markdown) || {}) } catch {} } }).catch(() => {}) }, [])\n   755\t  const setTag = (pagePath, color) => {\n   756\t    const next = { ...tags }; if (!color || next[pagePath] === color) delete next[pagePath]; else next[pagePath] = color\n   757\t    setTags(next)\n   758\t    fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: TAGS_PATH, markdown: JSON.stringify(next), sha: tagSha.current }) }).then((r) => r.json()).then((j) => { if (j && j.ok) tagSha.current = j.sha }).catch(() => {})\n   759\t  }\n   760\t\n   761\t  const newPage = () => {\n   76