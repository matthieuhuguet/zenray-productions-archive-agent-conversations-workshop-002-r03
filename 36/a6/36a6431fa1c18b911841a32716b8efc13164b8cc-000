ogress) onProgress(1)\n   280\t  return { ok: true, type: 'page', nodePath, name: file.name }\n   281\t}\n   282\t\n   283\t// --- routeur principal -----------------------------------------------------\n   284\t\n   285\tasync function routeFile(file, folder, onProgress) {\n   286\t  const mime = file.type || ''\n   287\t  const ext = extOf(file.name, mime)\n   288\t\n   289\t  if (mime.startsWith('image/') || ['png', 'jpg', 'jpeg', 'gif', 'webp', 'avif', 'bmp', 'tiff', 'heic'].includes(ext)) {\n   290\t    return captureImage(file, folder, onProgress)\n   291\t  }\n   292\t\n   293\t  if (mime.startsWith('video/') || ['mp4', 'webm', 'ogg', 'mkv', 'avi', 'mov'].includes(ext)) {\n   294\t    if (WEB_NATIVE_VIDEO.has(ext) || /\\/(mp4|webm|ogg)$/.test(mime)) {\n   295\t      return captureVideoNative(file, folder, onProgress)\n   296\t    }\n   297\t    // mkv/avi/mov : non lisibles en navigateur. On crée un placeholder + on met\n   298\t    // en file pour transcodage local (mp4) au lieu d'ignorer le drop.\n   299\t    return captureVideoTranscode(file, folder, onProgress)\n   300\t  }\n   301\t\n   302\t  if (mime === 'text/markdown' || ext === 'md' || ext === 'txt' || mime === 'text/plain') {\n   303\t    return captureText(file, folder, onProgress)\n   304\t  }\n   305\t\n   306\t  if (mime.startsWith('audio/') || ['mp3', 'm4a', 'wav', 'flac', 'opus', 'oga'].includes(ext)) {\n   307\t    return captureBinaryMedia(file, folder, mime || 'audio/mpeg', onProgress)\n   308\t  }\n   309\t\n   310\t  if (mime === 'application/pdf' || ext === 'pdf') {\n   311\t    return captureBinaryMedia(file, folder, 'application/pdf', onProgress)\n   312\t  }\n   313\t\n   314\t  // Fallback : binaire générique en média chunké.\n   315\t  return captureBinaryMedia(file, folder, mime || 'application/octet-stream', onProgress)\n   316\t}\n   317\t\n   318\t// API publique : traite chaque File, résilient, renvoie un tableau de résultats.\n   319\t// results[i] = { ok, type, nodePath?, name, error? }\n   320\texport async function captureFiles(files, { folder, onProgress } = {}) {\n   321\t  const list = Array.from(files || [])\n   322\t  const results = []\n   323\t  for (const file of list) {\n   324\t    try {\n   325\t      const res = await routeFile(file, folder, (r) => { if (onProgress) onProgress(r) })\n   326\t      results.push(res)\n   327\t    } catch (e) {\n   328\t      results.push({ ok: false, type: 'error', name: file && file.name, error: (e && e.message) || String(e) })\n   329\t    }\n   330\t  }\n   331\t  return results\n   332\t}\n"}}
