 {divider}\n   352\t\n   353\t      <section style={sectionStyle}>\n   354\t        {eyebrow(\"Exploration\")}\n   355\t        {h2(\"Dragon Quest VII Reimagined\")}\n   356\t        <p style={{ ...bodyStyle, marginBottom: 16, fontSize: isMobile ? \"0.75rem\" : \"0.8rem\", opacity: 0.5 }}>All rights are property of Square Enix.</p>\n   357\t        <div style={{ width: \"100%\", maxWidth: 1200 }}>\n   358\t          <div style={{ display: \"grid\", gridTemplateColumns: isMobile ? \"1fr\" : \"repeat(2, 1fr)\", gap: 16 }}>\n   359\t            {[\"dq1.webp\", \"dq2.webp\", \"dq3.webp\", \"dq4.webp\"].map((f, i) =>\n   360\t              <div key={i} style={{ cursor: \"zoom-in\", overflow: \"hidden\", borderRadius: 24, aspectRatio: \"4/3\" }} onClick={() => setViewerSrc(`${P}/${f}`)}>\n   361\t                <SmartImg src={`${P}/${f}`} alt={`DQ step ${i+1}`} loading=\"lazy\" style={{\n   362\t                  width: \"100%\", height: \"100%\", objectFit: \"cover\", display: \"block\", borderRadius: 24,\n   363\t                  transition: \"transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94)\",\n   364\t                }}\n   365\t                  onMouseEnter={e => { e.currentTarget.style.transform = \"scale(1.02)\"; }}\n   366\t                  onMouseLeave={e => { e.currentTarget.style.transform = \"scale(1)\"; }}\n   367\t                />\n   368\t              </div>\n   369\t            )}\n   370\t          </div>\n   371\t          {captionBelow(\"Exploring concept from game screenshots, then automating scattering with mesh generation and BlenderMCP\")}\n   372\t        </div>\n   373\t      </section>\n   374\t\n   375\t      {viewerSrc && <ImageViewer src={viewerSrc} onClose={() => setViewerSrc(null)} />}\n   376\t    </div>\n   377\t  );\n   378\t}\n   379\t\n   380\t/* ────────── FF7 GAME UI SLIDES ────────── */\n   381\tconst FF7F = \"'AnthropicSans', -apple-system, BlinkMacSystemFont, sans-serif\";\n   382\tconst FF7M = \"'SF Mono', 'Courier New', monospace\";\n   383\tconst FF7Y = \"#F9F773\";\n   384\tconst FF7C = \"#00CFFF\";\n   385\tconst FF7DB = \"#004466\";\n   386\tconst FF7BG = \"#0a0a0a\";\n   387\t\n   388\tfunction ff7Arc(cx, cy, r, s, e) {\n   389\t  const pt = (a) => ({ x: cx + r * Math.cos((a - 90) * Math.PI / 180), y: cy + r * Math.sin((a - 90) * Math.PI / 180) });\n   390\t  const sp = pt(e), ep = pt(s);\n   391\t  return `M ${sp.x} ${sp.y} A ${r} ${r} 0 ${e - s <= 180 ? \"0\" : \"1\"} 0 ${ep.x} ${ep.y}`;\n   392\t}\n   393\t\n   394\tfunction FF7Widget({ interactive = false, size = 140 }) {\n   395\t  const pfx = interactive ? \"i\" : \"d\";\n   396\t  const R = 18, s60 = 0.866, c60 = 0.5;\n   397\t  const tri = `M 50 ${50 - R} L ${50 + R * s60} ${50 + R * c60} L ${50 - R * s60} ${50 + R * c60} Z`;\n   398\t  const arcs = [35, 95, 215, 275];\n   399\t  return (\n   400\t    <svg viewBox=\"0 0 100 100\" width={size} height={size} style={{ overflow: \"visible\" }}>\n   401\t      <path d={tri} fill=\"none\" stroke={FF7C} strokeWidth=\"2.5\" strokeLinejoin=\"round\" />\n   402\t      {interactive ? (\n   403\t        <>\n   404\t          <circle cx=\"50\" cy=\"50\" r=\"36\" fill={FF7C} fillOpacity=\"0.33\" stroke={FF7C} strokeWidth=\"1\" />\n   405\t          <g stroke={FF7DB} strokeWidth=\"2\" fill=\"none\" strokeLinecap=\"round\">\n   406\t            {arcs.map((a, i) => <path key={i} d={ff7Arc(50, 50, 42, a, a + 50)} />)}\n   407\t          </g>\n   408\t          <g stroke={FF7DB} strokeWidth=\"2\" strokeLinecap=\"round\">\n   409\t            <line x1=\"8\" y1=\"50\" x2=\"4\" y2=\"50\" /><line x1=\"92\" y1=\"50\" x2=\"96\" y2=\"50\" />\n   410\t          </g>\n   411\t        </>\n   412\t      ) : (\n   413\t        <>\n   414\t          <g stroke={FF7DB} strokeWidth=\"3\" fill=\"none\" opacity=\"0.8\" strokeLinecap=\"round\">\n   415\t            {arcs.map((a, i) => <path key={i} d={ff7Arc(50, 50, 36, a, a + 50)} />)}\n   416\t          </g>\n   417\t          <g stroke={FF7C} strokeWidth=\"2\" fill=\"none\" filter={`url(#fsg${pfx})`} strokeLinecap=\"round\">\n   418\t            {arcs.map((a, i) => <path key={i} d={ff7Arc(50, 50, 42, a, a + 50)} />)}\n   419\t          </g>\n   420\t          <g strokeWidth=\"2\" filter={`url(#fsg${pfx})`}>\n"}}
