 await thumb.arrayBuffer()\n   167\t      const thumbSha = await putBlob(repo, abToB64(thumbAb))\n   168\t      files.push({ path: shardPathFor(hash, 'webp'), sha: thumbSha })\n   169\t      addBytes += thumb.size\n   170\t    } catch { /* vignette optionnelle */ }\n   171\t  }\n   172\t  if (onProgress) onProgress(0.8)\n   173\t\n   174\t  await commitShard(repo, files, addBytes)\n   175\t\n   176\t  const { w, h } = await imageDims(file)\n   177\t  const manifest = {\n   178\t    type: 'image', v: 1, repo, path, name: file.name, ext,\n   179\t    w: w || 0, h: h || 0, size: file.size, tags: [], addedAt: new Date().toISOString(),\n   180\t  }\n   181\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.img.json`\n   182\t  await writeNode(nodePath, JSON.stringify(manifest))\n   183\t  if (onProgress) onProgress(1)\n   184\t  return { ok: true, type: 'image', nodePath, name: file.name }\n   185\t}\n   186\t\n   187\t// Upload binaire chunké vers le shard actif (vidéo web-native, audio, pdf).\n   188\t// Retourne { repo, dir, parts, count, size } pour bâtir un .media.json.\n   189\tasync function uploadBinaryChunks(file, onProgress) {\n   190\t  const repo = await activeShard()\n   191\t  const id = `${Date.now().toString(36)}-${rand()}`\n   192\t  const dir = `media/${id}`\n   193\t  const count = Math.ceil(file.size / CHUNK_SIZE) || 1\n   194\t  const pad = (i) => String(i).padStart(3, '0')\n   195\t  const files = []\n   196\t  let sent = 0\n   197\t  for (let i = 0; i < count; i++) {\n   198\t    const slice = file.slice(i * CHUNK_SIZE, Math.min((i + 1) * CHUNK_SIZE, file.size))\n   199\t    const slAb = await slice.arrayBuffer()\n   200\t    const sha = await putBlob(repo, abToB64(slAb))\n   201\t    files.push({ path: `${dir}/${pad(i)}.bin`, sha })\n   202\t    sent += slice.size\n   203\t    if (onProgress) onProgress(Math.min(0.9, sent / file.size))\n   204\t  }\n   205\t  await commitShard(repo, files, file.size)\n   206\t  const parts = Array.from({ length: count }, (_, i) => pad(i))\n   207\t  return { repo, dir, parts, count, size: file.size }\n   208\t}\n   209\t\n   210\t// VIDEO web-native (mp4/webm/ogg) : chunke + nœud .media.json (probe.duration).\n   211\tasync function captureVideoNative(file, folder, onProgress) {\n   212\t  const duration = await videoDuration(file)\n   213\t  const { repo, dir, parts, count, size } = await uploadBinaryChunks(file, onProgress)\n   214\t  const manifest = {\n   215\t    type: 'chunked-media', v: 1, name: file.name, mime: file.type || 'video/mp4',\n   216\t    size, chunkSize: CHUNK_SIZE, count, dir, parts,\n   217\t    repo, probe: { duration: duration || 0, audio: [], subs: [] },\n   218\t  }\n   219\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   220\t  await writeNode(nodePath, JSON.stringify(manifest))\n   221\t  if (onProgress) onProgress(1)\n   222\t  return { ok: true, type: 'video', nodePath, name: file.name }\n   223\t}\n   224\t\n   225\t// VIDEO non web-native (mkv/avi/mov, etc.) : le navigateur ne sait pas la lire.\n   226\t// On NE chunke RIEN ici (le binaire brut serait illisible). À la place :\n   227\t//  (a) on écrit tout de suite un nœud .media.json PLACEHOLDER {transcoding:true}\n   228\t//      pour que la vidéo apparaisse dans le Finder avec un statut visible ;\n   229\t//  (b) on enregistre la vidéo dans la file pages/.zr-transcode-queue.json.\n   230\t// Le transcodage mkv->mp4 (ffmpeg) se fait ensuite EN LOCAL via\n   231\t// scripts/video-transcode.mjs ; ce script remplit le .media.json final.\n   232\tasync function captureVideoTranscode(file, folder, onProgress) {\n   233\t  const mime = file.type || 'video/x-matroska'\n   234\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   235\t\n   236\t  // (a) Nœud placeholder : pas de parts/dir/repo (rien d'uploadé), transcoding:true.\n   237\t  const manifest = {\n   238\t    type: 'chunked-media', v