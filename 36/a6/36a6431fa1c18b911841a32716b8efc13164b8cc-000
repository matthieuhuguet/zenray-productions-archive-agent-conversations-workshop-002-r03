ee: $root\" >&2\n    return\n  fi\n\n  local account_dir\n  local workspace_dir\n  for account_dir in \"$root\"/*; do\n    [[ -d \"$account_dir\" ]] || continue\n\n    for workspace_dir in \"$account_dir\"/*; do\n      [[ -d \"$workspace_dir\" ]] || continue\n      add_account \"$workspace_dir\"\n    done\n  done\n}\n\nadd_configured_accounts\n\nif [[ ${#SYNC_ACCOUNTS[@]} -eq 0 ]]; then\n  discover_accounts\nfi\n\nif [[ ${#SYNC_ACCOUNTS[@]} -lt 2 ]]; then\n  log \"SKIP: ${#SYNC_ACCOUNTS[@]} compte/workspace detecte, il en faut au moins 2\"\n  exit 0\nfi\n\nlog \"sync demarre: ${#SYNC_ACCOUNTS[@]} comptes/workspaces\"\n\nsource_account=\"\"\ndest_account=\"\"\nfor source_account in \"${SYNC_ACCOUNTS[@]}\"; do\n  for dest_account in \"${SYNC_ACCOUNTS[@]}\"; do\n    [[ \"$source_account\" == \"$dest_account\" ]] && continue\n    rsync -a --update \"$source_account/\" \"$dest_account/\"\n  done\ndone\n\nlog \"sync termine\"\n"}}
