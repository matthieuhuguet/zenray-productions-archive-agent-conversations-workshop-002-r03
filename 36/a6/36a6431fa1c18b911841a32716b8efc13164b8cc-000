 166\t      const hit = files.find((f) => VIDEO_RE.test(f) && f.replace(/\\.[^.]+$/, '').toLowerCase() === baseWanted)\n   167\t      if (hit) return path.join(WATCH, hit)\n   168\t    } catch { /* dossier illisible */ }\n   169\t  }\n   170\t  return null\n   171\t}\n   172\t\n   173\t// --- traitement d'une entrée -------------------------------------------------\n   174\tasync function processEntry(entry) {\n   175\t  const nodePath = entry.nodePath\n   176\t  log(`traitement: ${entry.name} (${nodePath})`)\n   177\t  state.current = { name: entry.name, nodePath, stage: 'resolving', progress: 0 }\n   178\t\n   179\t  const src = await resolveSource(entry)\n   180\t  if (!src) {\n   181\t    log(`SOURCE INTROUVABLE pour \"${entry.name}\". Déposer le fichier dans ${WATCH} (ou renseigner sourcePath). On laisse l'entrée en file.`)\n   182\t    await updateEntry(nodePath, { status: 'source-introuvable', sourceHint: WATCH })\n   183\t    state.current = null\n   184\t    return\n   185\t  }\n   186\t  log(`  source: ${src}`)\n   187\t  await updateEntry(nodePath, { status: 'encoding', progress: 0 })\n   188\t\n   189\t  // throttle des mises à jour de progression (évite de spammer GitHub à chaque frame).\n   190\t  let lastPush = 0\n   191\t  const onProgress = (stage, pct) => {\n   192\t    state.current = { name: entry.name, nodePath, stage, progress: Math.round(pct) }\n   193\t    const now = Date.now()\n   194\t    if (now - lastPush > 5000) {\n   195\t      lastPush = now\n   196\t      updateEntry(nodePath, { status: `encoding ${stage} ${Math.round(pct)}%`, progress: Math.round(pct) })\n   197\t      writePlaceholderProgress(nodePath, entry, Math.round(pct), stage)\n   198\t    }\n   199\t  }\n   200\t\n   201\t  // 1) transcode local (ffmpeg multi-thread sature les coeurs automatiquement)\n   202\t  //    HLS par défaut (segments + playlists m3u8), MSE legacy si --mse.\n   203\t  const transcode = USE_HLS ? transcodeHls : transcodeOne\n   204\t  const push = USE_