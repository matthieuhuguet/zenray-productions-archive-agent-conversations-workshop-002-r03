n   173\tconst GRADIENT = \"linear-gradient(135deg, #e88f67 0%, #d97d86 100%)\";\n   174\tconst FONT = \"'AnthropicSans', -apple-system, BlinkMacSystemFont, sans-serif\";\n   175\t\n   176\tconst SlideText = ({ children, size, bold }) => (\n   177\t  <div style={{ display: \"flex\", justifyContent: \"center\", width: \"100%\" }}>\n   178\t    <div style={{\n   179\t      background: GRADIENT,\n   180\t      borderRadius: 24,\n   181\t      padding: \"20px 32px\",\n   182\t      maxWidth: 400,\n   183\t      width: \"100%\",\n   184\t      textAlign: \"center\",\n   185\t    }}>\n   186\t      <p style={{\n   187\t        fontFamily: FONT,\n   188\t        fontSize: size === \"xl\" ? 20 : size === \"2xl\" ? 24 : 17,\n   189\t        lineHeight: 1.6,\n   190\t        color: \"#fff\",\n   191\t        fontWeight: bold ? 700 : 500,\n   192\t        margin: 0,\n   193\t      }}>\n   194\t        {children}\n   195\t      </p>\n   196\t    </div>\n   197\t  </div>\n   198\t);\n   199\t\n   200\tconst SlideCaption = ({ children, sub }) => (\n   201\t  <div style={{ display: \"flex\", justifyContent: \"center\", width: \"100%\" }}>\n   202\t    <div style={{\n   203\t      background: GRADIENT,\n   204\t      borderRadius: 24,\n   205\t      padding: \"12px 24px\",\n   206\t      maxWidth: 400,\n   207\t      width: \"100%\",\n   208\t      textAlign: \"center\",\n   209\t    }}>\n   210\t      <p style={{ fontFamily: FONT, fontSize: 15, lineHeight: 1.4, color: \"#fff\", fontWeight: 500, margin: 0 }}>\n   211\t        {children}\n   212\t      </p>\n   213\t      {sub && (\n   214\t        <p style={{ fontFamily: FONT, fontSize: 11, lineHeight: 1.4, color: \"rgba(255,255,255,0.7)\", fontStyle: \"italic\", margin: \"6px 0 0\" }}>\n   215\t          {sub}\n   216\t        </p>\n   217\t      )}\n   218\t    </div>\n   219\t  </div>\n   220\t);\n   221\t\n   222\tconst SLIDE_DATA = [\n   223\t  { type: \"text\", content: \"Lately I have been taking a week to build a custom C++ plugin for Unreal Engine 5.7 that lets AI agents manipulate the editor in real-time. Here is what I have learned.\" },\n   224\t  { type: \"text\", content: \"These past weeks, I have been building a bridge between UE 5.7 and Cursor or Claude Code. The core idea is to let an agent generate and execute Python through Unreal\\u2019s Python Editor Scripting and spawn C++ classes and Blueprints directly inside the editor.\" },\n   225\t  { type: \"text-image\", content: \"This is not a new idea. Gorka Games Studios have been making a lot of videos illustrating it recently. I did not want to copy and paste. I wanted to understand it.\", image: `${P}/gorka-videos.webp`, alt: \"Gorka Games Studios videos\" },\n   226\t  { type: \"text-image\", content: \"I have also been inspired by the recent work of Eldad Sery on Houdini and Cursor.\", image: `${P}/eldad-houdini.webp`, alt: \"Eldad Sery Houdini Cursor\", contain: true },\n   227\t  { type: \"text\", content: \"Drawing from open-source foundations by kvick, chongdashu and flopperam, I built a plugin that runs a server inside the editor, allowing an external agent to query the current scene, spawn and manipulate actors, especially static mesh actors, and generate and compile Blueprint classes.\" },\n   228\t  { type: \"text\", content: \"What it does not cover: materials, cinematics, animation retargeting, Niagara systems. The scope is deliberately narrow, limited to scene composition and Blueprint scaffolding. You can generate these assets without right-clicking, but modifying them was not something I wanted to focus on.\" },\n   229\t  { type: \"text\", content: \"Most existing Unreal MCP solutions work because they are locked to Claude Code, which excels at Python generation. Making the plugin compatible with lightweight models required heavy refactoring. Blueprint generation from agent output remains fragile. Each MCP handler needs multiple fallbacks because node graph serialization from raw text is still a minefield. It is buggy, it is experimental, and no GitHub release is planned.\" },\n   230\t  { type: \"text\", content: \"Working daily with Houdini, I already live in a procedural, node-based mindset. And with models like Claude Opus 4.6 getting significantly better at sustained code reasoning, the trajectory is clear. These tools will only get more capable.\" },\n   231\t  { type: \"text\", content: \"An AI agent talking to your editor is transformative for pipeline work. Scattering thousands of props with rule-based logic the way PCG does, without building the graph yourself or building an agent that builds the graph for you. Batch-renaming, folder reorganization, asset auditing. Generating Editor Utility Widgets on demand. Level blockout, procedural maze generation, modular kit assembly. Creating short Blueprint systems. Every kind of prototype coding and blocking.\" },\n   232\t  { type: \"text\", content: \"Where it falls short, and where it should. Creating assets that carry artistic intent. Art direction, textures with purpose, organic sculpts, nuanced material work. This is not what these tools are for. I do not want an LLM making my sculpts. I do not want probability deciding my art direction.\" },\n   233\t  { type: \"text\", content: \"The distinction matters. Automate the structure, protect the craft.\", size: \"xl\", bold: true },\n   234\t  { type: \"text\", content: \"For every designer who has spent hours writing a folder cleanup script or manually placing hundreds meshes with slight variations, this is already a working alternative. Not tomorrow. Now.\" },\n   235\t  { type: \"profile\", content: \"HERE IS MY RESULT\", image: `${P}/profile.webp` },\n   236\t  { type: \"two-images-caption\", images: [`${P}/blockout-1.webp`, `${P}/blockout-2.webp`], caption: \"Create Blockout from Image Use SM_Cube\" },\n   237\t  { type: \"two-images-caption\", images: [`${P}/orientation-1.webp`, `${P}/orientation-2.webp`], caption: \"Fix Orientation of Meshes.\" },\n   238\t  { type: \"three-images-caption\", images: [`${P}/expand-1.webp`, `${P}/expand-2.webp`, `${P}/expand-3.webp`], caption: \"Expand the perimeter\" },\n   239\t  { type: \"image-caption\", image: `${P}/cross-1.webp`, caption: \"Cross / Plus Pattern On Ground and Add Floor at Center\" },\n   240\t  { type: \"image-caption\", image: `${P}/grid-1.webp`, caption: \"Create 3x3 Grid With Offset.\" },\n   241\t  { type: \"grid4-caption\", images: [`${P}/tower-1.webp`, `${P}/tower-2.webp`, `${P}/tower-3.webp`, `${P}/tower-4.webp`], caption: \"Step By Step Resolve the Missing Tower and Link Walls.\" },\n   242\t  { type: \"grid4-caption-sub\", images: [`${P}/dq1.webp`, `${P}/dq2.webp`, `${P}/dq3.webp`, `${P}/dq4.webp`], caption: \"Exploring Concept From Game Screenshots, Then Automating Scattering With Mesh Generation and BlenderMCP.\", sub: \"Dragon Quest VII Reimagined. All rights are property of Square Enix.\" },\n   243\t];\n   244\t\n   245\tfunction UE5McpSlides({ isMobile }) {\n   246\t  const [viewerSrc, setViewerSrc] = useState(null);\n   247\t  const { sectionStyle, titleStyle, bodyStyle, divider, eyebrow, h2, imgZoom, captionBelow, pair, grid3 } = makeSlideHelpers(P, isMobile, setViewerSrc);\n   248\t\n   249\t  return (\n   250\t    <div style={{ background: \"#111\", color: \"#fff\", marginLeft: \"calc(-50vw + 50%)\", marginRight: \"calc(-50vw + 50%)\", width: \"100vw\" }}>\n   251\t\n   252\t      <section style={{ ...sectionStyle, paddingBottom: isMobile ? 50 : 60 }}>\n   253\t        <div style={{ width: \"100%\", maxWidth: 1200, marginBottom: isMobile ? 36 : 56 }}>\n   254\t          {imgZoom(\"thumbnail.webp\", \"UE5 MCP Plugin\", { mask: \"left\" })}\n   255\t        </div>\n   256\t        <h1 style={titleStyle}>UE5 MCP Plugin</h1>\n   257\t        <p style={bodyStyle}>Custom C++ plugin for Unreal Engine 5.7 that lets AI agents manipulate the editor in real-time via MCP. The agent can query the scene, spawn and manipulate actors, and generate Blueprint classes. Scope: scene composition, blockout from image, procedural placement, and Blueprint scaffolding.</p>\n   258\t      </section>\n   259\t\n   260\t      {divider}\n   261\t\n   262\t      <section style={sectionStyle}>\n   263\t        {eyebrow(\"Context\")}\n   264\t        {h2(\"Inspiration & Approach\")}\n   265\t        <p style={{ ...bodyStyle, marginBottom: isMobile ? 32 : 48 }}>Drawing from open-source foundations and inspired by Gorka Games Studios and Eldad Sery's work on Houdini with Cursor. I did not want to copy and paste. I wanted to understand it. The plugin runs a server inside the editor, allowing an external agent to query the scene and generate actors.</p>\n   266\t        <div style={{ width: \"100%\", maxWidth: 1200, display: \"flex\", flexDirection: \"column\", gap: 40 }}>\n   267\t          <div>\n   268\t            {imgZoom(\"gorka-videos.webp\", \"Gorka Games Studios\")}\n   269\t            {captionBelow(\"Gorka Games Studios - video references\")}\n   270\t          </div>\n   271\t          <div>\n   272\t            {imgZoom(\"eldad-houdini.webp\", \"Eldad Sery Houdini\")}\n   273\t            {captionBelow(\"Eldad Sery - Houdini and Cursor workflow\")}\n   274\t          </div>\n   275\t        </div>\n   276\t      </section>\n   277\t\n   278\t      {divider}\n   279\t\n   280\t      <section style={sectionStyle}>\n   281\t        {eyebrow(\"Philosophy\")}\n   282\t        {h2(\"Automate the Structure, Protect the Craft\")}\n   283\t        <p style={{ ...bodyStyle, marginBottom: isMobile ? 32 : 48 }}>An AI agent talking to your editor is transformative for pipeline work. Scattering thousands of props with rule-based logic, batch-renaming, folder reorganization, asset auditing, generating Editor Utility Widgets on demand, level blockout, procedural maze generation. Where it falls short: creating assets that carry artistic intent. Art direction, textures with purpose, organic sculpts. This is not what these tools are for.</p>\n   284\t      </section>\n   285\t\n   286\t      {divider}\n   287\t\n   288\t      <section style={sectionStyle}>\n   289\t        {eyebrow(\"Results\")}\n   290\t        {h2(\"Scene Composition from Prompts\")}\n   291\t        <div style={{ width: \"100%\", maxWidth: 1200, display: \"flex\", flexDirection: \"column\", gap: 40 }}>\n   292\t          {pair(\n   293\t            <>{imgZoom(\"blockout-1.webp\", \"Blockout from image 1\", { aspectRatio: \"16/9\" })}{captionBelow(\"Create blockout from image using SM_Cube\")}</>,\n   294\t            <>{imgZoom(\"blockout-2.webp\", \"Blockout from image 2\", { aspectRatio: \"16/9\" })}{captionBelow(\"Agent-generated blockout result\")}</>\n   295\t          )}\n   296\t          {pair(\n   297\t            <>{imgZoom(\"orientation-1.webp\", \"Orientation fix 1\", { aspectRatio: \"16/9\" })}{captionBelow(\"Fix orientation of meshes\")}</>,\n   298\t            <>{imgZoom(\"orientation-2.webp\", \"Orientation fix 2\", { aspectRatio: \"16/9\" })}{captionBelow(\"Corrected mesh alignment\")}</>\n   299\t          )}\n   300\t        </div>\n   301\t      </section>\n   302\t\n   303\t      {divider}\n   304\t\n   305\t      <section style={sectionStyle}>\n   306\t        {eyebrow(\"Patterns\")}\n   307\t        {h2(\"Procedural Layout Generation\")}\n   308\t        <div style={{ width: \"100%\", maxWidth: 1200, display: \"flex\", flexDirection: \"column\", gap: 40 }}>\n   309\t          {grid3([\n   310\t            { file: \"expand-1.webp\", label: \"Expand 1\" },\n   311\t            { file: \"expand-2.webp\", label: \"Expand 2\" },\n   312\t            { file: \"expand-3.webp\", label: \"Expand 3\" },\n   313\t          ], { ar: \"4/3\" })}\n   314\t          {captionBelow(\"Expand the perimeter - procedural growth\")}\n   315\t          <div style={{ display: \"flex\", flexDirection: isMobile ? \"column\" : \"row\", gap: 24, width: \"100%\", maxWidth: 1200 }}>\n   316\t            <div style={{ flex: 1 }}>\n   317\t      