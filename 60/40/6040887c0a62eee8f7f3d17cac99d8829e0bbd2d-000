{"parentUuid":"b7d99271-3f07-423e-917a-9862db1d26b2","isSidechain":false,"promptId":"afd7bff3-4adc-4e76-b31e-d68eb4680af5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014hiPUsPJv82Ussz29b4N9f","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t# 2026-08-31, cook zenray-html-hda : _index.json + _crop_params.json -> JPEG finaux dans out/\n3\t# Reproduit exactement le rendu CSS du picker (object-fit:cover + object-position\n4\t# + transform: scale(zoom*safescale) rotate(angle)) par une seule transformation\n5\t# affine directe source -> canevas final, pour que le fichier livré corresponde\n6\t# au pixel pres a ce que Matthieu a vu dans le navigateur. Porte aussi le texte\n7\t# optionnel (police Serif/Sans, taille XL/L/S, couleur jaune #f6cf47 ou blanc,\n8\t# ancre haut/milieu/bas x gauche/centre/droite).\n9\timport json\n10\timport math\n11\tfrom pathlib import Path\n12\t\n13\tfrom PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps\n14\t\n15\tHERE = Path(__file__).resolve().parent\n16\tSOURCE_DIR = HERE.parent\n17\tOUT_DIR = HERE / \"out\"\n18\t\n19\tFONT_FILES = {\n20\t    \"serif\": \"/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\",\n21\t    \"sans\": \"/Users/zenray/Library/Fonts/InterVariable.ttf\",\n22\t}\n23\tTEXT_SIZE_FRACTION = {\"xl\": 0.10, \"l\": 0.065, \"s\": 0.04}  # part de canvas_w, identique au CSS *cqw*\n24\t\n25\t\n26\tdef affine_coeffs(nw, nh, canvas_w, canvas_h, px, py, zoom, angle_deg):\n27\t    \"\"\"Coefficients (a,b,c,d,e,f) pour Image.transform(AFFINE) : pour chaque\n28\t    pixel de sortie (bx,by), le pixel source lu est (a*bx+b*by+c, d*bx+e*by+f).\n29\t    Derive directement de la meme chaine que le CSS : object-fit:cover +\n30\t    object-position(px,py) puis transform: scale(zoom*safescale) rotate(angle)\n31\t    autour du centre. `safescale` regonfle la couverture pour qu'aucune\n32\t    rotation ne laisse un coin transparent (meme formule que le JS du picker,\n33\t    a ne jamais faire diverger) :\n34\t        safescale = |cos angle| + max(H/W, W/H) * |sin angle|\n35\t    Angle positif = sens CSS (horaire), coherent avec `rotate(Xdeg)`.\n36\t    \"\"\"\n37\t    s = max(canvas_w / nw, canvas_h / nh)\n38\t    x0 = (nw - canvas_w / s) * (px / 100)\n39\t    y0 = (nh - canvas_h / s) * (py / 100)\n40\t\n41\t    ratio = max(canvas_h / canvas_w, canvas_w / canvas_h)\n42\t    theta = math.radians(angle_deg)\n43\t    safescale = abs(math.cos(theta)) + ratio * abs(math.sin(theta))\n44\t    safescale *= 1.002  # marge anti-arrondi\n45\t\n46\t    z = zoom * safescale\n47\t    cx, cy = canvas_w / 2, canvas_h / 2\n48\t    cos_t, sin_t = math.cos(theta), math.sin(theta)\n49\t\n50\t    a = cos_t / (z * s)\n51\t    b = sin_t / (z * s)\n52\t    c = x0 + cx / s - (cos_t * cx + sin_t * cy) / (z * s)\n53\t    d = -sin_t / (z * s)\n54\t    e = cos_t / (z * s)\n55\t    f = y0 + cy / s + (sin_t * cx - cos_t * cy) / (z * s)\n56\t    return (a, b, c, d, e, f)\n57\t\n58\t\n59\tdef load_font(font_key, size):\n60\t    font = ImageFont.truetype(FONT_FILES.get(font_key, FONT_FILES[\"serif\"]), size)\n61\t    if font_key == \"sans\":\n62\t        try:\n63\t            font.set_variation_by_axes([600])  # InterVariable, axe wght -> semi-gras\n64\t        except Exception:\n65\t            pass\n66\t    return font\n67\t\n68\t\n69\tdef draw_caption(canvas, text_cfg, canvas_w, canvas_h):\n70\t    if not text_cfg or not text_cfg.get(\"enabled\") or not text_cfg.get(\"value\", \"\").strip():\n71\t        return canvas\n72\t    value = text_cfg[\"value\"].strip()\n73\t    font_key = text_cfg.get(\"font\", \"serif\")\n74\t    size_key = text_cfg.get(\"size\", \"l\")\n75\t    color = text_cfg.get(\"color\", \"#f6cf47\")\n76\t\n77\t    font_size = round(canvas_w * TEXT_SIZE_FRACTION.get(size_key, TEXT_SIZE_FRACTION[\"l\"]))\n78\t    max_width = canvas_w * 0.88\n79\t\n80\t    font = load_font(font_key, font_size)\n81\t    probe = ImageDraw.Draw(canvas)\n82\t    bbox = probe.textbbox(