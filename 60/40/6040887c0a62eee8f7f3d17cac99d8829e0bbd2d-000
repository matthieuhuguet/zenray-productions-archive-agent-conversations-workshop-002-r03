layEl = overlay;\n\n    card.appendChild(frame);\n\n    var controls = document.createElement(\"div\");\n    controls.className = \"controls\";\n\n    function sliderRow(labelText, min, max, step, value, decimals, onInput) {\n      var row = document.createElement(\"div\");\n      row.className = \"slider-row\";\n      var lbl = document.createElement(\"div\");\n      lbl.className = \"row-label\";\n      var valSpan = document.createElement(\"b\");\n      valSpan.textContent = value.toFixed(decimals);\n      lbl.innerHTML = \"<span>\" + labelText + \"</span>\";\n      lbl.appendChild(valSpan);\n      row.appendChild(lbl);\n      var input = document.createElement(\"input\");\n      input.type = \"range\";\n      input.min = min; input.max = max; input.step = step; input.value = value;\n      input.addEventListener(\"input\", function () {\n        var v = parseFloat(input.value);\n        valSpan.textContent = v.toFixed(decimals);\n        onInput(v);\n      });\n      row.appendChild(input);\n      return row;\n    }\n\n    controls.appendChild(sliderRow(\"Zoom\", 1, 3, 0.01, img.zoom, 2, function (v) {\n      img.zoom = v; el.style.setProperty(\"--zoom\", v);\n    }));\n    controls.appendChild(sliderRow(\"Position X\", 0, 100, 1, img.px, 0, function (v) {\n      img.px = v; el.style.setProperty(\"--px\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"Position Y\", 0, 100, 1, img.py, 0, function (v) {\n      img.py = v; el.style.setProperty(\"--py\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"Rotation °\", -45, 45, 0.5, img.rotate, 1, function (v) {\n      img.rotate = v;\n      el.style.setProperty(\"--angle\", v + \"deg\");\n      el.style.setProperty(\"--safescale\", safeScale(v, FORMATS[state.format].w, FORMATS[state.format].h));\n    }));\n\n    // Texte optionnel, désactivé par défaut (extension du 2026-08-31)\n    var toggleRow = document.createElement(\"label\");\n    toggleRow.className = \"text-toggle-row\";\n    var toggle