 = document.documentElement;\n  var grid = document.getElementById(\"grid\");\n  var fmtSelect = document.getElementById(\"fmtSelect\");\n  var resLabel = document.getElementById(\"resLabel\");\n  var countLabel = document.getElementById(\"countLabel\");\n\n  Object.keys(FORMATS).forEach(function (key) {\n    var opt = document.createElement(\"option\");\n    opt.value = key;\n    opt.textContent = key;\n    if (key === DEFAULT_FORMAT) opt.selected = true;\n    fmtSelect.appendChild(opt);\n  });\n\n  // Facteur anti-coin-transparent : agrandit la couverture pour qu'une\n  // rotation de `angle` degrés ne laisse jamais voir le fond du cadre.\n  // k = |cos| + max(H/W, W/H) * |sin| — exact pour un cadre W x H tourné\n  // sur lui-même. Même formule côté crop-apply.py, à ne jamais faire diverger.\n  function safeScale(angleDeg, fw, fh) {\n    var rad = angleDeg * Math.PI / 180;\n    var ratio = Math.max(fh / fw, fw / fh);\n    return Math.abs(Math.cos(rad)) + ratio * Math.abs(Math.sin(rad));\n  }\n\n  function applyFormat() {\n    var f = FORMATS[state.format];\n    var parts = state.format.split(\":\");\n    root.style.setProperty(\"--fmt-ratio\", parts[0] + \" / \" + parts[1]);\n    var outW = f.w * f.factor, outH = f.h * f.factor;\n    resLabel.textContent = f.w + \"×\" + f.h + \" ×\" + f.factor + \" → sortie \" + outW + \"×\" + outH;\n    IMAGES.forEach(function (img) {\n      if (!img._els.imgEl) return;\n      img._els.imgEl.style.setProperty(\"--safescale\", safeScale(img.rotate, f.w, f.h));\n    });\n  }\n  fmtSelect.addEventListener(\"change\", function () {\n    state.format = fmtSelect.value;\n    applyFormat();\n  });\n\n  countLabel.textContent = IMAGES.length + \" photos\";\n\n  function lineFor(img) {\n    var f = FORMATS[state.format];\n    var line = \"[\" + img.id + \"] \" + img.file + \" — zoom=\" + img.zoom.toFixed(2) +\n      \" rotate=\" + img.rotate.toFixed(1) + \"deg\" +\n      \" x=\" + Math.round(img.px) + \"% y=\" + Math.round(img.py) + \"% f