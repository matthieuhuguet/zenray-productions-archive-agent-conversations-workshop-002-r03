{"parentUuid":"8ed94da5-662b-4196-958c-aa17f64f94b4","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/.claude/skills/zenray-html-photoshop-pdf-hda/scripts/zr-hda-instance.py","snippet":"1\t#!/usr/bin/env python3\n2\t\"\"\"Cree une instance d'outil zenray-html-hda depuis un gabarit, sans regenerer\n3\tune seule ligne de HTML.\n4\t\n5\tPourquoi ce script existe. Les premieres instances ont ete ecrites a la main,\n6\tliste d'images comprise, ce qui coutait plus de 30 000 tokens et plusieurs\n7\tminutes par projet. C'etait une faute HDA : la definition (le gabarit) doit\n8\tetre unique, et le projet ne doit etre qu'un jeu de parametres. Ici, le seul\n9\tbloc qui depend du projet est `@zr-instance` dans le HTML, et ce script l'ecrit.\n10\t\n11\tUsage\n12\t    zr-hda-instance.py <dossier-images> [--mode light|heavy] [--project NOM]\n13\t                       [--format 4:5] [--dest DOSSIER] [--open] [--force]\n14\t\n15\tExemples\n16\t    # Cadrage d'un lot de photos, format 4:5, ouverture dans Chrome\n17\t    zr-hda-instance.py ~/Downloads/mon-post --open\n18\t\n19\t    # Retouche + reorder d'un out/ deja cadre (poupee russe)\n20\t    zr-hda-instance.py ~/Downloads/mon-post/zenray-html-hda-mon-post/out \\\\\n21\t        --mode heavy --open\n22\t\"\"\"\n23\timport argparse\n24\timport json\n25\timport os\n26\timport re\n27\timport shutil\n28\timport subprocess\n29\timport sys\n30\tfrom datetime import datetime\n31\tfrom pathlib import Path\n32\t\n33\tSKILL = Path(__file__).resolve().parent.parent\n34\tTEMPLATES = SKILL / \"templates\"\n35\tINSTANCES_INDEX = SKILL / \"instances\" / \"INDEX.md\"\n36\t\n37\tIMAGE_SUFFIXES = {\".jpg\", \".jpeg\", \".png\", \".webp\", \".tif\", \".tiff\", \".heic\", \".JPG\", \".JPEG\", \".PNG\"}\n38\tFORMATS = {\"4:5\", \"1:1\", \"9:16\", \"16:9\", \"1:2\", \"3:4\", \"2:3\", \"4:3\", \"source\"}\n39\tFORMAT_RATIOS = {\n40\t    \"4:5\": 0.8, \"1:1\": 1.0, \"9:16\": 0.5625, \"16:9\": 1.7778,\n41\t    \"1:2\": 0.5, \"3:4\": 0.75, \"2:3\": 0.6667, \"4:3\": 1.3333,\n42\t}\n43\t\n44\t\n45\tdef measure(path):\n46\t    \"\"\"Dimensions en pixels. Pillow si dispo, sinon `sips`, natif macOS.\"\"\"\n47\t    try:\n48\t        from PIL import Image\n49\t        with Image.open(path) as im:\n50\t            return im.size\n51\t    except Exception:\n52\t        try:\n53\t            out = subprocess.run([\"sips\", \"-g\", \"pixelWidth\", \"-g\", \"pixelHeight\", str(path)],\n54\t                                 capture_output=True, text=True, check=True).stdout\n55\t            w = int(re.search(r\"pixelWidth:\\s*(\\d+)\", out).group(1))\n56\t            h = int(re.search(r\"pixelHeight:\\s*(\\d+)\", out).group(1))\n57\t            return w, h\n58\t        except Exception:\n59\t            return 0, 0\n60\t\n61\t\n62\tdef build_previews(images, dest, max_width=1400, quality=82):\n63\t    \"\"\"Ecrit `_previews.js`, un dictionnaire id -> data URI JPEG reduite.\n64\t\n65\t    Pourquoi c'est indispensable et pas un confort. WebGL REFUSE une texture\n66\t    issue d'une origine opaque, ce qu'est tout fichier ouvert en `file://` : le\n67\t    cadre central du mode heavy restait noir alors que les vignettes (de\n68\t    simples `<img>`, qui n'ont pas cette restriction) s'affichaient. Servir en\n69\t    localhost reglait le probleme mais ajoutait une dependance fragile, un\n70\t    process qui doit tourner ; des qu'il s'arrete, l'outil redevient noir. Une\n71\t    data URI, elle, est TOUJOURS same-origin : l'instance fonctionne alors en\n72\t    double-cliquant le fichier, sans serveur, sans reseau, definitivement.\n73\t\n74\t    L'apercu est reduit a `max_width` : l'ecran n'affiche jamais plus de\n75\t    quelques centaines de pixels, et le cook Python travaille de toute facon\n76\t    sur les ORIGINAUX pleine resolution lus depuis `_index.json`. La qualite\n77\t    finale n'est donc pas affectee, seul le poids du HTML l'est.\n78\t    \"\"\"\n79\t    from base64 import b64encode\n80\t    from io import BytesIO\n81\t\n82\t    try:\n83\t        from PIL import Image, ImageOps\n84\t    except ImportError:\n85\t        print(\"Pillow absent : previews non embarquees, le mode heavy exigera un service local\")\n86\t        return None\n87\t\n88\t    entries = []\n89\t    total = 0\n90\t    for image in images:\n91\t        with Image.open(image[\"path\"]) as raw:\n92\t            preview = ImageOps.exif_transpose(raw).convert(\"RGB\")\n93\t        if preview.width > max_width:\n94\t            height = round(preview.height * max_width / preview.width)\n95\t            preview = preview.resize((max_width, height), Image.LANCZOS)\n96\t        buffer = BytesIO()\n97\t        preview.save(buffer, \"JPEG\", quality=quality, optimize=True)\n98\t        payload = b64encode(buffer.getvalue()).decode(\"ascii\")\n99\t        total += len(payload)\n100\t        entries.append(f'  \"{image[\"id\"]}\": \"data:image/jpeg;base64,{payload}\"')\n101\t\n102\t    body = \",\\n\".join(entries)\n103\t    (dest / \"_previews.js\").write_text(\n104\t        \"// Apercus embarques, generes par zr-hda-instance.py.\\n\"\n105\t        \"// Une data URI est same-origin : WebGL l'accepte meme en file://, ce qu'il\\n\"\n106\t        \"// refuse pour un fichier local. C'est ce qui rend l'instance autonome.\\n\"\n107\t        \"// Le rendu FINAL n'utilise jamais ces apercus : le cook lit les originaux.\\n\"\n108\t        f\"window.ZR_PREVIEWS = {{\\n{body}\\n}};\\n\"\n109\t    )\n110\t    return total\n111\t\n112\t\n113\tdef collect_images(source_dir):\n114\t    files = sorted(\n115\t        (p for p in source_dir.iterdir()\n116\t         if p.is_file() and p.suffix in IMAGE_SUFFIXES and not p.name.startswith(\".\")),\n117\t        key=lambda p: p.name.lower(),\n118\t    )\n119\t    images = []\n120\t    for position, path in enumerate(files, start=1):\n121\t        width, height = measure(path)\n122\t        images.append({\n123\t            \"id\": f\"{position:02d}\",\n124\t            \"file\": path.name,\n125\t            \"path\": str(path),\n126\t            \"width\": width,\n127\t            \"height\": height,\n128\t        })\n129\t    return images\n130\t\n131\t\n132\tdef render_template(mode, dest, project, source_dir, images, target_format):\n133\t    template_dir = TEMPLATES / f\"hda-{mode}\"\n134\t    if not template_dir.is_dir():\n135\t        raise SystemExit(f\"gabarit introuvable : {template_dir}\")\n136\t\n137\t    dest.mkdir(parents=True, exist_ok=True)\n138\t    for item in template_dir.iterdir():\n139\t        target = dest / item.name\n140\t        if item.is_dir():\n141\t            shutil.copytree(item, target, dirs_exist_ok=True)\n142\t        else:\n143\t            shutil.copy2(item, target)\n144\t\n145\t    html_path = dest / \"index.html\"\n146\t    html = html_path.read_text()\n147\t\n148\t    # Le JS porte l'id, le nom ET les dimensions REELLES de l'original : ce sont\n149\t    # elles qui servent a l'auto-fit du texte et au choix du nombre d'ancres,\n150\t    # jamais celles de l'apercu reduit, sans quoi une taille en px annoncee ne\n151\t    # correspondrait pas au JPEG final.\n152\t    light_images = [\n153\t        {\"id\": i[\"id\"], \"file\": i[\"file\"], \"w\": i[\"width\"], \"h\": i[\"height\"]}\n154\t        for i in images\n155\t    ]\n156\t    payload = json.dumps(light_images, indent=4, ensure_ascii=False)\n157\t    payload = payload.replace(\"\\n\", \"\\n  \")\n158\t\n159\t    # Chemin RELATIF, jamais `file://` absolu. Deux raisons, la seconde est\n160\t    # bloquante : un chemin relatif marche aussi bien en file:// qu'en http, et\n161\t    # surtout WebGL REFUSE une texture issue d'une origine opaque, ce qu'est\n162\t    # tout fichier ouvert en file://. Avec `file://`, le canvas du mode heavy\n163\t    # restait vide alors que les vignettes s'affichaient (elles, ne passent pas\n164\t    # par texImage2D). En relatif plus service local, tout est same-origin.\n165\t    relative = os.path.relpath(source_dir, dest)\n166\t    substitutions = {\n167\t        \"__ZR_PROJECT__\": project,\n168\t        \"__ZR_SOURCE_DIR__\": relative.rstrip(\"/\") + \"/\",\n169\t        \"__ZR_IMAGES__\": payload,\n170\t        \"__ZR_DEFAULT_FORMAT__\": target_format,\n171\t    }\n172\t    for key, value in substitutions.items():\n173\t        html = html.replace(key, value)\n174\t\n175\t    leftover = sorted(set(re.findall(r\"__ZR_[A-Z_]+__\", html)))\n176\t    if leftover:\n177\t        raise SystemExit(f\"parametres non substitues : {leftover}\")\n178\t    html_path.write_text(html)\n179\t\n180\t    (dest / \"_index.json\").write_text(json.dumps(\n181\t        {\"dossier_source\": str(source_dir), \"images\": images}, indent=2, ensure_ascii=False) + \"\\n\")\n182\t\n183\t    # Le mode heavy lit des pixels (WebGL), donc il lui faut des apercus\n184\t    # same-origin pour fonctionner en file://. Le light n'affiche que des\n\n... [127 lines truncated] ..."},"type":"attachment","uuid":"21062855-191a-4df9-b831-33a4888db3df","timestamp":"2026-09-01T09:22:08.234Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"068e9161-445a-4e75-a52f-e12511b3ad70","version":"2.1.247","gitBranch":"main"}
