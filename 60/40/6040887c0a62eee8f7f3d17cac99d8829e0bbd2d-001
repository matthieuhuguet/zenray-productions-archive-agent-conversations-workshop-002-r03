ont_key, weight, size):\n    size = max(1, round(size))\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])  # InterVariable, axe wght natif\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    \"\"\"Coin haut-gauche (x,y) du texte pour dessiner `bbox` a l'ancre donnee.\n    Meme convention que le CSS (text-align + top/middle/bottom + marge 6%).\"\"\"\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_captions(canvas, text_cfgs, canvas_w, canvas_h):\n    \"\"\"Dessine 0 a N calques de texte, dans l'ordre donne (T1 puis T2 puis T3).\n    Accepte aussi l'ancien format mono-calque (un dict au lieu d'une liste).\"\"\"\n    if not text_cfgs:\n        return canvas\n    if isinstance(text_cfgs, dict):\n        text_cfgs = [text_cfgs]\n    for text_cfg in text_cfgs:\n        canvas = draw_caption(canvas, text_cfg, canvas_w, canvas_h)\n    return canvas\n\n\ndef draw_caption(canvas, text_cfg, canvas_w, canvas_h):\n    if not text_cfg or not text_cfg.get(\"value\", \"\").strip():\n        return canvas\n    if \"enabled\" in text_cfg and not text_cfg.get(\"enabled\"):\n        return canvas\n    value = text_cfg[\"value\"].strip()\n    font_key = text_cfg.get(\"font\", \"serif\")\n    weight = int(text_cfg.get(\"weight\", 400))\n    color = text_cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (text_cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # Auto-fit : jamais l'inverse. Part de la taille demandee (px, dans\n    # l'espace du canevas de sortie, meme convention que le curseur JS) et la\n    # retrecit tant que la boite de texte deborde la largeur padee OU les\n    # bords memes du cadre (0..canvas_w, 0..canvas_h). La police ne sort\n    # jamais du cadre pour \"cropper\" le texte, elle s'adapte a la taille\n    # maximale qui tient.\n    font_size = round(text_cfg.get(\"size_px\", 200))\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        text_w = bbox[2] - bbox[0]\n        if text_w > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        left, top = x + bbox[0], y + bbox[1]\n        right, bottom = x + bbox[2], y + bbox[3]\n        return left >= 0 and top >= 0 and right <= canvas_w and bottom <= canvas_h\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\ndef main():\n    index = json.loads((HERE / \"_index.json\").read_text())\n    params = json.loads((HERE / \"_crop_params.json\").read_text())\n    by_id = {img[\"id\"]: img for img in index[\"images\"]}\n\n    fmt = params[\"format\"]\n    canvas_w = fmt[\"w\"] * fmt[\"factor\"]\n    canvas_h = fmt[\"h\"] * fmt[\"factor\"]\n\n    OUT_DIR.mkdir(exist_ok=True)\n    written = []\n    for p in params[\"images\"]:\n        entry = by_id.get(p[\"id\"])\n        if entry is None:\n            raise SystemExit(f\"id {p['id']} absent de _index.json\")\n        src_path = Path(entry[\"path\"])\n        if not src_path.exists():\n            src_path = SOURCE_DIR / entry[\"file\"]\n        assert src_path.exists(), f\"source introuvable : {src_path}\"\n\n        im = Image.open(src_path)\n        im = ImageOps.exif_transpose(im)  # aligne sur ce qu'affiche un navigateur (EXIF)\n        im = im.convert(\"RGB\")\n        nw, nh = im.size\n\n        coeffs = affine_coeffs(nw, nh, canvas_w, canvas_h, p[\"x\"], p[\"y\"], p[\"zoom\"], p.get(\"rotate\", 0))\n        out = im.transform((canvas_w, canvas_h), Image.AFFINE, data=coeffs, resample=Image.BICUBIC)\n        out = draw_caption(out, p.get(\"text\"), canvas_w, canvas_h)\n\n        out_path = OUT_DIR / f'{p[\"id\"]}-{Path(entry[\"file\"]).stem}.jpg'\n        quality = 95\n        out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n        size_mb = out_path.stat().st_size / 1_048_576\n        while size_mb > 8 and quality > 60:\n            quality -= 5\n            out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n            size_mb = out_path.stat().st_size / 1_048_576\n\n        written.append(out_path)\n        print(f\"{out_path.name}: {out.size[0]}x{out.size[1]}  q{quality}  {size_mb:.2f} Mo\")\n\n    print(f\"\\n{len(written)} images ecrites dans {OUT_DIR}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":186,"oldLines":7,"newStart":186,"newLines":7,"lines":[" ","         coeffs = affine_coeffs(nw, nh, canvas_w, canvas_h, p[\"x\"], p[\"y\"], p[\"zoom\"], p.get(\"rotate\", 0))","         out = im.transform((canvas_w, canvas_h), Image.AFFINE, data=coeffs, resample=Image.BICUBIC)","-        out = draw_caption(out, p.get(\"text\"), canvas_w, canvas_h)","+        out = draw_captions(out, p.get(\"text\"), canvas_w, canvas_h)"," ","         out_path = OUT_DIR / f'{p[\"id\"]}-{Path(entry[\"file\"]).stem}.jpg'","         quality = 95"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"6de3e3b1-d4c4-4512-8a7b-79d2f00b2b04","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"068e9161-445a-4e75-a52f-e12511b3ad70","version":"2.1.247","gitBranch":"main"}
