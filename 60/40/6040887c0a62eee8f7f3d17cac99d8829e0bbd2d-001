\" class=\"zr-photo-status\" role=\"status\"></p>\n132\t  </aside>\n133\t\n134\t  <script src=\"assets/photo-controls/zr-photo-adjustments.js\"></script>\n135\t  <script>\n136\t    \"use strict\";\n137\t    const CONFIG = {\"canvas\": {\"width\": 1672, \"height\": 941}, \"background\": \"/Users/zenray/Downloads/tmp-thewitcher3-artdirection/assets/background-02-enhanced-combat-clean.png\", \"template_id\": \"single_center\", \"primary_text\": \"ENHANCED COMBAT\", \"secondary_text\": \"\", \"primary\": {\"font_url\": \"file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\", \"font_family\": \"AnthropicSerif\", \"font_size\": 42, \"font_weight\": 400, \"letter_spacing\": 10.8, \"anchor_x\": 841, \"baseline_y\": 503, \"color\": \"#f0ede5\", \"shadow\": \"0 1px 2px rgba(0,0,0,0.46)\"}, \"secondary\": null, \"photo\": {\"vignette\": 0, \"selective\": [{\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}], \"levels\": {\"inputBlack\": 0, \"midtone\": 50, \"inputWhite\": 100, \"outputBlack\": 0, \"outputWhite\": 100}, \"blackAndWhite\": 0, \"saturation\": 0, \"vibrance\": 0, \"brilliance\": 0, \"exposure\": 0, \"highlights\": 0, \"shadows\": 0, \"brightness\": 0, \"contrast\": 0, \"blackPoint\": 0, \"filter\": \"Original\", \"filterStrength\": 100}, \"output\": \"out/template-previews/generated-template.png\"};\n138\t    const root = document.documentElement;\n139\t    const canvas = document.querySelector(\"#photo\");\n140\t    const source = document.querySelector(\"#source\");\n141\t    const primaryText = document.querySelector(\"#primary-text\");\n142\t    const secondaryText = document.querySelector(\"#secondary-text\");\n143\t    const editorialLayer = document.querySelector(\"#editorial-layer\");\n144\t    const editorialDivider = document.querySelector(\"#editorial-divider\");\n145\t    const editorialDiamond = document.querySelector(\"#editorial-diamond\");\n146\t    const editorialText = document.querySelector(\"#editorial-text\");\n147\t    const status = document.querySelector(\"#status\");\n148\t    const processor = new ZRPhotoAdjustments(canvas);\n149\t    const filterNames = ZRPhotoAdjustments.filters();\n150\t    const channelNames = [\"Rouge\", \"Jaune\", \"Vert\", \"Cyan\", \"Bleu\", \"Magenta\"];\n151\t    let selectedChannel = 0;\n152\t    let selectedFilter = CONFIG.photo.filter;\n153\t    let framePending = false;\n154\t\n155\t    root.style.setProperty(\"--zr-canvas-width\", `${CONFIG.canvas.width}px`);\n156\t    root.style.setProperty(\"--zr-canvas-height\", `${CONFIG.canvas.height}px`);\n157\t    root.style.setProperty(\"--zr-canvas-ratio\", CONFIG.canvas.width / CONFIG.canvas.height);\n158\t    document.querySelector(\"#text-layers\").setAttribute(\"viewBox\", `0 0 ${CONFIG.canvas.width} ${CONFIG.canvas.height}`);\n159\t\n160\t    function setVariable(name, value) {\n161\t      root.style.setProperty(name, String(value));\n162\t    }\n163\t\n164\t    function getVariable(name) {\n165\t      return Number.parseFloat(getComputedStyle(root).getPropertyValue(name));\n166\t    }\n167\t\n168\t    function slider(parent, label, variable, min, max, value, step = 1) {\n169\t      const row = document.createElement(\"label\");\n170\t      row.className = \"zr-photo-control\";\n171\t      const name = document.createElement(\"span\");\n172\t      name.textContent = label;\n173\t      const input = document.createElement(\"input\");\n174\t      input.type = \"range\";\n175\t      input.min = min;\n176\t      input.max = max;\n177\t      input.step = step;\n178\t      input.value = value;\n179\t      input.dataset.variable = variable;\n180\t      const output = document.createElement(\"output\");\n181\t      output.value = Math.round(Number(value));\n182\t      input.addEventListener(\"input\", () => {\n183\t        setVariable(variable, input.value);\n184\t        output.value = Math.round(Number(input.value));\n185\t        scheduleRender();\n186\t      });\n187\t      row.append(name, input, output);\n188\t      parent.append(row);\n189\t      setVariable(variable, value);\n190\t      return { input, output };\n191\t    }\n192\t\n193\t    function makeControls() {\n194\t      const text = document.querySelector(\"#text-controls\");\n195\t      slider(text, \"Principal X\", \"--zr-primary-x\", 0, CONFIG.canvas.width, CONFIG.primary.anchor_x);\n196\t      slider(text, \"Principal Y\", \"--zr-primary-y\", 0, CONFIG.canvas.height, CONFIG.primary.baseline_y);\n197\t      slider(text, \"Taille\", \"--zr-primary-size\", 8, 240, CONFIG.primary.font_size);\n198\t      slider(text, \"Interlettrage\", \"--zr-primary-tracking\", -20, 100, CONFIG.primary.letter_spacing, 0.1);\n199\t\n200\t      slider(document.querySelector(\"#vignette-controls\"), \"Strength\", \"--zr-photo-vignette\", 0, 100, CONFIG.photo.vignette);\n201\t      const selectiveTabs = document.querySelector(\"#selective-tabs\");\n202\t      channelNames.forEach((name, index) => {\n203\t        const button = document.createElement(\"button\");\n204\t        button.type = \"button\";\n205\t        button.dataset.channel = index;\n206\t        button.title = name;\n207\t        button.setAttribute(\"aria-label\", name);\n208\t        button.setAttribute(\"aria-pressed\", index === selectedChannel ? \"true\" : \"false\");\n209\t        button.addEventListener(\"click\", () => selectChannel(index));\n210\t        selectiveTabs.append(button);\n211\t      });\n212\t      const selective = document.querySelector(\"#selective-controls\");\n213\t      slider(selective, \"Hue\", \"--zr-photo-selective-active-hue\", -100, 100, 0);\n214\t      slider(selective, \"Saturation\", \"--zr-photo-selective-active-saturation\", -100, 100, 0);\n215\t      slider(selective, \"Luminance\", \"--zr-photo-selective-active-luminance\", -100, 100, 0);\n216\t      CONFIG.photo.selective.forEach((value, index) => {\n217\t        setVariable(`--zr-photo-selective-${index}-hue`, value.hue);\n218\t        setVariable(`--zr-photo-selective-${index}-saturation`, value.saturation);\n219\t        setVariable(`--zr-photo-selective-${index}-luminance`, value.luminance);\n220\t      });\n221\t      for (const input of selective.querySelectorAll(\"input\")) {\n222\t        input.addEventListener(\"input\", () => {\n223\t          const property = input.dataset.variable.split(\"-\").at(-1);\n224\t          setVariable(`--zr-photo-selective-${selectedChannel}-${property}`, input.value);\n225\t        });\n226\t      }\n227\t      selectChannel(0);\n228\t\n229\t      const levels = document.querySelector(\"#levels-controls\");\n230\t      slider(levels, \"Input Black\", \"--zr-photo-level-input-black\", 0, 100, CONFIG.photo.levels.inputBlack);\n231\t      slider(levels, \"Midtone\", \"--zr-photo-level-midtone\", 0, 100, CONFIG.photo.levels.midtone);\n232\t      slider(levels, \"Input White\", \"--zr-photo-level-input-white\", 0, 100, CONFIG.photo.levels.inputWhite);\n233\t      slider(levels, \"Output Black\", \"--zr-photo-level-output-black\", 0, 100, CONFIG.photo.levels.outputBlack);\n234\t      slider(levels, \"Output White\", \"--zr-photo-level-output-white\", 0, 100, CONFIG.photo.levels.outputWhite);\n235\t\n236\t      slider(document.querySelector(\"#black-white-controls\"), \"Strength\", \"--zr-photo-black-and-white\", 0, 100, CONFIG.photo.blackAndWhite);\n237\t      const color = document.querySelector(\"#color-controls\");\n238\t      slider(color, \"Saturation\", \"--zr-photo-saturation\", -100, 100, CONFIG.photo.saturation);\n239\t      slider(color, \"Vibrance\", \"--zr-photo-vibrance\", -100, 100, CONFIG.photo.vibrance);\n240\t\n241\t      const light = document.querySelector(\"#light-controls\");\n242\t      [\n243\t        [\"Brilliance\", \"brilliance\"], [\"Exposure\", \"exposure\"], [\"Highlights\", \"highlights\"],\n244\t        [\"Shadows\", \"shadows\"], [\"Brightness\", \"brightness\"], [\"Contrast\", \"contrast\"], [\"Black Point\", \"blackPoint\"]\n245\t      ].forEach(([label, key]) => slider(light, label, `--zr-photo-${key.replace(/[A-Z]/g, match => `-${match.toLowerCase()}`)}`, -100, 100, CONFIG.photo[key]));\n246\t\n247\t      const filterButtons = document.querySelector(\"#filter-buttons\");\n248\t      filterNames.forEach(name => {\n249\t        const button = document.createElement(\"button\");\n250\t        button.type = \"button\";\n251\t        button.textContent = name;\n252\t        button.dataset.filter = name;\n253\t        button.setAttribute(\"aria-pressed\", name === selectedFilter ? \"true\" : \"false\");\n254\t        button.addEventListener(\"click\", () => {\n255\t          selectedFilter = name;\n256\t          filterButtons.querySelectorAll(\"button\").forEach(item => item.setAttribute(\"aria-pressed\", item === button ? \"true\" : \"false\"));\n257\t          scheduleRender();\n258\t        });\n259\t        filterButtons.append(button);\n260\t      });\n261\t      slider(document.querySelector(\"#filter-controls\"), \"Strength\", \"--zr-photo-filter-strength\", 0, 100, CONFIG.photo.filterStrength);\n262\t    }\n263\t\n264\t    function selectChannel(index) {\n265\t      selectedChannel = index;\n266\t      document.querySelectorAll(\"#selective-tabs button\").forEach(button => button.setAttribute(\"aria-pressed\", Number(button.dataset.channel) === index ? \"true\" : \"false\"));\n267\t      for (const property of [\"hue\", \"saturation\", \"luminance\"]) {\n268\t        const value = getVariable(`--zr-photo-selective-${index}-${property}`);\n269\t        setVariable(`--zr-photo-selective-active-${property}`, value);\n270\t        const input = document.querySelector(`[data-variable=\"--zr-photo-selective-active-${property}\"]`);\n271\t        input.value = value;\n272\t        input.nextElementSibling.value = Math.round(value);\n273\t      }\n274\t    }\n275\t\n276\t    function photoValues() {\n277\t      return {\n278\t        vignette: getVariable(\"--zr-photo-vignette\"),\n279\t        selective: channelNames.map((_, index) => ({\n280\t          hue: getVariable(`--zr-photo-selective-${index}-hue`),\n281\t          saturation: getVariable(`--zr-photo-selective-${index}-saturation`),\n282\t          luminance: getVariable(`--zr-photo-selective-${index}-luminance`)\n283\t        })),\n284\t        levels: {\n285\t          inputBlack: getVariable(\"--zr-photo-level-input-black\"),\n286\t          midtone: getVariable(\"--zr-photo-level-midtone\"),\n287\t          inputWhite: getVariable(\"--zr-photo-level-input-white\"),\n288\t          outputBlack: getVariable(\"--zr-photo-level-output-black\"),\n289\t          outputWhite: getVariable(\"--zr-photo-level-output-white\")\n290\t        },\n291\t        blackAndWhite: getVariable(\"--zr-photo-black-and-white\"),\n292\t        saturation: getVariable(\"--zr-photo-saturation\"),\n293\t        vibrance: getVariable(\"--zr-photo-vibrance\"),\n294\t        brilliance: getVariable(\"--zr-photo-brilliance\"),\n295\t        exposure: getVariable(\"--zr-photo-exposure\"),\n296\t        highlights: getVariable(\"--zr-photo-highlights\"),\n297\t        shadows: getVariable(\"--zr-photo-shadows\"),\n298\t        brightness: getVariable(\"--zr-photo-brightness\"),\n299\t        contrast: getVariable(\"--zr-photo-contrast\"),\n300\t        blackPoint: getVariable(\"--zr-photo-black-point\"),\n301\t        filter: selectedFilter,\n302\t        filterStrength: getVariable(\"--zr-photo-filter-strength\")\n303\t      };\n304\t    }\n305\t\n306\t    function drawText() {\n307\t      primaryText.textContent = document.querySelector(\"#primary-input\").value.toUpperCase();\n308\t      secondaryText.textContent = document.querySelector(\"#secondary-input\").value.toUpperCase();\n309\t      primaryText.setAttribute(\"x\", getVariable(\"--zr-primary-x\"));\n310\t      primaryText.setAttribute(\"y\", getVariable(\"--zr-primary-y\"));\n311\t      primaryText.style.fontSize = `${getVariable(\"--zr-primary-size\")}px`;\n312\t      primaryText.style.letterSpacing = `${getVariable(\"--zr-primary-tracking\")}px`;\n313\t      fitText(primaryText, getVariable(\"--zr-primary-size\"), getVariable(\"--zr-primary-tracking\"), CONFIG.editorial ? CONFIG.editorial.divider.x - 60 : CONFIG.canvas.width * 0.86);\n314\t      if (CONFIG.secondary) {\n315\t        secondaryText.setAttribute(\"x\", CONFIG.secondary.anchor_x);\n316\t        secondaryText.setAttribute(\"y\", CONFIG.secondary.baseline_y);\n317\t        secondaryText.style.fontSize = `${CONFIG.secondary.font_size}px`;\n318\t        secondaryText.style.letterSpacing = `${CONFIG.secondary.letter_spacing}px`;\n319\t        fitText(secondaryText, CONFIG.secondary.font_size, CONFIG.secondary.letter_spacing, CONFIG.canvas.width * 0.86);\n320\t      }\n321\t      if (CONFIG.editorial) {\n322\t        editorialLayer.hidden = false;\n323\t        const divider = CONFIG.editorial.divider;\n324\t        const dividerCenter = divider.x + divider.width / 2;\n325\t        editorialDivider.setAttribute(\"x1\", dividerCenter);\n326\t        editorialDivider.setAttribute(\"x2\", dividerCenter);\n327\t        editorialDivider.setAttribute(\"y1\", divider.y);\n328\t        editorialDivider.setAttribute(\"y2\", divider.y + divider.height);\n329\t        editorialDivider.setAttribute(\"stroke-width\", divider.width);\n330\t        const diamondY = CONFIG.editorial.diamond_center_y;\n331\t        editorialDiamond.setAttribute(\"d\", `M ${dividerCenter} ${diamondY - 13} L ${dividerCenter + 13} ${diamondY} L ${dividerCenter} ${diamondY + 13} L ${dividerCenter - 13} ${diamondY} Z`);\n332\t        editorialText.replaceChildren();\n333\t        editorialText.setAttribute(\"x\", CONFIG.editorial.list.x);\n334\t        editorialText.style.fontSize = `${CONFIG.editorial.list.font_size}px`;\n335\t        editorialText.style.letterSpacing = `${CONFIG.editorial.list.letter_spacing}px`;\n336\t        CONFIG.editorial.list.lines.forEach((line, index) => {\n337\t          const span = document.createElementNS(\"http://www.w3.org/2000/svg\", \"tspan\");\n338\t          span.setAttribute(\"x\", CONFIG.editorial.list.x);\n339\t          const baseline = CONFIG.editorial.list.baseline_y_by_line[index]\n340\t            ?? CONFIG.editorial.list.baseline_y_by_line[CONFIG.editorial.list.baseline_y_by_line.length - 1];\n341\t          span.setAttribute(\"y\", baseline);\n342\t          span.textContent = line;\n343\t          editorialText.append(span);\n344\t        });\n345\t        const finalBaseline = CONFIG.editorial.list.baseline_y_by_line[Math.min(\n346\t          CONFIG.editorial.list.lines.length,\n347\t          CONFIG.editorial.list.baseline_y_by_line.length\n348\t        ) - 1];\n349\t        document.body.dataset.editorialFit = finalBaseline <= CONFIG.canvas.height * 0.94 ? \"pass\" : \"fail\";\n350\t      }\n351\t    }\n352\t\n353\t    function fitText(node, baseSize, baseTracking, maximumWidth) {\n354\t      node.style.fontSize = `${baseSize}px`;\n355\t      node.style.letterSpacing = `${baseTracking}px`;\n356\t      const measured = node.getComputedTextLength();\n357\t      const scale = measured > maximumWidth ? maximumWidth / measured : 1;\n358\t      node.style.fontSize = `${baseSize * scale}px`;\n359\t      node.style.letterSpacing = `${baseTracking * scale}px`;\n360\t      node.dataset.fitScale = scale.toFixed(4);\n361\t      const current = Number(document.body.dataset.textFitScale || 1);\n362\t      const minimumScale = Math.min(current, scale);\n363\t      document.body.dataset.textFitScale = minimumScale.toFixed(4);\n364\t      document.body.dataset.textFit = minimumScale >= 0.55 ? \"pass\" : \"fail\";\n365\t    }\n366\t\n367\t    function scheduleRender() {\n368\t      if (framePending) return;\n369\t      framePending = true;\n370\t      requestAnimationFrame(() => {\n371\t        framePending = false;\n372\t        processor.set(photoValues());\n373\t        drawText();\n374\t      });\n375\t    }\n376\t\n377\t    function neutralSettings(values) {\n378\t      const clean = ZRPhotoAdjustments.defaults();\n379\t      return JSON.stringify(values) === JSON.stringify(clean);\n380\t    }\n381\t\n382\t    function verifyNeutralPixel(values) {\n383\t      if (!neutralSettings(values)) return { status: \"skipped\", delta: null };\n384\t      // Le PNG d'entrée peut porter un profil ICC que Canvas et WebGL décodent\n385\t      // différemment. Le contrôle emploie donc une charte non profilée, puis\n386\t      // compare la sortie neutre à ses pixels sources exacts.\n387\t      const chart = document.createElement(\"canvas\");\n388\t      chart.width = 4;\n389\t      chart.height = 2;\n390\t      const context = chart.getContext(\"2d\", { willReadFrequently: true });\n391\t      const swatches = [\"#102030\", \"#d64a46\", \"#4db56d\", \"#4775cc\", \"#f0c060\", \"#b954b5\", \"#dadada\", \"#050505\"];\n392\t      swatches.forEach((color, index) => {\n393\t        context.fillStyle = color;\n394\t        context.fillRect(index % chart.width, Math.floor(index / chart.width), 1, 1);\n395\t      });\n396\t      const expected = context.getImageData(0, 0, chart.width, chart.height).data;\n397\t      const testCanvas = document.createElement(\"canvas\");\n398\t      const testProcessor = new ZRPhotoAdjustments(testCanvas);\n399\t      testProcessor.setImage(chart);\n400\t      testProcessor.set(ZRPhotoAdjustments.defaults());\n401\t      const actual = new Uint8Array(expected.length);\n402\t      testProcessor.gl.readPixels(0, 0, chart.width, chart.height, testProcessor.gl.RGBA, testProcessor.gl.UNSIGNED_BYTE, actual);\n403\t      let delta = 0;\n404\t      for (let y = 0; y < chart.height; y += 1) {\n405\t        for (let x = 0; x < chart.width; x += 1) {\n406\t          const sourceOffset = (y * chart.width + x) * 4;\n407\t          const glOffset = ((chart.height - y - 1) * chart.width + x) * 4;\n408\t          for (let channel = 0; channel < 3; channel += 1) {\n409\t            delta = Math.max(delta, Math.abs(expected[sourceOffset + channel] - actual[glOffset + channel]));\n410\t          }\n411\t        }\n412\t      }\n413\t      return { status: delta <= 1 ? \"pass\" : \"fail\", delta };\n414\t    }\n415\t\n416\t    function verifyEveryEffect() {\n417\t      const chart = document.createElement(\"canvas\");\n418\t      chart.width = 8;\n419\t      chart.height = 8;\n420\t      const context = chart.getContext(\"2d\");\n421\t      const swatches = [\"#d64a46\", \"#d5b94a\", \"#4db56d\", \"#50b8bd\", \"#4775cc\", \"#b954b5\", \"#b5a78e\", \"#34383f\"];\n422\t      swatches.forEach((color, index) => {\n423\t        context.fillStyle = color;\n424\t        context.fillRect(index, 0, 1, 8);\n425\t      });\n426\t      const testCanvas = document.createElement(\"canvas\");\n427\t      const testProcessor = new ZRPhotoAdjustments(testCanvas);\n428\t      testProcessor.setImage(chart);\n429\t      const read = values => {\n430\t        testProcessor.set(values);\n431\t        const pixels = new Uint8Array(chart.width * chart.height * 4);\n432\t        testProcessor.gl.readPixels(0, 0, chart.width, chart.height, testProcessor.gl.RGBA, testProcessor.gl.UNSIGNED_BYTE, pixels);\n433\t        return pixels;\n434\t      };\n435\t      const baseline = read(ZRPhotoAdjustments.defaults());\n436\t      const differs = values => {\n437\t        const pixels = read(values);\n438\t        return pixels.some((value, index) => index % 4 !== 3 && Math.abs(value - baseline[index]) > 1);\n439\t      };\n440\t      const cases = [\n441\t        [\"vignette\", { vignette: 100 }],\n442\t        [\"blackAndWhite\", { blackAndWhite: 100 }],\n443\t        [\"saturation\", { saturation: 100 }],\n444\t        [\"vibrance\", { vibrance: 100 }],\n445\t        [\"brilliance\", { brilliance: 100 }],\n446\t        [\"exposure\", { exposure: 100 }],\n447\t        [\"highlights\", { highlights: 100 }],\n448\t        [\"shadows\", { shadows: 100 }],\n449\t        [\"brightness\", { brightness: 100 }],\n450\t        [\"contrast\", { contrast: 100 }],\n451\t        [\"blackPoint\", { blackPoint: 100 }],\n452\t        [\"levelInputBlack\", { levels: { inputBlack: 20 } }],\n453\t        [\"levelMidtone\", { levels: { midtone: 70 } }],\n454\t        [\"levelInputWhite\", { levels: { inputWhite: 80 } }],\n455\t        [\"levelOutputBlack\", { levels: { outputBlack: 20 } }],\n456\t        [\"levelOutputWhite\", { levels: { outputWhite: 80 } }]\n457\t      ];\n458\t      for (let index = 0; index < 6; index += 1) {\n459\t        const selective = ZRPhotoAdjustments.defaults().selective;\n460\t        selective[index].luminance = 100;\n461\t        cases.push([`selective${index}`, { selective }]);\n462\t      }\n463\t      filterNames.slice(1).forEach(filter => cases.push([`filter${filter}`, { filter, filterStrength: 100 }]));\n464\t      const failures = cases.filter(([, values]) => !differs(values)).map(([name]) => name);\n465\t      const zeroStrength = read({ filter: \"Vivid\", filterStrength: 0 });\n466\t      if (zeroStrength.some((value, index) => Math.abs(value - baseline[index]) > 1)) failures.push(\"filterStrengthZero\");\n467\t      return { status: failures.length ? \"fail\" : \"pass\", failures, count: cases.length + 1 };\n468\t    }\n469\t\n470\t    function initialize() {\n471\t      makeControls();\n472\t      document.querySelector(\"#primary-input\").value = CONFIG.primary_text;\n473\t      document.querySelector(\"#secondary-input\").value = CONFIG.secondary_text;\n474\t      document.querySelector(\"#primary-input\").addEventListener(\"input\", scheduleRender);\n475\t      document.querySelector(\"#secondary-input\").addEventListener(\"input\", scheduleRender);\n476\t      root.style.setProperty(\"--zr-primary-family\", CONFIG.primary.font_family);\n477\t      root.style.setProperty(\"--zr-primary-weight\", CONFIG.primary.font_weight);\n478\t      root.style.setProperty(\"--zr-text-color\", CONFIG.primary.color);\n479\t      root.style.setProperty(\"--zr-text-shadow\", CONFIG.primary.shadow);\n480\t      source.src = CONFIG.background;\n481\t      source.addEventListener(\"load\", async () => {\n482\t        processor.setImage(source);\n483\t        processor.set(photoValues());\n484\t        drawText();\n485\t        await document.fonts.load(`${CONFIG.primary.font_size}px \"${CONFIG.primary.font_family}\"`, CONFIG.primary_text || \"M\");\n486\t        await document.fonts.ready;\n487\t        document.body.dataset.fontReady = document.fonts.check(`${CONFIG.primary.font_size}px \"${CONFIG.primary.font_family}\"`, CONFIG.primary_text || \"M\") ? \"pass\" : \"fail\";\n488\t        drawText();\n489\t        const test = verifyNeutralPixel(photoValues());\n490\t        const effectsTest = verifyEveryEffect();\n491\t        document.body.dataset.neutralTest = test.status;\n492\t        document.body.dataset.effectsTest = effectsTest.status;\n493\t        document.body.dataset.effectsCount = effectsTest.count;\n494\t        status.textContent = test.status === \"pass\" ? `Fond neutre vérifié, écart maximal ${test.delta}` : `Test neutre ${test.status}`;\n495\t        if (effectsTest.status !== \"pass\") status.textContent += `, effets en échec : ${effectsTest.failures.join(\", \")}`;\n496\t        document.body.dataset.renderReady = \"true\";\n497\t      }, { once: true });\n498\t      source.addEventListener(\"error\", () => { throw new Error(`Fond introuvable : ${CONFIG.background}`); }, { once: true });\n499\t    }\n500\t\n501\t    document.querySelector(\"#reset\").addEventListener(\"click\", () => location.reload());\n502\t    document.querySelector(\"#copy\").addEventListener(\"click\", async () => {\n503\t      const payload = {\n504\t        template_id: CONFIG.template_id,\n505\t        primary_text: document.querySelector(\"#primary-input\").value,\n506\t        secondary_text: document.querySelector(\"#secondary-input\").value,\n507\t        primary: {\n508\t          anchor_x: getVariable(\"--zr-primary-x\"), baseline_y: getVariable(\"--zr-primary-y\"),\n509\t          font_size: getVariable(\"--zr-primary-size\"), letter_spacing: getVariable(\"--zr-primary-tracking\")\n510\t        },\n511\t        photo: photoValues()\n512\t      };\n513\t      await navigator.clipboard.writeText(JSON.stringify(payload, null, 2));\n514\t      status.textContent = \"Valeurs copiées\";\n515\t    });\n516\t    if (new URLSearchParams(location.search).has(\"render\")) root.classList.add(\"render\");\n517\t    initialize();\n518\t  </script>\n519\t</body>\n520\t</html>\n521\t"}]},"uuid":"b3de5369-33e1-4429-b0fc-c63510100e6e","timestamp":"2026-09-01T07:59:21.814Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Downloads/tmp-thewitcher3-artdirection/template-workshop.html","content":"<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <base href=\"file:///Users/zenray/Downloads/tmp-thewitcher3-artdirection/\">\n  <title>Template Creator</title>\n  <link rel=\"stylesheet\" href=\"assets/photo-controls/zr-photo-adjustments.css\">\n  <style>\n    @font-face { font-family: AnthropicSerif; src: url(\"file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\"); font-weight: 400; }\n    @font-face { font-family: AnthropicMono; src: url(\"file:///Users/zenray/Library/Fonts/AnthropicMono-Regular.ttf\"); font-weight: 400; }\n    @font-face { font-family: Inter; src: url(\"file:///Users/zenray/Library/Fonts/InterVariable.ttf\"); font-weight: 100 900; }\n    @font-face { font-family: Cinzel; src: url(\"assets/fonts/Cinzel-Variable.ttf\"); font-weight: 400 900; }\n    :root {\n      --zr-primary-x: 836;\n      --zr-primary-y: 503;\n      --zr-primary-size: 42;\n      --zr-primary-tracking: 10.8;\n      --zr-secondary-x: 836;\n      --zr-secondary-y: 458;\n      --zr-secondary-size: 25;\n      --zr-secondary-tracking: 8;\n    }\n    * { box-sizing: border-box; }\n    html, body { width: 100%; min-height: 100%; margin: 0; background: #0b0c0f; }\n    body { display: grid; place-items: center; color: white; font-family: Inter, sans-serif; }\n    .stage {\n      position: relative;\n      width: min(100vw, calc(100vh * var(--zr-canvas-ratio)));\n      aspect-ratio: var(--zr-canvas-ratio);\n      overflow: hidden;\n      background: black;\n    }\n    #photo,\n    #text-layers {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n    }\n    #source { display: none; }\n    #text-layers { overflow: visible; pointer-events: none; }\n    #primary-text,\n    #secondary-text,\n    #editorial-text {\n      fill: var(--zr-text-color, #f0ede5);\n      paint-order: stroke fill;\n      stroke: rgba(0, 0, 0, 0.18);\n      stroke-width: 0.35px;\n      text-shadow: var(--zr-text-shadow, 0 1px 2px rgba(0,0,0,0.46));\n      text-anchor: middle;\n    }\n    #primary-text { font-family: var(--zr-primary-family, Cinzel); font-weight: var(--zr-primary-weight, 400); }\n    #secondary-text { font-family: var(--zr-secondary-family, Cinzel); font-weight: var(--zr-secondary-weight, 400); }\n    #editorial-text { font-family: Cinzel; }\n    #editorial-divider,\n    #editorial-diamond { stroke: var(--zr-text-color, #f0ede5); fill: none; }\n    .zr-photo-panel .template-fields { padding-bottom: 10px; }\n    .zr-photo-panel .template-fields input[type=\"text\"] {\n      width: 100%;\n      min-height: 34px;\n      padding: 7px 9px;\n      border: 0;\n      border-radius: 8px;\n      background: #3a3a3a;\n      color: white;\n      font: 13px Inter, sans-serif;\n    }\n    html.render body { display: block; }\n    html.render .stage { width: var(--zr-canvas-width); height: var(--zr-canvas-height); }\n  </style>\n</head>\n<body>\n  <main class=\"stage\" id=\"stage\">\n    <img id=\"source\" alt=\"\">\n    <canvas id=\"photo\"></canvas>\n    <svg id=\"text-layers\" xmlns=\"http://www.w3.org/2000/svg\">\n      <text id=\"primary-text\"></text>\n      <text id=\"secondary-text\"></text>\n      <g id=\"editorial-layer\" hidden>\n        <line id=\"editorial-divider\"></line>\n        <path id=\"editorial-diamond\"></path>\n        <text id=\"editorial-text\"></text>\n      </g>\n    </svg>\n  </main>\n\n  <aside class=\"zr-photo-panel\" aria-label=\"Réglages du template\">\n    <h2>Template Creator</h2>\n    <div class=\"template-fields\">\n      <div class=\"zr-photo-grid\">\n        <label>Texte principal<input id=\"primary-input\" type=\"text\"></label>\n        <label>Texte secondaire<input id=\"secondary-input\" type=\"text\"></label>\n      </div>\n      <div id=\"text-controls\" class=\"zr-photo-grid\"></div>\n    </div>\n    <details open>\n      <summary>Vignette</summary>\n      <div id=\"vignette-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <details>\n      <summary>Selective Color</summary>\n      <div id=\"selective-tabs\" class=\"zr-photo-color-tabs\"></div>\n      <div id=\"selective-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <details>\n      <summary>Levels</summary>\n      <div id=\"levels-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <details>\n      <summary>Black and White</summary>\n      <div id=\"black-white-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <details>\n      <summary>Color</summary>\n      <div id=\"color-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <details open>\n      <summary>Light</summary>\n      <div id=\"light-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <details>\n      <summary>Filters</summary>\n      <div id=\"filter-buttons\" class=\"zr-photo-filter-grid\"></div>\n      <div id=\"filter-controls\" class=\"zr-photo-grid\"></div>\n    </details>\n    <div class=\"zr-photo-actions\">\n      <button id=\"reset\" type=\"button\">Réinitialiser</button>\n      <button id=\"copy\" type=\"button\">Copier les valeurs</button>\n    </div>\n    <p id=\"status\" class=\"zr-photo-status\" role=\"status\"></p>\n  </aside>\n\n  <script src=\"assets/photo-controls/zr-photo-adjustments.js\"></script>\n  <script>\n    \"use strict\";\n    const CONFIG = {\"canvas\": {\"width\": 1672, \"height\": 941}, \"background\": \"/Users/zenray/Downloads/tmp-thewitcher3-artdirection/assets/background-02-enhanced-combat-clean.png\", \"template_id\": \"single_center\", \"primary_text\": \"ENHANCED COMBAT\", \"secondary_text\": \"\", \"primary\": {\"font_url\": \"file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\", \"font_family\": \"AnthropicSerif\", \"font_size\": 42, \"font_weight\": 400, \"letter_spacing\": 10.8, \"anchor_x\": 841, \"baseline_y\": 503, \"color\": \"#f0ede5\", \"shadow\": \"0 1px 2px rgba(0,0,0,0.46)\"}, \"secondary\": null, \"photo\": {\"vignette\": 0, \"selective\": [{\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}, {\"hue\": 0, \"saturation\": 0, \"luminance\": 0}], \"levels\": {\"inputBlack\": 0, \"midtone\": 50, \"inputWhite\": 100, \"outputBlack\": 0, \"outputWhite\": 100}, \"blackAndWhite\": 0, \"saturation\": 0, \"vibrance\": 0, \"brilliance\": 0, \"exposure\": 0, \"highlights\": 0, \"shadows\": 0, \"brightness\": 0, \"contrast\": 0, \"blackPoint\": 0, \"filter\": \"Original\", \"filterStrength\": 100}, \"output\": \"out/template-previews/generated-template.png\"};\n    const root = document.documentElement;\n    const canvas = document.querySelector(\"#photo\");\n    const source = document.querySelector(\"#source\");\n    const primaryText = document.querySelector(\"#primary-text\");\n    const secondaryText = document.querySelector(\"#secondary-text\");\n    const editorialLayer = document.querySelector(\"#editorial-layer\");\n    const editorialDivider = document.querySelector(\"#editorial-divider\");\n    const editorialDiamond = document.querySelector(\"#editorial-diamond\");\n    const editorialText = document.querySelector(\"#editorial-text\");\n    const status = document.querySelector(\"#status\");\n    const processor = new ZRPhotoAdjustments(canvas);\n    const filterNames = ZRPhotoAdjustments.filters();\n    const channelNames = [\"Rouge\", \"Jaune\", \"Vert\", \"Cyan\", \"Bleu\", \"Magenta\"];\n    let selectedChannel = 0;\n    let selectedFilter = CONFIG.photo.filter;\n    let framePending = false;\n\n    root.style.setProperty(\"--zr-canvas-width\", `${CONFIG.canvas.width}px`);\n    root.style.setProperty(\"--zr-canvas-height\", `${CONFIG.canvas.height}px`);\n    root.style.setProperty(\"--zr-canvas-ratio\", CONFIG.canvas.width / CONFIG.canvas.height);\n    document.querySelector(\"#text-layers\").setAttribute(\"viewBox\", `0 0 ${CONFIG.canvas.width} ${CONFIG.canvas.height}`);\n\n    function setVariable(name, value) {\n      root.style.setProperty(name, String(value));\n    }\n\n    function getVariable(name) {\n      return Number.parseFloat(getComputedStyle(root).getPropertyValue(name));\n    }\n\n    function slider(parent, label, variable, min, max, value, step = 1) {\n      const row = document.createElement(\"label\");\n      row.className = \"zr-photo-control\";\n      const name = document.createElement(\"span\");\n      name.textContent = label;\n      const input = document.createElement(\"input\");\n      input.type = \"range\";\n      input.min = min;\n      input.max = max;\n      input.step = step;\n      input.value = value;\n      input.dataset.variable = variable;\n      const output = document.createElement(\"output\");\n      output.value = Math.round(Number(value));\n      input.addEventListener(\"input\", () => {\n        setVariable(variable, input.value);\n        output.value = Math.round(Number(input.value));\n        scheduleRender();\n      });\n      row.append(name, input, output);\n      parent.append(row);\n      setVariable(variable, value);\n      return { input, output };\n    }\n\n    function makeControls() {\n      const text = document.querySelector(\"#text-controls\");\n      slider(text, \"Principal X\", \"--zr-primary-x\", 0, CONFIG.canvas.width, CONFIG.primary.anchor_x);\n      slider(text, \"Principal Y\", \"--zr-primary-y\", 0, CONFIG.canvas.height, CONFIG.primary.baseline_y);\n      slider(text, \"Taille\", \"--zr-primary-size\", 8, 240, CONFIG.primary.font_size);\n      slider(text, \"Interlettrage\", \"--zr-primary-tracking\", -20, 100, CONFIG.primary.letter_spacing, 0.1);\n\n      slider(document.querySelector(\"#vignette-controls\"), \"Strength\", \"--zr-photo-vignette\", 0, 100, CONFIG.photo.vignette);\n      const selectiveTabs = document.querySelector(\"#selective-tabs\");\n      channelNames.forEach((name, index) => {\n        const button = document.createElement(\"button\");\n        button.type = \"button\";\n        button.dataset.channel = index;\n        button.title = name;\n        button.setAttribute(\"aria-label\", name);\n        button.setAttribute(\"aria-pressed\", index === selectedChannel ? \"true\" : \"false\");\n        button.addEventListener(\"click\", () => selectChannel(index));\n        selectiveTabs.append(button);\n      });\n      const selective = document.querySelector(\"#selective-controls\");\n      slider(selective, \"Hue\", \"--zr-photo-selective-active-hue\", -100, 100, 0);\n      slider(selective, \"Saturation\", \"--zr-photo-selective-active-saturation\", -100, 100, 0);\n      slider(selective, \"Luminance\", \"--zr-photo-selective-active-luminance\", -100, 100, 0);\n      CONFIG.photo.selective.forEach((value, index) => {\n        setVariable(`--zr-photo-selective-${index}-hue`, value.hue);\n        setVariable(