du shader sur un tableau HxWx3 en float32 (0..1).\"\"\"\n    if photo is None:\n        return image\n\n    def pct(key, default=0.0):\n        return float(photo.get(key, default)) / 100.0\n\n    levels = photo.get(\"levels\") or {}\n    color = image\n\n    # 1. Levels\n    input_black = float(levels.get(\"inputBlack\", 0)) / 100.0\n    midtone = float(levels.get(\"midtone\", 50)) / 100.0\n    input_white = max(input_black + 0.001, float(levels.get(\"inputWhite\", 100)) / 100.0)\n    output_black = float(levels.get(\"outputBlack\", 0)) / 100.0\n    output_white = float(levels.get(\"outputWhite\", 100)) / 100.0\n    color = np.clip((color - input_black) / (input_white - input_black), 0.0, 1.0)\n    gamma = 2.0 ** ((0.5 - midtone) * 3.0)\n    color = np.power(np.maximum(color, 1e-5), gamma)\n    color = output_black + (output_white - output_black) * color\n\n    # 2. Selective Color\n    selective = photo.get(\"selective\") or []\n    if any(any(float(channel.get(k, 0)) for k in (\"hue\", \"saturation\", \"luminance\")) for channel in selective):\n        hsv = rgb_to_hsv(color)\n        for index, center in enumerate(SELECTIVE_CENTERS):\n            channel = selective[index] if index < len(selective) else {}\n            hue_amount = float(channel.get(\"hue\", 0)) / 100.0\n            sat_amount = float(channel.get(\"saturation\", 0)) / 100.0\n            lum_amount = float(channel.get(\"luminance\", 0)) / 100.0\n            if not (hue_amount or sat_amount or lum_amount):\n                continue\n            weight = smoothstep(0.19, 0.0, hue_distance(hsv[..., 0], center)) \\\n                * smoothstep(0.05, 0.25, hsv[..., 1])\n            hsv[..., 0] = (hsv[..., 0] + hue_amount * weight * 0.12 + 1.0) % 1.0\n            hsv[..., 1] = np.clip(hsv[..., 1] + sat_amount * weight * 0.55, 0.0, 1.0)\n            hsv[..., 2] = np.clip(hsv[..., 2] + lum_amount * weight * 0.38, 0.0, 1.0)\n        color = hsv_to_rgb(hsv)\n\n    # 3. Light. `luminosity` est mesuree UNE fois, avant les operations, comme\n    #    dans le shader : la recalculer entre deux etapes changerait le rendu.\n    brilliance = pct(\"brilliance\")\n    exposure = pct(\"exposure\")\n    highlights = pct(\"highlights\")\n    shadows = pct(\"shadows\")\n    brightness = pct(\"brightness\")\n    contrast = pct(\"contrast\")\n    black_point = pct(\"blackPoint\")\n    luminosity = luma(color)[..., None]\n\n    color = color * (2.0 ** (exposure * 2.0))\n    color = color + brilliance * (0.25 - np.power(luminosity - 0.5, 2.0)) * 0.55\n    color = color + highlights * smoothstep(0.45, 1.0, luminosity) * 0.32\n    color = color + shadows * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.32\n    color = color + brightness * 0.30\n    color = (color - 0.5) * (1.0 + contrast * 0.90) + 0.5\n    color = color - black_point * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.35\n\n    # 4. Saturation, puis Vibrance\n    color = adjust_saturation(color, pct(\"saturation\") * 0.85)\n    vibrance = pct(\"vibrance\")\n    if vibrance:\n        hsv = rgb_to_hsv(np.clip(color, 0.0, 1.0))\n        hsv[..., 1] = np.clip(hsv[..., 1] + vibrance * (1.0 - hsv[..., 1]) * 0.75, 0.0, 1.0)\n        color = hsv_to_rgb(hsv)\n\n    # 5. Black and White\n    black_and_white = pct(\"blackAndWhite\")\n    if black_and_white:\n        gray = np.repeat(luma(color)[..., None], 3, axis=-1)\n        color = color + (gray - color) * black_and_white\n\n    # 6. Filtre\n    filter_name = photo.get(\"filter\", \"Original\")\n    if filter_name not in FILTERS:\n        raise SystemExit(f\"filtre inconnu : {filter_name}\")\n    filter_id = FILTERS.index(filter_name)\n    filter_strength = float(photo.get(\"filterStrength\", 100)) / 100.0\n    if filter_id and filter_strength:\n        color = color + (apply_preset(color, filter_id) - color) * filter_strength\n\n    # 7. Vignette, en coordonnees normalisees du cadre\n    vignette = pct(\"vignette\")\n    if vignette:\n        height, width = color.shape[0], color.shape[1]\n        ys = (np.arange(height, dtype=np.float32) + 0.5) / height\n        xs = (np.arange(width, dtype=np.float32) + 0.5) / width\n        radius = np.sqrt((xs[None, :] - 0.5) ** 2 + (ys[:, None] - 0.5) ** 2) / 0.70710678\n        color = color * (1.0 - (smoothstep(0.34, 1.0, radius) * vignette * 0.78))[..., None]\n\n    return np.clip(color, 0.0, 1.0)\n\n\n# ---------------------------------------------------------------- texte\n\ndef load_font(font_key, weight, size):\n    size = max(1, round(size))\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_caption(canvas, cfg, canvas_w, canvas_h):\n    value = (cfg.get(\"value\") or \"\").strip()\n    if not value:\n        return canvas\n    font_key = cfg.get(\"font\", \"serif\")\n    weight = int(cfg.get(\"weight\", 400))\n    color = cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # La taille venue du navigateur est un point de depart : on refait l'ajustement\n    # cote Python, dont les metriques different legerement, pour garantir que le\n    # texte ne sorte JAMAIS du cadre dans le fichier livre.\n    font_size = round(cfg.get(\"size_px\") or cfg.get(\"requested_size_px\") or 200)\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        if (bbox[2] - bbox[0]) > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        return (x + bbox[0] >= 0 and y + bbox[1] >= 0\n                and x + bbox[2] <= canvas_w and y + bbox[3] <= canvas_h)\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\n# ---------------------------------------------------------------- cook\n\ndef main():\n    index = json.loads((HERE / \"_index.json\").read_text())\n    params_path = HERE / \"_params.json\"\n    if not params_path.exists():\n        raise SystemExit(\n            \"_params.json manquant : coller ici le JSON rendu par le bouton \"\n            \"« Copier TOUT (ordre + réglages) » de index.html\"\n        )\n    params = json.loads(params_path.read_text())\n    by_id = {img[\"id\"]: img for img in index[\"images\"]}\n\n    order = params[\"order\"]\n    images = params[\"images\"]\n    known, given = set(by_id), set(order)\n    assert given == known, (\n        f\"l'ordre doit citer exactement les {len(known)} id de _index.json ; \"\n        f\"manquants={sorted(known - given)} en trop={sorted(given - known)}\"\n    )\n\n    OUT_DIR.mkdir(exist_ok=True)\n    written = []\n    for position, image_id in enumerate(order, start=1):\n        entry = by_id[image_id]\n        spec = images[image_id]\n        src_path = Path(entry[\"path\"])\n        if not src_path.exists():\n            src_path = SOURCE_DIR / entry[\"file\"]\n        assert src_path.exists(), f\"source introuvable : {src_path}\"\n\n        image = ImageOps.exif_transpose(Image.open(src_path)).convert(\"RGB\")\n        canvas_w, canvas_h = image.size\n\n        array = np.asarray(image, dtype=np.float32) / 255.0\n        array = apply_photo(array, spec.get(\"photo\"))\n        out = Image.fromarray(np.rint(array * 255.0).astype(np.uint8), mode=\"RGB\")\n\n        texts = spec.get(\"text\") or []\n        for cfg in texts:\n            out = draw_caption(out, cfg, canvas_w, canvas_h)\n\n        stem, ext = Path(entry[\"file\"]).stem, Path(entry[\"file\"]).suffix\n        out_path = OUT_DIR / (spec.get(\"output\") or f\"{stem}_{position:02d}{ext}\")\n        quality = 95\n        out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n        size_mb = out_path.stat().st_size / 1_048_576\n        while size_mb > 8 and quality > 60:\n            quality -= 5\n            out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n            size_mb = out_path.stat().st_size / 1_048_576\n\n        marks = []\n        if spec.get(\"photo\") and spec[\"photo\"] != {}:\n            marks.append(\"photo\")\n        if texts:\n            marks.append(f\"{len(texts)} texte{'s' if len(texts) > 1 else ''}\")\n        written.append(out_path)\n        print(f\"{position:02d}  {entry['file']}  ->  {out_path.name}  \"\n              f\"{out.size[0]}x{out.size[1]}  q{quality}  {size_mb:.2f} Mo\"\n              + (f\"  [{', '.join(marks)}]\" if marks else \"\"))\n\n    print(f\"\\n{len(written)} images ecrites dans {OUT_DIR}\")\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"6acd32bf-68a2-4c6f-949c-50f079962a1e","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"068e9161-445a-4e75-a52f-e12511b3ad70","version":"2.1.247","gitBranch":"main","slug":"fancy-watching-ember"}
