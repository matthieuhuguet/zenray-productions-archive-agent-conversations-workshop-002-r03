  var addLayerBtn = document.getElementById(\"addLayerBtn\");\n  var processor = new ZRPhotoAdjustments(canvas);\n  var framePending = false;\n\n  document.getElementById(\"countLabel\").textContent = IMAGES.length + \" images\";\n\n  function current() { return settings[selectedId]; }\n  function currentLayers() { return layers[selectedId]; }\n\n  function newLayer(index) {\n    return {\n      value: \"\", font: \"serif\", weight: 400,\n      sizePx: DEFAULT_SIZE_PX, effectiveSizePx: DEFAULT_SIZE_PX,\n      color: \"#f6cf47\", anchor: DEFAULT_ANCHOR_BY_INDEX[index] || \"bottom-center\"\n    };\n  }\n\n  function isNeutralPhoto(values) {\n    return JSON.stringify(values) === JSON.stringify(ZRPhotoAdjustments.defaults());\n  }\n  function hasEdits(id) {\n    return !isNeutralPhoto(settings[id]) || layers[id].some(function (l) { return l.value.trim(); });\n  }\n\n  function srcUrl(file) {\n    return \"file://\" + SOURCE_DIR + encodeURIComponent(file).replace(/%2F/g, \"/\");\n  }\n\n  function canvasWidth() { return canvas.width || 1080; }\n\n  function isLandscape() { return canvas.width > canvas.height; }\n\n  function clampAnchorToCenter(anchor) { return anchor.split(\"-\")[0] + \"-center\"; }\n\n  function scheduleRender() {\n    if (framePending) return;\n    framePending = true;\n    requestAnimationFrame(function () {\n      framePending = false;\n      processor.set(current());\n      renderTextLayers();\n      refreshTileFlags();\n    });\n  }\n\n  // ---------- mesure du texte, jamais la boite DOM etiree ----------\n  // Leçon deja payee cote picker light : mesurer le CONTENU (Canvas 2D), pas la\n  // boite `left:0;right:0` qui vaut toujours la largeur du cadre. Meme algorithme\n  // que ImageDraw.textbbox() cote Python.\n  var measureContext = document.createElement(\"canvas\").getContext(\"2d\");\n\n  function measureText(layer, fontSizePx) {\n    var family = layer.font === \"serif\"\n      ? '\"AnthropicSerif\", serif'\n      : '\"InterLocal\", sans-serif';\n    measureContext.font = layer.weight + \" \" + fontSizePx + \"px \" + family;\n    var metrics = measureContext.measureText(layer.value);\n    var width = metrics.actualBoundingBoxLeft !== undefined\n      ? metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight\n      : metrics.width;\n    var height = (metrics.actualBoundingBoxAscent || fontSizePx * 0.8) +\n                 (metrics.actualBoundingBoxDescent || fontSizePx * 0.2);\n    return { width: width, height: height };\n  }\n\n  // Auto-fit : la taille demandee est un POINT DE DEPART, jamais une valeur\n  // imposee. On la reduit jusqu'a ce que le texte tienne entierement dans le\n  // cadre (88 % de large, 88 % de haut), et c'est cette valeur reelle qui part\n  // dans le presse-papier, jamais celle demandee.\n  function fitSize(layer) {\n    var cw = canvasWidth();\n    var ch = canvas.height || 1350;\n    var size = layer.sizePx;\n    var maxW = cw * 0.88;\n    var maxH = ch * 0.88;\n    var guard = 0;\n    var m = measureText(layer, size);\n    while (guard++ < 200 && size > MIN_SIZE_PX && (m.width > maxW || m.height > maxH)) {\n      size = Math.max(MIN_SIZE_PX, size - 2);\n      m = measureText(layer, size);\n    }\n    return Math.round(size);\n  }\n\n  function renderTextLayers() {\n    textLayersEl.innerHTML = \"\";\n    var cw = canvasWidth();\n    currentLayers().forEach(function (layer) {\n      var effective = fitSize(layer);\n      layer.effectiveSizePx = effective;\n      if (!layer.value.trim()) return;\n      var parts = layer.anchor.split(\"-\");\n      var el = document.createElement(\"div\");\n      el.className = \"text-layer font-\" + layer.font +\n        \" anchor-v-\" + parts[0] + \" anchor-h-\" + parts[1];\n      el.style.fontWeight = layer.weight;\n      el.style.color = layer.color;\n      el.style.fontSize = (effective / cw * 100) + \"cqw\";\n      el.textContent = layer.value;\n      textLayersEl.append(el);\n    });\n    refreshLayerReadouts();\n  }\n\n  // ---------- panneau photo ----------\n\n  var controlRegistry = [];\n\n  function slider(parent, label, path, min, max, value, step) {\n    var row = document.createElement(\"label\");\n    row.className = \"zr-photo-control\";\n    var name = document.createElement(\"span\");\n    name.textContent = label;\n    var input = document.createElement(\"input\");\n    input.type = \"range\";\n    input.min = min; input.max = max; input.step = step || 1; input.value = value;\n    var output = document.createElement(\"output\");\n    output.value = Math.round(Number(value));\n    input.addEventListener(\"input\", function () {\n      var v = Number(input.value);\n      output.value = Math.round(v);\n      writePath(path, v);\n      scheduleRender();\n    });\n    row.append(name, input, output);\n    parent.append(row);\n    controlRegistry.push({ input: input, output: output, path: path });\n    return input;\n  }\n\n  // `path` designe un chemin dans l'objet de reglages : \"saturation\",\n  // \"levels.midtone\", ou \"selective.ACTIVE.hue\" (ACTIVE = canal courant).\n  function resolvePath(path) {\n    return path.replace(\"ACTIVE\", String(selectedChannel)).split(\".\");\n  }\n  function writePath(path, value) {\n    var parts = resolvePath(path);\n    var node = current();\n    for (var i = 0; i < parts.length - 1; i++) node = node[parts[i]];\n    node[parts[parts.length - 1]] = value;\n  }\n  function readPath(path) {\n    var parts = resolvePath(path);\n    var node = current();\n    for (var i = 0; i < parts.length - 1; i++) node = node[parts[i]];\n    return node[parts[parts.length - 1]];\n  }\n\n  function syncPhotoControls() {\n    controlRegistry.forEach(function (control) {\n      var value = readPath(control.path);\n      control.input.value = value;\n      control.output.value = Math.round(Number(value));\n    });\n    document.querySelectorAll(\"#filter-buttons button\").forEach(function (button) {\n      button.setAttribute(\"aria-pressed\", button.dataset.filter === current().filter ? \"true\" : \"false\");\n    });\n  }\n\n  function buildPhotoControls() {\n    slider(document.getElementById(\"vignette-controls\"), \"Strength\", \"vignette\", 0, 100, 0);\n\n    var tabs = document.getElementById(\"selective-tabs\");\n    CHANNELS.forEach(function (name, index) {\n      var button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.dataset.channel = index;\n      button.title = name;\n      button.setAttribute(\"aria-label\", name);\n      button.setAttribute(\"aria-pressed\", index === selectedChannel ? \"true\" : \"false\");\n      button.addEventListener(\"click\", function () {\n        selectedChannel = index;\n        tabs.querySelectorAll(\"button\").forEach(function (b) {\n          b.setAttribute(\"aria-pressed\", Number(b.dataset.channel) === index ? \"true\" : \"false\");\n        });\n        syncPhotoControls();\n      });\n      tabs.append(button);\n    });\n    var selective = document.getElementById(\"selective-controls\");\n    slider(selective, \"Hue\", \"selective.ACTIVE.hue\", -100, 100, 0);\n    slider(selective, \"Saturation\", \"selective.ACTIVE.saturation\", -100, 100, 0);\n    slider(selective, \"Luminance\", \"selective.ACTIVE.luminance\", -100, 100, 0);\n\n    var levels = document.getElementById(\"levels-controls\");\n    slider(levels, \"Input Black\", \"levels.inputBlack\", 0, 100, 0);\n    slider(levels, \"Midtone\", \"levels.midtone\", 0, 100, 50);\n    slider(levels, \"Input White\", \"levels.inputWhite\", 0, 100, 100);\n    slider(levels, \"Output Black\", \"levels.outputBlack\", 0, 100, 0);\n    slider(levels, \"Output White\", \"levels.outputWhite\", 0, 100, 100);\n\n    slider(document.getElementById(\"black-white-controls\"), \"Strength\", \"blackAndWhite\", 0, 100, 0);\n\n    var color = document.getElementById(\"color-controls\");\n    slider(color, \"Saturation\", \"saturation\", -100, 100, 0);\n    slider(color, \"Vibrance\", \"vibrance\", -100, 100, 0);\n\n    var light = document.getElementById(\"light-controls\");\n    [[\"Brilliance\", \"brilliance\"], [\"Exposure\", \"exposure\"], [\"Highlights\", \"highlights\"],\n     [\"Shadows\", \"shadows\"], [\"Brightness\", \"brightness\"], [\"Contrast\", \"contrast\"],\n     [\"Black Point\", \"blackPoint\"]].forEach(function (pair) {\n      slider(light, pair[0], pair[1], -100, 100, 0);\n    });\n\n    var filterButtons = document.getElementById(\"filter-buttons\");\n    FILTERS.forEach(function (name) {\n      var button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.textContent = name;\n      button.dataset.filter = name;\n      button.setAttribute(\"aria-pressed\", name === \"Original\" ? \"true\" : \"false\");\n      button.addEventListener(\"click\", function () {\n        current().filter = name;\n        filterButtons.querySelectorAll(\"button\").forEach(function (b) {\n          b.setAttribute(\"aria-pressed\", b === button ? \"true\" : \"false\");\n        });\n        scheduleRender();\n      });\n      filterButtons.append(button);\n    });\n    slider(document.getElementById(\"filter-controls\"), \"Strength\", \"filterStrength\", 0, 100, 100);\n  }\n\n  // ---------- calques de texte ----------\n\n  var layerReadouts = [];\n\n  function refreshLayerReadouts() {\n    layerReadouts.forEach(function (entry) {\n      var layer = currentLayers()[entry.index];\n      if (!layer) return;\n      var adjusted = layer.effectiveSizePx !== layer.sizePx;\n      entry.node.textContent = adjusted\n        ? (\"affiché \" + layer.effectiveSizePx + \"px (ajusté pour tenir dans le cadre)\")\n        : \"\";\n      entry.node.classList.toggle(\"adjusted\", adjusted);\n    });\n  }\n\n  function buildLayerPanel() {\n    layerList.innerHTML = \"\";\n    layerReadouts = [];\n    currentLayers().forEach(function (layer, index) {\n      var block = document.createElement(\"div\");\n      block.className = \"layer-block\";\n\n      var head = document.createElement(\"div\");\n      head.className = \"layer-head\";\n      var idx = document.createElement(\"span\");\n      idx.className = \"idx\";\n      idx.textContent = \"T\" + (index + 1);\n      var title = document.createElement(\"span\");\n      title.textContent = \"Calque de texte\";\n      var remove = document.createElement(\"button\");\n      remove.type = \"button\";\n      remove.textContent = \"Supprimer\";\n      remove.addEventListener(\"click\", function () {\n        currentLayers().splice(index, 1);\n        buildLayerPanel();\n        scheduleRender();\n      });\n      head.append(idx, title, remove);\n      block.append(head);\n\n      var input = document.createElement(\"input\");\n      input.type = \"text\";\n      input.placeholder = \"Texte à poser sur la photo…\";\n      input.value = layer.value;\n      input.addEventListener(\"input\", function () {\n        layer.value = input.value;\n        scheduleRender();\n      });\n      block.append(input);\n\n      var row2 = document.createElement(\"div\");\n      row2.className = \"row2\";\n      var fontSelect = document.createElement(\"select\");\n      [[\"serif\", \"Serif\"], [\"sans\", \"Sans\"]].forEach(function (pair) {\n        var o = document.createElement(\"option\");\n        o.value = pair[0]; o.textContent = pair[1];\n        fontSelect.append(o);\n      });\n      fontSelect.value = layer.font;\n      fontSelect.addEventListener(\"change\", function () {\n        layer.font = fontSelect.value;\n        scheduleRender();\n      });\n      var weightSelect = document.createElement(\"select\");\n      WEIGHTS.forEach(function (pair) {\n        var o = document.createElement(\"option\");\n        o.value = pair[0]; o.textContent = pair[1];\n        weightSelect.append(o);\n      });\n      weightSelect.value = String(layer.weight);\n      weightSelect.addEventListener(\"change\", function () {\n        layer.weight = parseInt(weightSelect.value, 10);\n        scheduleRender();\n      });\n      row2.append(fontSelect, weightSelect);\n      block.append(row2);\n\n      var sizeRow = document.createElement(\"div\");\n      sizeRow.className = \"size-row\";\n      var sizeInput = document.createElement(\"input\");\n      sizeInput.type = \"number\";\n      sizeInput.min = String(MIN_SIZE_PX);\n      sizeInput.max = \"4000\";\n      sizeInput.step = \"2\";\n      sizeInput.value = String(layer.sizePx);\n      sizeInput.addEventListener(\"input\", function () {\n        var v = parseFloat(sizeInput.value);\n        if (!isFinite(v) || v <= 0) return;\n        layer.sizePx = v;\n        scheduleRender();\n      });\n      var unit = document.createElement(\"span\");\n      unit.textContent = \"px\";\n      unit.style.color = \"var(--muted)\";\n      unit.style.fontSize = \"11px\";\n      var effective = document.createElement(\"span\");\n      effective.className = \"size-effective\";\n      layerReadouts.push({ index: index, node: effective });\n      sizeRow.append(sizeInput, unit, effective);\n      block.append(sizeRow);\n\n      var bottom = document.createElement(\"div\");\n      bottom.className = \"bottom\";\n\n      var swatches = document.createElement(\"div\");\n      swatches.className = \"swatches\";\n      var yellow = document.createElement(\"div\");\n      yellow.className = \"swatch yellow\" + (layer.color === \"#f6cf47\" ? \" active\" : \"\");\n      yellow.title = \"Jaune #f6cf47\";\n      var white = document.createElement(\"div\");\n      white.className = \"swatch white\" + (layer.color === \"#ffffff\" ? \" active\" : \"\");\n      white.title = \"Blanc #ffffff\";\n      yellow.addEventListener(\"click\", function () {\n        layer.color = \"#f6cf47\";\n        yellow.classList.add(\"active\"); white.classList.remove(\"active\");\n        scheduleRender();\n      });\n      white.addEventListener(\"click\", function () {\n        layer.color = \"#ffffff\";\n        white.classList.add(\"active\"); yellow.classList.remove(\"active\");\n        scheduleRender();\n      });\n      swatches.append(yellow, white);\n\n      var widget = document.createElement(\"div\");\n      widget.className = \"anchor-widget\";\n      widget.dataset.mode = isLandscape() ? \"9\" : \"3\";\n      var buttons = ANCHORS.map(function (anchor) {\n        var b = document.createElement(\"button\");\n        b.type = \"button\";\n        b.dataset.anchor = anchor;\n        b.title = anchor;\n        if (anchor === layer.anchor) b.classList.add(\"active\");\n        b.addEventListener(\"click\", function () {\n          layer.anchor = anchor;\n          buttons.forEach(function (other) {\n            other.classList.toggle(\"active\", other.dataset.anchor === anchor);\n          });\n          scheduleRender();\n        });\n        widget.append(b);\n        return b;\n      });\n      // Un format portrait ou carre n'expose que la colonne du centre : une ancre\n      // laterale devenue invalide est ramenee sur son equivalent centre.\n      if (!isLandscape() && layer.anchor.indexOf(\"-center\") === -1) {\n        layer.anchor = clampAnchorToCenter(layer.anchor);\n        buttons.forEach(function (b) {\n          b.classList.toggle(\"active\", b.dataset.anchor === layer.anchor);\n        });\n      }\n\n      bottom.append(swatches, widget);\n      block.append(bottom);\n      layerList.append(block);\n    });\n\n    addLayerBtn.disabled = currentLayers().length >= MAX_LAYERS;\n    addLayerBtn.textContent = currentLayers().length >= MAX_LAYERS\n      ? \"+ Ajouter un texte (3 maximum)\"\n      : \"+ Ajouter un texte\";\n    refreshLayerReadouts();\n  }\n\n  addLayerBtn.addEventListener(\"click\", function () {\n    if (currentLayers().length >= MAX_LAYERS) return;\n    currentLayers().push(newLayer(currentLayers().length));\n    buildLayerPanel();\n    scheduleRender();\n  });\n\n  // ---------- bande de vignettes, selection et reorder ----------\n\n  var dragSrcId = null;\n\n  function refreshTi