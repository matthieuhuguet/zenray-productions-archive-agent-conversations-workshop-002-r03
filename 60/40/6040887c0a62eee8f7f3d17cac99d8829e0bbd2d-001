-user-drag: none; }\n  .tile .meta {\n    display: flex; align-items: center; gap: 5px; padding: 5px 6px; pointer-events: none;\n  }\n  .tile .pos {\n    background: var(--accent); color: #17140f; border-radius: 4px; padding: 1px 5px;\n    font: 700 11px ui-monospace, \"AnthropicMono\", monospace; flex: 0 0 auto;\n  }\n  .tile .nm {\n    font: 500 9px ui-monospace, \"AnthropicMono\", monospace; color: var(--muted);\n    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;\n  }\n  .tile .edited {\n    position: absolute; top: 6px; right: 6px; width: 8px; height: 8px;\n    border-radius: 50%; background: var(--accent); display: none;\n    box-shadow: 0 0 0 2px rgba(0,0,0,.45);\n  }\n  .tile.has-edits .edited { display: block; }\n\n  .zr-photo-panel { inset: 0 0 0 auto; width: var(--panel-gutter); max-height: 100vh; border-radius: 0; border-left: 1px solid rgba(255,255,255,.1); }\n  .zr-photo-panel h2 { font-size: 19px; }\n  .zr-photo-panel .current {\n    margin: 0 0 10px; padding: 7px 9px; border-radius: 8px;\n    background: rgba(255,255,255,.05);\n    font: 500 11px ui-monospace, \"AnthropicMono\", monospace; color: var(--muted);\n    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n  }\n  .zr-photo-panel .current b { color: var(--accent); }\n\n  .out-box { position: fixed; inset: 0; z-index: 60; display: none; place-items: center; background: rgba(0,0,0,.72); }\n  .out-box.shown { display: grid; }\n  .out-inner {\n    width: min(760px, 90vw); background: #141517; border: 1px solid rgba(255,255,255,.12);\n    border-radius: 14px; padding: 16px;\n  }\n  .out-inner h3 { margin: 0 0 10px; font: 600 14px Inter, sans-serif; }\n  .out-inner textarea {\n    width: 100%; height: 320px; resize: vertical;\n    background: #0d0e10; color: var(--accent); border: 1px solid rgba(255,255,255,.14);\n    border-radius: 9px; padding: 10px 12px;\n    font: 500 11px/1.5 ui-monospace, \"AnthropicMono\", monospace;\n  }\n  .out-inner .row { display: flex; gap: 8px; margin-top: 10px; }\n</style>\n</head>\n<body>\n\n<header class=\"top\">\n  <h1>zenray-html-hda heavy</h1>\n  <span class=\"sub\">acquarium-post1 · <span id=\"countLabel\">9 images</span></span>\n  <div class=\"spacer\"></div>\n  <button class=\"ghost\" id=\"resetImageBtn\">Réinitialiser cette image</button>\n  <button class=\"ghost\" id=\"resetOrderBtn\">Réinitialiser l'ordre</button>\n  <button class=\"primary\" id=\"copyAllBtn\">Copier TOUT (ordre + réglages)</button>\n</header>\n\n<main class=\"stage\" id=\"stage\">\n  <img id=\"source\" alt=\"\">\n  <canvas id=\"photo\"></canvas>\n</main>\n\n<div class=\"strip\" id=\"strip\"></div>\n\n<aside class=\"zr-photo-panel\" aria-label=\"Réglages photo\">\n  <h2>Réglages photo</h2>\n  <p class=\"current\" id=\"currentLabel\"></p>\n  <details open>\n    <summary>Vignette</summary>\n    <div id=\"vignette-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <details>\n    <summary>Selective Color</summary>\n    <div id=\"selective-tabs\" class=\"zr-photo-color-tabs\"></div>\n    <div id=\"selective-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <details>\n    <summary>Levels</summary>\n    <div id=\"levels-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <details>\n    <summary>Black and White</summary>\n    <div id=\"black-white-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <details open>\n    <summary>Color</summary>\n    <div id=\"color-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <details open>\n    <summary>Light</summary>\n    <div id=\"light-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <details>\n    <summary>Filters</summary>\n    <div id=\"filter-buttons\" class=\"zr-photo-filter-grid\"></div>\n    <div id=\"filter-controls\" class=\"zr-photo-grid\"></div>\n  </details>\n  <p id=\"status\" class=\"zr-photo-status\" role=\"status\"></p>\n</aside>\n\n<div class=\"out-box\" id=\"outBox\">\n  <div class=\"out-inner\">\n    <h3>Ordre et réglages, à recoller dans le prompt</h3>\n    <textarea id=\"outText\" readonly></textarea>\n    <div class=\"row\">\n      <button class=\"primary\" id=\"outCopyBtn\">Copier</button>\n      <button class=\"ghost\" id=\"outCloseBtn\">Fermer</button>\n    </div>\n  </div>\n</div>\n\n<script src=\"assets/photo-controls/zr-photo-adjustments.js\"></script>\n<script>\n(function () {\n  \"use strict\";\n  // 2026-09-01, outil zenray-html-hda mode HEAVY du skill zenray-html-photoshop-pdf-hda.\n  // Un seul HTML : reorder par glisser-deposer DANS l'outil, plus le module photo\n  // complet du skill (Vignette, Selective Color, Levels, Black and White, Color,\n  // Light, Filters), chaque image gardant ses propres reglages.\n\n  var IMAGES = [\n    { id: \"01\", file: \"01-IMG_6207.jpg\" },\n    { id: \"02\", file: \"02-DJI_20000818114702_0855_D.jpg\" },\n    { id: \"03\", file: \"03-DJI_20000818114703_0856_D.jpg\" },\n    { id: \"04\", file: \"04-DJI_20000818115615_0904_D.jpg\" },\n    { id: \"05\", file: \"05-DJI_20000818120619_0909_D.jpg\" },\n    { id: \"06\", file: \"06-IMG_6111.jpg\" },\n    { id: \"07\", file: \"07-IMG_6132.jpg\" },\n    { id: \"08\", file: \"08-IMG_6138.jpg\" },\n    { id: \"09\", file: \"09-IMG_6164.jpg\" }\n  ];\n  var SOURCE_DIR = \"/Users/zenray/Downloads/acquarium-post1/zenray-html-hda-acquarium-post1/out/\";\n  var PROJECT = \"acquarium-post1\";\n\n  var byId = {};\n  IMAGES.forEach(function (img) { byId[img.id] = img; });\n\n  var order = IMAGES.map(function (i) { return i.id; });\n  var initialOrder = order.slice();\n\n  // Un jeu de reglages COMPLET par image, initialise aux defauts du module.\n  var settings = {};\n  IMAGES.forEach(function (img) { settings[img.id] = ZRPhotoAdjustments.defaults(); });\n\n  var selectedId = order[0];\n  var selectedChannel = 0;\n  var CHANNELS = [\"Rouge\", \"Jaune\", \"Vert\", \"Cyan\", \"Bleu\", \"Magenta\"];\n  var FILTERS = ZRPhotoAdjustments.filters();\n\n  var canvas = document.getElementById(\"photo\");\n  var source = document.getElementById(\"source\");\n  var strip = document.getElementById(\"strip\");\n  var status = document.getElementById(\"status\");\n  var currentLabel = document.getElementById(\"currentLabel\");\n  var processor = new ZRPhotoAdjustments(canvas);\n  var framePending = false;\n\n  document.getElementById(\"countLabel\").textContent = IMAGES.length + \" images\";\n\n  function current() { return settings[selectedId]; }\n\n  function isNeutral(values) {\n    return JSON.stringify(values) === JSON.stringify(ZRPhotoAdjustments.defaults());\n  }\n\n  function srcUrl(file) {\n    return \"file://\" + SOURCE_DIR + encodeURIComponent(file).replace(/%2F/g, \"/\");\n  }\n\n  function scheduleRender() {\n    if (framePending) return;\n    framePending = true;\n    requestAnimationFrame(function () {\n      framePending = false;\n      processor.set(current());\n      refreshTileFlags();\n    });\n  }\n\n  // ---------- panneau de reglages ----------\n\n  var controlRegistry = [];\n\n  function slider(parent, label, path, min, max, value, step) {\n    var row = document.createElement(\"label\");\n    row.className = \"zr-photo-control\";\n    var name = document.createElement(\"span\");\n    name.textContent = label;\n    var input = document.createElement(\"input\");\n    input.type = \"range\";\n    input.min = min; input.max = max; input.step = step || 1; input.value = value;\n    var output = document.createElement(\"output\");\n    output.value = Math.round(Number(value));\n    input.addEventListener(\"input\", function () {\n      var v = Number(input.value);\n      output.value = Math.round(v);\n      writePath(path, v);\n      scheduleRender();\n    });\n    row.append(name, input, output);\n    parent.append(row);\n    controlRegistry.push({ input: input, output: output, path: path });\n    return input;\n  }\n\n  // `path` designe un chemin dans l'objet de reglages, par exemple\n  // \"saturation\", \"levels.midtone\" ou \"selective.ACTIVE.hue\" (ACTIVE etant\n  // resolu au canal Selective Color actuellement selectionne).\n  function resolvePath(path) {\n    return path.replace(\"ACTIVE\", String(selectedChannel)).split(\".\");\n  }\n\n  function writePath(path, value) {\n    var parts = resolvePath(path);\n    var node = current();\n    for (var i = 0; i < parts.length - 1; i++) node = node[parts[i]];\n    node[parts[parts.length - 1]] = value;\n  }\n\n  function readPath(path) {\n    var parts = resolvePath(path);\n    var node = current();\n    for (var i = 0; i < parts.length - 1; i++) node = node[parts[i]];\n    return node[parts[parts.length - 1]];\n  }\n\n  function syncControlsFromSettings() {\n    controlRegistry.forEach(function (control) {\n      var value = readPath(control.path);\n      control.input.value = value;\n      control.output.value = Math.round(Number(value));\n    });\n    document.querySelectorAll(\"#filter-buttons button\").forEach(function (button) {\n      button.setAttribute(\"aria-pressed\", button.dataset.filter === current().filter ? \"true\" : \"false\");\n    });\n  }\n\n  function buildControls() {\n    slider(document.getElementById(\"vignette-controls\"), \"Strength\", \"vignette\", 0, 100, 0);\n\n    var tabs = document.getElementById(\"selective-tabs\");\n    CHANNELS.forEach(function (name, index) {\n      var button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.dataset.channel = index;\n      button.title = name;\n      button.setAttribute(\"aria-label\", name);\n      button.setAttribute(\"aria-pressed\", index === selectedChannel ? \"true\" : \"false\");\n      button.addEventListener(\"click\", function () {\n        selectedChannel = index;\n        tabs.querySelectorAll(\"button\").forEach(function (b) {\n          b.setAttribute(\"aria-pressed\", Number(b.dataset.channel) === index ? \"true\" : \"false\");\n        });\n        syncControlsFromSettings();\n      });\n      tabs.append(button);\n    });\n    var selective = document.getElementById(\"selective-controls\");\n    slider(selective, \"Hue\", \"selective.ACTIVE.hue\", -100, 100, 0);\n    slider(selective, \"Saturation\", \"selective.ACTIVE.saturation\", -100, 100, 0);\n    slider(selective, \"Luminance\", \"selective.ACTIVE.luminance\", -100, 100, 0);\n\n    var levels = document.getElementById(\"levels-controls\");\n    slider(levels, \"Input Black\", \"levels.inputBlack\", 0, 100, 0);\n    slider(levels, \"Midtone\", \"levels.midtone\", 0, 100, 50);\n    slider(levels, \"Input White\", \"levels.inputWhite\", 0, 100, 100);\n    slider(levels, \"Output Black\", \"levels.outputBlack\", 0, 100, 0);\n    slider(levels, \"Output White\", \"levels.outputWhite\", 0, 100, 100);\n\n    slider(document.getElementById(\"black-white-controls\"), \"Strength\", \"blackAndWhite\", 0, 100, 0);\n\n    var color = document.getElementById(\"color-controls\");\n    slider(color, \"Saturation\", \"saturation\", -100, 100, 0);\n    slider(color, \"Vibrance\", \"vibrance\", -100, 100, 0);\n\n    var light = document.getElementById(\"light-controls\");\n    [[\"Brilliance\", \"brilliance\"], [\"Exposure\", \"exposure\"], [\"Highlights\", \"highlights\"],\n     [\"Shadows\", \"shadows\"], [\"Brightness\", \"brightness\"], [\"Contrast\", \"contrast\"],\n     [\"Black Point\", \"blackPoint\"]].forEach(function (pair) {\n      slider(light, pair[0], pair[1], -100, 100, 0);\n    });\n\n    var filterButtons = document.getElementById(\"filter-buttons\");\n    FILTERS.forEach(function (name) {\n      var button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.textContent = name;\n      button.dataset.filter = name;\n      button.setAttribute(\"aria-pressed\", name === \"Original\" ? \"true\" : \"false\");\n      button.addEventListener(\"click\", function () {\n        current().filter = name;\n        filterButtons.querySelectorAll(\"button\").forEach(function (b) {\n          b.setAttribute(\"aria-pressed\", b === button ? \"true\" : \"false\");\n        });\n        scheduleRender();\n      });\n      filterButtons.append(button);\n    });\n    slider(document.getElementById(\"filter-controls\"), \"Strength\", \"filterStrength\", 0, 100, 100);\n  }\n\n  // ---------- bande de vignettes, selection et reorder ----------\n\n  var dragSrcId = null;\n\n  function refreshTileFlags() {\n    strip.querySelectorAll(\".tile\").forEach(function (tile) {\n      tile.classList.toggle(\"has-edits\", !isNeutral(settings[tile.dataset.id]));\n      tile.classList.toggle(\"selected\", tile.dataset.id === selectedId);\n    });\n  }\n\n  function renderStrip() {\n    strip.innerHTML = \"\";\n    order.forEach(function (id, index) {\n      var img = byId[id];\n      var tile = document.createElement(\"div\");\n      tile.className = \"tile\";\n      tile.draggable = true;\n      tile.dataset.id = id;\n\n      var thumb = document.createElement(\"div\");\n      thumb.className = \"thumb\";\n      var el = document.createElement(\"img\");\n      el.src = srcUrl(img.file);\n      el.alt = img.file;\n      thumb.append(el);\n\n      var meta = document.createElement(\"div\");\n      meta.className = \"meta\";\n      var pos = document.createElement(\"span\");\n      pos.className = \"pos\";\n      pos.textContent = String(index + 1).padStart(2, \"0\");\n      var nm = document.createElement(\"span\");\n      nm.className = \"nm\";\n      nm.textContent = img.file;\n      meta.append(pos, nm);\n\n      var dot = document.createElement(\"span\");\n      dot.className = \"edited\";\n\n      tile.append(thumb, meta, dot);\n\n      tile.addEventListener(\"click\", function () { select(id); });\n      tile.addEventListener(\"dragstart\", function () { dragSrcId = id; tile.classList.add(\"dragging\"); });\n      tile.addEventListener(\"dragend\", function () { tile.classList.remove(\"dragging\"); });\n      tile.addEventListener(\"dragover\", function (e) { e.preventDefault(); tile.classList.add(\"drop-target\"); });\n      tile.addEventListener(\"dragleave\", function () { tile.classList.remove(\"drop-target\"); });\n      tile.addEventListener(\"drop\", function (e) {\n        e.preventDefault();\n        tile.classList.remove(\"drop-target\");\n        if (!dragSrcId || dragSrcId === id) return;\n        var from = order.indexOf(dragSrcId);\n        var to = order.indexOf(id);\n        order.splice(from, 1);\n        order.splice(to, 0, dragSrcId);\n        dragSrcId = null;\n        renderStrip();\n      });\n\n      strip.append(tile);\n    });\n    refreshTileFlags();\n  }\n\n  function select(id) {\n    selectedId = id;\n    var img = byId[id];\n    currentLabel.innerHTML = \"position <b>\" + String(order.indexOf(id) + 1).padStart(2, \"0\") +\n      \"</b> · id \" + id + \" · \" + img.file;\n    source.src = srcUrl(img.file);\n    refreshTileFlags();\n    syncControlsFromSettings();\n  }\n\n  source.addEventListener(\"load\", function () {\n    processor.setImage(source);\n    processor.set(current());\n    status.textContent = source.naturalWidth + \" × \" + source.naturalHeight + \" px\";\n  });\n  source.addEventListener(\"error\", function () {\n    status.textContent = \"image introuvable : \" + source.src;\n  });\n\n  // ---------- actions ----------\n\n  document.getElementById(\"resetImageBtn\").addEventListener(\"click\", function () {\n    settings[selectedId] = ZRPhotoAdjustments.defaults();\n    syncControlsFromSettings();\n    scheduleRender();\n  });\n\n  document.getElementById(\"resetOrderBtn\").addEventListener(\"click\", function () {\n    order = initialOrder.slice();\n    renderStrip();\n    select(selectedId);\n  });\n\n  function payload() {\n    var images = {};\n    order.forEach(function (id, index) {\n      var img = byId[id];\n      var dot = img.file.lastIndexOf(\".\");\n      var stem = dot === -1 ? img.file : img.file.slice(0, dot);\n      var ext = dot === -1 ? \"\" : img.file.slice(dot);\n      images[id] = {\n        position: index + 1,\n        file: img.file,\n        output: stem + \"_\" + String(index + 1).padStart(2, \"0\") + ext,\n        photo: settings[id]\n      };\n    });\n    return { project: PROJECT, order: order, images: images };\n  }\n\n  function copyText(text) {\n    var ta = document.createElement(\"textarea\");\n    ta.value = text;\n    ta.style.position = \"fixed\";\n    ta.style.opacity = \"0\";\n    document.body.appendChild(ta);\n    ta.select();\n    var ok = false;\n    try { ok = document.execCommand(\"copy\"); } catch (e) {}\n    ta.remove();\n    return ok;\n  }\n\n  function outputText() {\n    var data = payload();\n    var lines = order.map(function (id) {\n      var entry = data.images[id];\n      var edited = isNeutral(entry.photo) ? \"sans retouche\" : \"retouchée\";\n      return String(entry.position).padStart(2, \"0\") + \": \" + entry.file + \" -> \" + entry.output + \"  (\" + edited + \")\";\n    });\n    return \"ZENRAY-HTML-HDA HEAVY · \" + PROJECT + \"\\n\\n\" +\n      lines.join(\"\\n\") + \"\\n\\n\" + JSON.stringify(data, null, 2);\n  }\n\n  var outBox = document.getElementById(\"outBox\");\n  var outText = document.getElementById(\"outText\");\n\n  document.getElementById(\"copyAllBtn\").addEventListener(\"click\", function () {\n    var text = outputText();\n    outText.value = text;\n    outBox.classList.add(\"shown\");\n    outText.focus();\n    outText.select();\n    copyText(text);\n  });\n  document.getElementById(\"outCopyBtn\").addEventListener(\"click\", function () {\n    var ok = copyText(outText.value);\n    document.getElementById(\"outCopyBtn\").textContent = ok ? \"Copié\" : \"Sélectionne et copie à la main\";\n  });\n  document.getElementById(\"outCloseBtn\").addEventListener(\"click\", function () {\n    outBox.classList.remove(\"shown\");\n    document.getElementById(\"outCopyBtn\").textContent = \"Copier\";\n  });\n\n  // ---------- demarrage ----------\n\n  buildControls();\n  renderStrip();\n  select(order[