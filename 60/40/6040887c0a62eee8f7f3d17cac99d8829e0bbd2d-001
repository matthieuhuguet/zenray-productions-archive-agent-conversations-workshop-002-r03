gabarit) doit\netre unique, et le projet ne doit etre qu'un jeu de parametres. Ici, le seul\nbloc qui depend du projet est `@zr-instance` dans le HTML, et ce script l'ecrit.\n\nUsage\n    zr-hda-instance.py <dossier-images> [--mode light|heavy] [--project NOM]\n                       [--format 4:5] [--dest DOSSIER] [--open] [--force]\n\nExemples\n    # Cadrage d'un lot de photos, format 4:5, ouverture dans Chrome\n    zr-hda-instance.py ~/Downloads/mon-post --open\n\n    # Retouche + reorder d'un out/ deja cadre (poupee russe)\n    zr-hda-instance.py ~/Downloads/mon-post/zenray-html-hda-mon-post/out \\\\\n        --mode heavy --open\n\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\n\nSKILL = Path(__file__).resolve().parent.parent\nTEMPLATES = SKILL / \"templates\"\nINSTANCES_INDEX = SKILL / \"instances\" / \"INDEX.md\"\n\nIMAGE_SUFFIXES = {\".jpg\", \".jpeg\", \".png\", \".webp\", \".tif\", \".tiff\", \".heic\", \".JPG\", \".JPEG\", \".PNG\"}\nFORMATS = {\"4:5\", \"1:1\", \"9:16\", \"16:9\", \"1:2\", \"3:4\", \"2:3\", \"4:3\"}\n\n\ndef measure(path):\n    \"\"\"Dimensions en pixels. Pillow si dispo, sinon `sips`, natif macOS.\"\"\"\n    try:\n        from PIL import Image\n        with Image.open(path) as im:\n            return im.size\n    except Exception:\n        try:\n            out = subprocess.run([\"sips\", \"-g\", \"pixelWidth\", \"-g\", \"pixelHeight\", str(path)],\n                                 capture_output=True, text=True, check=True).stdout\n            w = int(re.search(r\"pixelWidth:\\s*(\\d+)\", out).group(1))\n            h = int(re.search(r\"pixelHeight:\\s*(\\d+)\", out).group(1))\n            return w, h\n        except Exception:\n            return 0, 0\n\n\ndef collect_images(source_dir):\n    files = sorted(\n        (p for p in source_dir.iterdir()\n         if p.is_file() and p.suffix in IMAGE_SUFFIXES and not p.name.startswith(\".\")),\n        key=lambda p: p.name.lower(),\n    )\n    images = []\n    for position, path in enumerate(files, start=1):\n        width, height = measure(path)\n        images.append({\n            \"id\": f\"{position:02d}\",\n            \"file\": path.name,\n            \"path\": str(path),\n            \"width\": width,\n            \"height\": height,\n        })\n    return images\n\n\ndef render_template(mode, dest, project, source_dir, images, target_format):\n    template_dir = TEMPLATES / f\"hda-{mode}\"\n    if not template_dir.is_dir():\n        raise SystemExit(f\"gabarit introuvable : {template_dir}\")\n\n    dest.mkdir(parents=True, exist_ok=True)\n    for item in template_dir.iterdir():\n        target = dest / item.name\n        if item.is_dir():\n            shutil.copytree(item, target, dirs_exist_ok=True)\n        else:\n            shutil.copy2(item, target)\n\n    html_path = dest / \"index.html\"\n    html = html_path.read_text()\n\n    # Le JS n'a besoin que de l'id et du nom ; le chemin absolu et les\n    # dimensions vivent dans _index.json, que lit le cook Python.\n    light_images = [{\"id\": i[\"id\"], \"file\": i[\"file\"]} for i in images]\n    payload = json.dumps(light_images, indent=4, ensure_ascii=False)\n    payload = payload.replace(\"\\n\", \"\\n  \")\n\n    substitutions = {\n        \"__ZR_PROJECT__\": project,\n        \"__ZR_SOURCE_DIR__\": str(source_dir) + \"/\",\n        \"__ZR_IMAGES__\": payload,\n        \"__ZR_DEFAULT_FORMAT__\": target_format,\n    }\n    for key, value in substitutions.items():\n        html = html.replace(key, value)\n\n    leftover = sorted(set(re.findall(r\"__ZR_[A-Z_]+__\", html)))\n    if leftover:\n        raise SystemExit(f\"parametres non substitues : {leftover}\")\n    html_path.write_text(html)\n\n    (dest / \"_index.json\").write_text(json.dumps(\n        {\"dossier_source\": str(source_dir), \"images\": images}, indent=2, ensure_ascii=False) + \"\\n\")\n    return html_path\n\n\ndef register(dest, mode, project, count, source_dir):\n    INSTANCES_INDEX.parent.mkdir(parents=True, exist_ok=True)\n    if not INSTANCES_INDEX.exists():\n        INSTANCES_INDEX.write_text(\n            \"# Instances zenray-html-hda\\n\\n\"\n            \"Registre append-only des outils crees depuis `templates/`. Une ligne par\\n\"\n            \"instance : la relire coute quelques dizaines de tokens, la recreer a la main\\n\"\n            \"en coutait plus de trente mille.\\n\\n\"\n            \"| Date | Mode | Projet | Images | Dossier |\\n\"\n            \"|---|---|---|---|---|\\n\"\n        )\n    stamp = datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n    line = f\"| {stamp} | {mode} | {project} | {count} | `{dest}` |\\n\"\n    with INSTANCES_INDEX.open(\"a\") as handle:\n        handle.write(line)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Cree une instance d'outil zenray-html-hda.\")\n    parser.add_argument(\"source\", type=Path, help=\"dossier contenant les images\")\n    parser.add_argument(\"--mode\", choices=(\"light\", \"heavy\"), default=\"light\",\n                        help=\"light = cadrage et texte ; heavy = reorder, photo et texte\")\n    parser.add_argument(\"--project\", default=None, help=\"nom parlant (defaut : nom du dossier source)\")\n    parser.add_argument(\"--format\", dest=\"target_format\", default=\"4:5\", choices=sorted(FORMATS),\n                        help=\"format cible du mode light (defaut 4:5)\")\n    parser.add_argument(\"--dest\", type=Path, default=None, help=\"dossier de l'instance\")\n    parser.add_argument(\"--open\", action=\"store_true\", help=\"ouvrir dans Chrome une fois cree\")\n    parser.add_argument(\"--force\", action=\"store_true\", help=\"ecraser une instance existante\")\n    args = parser.parse_args()\n\n    source_dir = args.source.expanduser().resolve()\n    if not source_dir.is_dir():\n        raise SystemExit(f\"dossier source introuvable : {source_dir}\")\n\n    project = args.project or source_dir.name\n    dest = (args.dest.expanduser().resolve() if args.dest\n            else source_dir / f\"zenray-html-hda-{project}\")\n    if args.mode == \"heavy\" and not args.dest:\n        dest = source_dir / f\"zenray-html-hda-{project}-heavy\"\n\n    if dest.exists() and not args.force:\n        raise SystemExit(f\"l'instance existe deja : {dest}\\nrelancer avec --force pour l'ecraser\")\n\n    images = collect_images(source_dir)\n    if not images:\n        raise SystemExit(f\"aucune image trouvee dans {source_dir}\")\n\n    html_path = render_template(args.mode, dest, project, source_dir, images, args.target_format)\n    register(dest, args.mode, project, len(images), dest)\n\n    print(f\"instance {args.mode} creee : {dest}\")\n    print(f\"{len(images)} images indexees, format {args.target_format}\")\n    for image in images[:3]:\n        print(f\"  {image['id']}  {image['file']}  {image['width']}x{image['height']}\")\n    if len(images) > 3:\n        print(f\"  ... et {len(images) - 3} autres\")\n    cook = \"photo-apply.py\" if args.mode == \"heavy\" else \"crop-apply.py\"\n    print(f\"\\nregler dans le navigateur, copier, coller dans \"\n          f\"{dest.name}/{'_params.json' if args.mode == 'heavy' else '_crop_params.json'}, \"\n          f\"puis : python3 {cook}\")\n\n    if args.open:\n        subprocess.run([\"open\", \"-a\", \"Google Chrome\", str(html_path)], check=False)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","structuredPatch":[{"oldStart":96,"oldLines":9,"newStart":96,"newLines":16,"lines":["     payload = json.dumps(light_images, indent=4, ensure_ascii=False)","     payload = payload.replace(\"\\n\", \"\\n  \")"," ","+    # Chemin RELATIF, jamais `file://` absolu. Deux raisons, la seconde est","+    # bloquante : un chemin relatif marche aussi bien en file:// qu'en http, et","+    # surtout WebGL REFUSE une texture issue d'une origine opaque, ce qu'est","+    # tout fichier ouvert en file://. Avec `f