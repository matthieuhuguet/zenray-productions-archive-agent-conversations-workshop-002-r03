ngle|\n    Angle positif = sens CSS (horaire), coherent avec `rotate(Xdeg)`.\n    \"\"\"\n    s = max(canvas_w / nw, canvas_h / nh)\n    x0 = (nw - canvas_w / s) * (px / 100)\n    y0 = (nh - canvas_h / s) * (py / 100)\n\n    ratio = max(canvas_h / canvas_w, canvas_w / canvas_h)\n    theta = math.radians(angle_deg)\n    safescale = abs(math.cos(theta)) + ratio * abs(math.sin(theta))\n    safescale *= 1.002  # marge anti-arrondi\n\n    z = zoom * safescale\n    cx, cy = canvas_w / 2, canvas_h / 2\n    cos_t, sin_t = math.cos(theta), math.sin(theta)\n\n    a = cos_t / (z * s)\n    b = sin_t / (z * s)\n    c = x0 + cx / s - (cos_t * cx + sin_t * cy) / (z * s)\n    d = -sin_t / (z * s)\n    e = cos_t / (z * s)\n    f = y0 + cy / s + (sin_t * cx - cos_t * cy) / (z * s)\n    return (a, b, c, d, e, f)\n\n\ndef load_font(font_key, weight, size):\n    size = max(1, round(size))\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])  # InterVariable, axe wght natif\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    \"\"\"Coin haut-gauche (x,y) du texte pour dessiner `bbox` a l'ancre donnee.\n    Meme convention que le CSS (text-align + top/middle/bottom + marge 6%).\"\"\"\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x,